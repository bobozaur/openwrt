Subject: [PATCH] block: check HFS volumes before mounting

Dispatch HFS and HFS+ volumes to the installed hfsprogs checker when
filesystem checking is enabled. Its noninteractive preen option matches
the existing -p invocation and repairs the clean-unmount state after a
successful check. Keep checker absence and failure handling unchanged.

--- a/block.c
+++ b/block.c
@@ -775,6 +775,7 @@
 	const char *fatfsck = "/usr/sbin/fsck.fat";
 	const char *btrfsck = "/usr/bin/btrfsck";
 	const char *ntfsck = "/usr/bin/ntfsfix";
+	const char *hfsck = "/usr/sbin/fsck.hfsplus";
 	const char *ckfs;
 
 	/* UBIFS does not need stuff like fsck */
@@ -791,6 +792,8 @@
 		ckfs = btrfsck;
 	} else if (!strncmp(pr->type, "ntfs", 4)) {
 		ckfs = ntfsck;
+	} else if (!strcmp(pr->type, "hfs") || !strcmp(pr->type, "hfsplus")) {
+		ckfs = hfsck;
 	} else {
 		ULOG_ERR("check_filesystem: %s is not supported\n", pr->type);
 		return;
