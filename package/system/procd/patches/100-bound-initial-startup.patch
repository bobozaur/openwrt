From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] add an opt-in absolute boot deadline to PID 1

boot_timeout=N bounds initd/preinit and procd startup independently of rcS and
the event loop. Preserve the original CLOCK_BOOTTIME deadline across exec and
cancel it only on entry to STATE_RUNNING. Normal watchdog feeding and upgraded
are unchanged; devices without the parameter retain existing behavior.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>

--- /dev/null
+++ b/boot_timeout.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef __PROCD_BOOT_TIMEOUT_H
+#define __PROCD_BOOT_TIMEOUT_H
+
+#ifndef DISABLE_INIT
+/* initd starts the deadline; procd resumes it after exec, without renewal. */
+void boot_timeout_start(void);
+void boot_timeout_resume(void);
+void boot_timeout_complete(void);
+#else
+static inline void boot_timeout_resume(void) {}
+static inline void boot_timeout_complete(void) {}
+#endif
+
+#endif
--- /dev/null
+++ b/boot_timeout.c
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <sys/reboot.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "boot_timeout.h"
+#include "utils/utils.h"
+
+#define DEADLINE_ENV "PROCD_BOOT_DEADLINE"
+
+static timer_t boot_timer;
+static volatile sig_atomic_t armed;
+
+static void boot_timeout_expired(int signal)
+{
+	if (!armed)
+		return;
+
+	/* Do not depend on the event loop, rcS, sync(), or shutdown services. */
+	reboot(RB_AUTOBOOT);
+	for (;;)
+		pause();
+}
+
+static void boot_timeout_arm(const struct timespec *deadline)
+{
+	struct sigevent event = { .sigev_notify = SIGEV_SIGNAL, .sigev_signo = SIGALRM };
+	struct sigaction action = { .sa_handler = boot_timeout_expired };
+	struct itimerspec timeout = { .it_value = *deadline };
+	struct timespec now;
+	sigset_t set;
+
+	armed = 1;
+	if (clock_gettime(CLOCK_BOOTTIME, &now) ||
+	    now.tv_sec > deadline->tv_sec ||
+	    (now.tv_sec == deadline->tv_sec && now.tv_nsec >= deadline->tv_nsec))
+		boot_timeout_expired(SIGALRM);
+
+	sigemptyset(&action.sa_mask);
+	sigemptyset(&set);
+	sigaddset(&set, SIGALRM);
+	if (sigaction(SIGALRM, &action, NULL) ||
+	    sigprocmask(SIG_UNBLOCK, &set, NULL) ||
+	    timer_create(CLOCK_BOOTTIME, &event, &boot_timer) ||
+	    timer_settime(boot_timer, TIMER_ABSTIME, &timeout, NULL))
+		boot_timeout_expired(SIGALRM);
+}
+
+void boot_timeout_start(void)
+{
+	struct timespec deadline;
+	char value[64], *end;
+	unsigned long seconds;
+
+	if (getpid() != 1 ||
+	    !get_cmdline_val("boot_timeout", value, sizeof(value)))
+		return;
+
+	errno = 0;
+	seconds = strtoul(value, &end, 10);
+	if (errno || end == value || *end || !seconds || seconds > INT_MAX)
+		return;
+
+	armed = 1;
+	if (clock_gettime(CLOCK_BOOTTIME, &deadline))
+		boot_timeout_expired(SIGALRM);
+	deadline.tv_sec += seconds;
+	snprintf(value, sizeof(value), "%" PRIdMAX ".%09ld",
+		 (intmax_t)deadline.tv_sec, deadline.tv_nsec);
+	if (setenv(DEADLINE_ENV, value, 1))
+		boot_timeout_expired(SIGALRM);
+
+	boot_timeout_arm(&deadline);
+}
+
+void boot_timeout_resume(void)
+{
+	struct timespec deadline;
+	const char *value;
+	intmax_t seconds;
+	char trailing;
+
+	if (getpid() != 1 || !(value = getenv(DEADLINE_ENV)))
+		return;
+
+	/* POSIX timers disappear on exec; only the original absolute time survives. */
+	armed = 1;
+	if (sscanf(value, "%" SCNdMAX ".%ld%c", &seconds, &deadline.tv_nsec, &trailing) != 2 ||
+	    seconds < 0 || deadline.tv_nsec < 0 || deadline.tv_nsec >= 1000000000L)
+		boot_timeout_expired(SIGALRM);
+	deadline.tv_sec = seconds;
+	boot_timeout_arm(&deadline);
+}
+
+void boot_timeout_complete(void)
+{
+	/* A signal queued before timer_delete must not reboot an accepted boot. */
+	if (!armed)
+		return;
+	armed = 0;
+	timer_delete(boot_timer);
+	unsetenv(DEADLINE_ENV);
+}
