@@ -239,8 +246,34 @@
  *
  * committing may reload the whole uci_package data,
  * the supplied pointer is updated accordingly
+ *
+ * Saved edits are consumed only after durable configuration publication.
+ * UCI_ERR_PUBLISHED may report the prerequisite uci_save publication, or a
+ * configuration publication followed by synchronization/delta cleanup failure.
+ * Inspect both committed and pending state before retrying; replaying
+ * non-idempotent deltas after that error can repeat their effects.
  */
 extern int uci_commit(struct uci_context *ctx, struct uci_package **p, bool overwrite);
+
+/**
+ * Serialize a conditional update of one file-backed package against save and
+ * commit in other libuci users. Load committed state again after acquiring the
+ * lock, perform the condition check and commit, then unlock. Delta paths remain
+ * the caller's responsibility. Nested locks in this context must name the same
+ * package; freeing the context also releases the lock. Direct file writers do
+ * not participate in this protocol.
+ */
+extern int uci_lock(struct uci_context *ctx, struct uci_package *p);
+
+/**
+ * Acquire a named file-backed package before loading it, using the same
+ * primary/secondary directory selection as uci_load(). Does not create a
+ * missing package or wait for a lock. Contention, interruption, or replacement
+ * during the single acquisition attempt returns UCI_ERR_BUSY. Load only after
+ * success and release with uci_unlock(). Delta files remain caller-owned.
+ */
+extern int uci_trylock(struct uci_context *ctx, const char *name);
+extern void uci_unlock(struct uci_context *ctx);
 
