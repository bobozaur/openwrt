+__private void uci_lock_path(struct uci_context *ctx, char *path, bool wait)
+{
+	struct stat held, current;
+	int fd, error = UCI_ERR_IO;
+
+	if (ctx->lock_depth) {
+		bool same = !strcmp(ctx->lock_path, path);
+		free(path);
+		UCI_ASSERT(ctx, same);
+		ctx->lock_depth++;
+		return;
+	}
+
+	for (;;) {
+		fd = open(path, O_RDONLY | O_CLOEXEC | (wait ? O_CREAT : O_NONBLOCK), UCI_FILEMODE);
+		if (fd < 0) {
+			if (errno == ENOENT)
+				error = UCI_ERR_NOTFOUND;
+			break;
+		}
+		while (flock(fd, LOCK_EX | (wait ? 0 : LOCK_NB)) < 0) {
+			if (wait && errno == EINTR)
+				continue;
+			if (!wait && (errno == EWOULDBLOCK || errno == EAGAIN || errno == EINTR))
+				error = UCI_ERR_BUSY;
+			close(fd);
+			fd = -1;
+			break;
+		}
+		if (fd < 0)
+			break;
+		if (fstat(fd, &held) || stat(path, &current)) {
+			if (!wait && errno == ENOENT)
+				error = UCI_ERR_BUSY;
+			close(fd);
+			break;
+		}
+		if (!S_ISREG(held.st_mode)) {
+			error = UCI_ERR_INVAL;
+			close(fd);
+			break;
+		}
+		if (held.st_dev == current.st_dev && held.st_ino == current.st_ino) {
+			ctx->lock_fd = fd;
+			ctx->lock_depth = 1;
+			ctx->lock_path = path;
+			return;
+		}
+		/* A preceding committer replaced the inode while we waited. Its new
+		 * inode remains locked until publication finishes; acquire that one. */
+		close(fd);
+		if (!wait) {
+			error = UCI_ERR_BUSY;
+			break;
+		}
+	}
+	free(path);
+	UCI_THROW(ctx, error);
+}
+
+int uci_lock(struct uci_context *ctx, struct uci_package *p)
+{
+	char *path;
+	const char *confdir;
+
+	UCI_HANDLE_ERR(ctx);
+	UCI_ASSERT(ctx, p && p->backend == &uci_file_backend);
+	confdir = p->uses_conf2 ? ctx->conf2dir : ctx->confdir;
+	UCI_ASSERT(ctx, p->path || confdir);
+	if (p->path)
+		path = strdup(p->path);
+	else if (asprintf(&path, "%s/%s", confdir, p->e.name) < 0)
+		path = NULL;
+	if (!path)
+		UCI_THROW(ctx, UCI_ERR_MEM);
+	uci_lock_path(ctx, path, true);
+	return 0;
+}
+
+void uci_unlock(struct uci_context *ctx)
+{
+	if (!ctx || !ctx->lock_depth || --ctx->lock_depth)
+		return;
+	close(ctx->lock_fd);
+	free(ctx->lock_path);
+	ctx->lock_path = NULL;
+	ctx->lock_fd = -1;
+}
