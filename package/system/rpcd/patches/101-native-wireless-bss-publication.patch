+			if (u->section && !rpc_mesh_new_matches(c, u->section, u->values))
+				goto reply;
+		} else {
+			value = rpc_wps_field(u->expected, ".type");
+			if (!rpc_wps_string(value))
+				goto invalid;
+			u->type = blobmsg_get_string(value);
+			if (!rpc_wps_section(c, u->section, u->expected, NULL) &&
+			    !rpc_wps_section(c, u->section, u->expected, u->values))
+				goto reply;
+		}
+		if (!strcmp(u->type, "wifi-device")) {
+			if (strcmp(u->name, device_name) || device_values)
+				goto invalid;
+			device_values = u->values;
+		} else if (!strcmp(u->type, "wifi-iface")) {
+			if (u->section &&
+			    ((!strcmp(uci_lookup_option_string(c, u->section, "disabled") ?: "", "1")) ||
+				 (!strcmp(uci_lookup_option_string(c, u->section, "disabled") ?: "", "true")) ||
+				 !rpc_wps_device(c, u->section, device_name) ||
+			     strcmp(uci_lookup_option_string(c, u->section, "mode") ?: "", "ap")))
+				goto reply;
+		} else if (strcmp(u->type, "wifi-station") || !u->section) {
+			goto invalid;
+		}
+		if (!rpc_mesh_values(c, u, device_name))
+			goto invalid;
+		value = rpc_wps_field(u->values, "ifname");
+		if (!strcmp(u->type, "wifi-iface") && value) {
+			uci_foreach_element(&p->sections, e) {
+				const char *ifname;
+				s = uci_to_section(e);
+				if (s == u->section) continue;
+				ifname = uci_lookup_option_string(c, s, "ifname");
+				if (ifname && rpc_mesh_is(value, ifname))
+					goto reply;
+			}
+			for (j = 0; j < count - 1; j++)
+				if (rpc_mesh_is(rpc_wps_field(updates[j].values, "ifname"),
+								blobmsg_get_string(value)))
+					goto invalid;
+		}
+	}
+	if (!count)
+		goto invalid;
+	if (!rpc_wps_section(c, device, tb[MESH_EXPECTED_DEVICE], NULL) &&
+	    !rpc_wps_section(c, device, tb[MESH_EXPECTED_DEVICE], device_values))
+		goto reply;
+	uci_foreach_element(&p->sections, e) {
+		s = uci_to_section(e);
+		if (!strcmp(s->type, "wifi-station") && !rpc_mesh_station(c, p, s, updates, count))
+			goto reply;
+	}
+
+	for (i = 0; i < count; i++) {
+		if (!updates[i].section) {
+			changed = true;
+			continue;
+		}
+		blobmsg_for_each_attr(value, updates[i].values, values_rem)
+			if (!rpc_wps_option(c, updates[i].section, blobmsg_name(value), value))
+				changed = true;
+	}
+	if (!changed) {
+		status = "saved";
+		saved = true;
+		goto reply;
+	}
+
+	p->has_delta = false;
+	for (i = 0; i < count; i++) {
+		struct rpc_mesh_update *u = &updates[i];
+		s = u->section;
+		if (!s) {
+			struct uci_ptr ptr = { .p = p, .package = p->e.name,
+				.section = u->name, .value = "wifi-iface" };
+			if (uci_set(c, &ptr))
+				goto out;
+			s = ptr.s;
+		}
+		blobmsg_for_each_attr(value, u->values, values_rem) {
+			struct uci_ptr ptr = { .p = p, .s = s, .package = p->e.name,
+				.section = s->e.name, .option = blobmsg_name(value) };
+			if (blobmsg_type(value) == BLOBMSG_TYPE_UNSPEC) {
+				if (uci_lookup_option(c, s, ptr.option) && uci_delete(c, &ptr))
+					goto out;
+			} else if (blobmsg_type(value) == BLOBMSG_TYPE_ARRAY) {
+				struct blob_attr *item;
+				int item_rem;
+				if (uci_lookup_option(c, s, ptr.option) && uci_delete(c, &ptr))
+					goto out;
+				blobmsg_for_each_attr(item, value, item_rem) {
+					ptr.value = blobmsg_get_string(item);
+					if (uci_add_list(c, &ptr))
+						goto out;
+				}
+			} else {
+				ptr.value = blobmsg_get_string(value);
+				if (uci_set(c, &ptr))
+					goto out;
+			}
+		}
+	}
+	if (uci_commit(c, &p, true))
+		goto out;
+	status = "saved";
+	saved = true;
+reply:
+	if (c) {
+		uci_free_context(c);
+		c = NULL;
+	}
+	if (saved && rpc_uci_reload_wireless(bus))
+		status = "reload_failed";
+	blob_buf_init(&buf, 0);
+	blobmsg_add_string(&buf, "status", status);
+	ubus_send_reply(bus, req, buf.head);
+	rv = 0;
+out:
+	if (c)
+		uci_free_context(c);
+	return rv;
+invalid:
+	rv = UBUS_STATUS_INVALID_ARGUMENT;
+	goto out;
+}
