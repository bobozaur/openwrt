From 618f3cf75ae3920c1a3164215ef084cbd50eaf92 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Fri, 10 Jul 2026 07:28:08 +0200
Subject: [PATCH] libubus-obj: fix fd leaks on object message error paths

An incoming message can carry a file descriptor via SCM_RIGHTS, but
several paths dropped it without closing:

  - ubus_process_invoke() jumped to the status reply before the
    handler ran (object or method not found, missing method or data
    attribute) with req_fd still open. Any client repeatedly invoking
    a wrong method with an fd attached makes the server accumulate
    descriptors until it hits its fd limit.
  - ubus_process_obj_msg() returned early on a message without an
    object id.
  - ubus_process_unsubscribe() and ubus_process_notify() closed the
    fd only after their early returns.

Close req_fd on the reply path of ubus_process_invoke() as well, and
close the fd up front in the unsubscribe/notify handlers, which never
use it. Verified with a test client sending 20 fd-carrying invokes to
a nonexistent method: the server previously leaked 20 descriptors and
now stays flat, while regular fd passing keeps working.

Signed-off-by: Felix Fietkau <nbd@nbd.name>
Upstream-Status: Backport [https://github.com/openwrt/ubus/commit/618f3cf75ae3920c1a3164215ef084cbd50eaf92]

---
 libubus-obj.c | 31 ++++++++++++++++++++-----------
 1 file changed, 20 insertions(+), 11 deletions(-)

--- a/libubus-obj.c
+++ b/libubus-obj.c
@@ -21,6 +21,9 @@ ubus_process_unsubscribe(struct ubus_con
 {
 	struct ubus_subscriber *s;
 
+	if (fd >= 0)
+		close(fd);
+
 	if (!obj || !attrbuf[UBUS_ATTR_TARGET])
 		return;
 
@@ -30,24 +33,21 @@ ubus_process_unsubscribe(struct ubus_con
 	s = container_of(obj, struct ubus_subscriber, obj);
 	if (s->remove_cb)
 		s->remove_cb(ctx, s, blob_get_u32(attrbuf[UBUS_ATTR_TARGET]));
-
-	if (fd >= 0)
-		close(fd);
 }
 
 static void
 ubus_process_notify(struct ubus_context *ctx, struct ubus_msghdr *hdr,
 		    struct ubus_object *obj, struct blob_attr **attrbuf, int fd)
 {
+	if (fd >= 0)
+		close(fd);
+
 	if (!obj || !attrbuf[UBUS_ATTR_ACTIVE])
 		return;
 
 	obj->has_subscribers = blob_get_u8(attrbuf[UBUS_ATTR_ACTIVE]);
 	if (obj->subscribe_cb)
 		obj->subscribe_cb(ctx, obj);
-
-	if (fd >= 0)
-		close(fd);
 }
 static void
 ubus_process_invoke(struct ubus_context *ctx, struct ubus_msghdr *hdr,
@@ -110,12 +110,15 @@ found:
 
 	ret = handler(ctx, obj, &req, blob_data(attrbuf[UBUS_ATTR_METHOD]),
 		      attrbuf[UBUS_ATTR_DATA]);
-	if (req.req_fd >= 0)
-		close(req.req_fd);
-	if (req.deferred || no_reply)
+	if (req.deferred || no_reply) {
+		if (req.req_fd >= 0)
+			close(req.req_fd);
 		return;
+	}
 
 send:
+	if (req.req_fd >= 0)
+		close(req.req_fd);
 	ubus_complete_deferred_request(ctx, &req, ret);
 }
 
@@ -131,7 +134,7 @@ void __hidden ubus_process_obj_msg(struc
 	void *prev_data = NULL;
 	attrbuf = ubus_parse_msg(buf->data, blob_raw_len(buf->data));
 	if (!attrbuf[UBUS_ATTR_OBJID])
-		return;
+		goto drop;
 
 	objid = blob_get_u32(attrbuf[UBUS_ATTR_OBJID]);
 	obj = avl_find_element(&ctx->objects, &objid, obj, avl);
@@ -147,7 +150,7 @@ void __hidden ubus_process_obj_msg(struc
 		cb = ubus_process_notify;
 		break;
 	default:
-		return;
+		goto drop;
 	}
 
 	if (buf == &ctx->msgbuf) {
@@ -163,6 +166,12 @@ void __hidden ubus_process_obj_msg(struc
 		else
 			buf->data = prev_data;
 	}
+
+	return;
+
+drop:
+	if (fd >= 0)
+		close(fd);
 }
 
 static void ubus_add_object_cb(struct ubus_request *req, int type, struct blob_attr *msg)
