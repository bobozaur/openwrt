From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] libubus: preserve request envelope on early invoke errors

Initialize the caller, sequence and requested object before validating the
local object or channel handler. Early errors otherwise carry an empty request
envelope and a synchronous channel caller discards the status and times out.
Missing method errors need the same envelope. Daemon routing still determines
whether a response for a removed object can reach its caller.

Read no_reply before validation so a fire-and-forget early error does not
emit a reply. Descriptor retirement is supplied separately by upstream
commit 618f3cf75ae3920c1a3164215ef084cbd50eaf92. Deferred handlers retain
the existing completion ownership.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---

--- a/libubus-obj.c
+++ b/libubus-obj.c
@@ -54,13 +54,17 @@ ubus_process_invoke(struct ubus_context
 		    struct ubus_object *obj, struct blob_attr **attrbuf, int fd)
 {
 	struct ubus_request_data req = {
+		.peer = hdr->peer,
+		.seq = hdr->seq,
+		.object = blob_get_u32(attrbuf[UBUS_ATTR_OBJID]),
 		.fd = -1,
 		.req_fd = fd,
 	};
 	ubus_handler_t handler;
 	int method;
 	int ret;
-	bool no_reply = false;
+	bool no_reply = attrbuf[UBUS_ATTR_NO_REPLY] &&
+		blob_get_int8(attrbuf[UBUS_ATTR_NO_REPLY]);
 
 	if ((!obj && !ubus_context_is_channel(ctx)) ||
 	    (!ctx->request_handler && ubus_context_is_channel(ctx))) {
@@ -73,18 +77,11 @@ ubus_process_invoke(struct ubus_context
 		goto send;
 	}
 
-	if (attrbuf[UBUS_ATTR_NO_REPLY])
-		no_reply = blob_get_int8(attrbuf[UBUS_ATTR_NO_REPLY]);
-
-	req.peer = hdr->peer;
-	req.seq = hdr->seq;
-
 	if (ubus_context_is_channel(ctx)) {
 		handler = ctx->request_handler;
 		goto found;
 	}
 
-	req.object = obj->id;
 	if (attrbuf[UBUS_ATTR_USER] && attrbuf[UBUS_ATTR_GROUP]) {
 		req.acl.user = blobmsg_get_string(attrbuf[UBUS_ATTR_USER]);
 		req.acl.group = blobmsg_get_string(attrbuf[UBUS_ATTR_GROUP]);
@@ -110,15 +107,11 @@ found:
 
 	ret = handler(ctx, obj, &req, blob_data(attrbuf[UBUS_ATTR_METHOD]),
 		      attrbuf[UBUS_ATTR_DATA]);
-	if (req.deferred || no_reply) {
-		if (req.req_fd >= 0)
-			close(req.req_fd);
-		return;
-	}
-
 send:
 	if (req.req_fd >= 0)
 		close(req.req_fd);
+	if (req.deferred || no_reply)
+		return;
 	ubus_complete_deferred_request(ctx, &req, ret);
 }
 
