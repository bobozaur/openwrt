-static int wpasupp_ssid_decode(const char *in, char *out, int outlen)
-{
-#define hex(x) \
-	(((x) >= 'a') ? ((x) - 'a' + 10) : \
-		(((x) >= 'A') ? ((x) - 'A' + 10) : ((x) - '0')))
-
-	int len = 0;
-
-	while (*in)
-	{
-		if (len + 1 >= outlen)
-			break;
-
-		switch (*in)
-		{
-		case '\\':
-			in++;
-			switch (*in)
-			{
-			case 'n':
-				out[len++] = '\n'; in++;
-				break;
-
-			case 'r':
-				out[len++] = '\r'; in++;
-				break;
-
-			case 't':
-				out[len++] = '\t'; in++;
-				break;
-
-			case 'e':
-				out[len++] = '\033'; in++;
-				break;
-
-			case 'x':
-				if (isxdigit(*(in+1)) && isxdigit(*(in+2)))
-					out[len++] = hex(*(in+1)) * 16 + hex(*(in+2));
-				in += 3;
-				break;
-
-			default:
-				out[len++] = *in++;
-				break;
-			}
-			break;
-
-		default:
-			out[len++] = *in++;
-			break;
-		}
-	}
-
-	if (outlen > len)
-		out[len] = '\0';
-
-	return len;
-}
