-static int nl80211_get_scanlist_nl(const char *ifname, char *buf, int *len)
+static int nl80211_scan_request(unsigned int ifindex, int cmd,
+                                 struct nl80211_scanlist *sl, bool ap)
+{
+	struct nl80211_msg_conveyor *cv;
+	struct nlattr *ssids;
+
+	cv = nl80211_new(nls->nl80211, cmd,
+	                 cmd == NL80211_CMD_GET_SCAN ? NLM_F_DUMP : 0);
+	if (!cv)
+		return -ENOMEM;
+	NLA_PUT_U32(cv->msg, NL80211_ATTR_IFINDEX, ifindex);
+	if (cmd == NL80211_CMD_TRIGGER_SCAN) {
+		/* Preserve active wildcard discovery. The AP permission is only
+		 * needed for an interface currently in AP mode. */
+		if (ap)
+			NLA_PUT_U32(cv->msg, NL80211_ATTR_SCAN_FLAGS, NL80211_SCAN_FLAG_AP);
+		ssids = nla_nest_start(cv->msg, NL80211_ATTR_SCAN_SSIDS);
+		if (!ssids || nla_put(cv->msg, 1, 0, ""))
+			goto nla_put_failure;
+		nla_nest_end(cv->msg, ssids);
+	}
+	return nl80211_send(cv, cmd == NL80211_CMD_GET_SCAN ?
+	                    nl80211_get_scanlist_cb : NULL, sl);
+
+nla_put_failure:
+	nl80211_free(cv);
+	return -ENOMEM;
+}
