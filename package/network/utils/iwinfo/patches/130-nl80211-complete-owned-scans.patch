From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] nl80211: complete scans through the captured kernel interface

Use the existing kernel scan path for every ordinary scan. The preferred
WPA control path had a shorter wait and did not expose aborted completion.
Subscribe before triggering, retain active wildcard discovery, and bind
trigger, completion and result dump to the captured numeric interface.
Use one finite monotonic event deadline; reject aborts or replaced interfaces.
Native metadata/command transport and interface lifecycle queries are unchanged.
This uses privileged nl80211 scanning; control-group-only callers now need
the same CAP_NET_ADMIN permission as the native iwinfo CLI/RPC services.
Keep ordinary WPA control queries and native interface lifecycle handling.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>

--- a/iwinfo_nl80211.c
+++ b/iwinfo_nl80211.c
@@ -670,17 +670,27 @@
 	return NL_OK;
 }
 
-static int nl80211_wait(struct nl_sock *sock, unsigned int ifindex)
+static int nl80211_scan_remaining(const struct timespec *deadline)
+{
+	struct timespec now;
+	int64_t remaining;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &now))
+		return -errno;
+	remaining = (int64_t)(deadline->tv_sec - now.tv_sec) * 1000000000 +
+	            deadline->tv_nsec - now.tv_nsec;
+	if (remaining <= 0)
+		return -ETIMEDOUT;
+	return (remaining + 999999) / 1000000;
+}
+
+static int nl80211_wait(struct nl_sock *sock, unsigned int ifindex,
+                        const struct timespec *deadline)
 {
 	struct nl80211_event_conveyor cv = { .ifindex = ifindex };
 	struct pollfd pfd = { .fd = nl_socket_get_fd(sock), .events = POLLIN };
-	struct timespec deadline, now;
 	struct nl_cb *cb;
 	int err = 0, ret, timeout;
-
-	if (clock_gettime(CLOCK_MONOTONIC, &deadline))
-		return -errno;
-	deadline.tv_sec += 60;
 
 	cb = nl_cb_alloc(NL_CB_DEFAULT);
 	if (!cb)
@@ -692,16 +702,10 @@
 
 	while (!cv.recv && !err)
 	{
-		if (clock_gettime(CLOCK_MONOTONIC, &now))
-		{
-			err = -errno;
-			break;
-		}
-		timeout = (deadline.tv_sec - now.tv_sec) * 1000 +
-		          (deadline.tv_nsec - now.tv_nsec) / 1000000;
+		timeout = nl80211_scan_remaining(deadline);
 		if (timeout <= 0)
 		{
-			err = -ETIMEDOUT;
+			err = timeout;
 			break;
 		}
 
@@ -725,7 +729,7 @@
 	}
 
 	nl_cb_put(cb);
-	return err;
+	return err ? err : (cv.recv == NL80211_CMD_NEW_SCAN_RESULTS ? 0 : -ECANCELED);
 }
 
