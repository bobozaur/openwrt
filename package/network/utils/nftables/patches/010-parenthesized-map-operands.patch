+
+# Include ordinary flag/protocol expressions to guard their grammar boundaries.
+$NFT -f - <<'EOF'
+table inet scalar_map_binop {
+ map owners { type mark . ifname : ipv4_addr; elements = { 1 . "lo" : 127.0.0.3 }; }
+ map marks { type mark : mark; elements = { 1 : 0x80000000 }; }
+ map states { type mark : ct_state; elements = { 1 : established }; }
+ counter mask_true { }
+ counter mask_false { }
+ counter shift_true { }
+ counter flags_true { }
+ counter flags_false { }
+ counter assignment_true { }
+ chain out {
+  type filter hook output priority -1; policy accept;
+  ip daddr 127.0.0.1 icmp type echo-request jump semantic
+ }
+ chain semantic {
+  meta mark set 1
+  (((meta mark & 0 | 1) . oifname map @owners) ^ (ip saddr)) & (meta mark) == 0.0.0.0 counter name mask_true
+  ((meta mark & 0 | 1) map @states) & (meta mark) == 0 counter name flags_true
+  meta mark set 2
+  (((meta mark & 0 | 1) . oifname map @owners) ^ (ip saddr)) & (meta mark) == 0.0.0.0 counter name mask_false
+  ((meta mark & 0 | 1) map @states) & (meta mark) == 0 counter name flags_false
+  ((meta mark & 0 | 1) map @marks) << 1 == 0 counter name shift_true
+  meta mark set 1
+  meta mark set ((meta mark & 0 | 1) map @marks) ^ (meta mark)
+  meta mark 0x80000001 counter name assignment_true
+  meta mark set 0
+ }
+ chain check {
+  tcp flags & (fin | syn | rst | ack) == syn counter
+  meta l4proto gre ip saddr 192.0.2.1 counter
+  ((meta mark & 0 | 1) . oifname map @owners) ^ (ip saddr) == 0.0.0.0 counter
+  ip saddr ^ ((ip daddr) & 0.0.0.255) == 0.0.0.0 counter
+  ((meta mark & 0 | 1) . oifname map @owners) ^ ((ip saddr) & 255.255.255.0) == 0.0.0.0 counter
+  ((meta mark & 0 | 1) . oifname map @owners) << 1 == 0 counter
+  (((meta mark & 0 | 1) . oifname map @owners) ^ (ip saddr)) & (meta mark) == 0.0.0.0 counter
+  ((meta mark & 0 | 1) . oifname map @owners) ^ 0.0.0.1 == 0.0.0.0 counter
+  ((meta mark & 0 | 1) . oifname map @owners) & 255.255.255.0 == 192.0.2.0 counter
+  ((meta mark & 0 | 1) map @states) & (established | related) == 0 counter
+ }
+}
+EOF
+
+check_semantics()
+{
+ $NFT reset counters table inet scalar_map_binop >/dev/null
+ ping -c 1 -W 1 127.0.0.1 >/dev/null
+ for name in mask_true shift_true flags_true assignment_true; do
+  $NFT list counter inet scalar_map_binop "$name" | grep -q 'packets 1 '
+ done
+ for name in mask_false flags_false; do
+  $NFT list counter inet scalar_map_binop "$name" | grep -q 'packets 0 '
+ done
+}
+
+ip link set lo up
+check_semantics
+rules=$($NFT list table inet scalar_map_binop)
+if [ "${NFT_TEST_HAVE_json:-y}" != n ]; then
+ json_rules=$($NFT -j list table inet scalar_map_binop)
+fi
+$NFT delete table inet scalar_map_binop
+printf '%s\n' "$rules" | $NFT -f -
+check_semantics
+
+if [ "${NFT_TEST_HAVE_json:-y}" != n ]; then
+ $NFT delete table inet scalar_map_binop
+ printf '%s\n' "$json_rules" | $NFT -j -f -
+ check_semantics
+fi
+
+# The explicit selector syntax is accepted, but shifts still need a constant.
+if diagnostic=$($NFT 'add rule inet scalar_map_binop check ((meta mark & 0 | 1) . oifname map @owners) << (meta mark) == 0.0.0.0' 2>&1); then
+	exit 1
+fi
+printf '%s\n' "$diagnostic" | grep -q 'must be constant'
+
+if diagnostic=$($NFT 'add rule inet scalar_map_binop check (((meta mark & 0 | 1) . oifname map @owners) ^ (ip saddr)) & (ct bytes) == 0' 2>&1); then
+ exit 1
+fi
+printf '%s\n' "$diagnostic" | grep -q 'Map binary operands must have equal widths'
+
+# JSON must not accept RHS map trees which the textual grammar cannot reload.
+if [ "${NFT_TEST_HAVE_json:-y}" != n ]; then
+for operand in '{"map":{"key":{"meta":{"key":"mark"}},"data":"@marks"}}' '{"&":[{"map":{"key":{"meta":{"key":"mark"}},"data":"@marks"}},255]}'; do
+ json='{"nftables":[{"add":{"rule":{"family":"inet","table":"scalar_map_binop","chain":"check","expr":[{"match":{"op":"==","left":{"^":[{"meta":{"key":"mark"}},'"$operand"',0]},"right":0}}]}}}]}'
+ if diagnostic=$(printf '%s\n' "$json" | $NFT -j -f - 2>&1); then
+  exit 1
+ fi
+ printf '%s\n' "$diagnostic" | grep -q 'Map lookup requires the left side'
+done
+fi
+$NFT delete table inet scalar_map_binop
