+static bool expr_binop_contains_map(const struct expr *expr)
+{
+	if (expr->etype == EXPR_MAP)
+		return true;
+	if (expr->etype == EXPR_UNARY)
+		return expr_binop_contains_map(expr->arg);
+	if (expr->etype == EXPR_BINOP)
+		return expr_binop_contains_map(expr->left) ||
+		       expr_binop_contains_map(expr->right);
+	return false;
+}
+
+/* Maps are historically marked constant for statement validation. A scalar
+ * lookup used in scalar arithmetic or comparisons is runtime data, with the map value's width
+ * and byte order, rather than a literal eligible for constant folding.
+ */
+static int expr_evaluate_scalar_map(struct eval_ctx *ctx, struct expr **expr)
+{
+	const struct expr *data;
+
+	if (expr_evaluate(ctx, expr) < 0)
+		return -1;
+	if ((*expr)->etype != EXPR_MAP)
+		return 0;
+
+	data = (*expr)->mappings->set->data;
+	if (data->etype == EXPR_CONCAT || (data->flags & EXPR_F_INTERVAL) ||
+	    expr_basetype(data)->type != TYPE_INTEGER || !data->len ||
+	    data->len > NFT_REG_SIZE * BITS_PER_BYTE ||
+	    (data->byteorder != BYTEORDER_HOST_ENDIAN &&
+	     data->byteorder != BYTEORDER_BIG_ENDIAN))
+		return expr_error(ctx->msgs, *expr,
+				  "Binary operation requires a scalar integer map value");
+
+	(*expr)->flags &= ~EXPR_F_CONSTANT;
+	(*expr)->flags |= EXPR_F_SINGLETON;
+	(*expr)->len = data->len;
+	(*expr)->byteorder = data->byteorder;
+	__expr_set_context(&ctx->ectx, (*expr)->dtype, (*expr)->byteorder,
+			   (*expr)->len, 0);
+	return 0;
+}
