+		ret = -1;
 	fclose(f);
 
 	return ret;
@@ -555,31 +557,52 @@
 }
 
 
+int hostapd_prepare_wpa_psk(struct hostapd_bss_config *conf,
+			    const char *file, const char *supplemental,
+			    struct hostapd_wpa_psk **result)
+{
+	struct hostapd_ssid ssid = conf->ssid;
+	struct hostapd_wpa_psk *raw = ssid.wpa_psk;
+
+	*result = NULL;
+	ssid.wpa_psk = NULL;
+	/* The inline raw key is the original tail; file readers prepend rows. */
+	if (ssid.wpa_psk_set && !ssid.wpa_passphrase && raw) {
+		for (; raw->next; raw = raw->next)
+			;
+		ssid.wpa_psk = os_memdup(raw, sizeof(*raw));
+		if (!ssid.wpa_psk)
+			return -1;
+		ssid.wpa_psk->next = NULL;
+	} else if (ssid.wpa_passphrase) {
+		if (hostapd_derive_psk(&ssid) < 0)
+			goto fail;
+		ssid.wpa_psk->group = 1;
+	}
+
+	if (hostapd_config_read_wpa_psk(file, &ssid) < 0 ||
+	    hostapd_config_read_wpa_psk(supplemental, &ssid) < 0)
+		goto fail;
+	*result = ssid.wpa_psk;
+	return 0;
+fail:
+	hostapd_config_clear_wpa_psk(&ssid.wpa_psk);
+	return -1;
+}
