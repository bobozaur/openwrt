+				  conf->ssid.wpa_psk_file_static, &psk) < 0)
+		return -1;
+	hostapd_config_clear_wpa_psk(&conf->ssid.wpa_psk);
+	conf->ssid.wpa_psk = psk;
+	return 0;
+}
 
