+	case WPS_EV_PBC_ACTIVE:
+		hostapd_wps_status_reset(hapd);
+		/* fall through */
+	default:
+		goto notify;
+	}
+	if (os_get_reltime(&hapd->wps_status_time))
+		hapd->wps_status_event = NULL;
+notify:
+	hostapd_ucode_wps_state_changed();
 	if (hapd->wps_event_cb)
