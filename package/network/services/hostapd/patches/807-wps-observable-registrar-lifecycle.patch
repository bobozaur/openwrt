+static void hostapd_wps_status_reset(struct hostapd_data *hapd)
+{
+	hapd->wps_status_event = NULL;
+	hostapd_ucode_wps_state_changed();
+}
+
+
+static void hostapd_wps_set_sel_reg_cb(void *ctx, int sel_reg,
+				    u16 dev_passwd_id, u16 config_methods)
+{
+	struct hostapd_data *hapd = ctx;
+	bool selected = hapd->wps &&
+		wps_registrar_is_selected(hapd->wps->registrar);
+
+	/* The payload describes only the internal registrar. Observe the union
+	 * after every selection change, even if WPS IE construction failed. */
+	if (selected && !hapd->wps_status_selected)
+		hapd->wps_status_event = NULL;
+	hapd->wps_status_selected = selected;
+	hostapd_ucode_wps_state_changed();
 }
 
 
