+		break;
+	case WPS_EV_PWD_AUTH_FAIL:
+		hapd->wps_status_event = "failure";
+		break;
+	case WPS_EV_PBC_OVERLAP:
+		hapd->wps_status_event = "overlap";
+		break;
+	case WPS_EV_PBC_TIMEOUT:
+		hapd->wps_status_event = "timeout";
