+/* Live PSK reload can change WPS capability without replacing the BSS. */
+static void hostapd_wps_reload_sta(struct hostapd_data *hapd)
+{
+	struct sta_info *sta;
+
+	for (sta = hapd->sta_list; sta; sta = sta->next)
+		if ((sta->flags & (WLAN_STA_WPS | WLAN_STA_MAYBE_WPS)) ||
+		    (sta->eapol_sm && eap_server_uses_wps(sta->eapol_sm->eap)))
+			ieee802_1x_free_station(hapd, sta);
+}
+
+
+static void hostapd_wps_reload_disable(struct hostapd_data *hapd)
+{
+	/* Each link's EAP sessions retain that link's WPS context. */
+	hostapd_wps_reload_sta(hapd);
+	/* External RADIUS sessions use the optional shared configuration. */
+	if (hapd->eap_cfg && hapd->eap_cfg->wps == hapd->wps) {
+#ifdef RADIUS_SERVER
+		radius_server_wps_cancel(hapd->radius_srv);
+#endif /* RADIUS_SERVER */
+		hapd->eap_cfg->wps = NULL;
+	}
+	hostapd_deinit_wps(hapd);
+	if (hapd->beacon_set_done)
+		ieee802_11_set_beacon(hapd);
+}
