+/* Retire only sessions retaining a WPS context before its live replacement. */
+void radius_server_wps_cancel(struct radius_server_data *data)
+{
+	struct radius_client *client;
+	struct radius_session *sess, *next;
+
+	if (!data)
+		return;
+	for (client = data->clients; client; client = client->next)
+		for (sess = client->sessions; sess; sess = next) {
+			next = sess->next;
+			if (eap_server_uses_wps(sess->eap))
+				radius_server_session_remove(data, sess);
+		}
 }
 
 
