+static const u8 * hostapd_wps_group_psk(const struct hostapd_bss_config *conf)
+{
+	struct hostapd_wpa_psk *psk;
+
+	for (psk = conf->ssid.wpa_psk; psk; psk = psk->next)
+		if (psk->group)
+			return psk->psk;
+	return NULL;
+}
