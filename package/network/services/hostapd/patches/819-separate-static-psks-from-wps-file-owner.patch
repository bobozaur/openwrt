+static bool hostapd_wps_static_only(const struct hostapd_bss_config *conf,
+				  const u8 *group_psk)
+{
+	if (conf->ssid.security_policy != SECURITY_WPA_PSK ||
+	    !conf->ssid.wpa_psk_file_static || conf->ssid.wpa_psk_file ||
+	    conf->ssid.wpa_passphrase || group_psk)
+		return false;
+
+	wpa_printf(MSG_WARNING,
+		   "WPS: Static station PSKs require a shared key or a primary PSK file for new enrolment");
+	return true;
+}
