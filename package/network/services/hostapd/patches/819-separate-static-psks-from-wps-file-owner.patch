+static int hostapd_wps_sync_psk_parent(const char *path, const struct stat *opened)
+{
+	char target[PATH_MAX], *slash;
+	int fd, ret, saved_errno;
+
+	if (!realpath(path, target) ||
+	    hostapd_wps_psk_file_matches(target, opened))
+		return -1;
+	slash = os_strrchr(target, '/');
+	if (slash == target)
+		slash++;
+	*slash = '\0';
+	fd = open(target, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	ret = fsync(fd);
+	saved_errno = errno;
+	if (close(fd) < 0 && !ret)
+		return -1;
+	errno = saved_errno;
+	return ret;
 }
 
 
