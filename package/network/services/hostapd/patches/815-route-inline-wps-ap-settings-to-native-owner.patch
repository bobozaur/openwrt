+static int hapd_wps_cred_cb(struct hostapd_data *hapd, void *ctx)
+{
+	const struct wps_credential *cred = ctx;
+	FILE *oconf, *nconf;
+	size_t len, i;
+	char *tmp_fname;
+	char buf[1024];
+	int multi_bss;
+	int wpa;
+	int pmf_changed = 0;
+
+	if (hapd->wps == NULL)
+		return 0;
+
+	wpa_hexdump_key(MSG_DEBUG, "WPS: Received Credential attribute",
+			cred->cred_attr, cred->cred_attr_len);
+
+	wpa_printf(MSG_DEBUG, "WPS: Received new AP Settings");
+	wpa_hexdump_ascii(MSG_DEBUG, "WPS: SSID", cred->ssid, cred->ssid_len);
+	wpa_printf(MSG_DEBUG, "WPS: Authentication Type 0x%x",
+		   cred->auth_type);
+	wpa_printf(MSG_DEBUG, "WPS: Encryption Type 0x%x", cred->encr_type);
+	wpa_printf(MSG_DEBUG, "WPS: Network Key Index %d", cred->key_idx);
+	wpa_hexdump_key(MSG_DEBUG, "WPS: Network Key",
+			cred->key, cred->key_len);
+	wpa_printf(MSG_DEBUG, "WPS: MAC Address " MACSTR,
+		   MAC2STR(cred->mac_addr));
+
+	hapd_wps_notify_credential(hapd, cred);
 
 	if (hapd->conf->wps_cred_processing == 1)
 		return 0;
@@ -834,6 +842,23 @@
 static int hostapd_wps_cred_cb(void *ctx, const struct wps_credential *cred)
 {
 	struct hostapd_data *hapd = ctx;
+
+	/* Inline configurations belong to the native netifd/ucode BSS owner.
+	 * Publish only after that owner durably accepts the exact credential;
+	 * neither a pseudo filename nor a cross-BSS file rewrite owns it.
+	 * Explicit external processing retains its existing event-only path.
+	 */
+	if (hapd->iface->config_fname &&
+	    str_starts(hapd->iface->config_fname, "data:") &&
+	    hapd->conf->wps_cred_processing != 1) {
+		hapd_wps_notify_credential(hapd, cred);
+		if (hostapd_ucode_wps_credential(hapd, cred)) {
+			wpa_printf(MSG_WARNING,
+				   "WPS: Native BSS owner did not accept AP settings");
+			return -1;
+		}
+		return 0;
+	}
 	return hostapd_wps_for_each(hapd, hapd_wps_cred_cb, (void *) cred);
 }
 
