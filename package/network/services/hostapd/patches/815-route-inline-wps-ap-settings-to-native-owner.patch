 #endif /* CONFIG_DPP */
 
+#ifdef CONFIG_WPS
+int hostapd_ucode_wps_credential(struct hostapd_data *hapd,
+				 const struct wps_credential *cred)
+{
+	uc_value_t *data, *ret;
+	int accepted;
+
+	if (!cred->ssid_len || cred->ssid_len > sizeof(cred->ssid) ||
+	    cred->key_len > sizeof(cred->key))
+		return -1;
+
+	if (wpa_ucode_call_prepare("wps_credential"))
+		return -1;
+
+	data = ucv_object_new(vm);
+	ucv_object_add(data, "ssid", ucv_string_new_length(
+		(const char *) cred->ssid, cred->ssid_len));
+	ucv_object_add(data, "key", ucv_string_new_length(
+		(const char *) cred->key, cred->key_len));
+	ucv_object_add(data, "auth_type", ucv_uint64_new(cred->auth_type));
+	ucv_object_add(data, "encr_type", ucv_uint64_new(cred->encr_type));
+	ucv_object_add(data, "ieee80211w", ucv_int64_new(hapd->conf->ieee80211w));
+	ucv_object_add(data, "add_sae", ucv_boolean_new(hapd->conf->wps_cred_add_sae));
+	uc_value_push(ucv_string_new(hapd->iface->phy));
+	uc_value_push(ucv_string_new(hapd->conf->iface));
+	uc_value_push(hostapd_ucode_bss_get_uval(hapd));
+	uc_value_push(data);
+	ret = wpa_ucode_call(4);
+	accepted = ucv_type(ret) == UC_BOOLEAN && ucv_is_truish(ret);
+	ucv_put(ret);
+	return accepted ? 0 : -1;
+}
+#endif /* CONFIG_WPS */
