Subject: [PATCH] ACS: Reach BSS fallback when survey data is unsupported

Continue the completed scan when surveys explicitly return EOPNOTSUPP,
including a missing get_survey callback. Preserve other survey errors.

Score BSS interference in every eligible hardware mode, as survey-based
ACS does, so hw_mode=any can select a channel without current_mode.
Clear BSS scores and eligibility on cleanup for subsequent ACS runs.
Preserve allowed-channel primary promotion when selecting across modes.
Validate the selected primary against the configured channel/frequency lists.
---
--- a/src/ap/acs.c
+++ b/src/ap/acs.c
@@ -348,6 +348,8 @@
 		dl_list_init(&chan->survey_list);
 		chan->flag |= HOSTAPD_CHAN_SURVEY_LIST_INITIALIZED;
 		chan->min_nf = 0;
+		chan->interference_factor = 0;
+		chan->interference_bss_based = false;
 		chan->punct_bitmap = 0;
 	}
 }
@@ -974,8 +976,7 @@
 
 		/* If the AP is in the 5 GHz or 6 GHz band, lets prefer a less
 		 * crowded primary channel if one was found in the segment */
-		if (iface->current_mode &&
-		    iface->current_mode->mode == HOSTAPD_MODE_IEEE80211A &&
+		if (mode->mode == HOSTAPD_MODE_IEEE80211A &&
 		    chan != best) {
 			wpa_printf(MSG_DEBUG,
 				   "ACS: promoting channel %d over %d (less interference %Lg/%Lg)",
@@ -987,6 +988,9 @@
 #endif /* CONFIG_IEEE80211BE */
 			chan = best;
 		}
+
+		if (!is_in_chanlist(iface, chan) || !is_in_freqlist(iface, chan))
+			continue;
 
 		/* 2.4 GHz has overlapping 20 MHz channels. Include adjacent
 		 * channel interference factor. */
@@ -1263,7 +1267,7 @@
 static int acs_study_bss_based(struct hostapd_iface *iface)
 {
 	struct wpa_scan_results *scan_res;
-	int j;
+	int k, j;
 
 	wpa_printf(MSG_DEBUG, "ACS: Trying BSS-based ACS");
 
@@ -1274,24 +1278,32 @@
 		return -1;
 	}
 
-	for (j = 0; j < iface->current_mode->num_channels; j++) {
-		struct hostapd_channel_data *chan;
-		unsigned int bss_on_ch = 0;
-		size_t i;
-
-		chan = &iface->current_mode->channels[j];
-		for (i = 0; i < scan_res->num; i++) {
-			struct wpa_scan_res *bss = scan_res->res[i];
-
-			if (bss->freq == chan->freq)
-				bss_on_ch++;
-		}
-
-		wpa_printf(MSG_MSGDUMP,
-			   "ACS: Interference on ch %d (%d MHz): %d",
-			   chan->chan, chan->freq, bss_on_ch);
-		chan->interference_factor = bss_on_ch;
-		chan->interference_bss_based = true;
+	for (k = 0; k < iface->num_hw_features; k++) {
+		struct hostapd_hw_modes *mode = &iface->hw_features[k];
+
+		if (hostapd_hw_skip_mode(iface, mode))
+			continue;
+
+		for (j = 0; j < mode->num_channels; j++) {
+			struct hostapd_channel_data *chan;
+			unsigned int bss_on_ch = 0;
+			size_t i;
+
+			chan = &mode->channels[j];
+			for (i = 0; i < scan_res->num; i++) {
+				struct wpa_scan_res *bss = scan_res->res[i];
+
+				if (bss->freq == chan->freq)
+					bss_on_ch++;
+			}
+
+			wpa_printf(MSG_MSGDUMP,
+				   "ACS: Interference on ch %d (%d MHz): %d",
+				   chan->chan, chan->freq, bss_on_ch);
+			chan->interference_factor = bss_on_ch;
+			chan->interference_bss_based = true;
+		}
+
 	}
 
 	wpa_scan_results_free(scan_res);
@@ -1462,7 +1474,7 @@
 		eloop_cancel_timeout(acs_scan_wait_timeout, ifaces[i], NULL);
 	}
 
-	if (err) {
+	if (err && err != -EOPNOTSUPP) {
 		wpa_printf(MSG_ERROR, "ACS: Failed to get survey data");
 		for (i = 0; i < n; i++)
 			acs_scan_failed(ifaces[i]);
--- a/src/ap/ap_drv_ops.h
+++ b/src/ap/ap_drv_ops.h
@@ -289,7 +289,7 @@
 	if (hapd->driver == NULL)
 		return -1;
 	if (!hapd->driver->get_survey)
-		return -1;
+		return -EOPNOTSUPP;
 	return hapd->driver->get_survey(hapd->drv_priv, freq);
 }
 
