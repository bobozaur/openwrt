From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] AP: handle unprotected PMF disconnect indications

An unprotected disconnect indication must reach the AP PMF owner without
being treated as an authenticated peer teardown. Use the existing SA Query
path and retain native station, protection and driver event checks.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---

--- a/src/ap/drv_callbacks.c
+++ b/src/ap/drv_callbacks.c
@@ -115,6 +115,40 @@
 #endif /* CONFIG_FILS */
 
 
+static void hostapd_event_unprot_disconnect(struct hostapd_data *hapd,
+					    const u8 *sa, const u8 *da,
+					    u16 reason)
+{
+	struct sta_info *sta;
+	struct os_reltime now;
+
+	if (!sa || !da || !ether_addr_equal(da, hapd->own_addr) ||
+	    (reason != WLAN_REASON_CLASS2_FRAME_FROM_NONAUTH_STA &&
+	     reason != WLAN_REASON_CLASS3_FRAME_FROM_NONASSOC_STA))
+		return;
+#ifdef CONFIG_IEEE80211BE
+	if (hapd->conf->mld_ap)
+		return;
+#endif /* CONFIG_IEEE80211BE */
+	sta = ap_get_sta(hapd, sa);
+	if (!sta || (sta->flags &
+		     (WLAN_STA_ASSOC | WLAN_STA_MFP | WLAN_STA_AUTHORIZED)) !=
+		    (WLAN_STA_ASSOC | WLAN_STA_MFP | WLAN_STA_AUTHORIZED) ||
+	    sta->sa_query_count)
+		return;
+	os_get_reltime(&now);
+	if (sta->sa_query_start.sec &&
+	    !os_reltime_expired(&now, &sta->sa_query_start, 10))
+		return;
+
+	/* An unprotected disconnect cannot remove an established PMF peer.
+	 * Ask the existing SA Query owner to check for a state mismatch, with
+	 * the same frequency limit used by the station SME. */
+	ap_sta_set_sa_query_timeout(hapd, sta, 0);
+	ap_sta_start_sa_query(hapd, sta);
+}
+
