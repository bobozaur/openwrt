 #endif /* CONFIG_OWE */
+	case EVENT_UNPROT_DEAUTH:
+		if (data)
+			hostapd_event_unprot_disconnect(hapd, data->unprot_deauth.sa,
+				data->unprot_deauth.da, data->unprot_deauth.reason_code);
+		break;
+	case EVENT_UNPROT_DISASSOC:
