+static int hostapd_wps_psk_file_matches(const char *path, const struct stat *opened)
+{
+	struct stat named;
+
+	if (stat(path, &named) < 0)
+		return -1;
+	if (named.st_dev != opened->st_dev || named.st_ino != opened->st_ino) {
+		errno = ESTALE;
+		return -1;
+	}
+	return 0;
+}
+
+
+static int hostapd_wps_append_psk(const char *path, const u8 *mac_addr,
+				const u8 *psk, size_t psk_len)
+{
+	FILE *f;
+	struct stat st;
+	char hex[PMK_LEN * 2 + 1], record[PMK_LEN * 2 + 27];
+	const char *operation = "open";
+	int fd, last = '\n', len, saved_errno, ret = -1, restore = 0;
+
+	/* The configured owner must already exist: setup read this same file.
+	 * Do not create a new inode without its owner's permissions/durability.
+	 * One writer holds the lock through synchronization and rollback.
+	 * Providers must honor this lock for rotation and preserve committed rows,
+	 * or quiesce the BSS. Named-owner checks also detect a replaced inode.
+	 */
+	f = fopen(path, "r+");
+	if (!f) {
+		wpa_printf(MSG_WARNING, "WPS: Cannot open PSK file '%s': %s",
+			   path, strerror(errno));
+		return -1;
+	}
+	fd = fileno(f);
+	operation = "lock";
+	if (flock(fd, LOCK_EX | LOCK_NB) < 0)
+		goto out;
+	operation = "stat";
+	if (fstat(fd, &st) < 0)
+		goto out;
+	if (!S_ISREG(st.st_mode)) {
+		errno = EINVAL;
+		goto out;
+	}
+	operation = "owner check";
+	if (hostapd_wps_psk_file_matches(path, &st))
+		goto out;
+	/* No stdio output may remain queued after a failed append is truncated. */
+	operation = "buffer setup";
+	if (setvbuf(f, NULL, _IONBF, 0))
+		goto out;
+	operation = "seek";
+	if (st.st_size) {
+		if (fseeko(f, -1, SEEK_END) < 0 || (last = fgetc(f)) == EOF)
+			goto out;
+	}
+	if (fseeko(f, 0, SEEK_END) < 0)
+		goto out;
+	wpa_snprintf_hex(hex, sizeof(hex), psk, psk_len);
+	len = os_snprintf(record, sizeof(record), "%swps=1 " MACSTR " %s\n",
+			  last == '\n' ? "" : "\n", MAC2STR(mac_addr), hex);
+	if (os_snprintf_error(sizeof(record), len)) {
+		errno = EOVERFLOW;
+		goto out;
+	}
+	operation = "write";
+	restore = 1;
+	if (fwrite(record, 1, len, f) != (size_t) len)
+		goto out;
+	operation = "sync";
+	if (os_fdatasync(f))
+		goto out;
+	operation = "owner check";
+	if (hostapd_wps_psk_file_matches(path, &st))
+		goto out;
+	ret = 0;
+
+out:
+	if (ret) {
+		saved_errno = errno ? errno : EIO;
+		if (restore) {
+			clearerr(f);
+			if (ftruncate(fd, st.st_size) < 0 || os_fdatasync(f))
+				wpa_printf(MSG_ERROR,
+					   "WPS: Cannot restore PSK file '%s' after failed append: %s",
+					   path, strerror(errno));
+		}
+		wpa_printf(MSG_WARNING, "WPS: PSK file '%s' %s failed: %s",
+			   path, operation, strerror(saved_errno));
+	}
+	if (fclose(f)) {
+		/* A completed sync may already have committed a valid record.
+		 * Report the close error; never turn uncertain storage into RAM-only
+		 * successful enrollment or reopen a possibly replaced owner path.
+		 */
+		wpa_printf(MSG_WARNING, "WPS: PSK file '%s' close failed: %s",
+			   path, strerror(errno));
+		ret = -1;
+	}
+	return ret;
+}
