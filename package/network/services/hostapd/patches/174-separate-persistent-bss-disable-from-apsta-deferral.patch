 			ret = os_snprintf(pos, end - pos,
 					  "multi_ap_backhaul_ssid=%s\n",
 					  wpa_ssid_txt(ssid->ssid,
@@ -1028,8 +1065,7 @@
 			pos += ret;
 		}
 
-		if (hapd->conf->wps_state && hapd->conf->wpa &&
-			ssid->wpa_passphrase) {
+		if (ssid->wpa_passphrase) {
 			ret = os_snprintf(pos, end - pos,
 					  "multi_ap_backhaul_wpa_passphrase=%s\n",
 					  ssid->wpa_passphrase);
@@ -1038,8 +1074,7 @@
 			pos += ret;
 		}
 
-		if (hapd->conf->wps_state && hapd->conf->wpa &&
-		    ssid->wpa_psk &&
+		if (ssid->wpa_psk &&
 		    ssid->wpa_psk->group) {
 			char hex[PMK_LEN * 2 + 1];
 
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -364,6 +364,8 @@
 	int wds_sta;
 	int isolate;
 	int start_disabled;
+	/* OpenWrt defers initial beacons until its co-located STA is ready. */
+	bool start_deferred;
 
 	int auth_algs; /* bitfield of allowed IEEE 802.11 authentication
 			* algorithms, WPA_AUTH_ALG_{OPEN,SHARED,LEAP} */
--- a/src/ap/beacon.c
+++ b/src/ap/beacon.c
@@ -2774,6 +2774,11 @@
 	int res, ret = -1, i;
 	struct hostapd_hw_modes *mode;
 
+	/* Explicit disable survives reload, channel changes and driver re-enable.
+	 * The temporary AP+STA barrier is released only by the native owner. */
+	if (hapd->conf->start_disabled || hapd->conf->start_deferred)
+		return 0;
+
 	if (!hapd->drv_priv) {
 		wpa_printf(MSG_ERROR, "Interface is disabled");
 		return -1;
