Subject: [PATCH] ap: distinguish persistent disable from native AP+STA deferral

--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -2481,6 +2481,8 @@
 		bss->wds_sta = atoi(pos);
 	} else if (os_strcmp(buf, "start_disabled") == 0) {
 		bss->start_disabled = atoi(pos);
+	} else if (os_strcmp(buf, "start_deferred") == 0) {
+		bss->start_deferred = atoi(pos) != 0;
 	} else if (os_strcmp(buf, "ap_isolate") == 0) {
 		bss->isolate = atoi(pos);
 	} else if (os_strcmp(buf, "ap_max_inactivity") == 0) {
--- a/hostapd/ctrl_iface.c
+++ b/hostapd/ctrl_iface.c
@@ -971,6 +971,37 @@
 		return pos - buf;
 	pos += ret;
 
+	{
+		char hex[SSID_MAX_LEN * 2 + 1];
+		wpa_snprintf_hex(hex, sizeof(hex), hapd->conf->ssid.ssid,
+				 hapd->conf->ssid.ssid_len);
+		ret = os_snprintf(pos, end - pos, "ssid_hex=%s\n", hex);
+		if (os_snprintf_error(end - pos, ret))
+			return pos - buf;
+		pos += ret;
+	}
+	{
+		struct hostapd_wpa_psk *psk;
+		int psk_count = 0, sae_count = 0;
+		for (psk = hapd->conf->ssid.wpa_psk; psk; psk = psk->next)
+			psk_count++;
+#ifdef CONFIG_SAE
+		struct sae_password_entry *sae;
+		for (sae = hapd->conf->sae_passwords; sae; sae = sae->next)
+			sae_count++;
+#endif
+		ret = os_snprintf(pos, end - pos,
+			"start_disabled=%d\nstart_deferred=%d\nbeacon_set=%d\n"
+			"ieee80211w=%d\nmulti_ap_client_disallow=%d\n"
+			"wpa_psk_count=%d\nsae_password_count=%d\n",
+			!!hapd->conf->start_disabled, !!hapd->conf->start_deferred,
+			!!hapd->beacon_set_done, hapd->conf->ieee80211w,
+			hapd->conf->multi_ap_client_disallow, psk_count, sae_count);
+		if (os_snprintf_error(end - pos, ret))
+			return pos - buf;
+		pos += ret;
+	}
+
 	if ((hapd->conf->config_id)) {
 		ret = os_snprintf(pos, end - pos, "config_id=%s\n",
 				  hapd->conf->config_id);
@@ -988,7 +1019,7 @@
 		return pos - buf;
 	pos += ret;
 
-	if (hapd->conf->wps_state && hapd->conf->wpa &&
+	if (hapd->conf->wpa &&
 	    hapd->conf->ssid.wpa_passphrase) {
 		ret = os_snprintf(pos, end - pos, "passphrase=%s\n",
 				  hapd->conf->ssid.wpa_passphrase);
@@ -997,7 +1028,7 @@
 		pos += ret;
 	}
 
-	if (hapd->conf->wps_state && hapd->conf->wpa &&
+	if (hapd->conf->wpa &&
 	    hapd->conf->ssid.wpa_psk &&
 	    hapd->conf->ssid.wpa_psk->group) {
 		char hex[PMK_LEN * 2 + 1];
@@ -1019,6 +1050,12 @@
 		pos += ret;
 
