{
	"user": "network",
	"access": {
		"service": {
			"methods": [ "event" ]
		},
		"wpa_supplicant": {
			"methods": [ "phy_set_state", "phy_status", "phy_transition" ]
		},
		"hostapd": {
			"methods": [ "apsta_state" ]
		},
		"network.wireless": {
			"methods": [ "macaddr_get", "macaddr_sync", "macaddr_release" ]
		},
		"udebug": {
			"methods": [ "get_config" ]
		},
		"uci": {
			"methods": [ "wireless_enroll" ]
		}
	},
	"subscribe": [ "udebug", "hostapd", "wpa_supplicant" ],
	"listen": [ "ubus.object.add" ],
	"publish": [ "hostapd", "hostapd.*", "wpa_supplicant", "wpa_supplicant.*", "hostapd-auth" ],
	"send": [ "bss.*", "wps_credentials", "wps_persistence" ]
}
