@@ -671,6 +671,9 @@ void odhcpd_enum_addr6(struct interface
 	struct odhcpd_ipaddr *addrs = iface->addr6;
 	size_t m = get_preferred_addr(addrs, iface->addr6_len);
 
+	if (lease->retiring)
+		return;
+
 	for (size_t i = 0; i < iface->addr6_len; ++i) {
 		struct in6_addr addr;
 		uint32_t preferred_lt, valid_lt;
--- a/src/odhcpd.h
+++ b/src/odhcpd.h
@@ -300,6 +300,10 @@ struct dhcpv6_lease {
 
 	unsigned int flags;
 	bool bound;				// the lease has been accepted by the client
+	/* A withdrawn PD retains revocation authority until its original expiry.
