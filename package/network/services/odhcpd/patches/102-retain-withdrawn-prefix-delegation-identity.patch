-				blobmsg_add_u64(&b, "assigned", a->assigned_host_id);
-			else
-				blobmsg_add_u32(&b, "assigned", a->assigned_subnet_id);
+			if (!a->retiring) {
+				if (a->flags & OAF_DHCPV6_NA)
