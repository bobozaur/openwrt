 			if (a->bound)
 				blobmsg_add_string(&b, NULL, "bound");
+			if (a->retiring)
+				blobmsg_add_string(&b, NULL, "retiring");
 
 			if (a->lease_cfg)
 				blobmsg_add_string(&b, NULL, "static");
@@ -521,4 +525,3 @@ int ubus_init(void)
 
 	return 0;
 }
