+++ b/src/ubus.c
@@ -145,14 +145,18 @@ static int handle_dhcpv6_leases(_o_unuse
 			blobmsg_add_u32(&b, "iaid", ntohl(a->iaid));
 			blobmsg_add_string(&b, "hostname", (a->hostname) ? a->hostname : "");
