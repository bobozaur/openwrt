--- a/src/router.c
+++ b/src/router.c
@@ -259,6 +259,7 @@ static void router_netevent_cb(unsigned
 				uloop_timeout_set(&iface->timer_rs, 1000);
 		}
 		break;
+	case NETEV_MTU_CHANGE:
 	case NETEV_ADDR6LIST_CHANGE:
 		iface = info->iface;
 		if (iface && iface->ra == MODE_SERVER && !iface->master)
@@ -270,6 +271,21 @@ static void router_netevent_cb(unsigned
 }
 
 
+/* IPv6 MTU changes made through sysctl have no netlink notification. Derive
+ * each advertisement from current state without overwriting configured policy.
+ */
+static uint32_t router_effective_mtu(const struct interface *iface)
+{
+	int mtu = odhcpd_get_interface_config(iface->ifname, "mtu");
+
+	if (mtu < RA_MTU_MIN)
+		mtu = RA_MTU_MIN;
+	else if (mtu > RA_MTU_MAX)
+		mtu = RA_MTU_MAX;
+
+	return iface->ra_mtu ? min(iface->ra_mtu, (uint32_t)mtu) : (uint32_t)mtu;
+}
+
 static bool router_icmpv6_valid(struct sockaddr_in6 *source, uint8_t *data, size_t len)
 {
 	struct icmp6_hdr *hdr = (struct icmp6_hdr *)data;
@@ -690,7 +706,7 @@ static int send_router_advert(struct int
 	adv.mtu.nd_opt_mtu_type = ND_OPT_MTU;
 	adv.mtu.nd_opt_mtu_len = 1;
 
-	adv.mtu.nd_opt_mtu_mtu = htonl(iface->ra_mtu);
+	adv.mtu.nd_opt_mtu_mtu = htonl(router_effective_mtu(iface));
 
 	iov[IOV_RA_ADV].iov_base = &adv;
 	iov[IOV_RA_ADV].iov_len = sizeof(adv);
@@ -1335,13 +1351,14 @@ static void forward_router_advertisement
 			}
 		}
 
-		/* Rewrite MTU option if local RA MTU is configured */
-		if (c->ra_mtu && mtu_opt) {
-			if (ingress_mtu_val != c->ra_mtu) {
+		/* Each downstream has its own current IPv6 MTU and configured cap. */
+		if (mtu_opt) {
+			uint32_t mtu = router_effective_mtu(c);
+			if (ingress_mtu_val != mtu) {
 				debug("Rewriting RA MTU from %u to %u on %s",
-				      ingress_mtu_val, c->ra_mtu, c->name);
-				mtu_opt->nd_opt_mtu_mtu = htonl(c->ra_mtu);
+				      ingress_mtu_val, mtu, c->name);
 			}
+			mtu_opt->nd_opt_mtu_mtu = htonl(mtu);
 		}
 
 		info("Forward a RA on %s", c->name);
