+/* IPv6 MTU changes made through sysctl have no netlink notification. Derive
+ * each advertisement from current state without overwriting configured policy.
+ */
+static uint32_t router_effective_mtu(const struct interface *iface)
+{
+	int mtu = odhcpd_get_interface_config(iface->ifname, "mtu");
+
+	if (mtu < RA_MTU_MIN)
+		mtu = RA_MTU_MIN;
+	else if (mtu > RA_MTU_MAX)
+		mtu = RA_MTU_MAX;
+
+	return iface->ra_mtu ? min(iface->ra_mtu, (uint32_t)mtu) : (uint32_t)mtu;
