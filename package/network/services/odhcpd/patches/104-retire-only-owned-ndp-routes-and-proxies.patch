+
+int netlink_setup_route(const struct in6_addr *addr, const int prefixlen,
+		const int ifindex, const struct in6_addr *gw,
+		const uint32_t metric, const bool add)
+{
+	return setup_route(addr, prefixlen, ifindex, gw, metric, add, false);
+}
+
+/* Callers may withdraw only routes for which exclusive creation succeeded. */
+int netlink_setup_route_owned(const struct in6_addr *addr, const int prefixlen,
+		const int ifindex, const struct in6_addr *gw,
+		const uint32_t metric, const bool add)
+{
+	return setup_route(addr, prefixlen, ifindex, gw, metric, add, true);
