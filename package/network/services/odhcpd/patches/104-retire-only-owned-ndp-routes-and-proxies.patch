 	odhcpd_try_send_with_src(iface->ndp_ping_fd, &dest, &iov, 1, iface);
 
-	netlink_setup_route(addr, 128, iface->ifindex, NULL, 128, false);
+	if (!ret && !ndp_release(allocation))
