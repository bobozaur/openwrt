+
 int netlink_setup_proxy_neigh(const struct in6_addr *addr,
 		const int ifindex, const bool add)
 {
diff --git a/src/odhcpd.h b/src/odhcpd.h
index bde4f30..9096cc1 100644
--- a/src/odhcpd.h
+++ b/src/odhcpd.h
@@ -631,6 +631,9 @@ int netlink_get_interface_proxy_neigh(int ifindex, const struct in6_addr *addr);
 int netlink_setup_route(const struct in6_addr *addr, const int prefixlen,
 			const int ifindex, const struct in6_addr *gw,
 			const uint32_t metric, const bool add);
+int netlink_setup_route_owned(const struct in6_addr *addr, const int prefixlen,
