+#ifdef PPP_WITH_MPPE
+/* Reserve MPPE padding once per LCP link, after authentication and plugins
+ * have established the MTU.  Rejected requests must not change the MTU. */
+static bool
+ccp_mppe_set_mtu(int unit)
+{
+    int mtu = ppp_get_mtu(unit);
+
+    if (mtu <= MPPE_PAD)
+        return 0;
+    if (!mppe_mtu[unit])
+        mppe_mtu[unit] = mtu - MPPE_PAD;
+
+    if (mtu != mppe_mtu[unit]) {
+        ppp_set_mtu(unit, mppe_mtu[unit]);
+        /* The setter has no return value.  Do not ACK a failed adjustment,
+         * or recapture an already padded MTU after a failed readback. */
+        if (ppp_get_mtu(unit) != mppe_mtu[unit])
+            return 0;
+    }
+    return 1;
+}
+#endif
 
