+static bool
+interface_prefix_address_in_use(const struct device_prefix_assignment *assignment,
+		const struct device *dev)
+{
+	struct interface *iface;
+	struct device_addr *addr;
+	struct device_prefix *prefix;
+	struct device_prefix_assignment *other;
+
+	vlist_for_each_element(&interfaces, iface, node) {
+		if (!iface->l3_dev.dev || iface->l3_dev.dev->ifindex != dev->ifindex)
+			continue;
+
+		struct interface_ip_settings *settings[] = { &iface->config_ip, &iface->proto_ip };
+		for (size_t i = 0; i < ARRAY_SIZE(settings); i++)
+			vlist_for_each_element(&settings[i]->addr, addr, node)
+				if (addr->enabled && !addr->failed &&
+				    (addr->flags & DEVADDR_FAMILY) == DEVADDR_INET6 &&
+				    IN6_ARE_ADDR_EQUAL(&addr->addr.in6, &assignment->addr))
+					return true;
+	}
+
+	list_for_each_entry(prefix, &prefixes, head)
+		list_for_each_entry(other, &prefix->assignments, head)
+			if (other != assignment && other->enabled &&
+			    IN6_ARE_ADDR_EQUAL(&other->addr, &assignment->addr)) {
+				iface = vlist_find(&interfaces, other->name, iface, node);
+				if (iface && iface->l3_dev.dev &&
+				    iface->l3_dev.dev->ifindex == dev->ifindex)
+					return true;
+			}
+
+	return false;
+}
