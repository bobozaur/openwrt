+struct prefix_address_query {
+	struct device *dev;
+	struct device_addr *addr;
+	struct nl_msg *old;
+	int pending;
+	int error;
+};
+
+static int cb_prefix_address_valid(struct nl_msg *msg, void *arg)
+{
+	struct prefix_address_query *q = arg;
+	struct nlmsghdr *hdr = nlmsg_hdr(msg);
+	struct ifaddrmsg *ifa = nlmsg_data(hdr);
+	struct nlattr *tb[IFA_MAX + 1], *local;
+
+	if (hdr->nlmsg_type != RTM_NEWADDR || !nlmsg_valid_hdr(hdr, sizeof(*ifa)) ||
+	    ifa->ifa_family != AF_INET6 || ifa->ifa_index != (unsigned int)q->dev->ifindex)
+		return NL_SKIP;
+	if (nlmsg_parse(hdr, sizeof(*ifa), tb, IFA_MAX, NULL))
+		return NL_SKIP;
+	local = tb[IFA_LOCAL] ?: tb[IFA_ADDRESS];
+	if (!local || nla_len(local) != (int)sizeof(q->addr->addr.in6) ||
+	    memcmp(nla_data(local), &q->addr->addr.in6, sizeof(q->addr->addr.in6)))
+		return NL_SKIP;
+
+	if (!q->old)
+		q->old = nlmsg_convert(hdr);
+	if (!q->old)
+		q->error = -ENOMEM;
+	return NL_OK;
+}
+
+static int cb_prefix_address_ack(struct nl_msg *msg, void *arg)
+{
+	struct prefix_address_query *q = arg;
+
+	q->pending = 0;
+	return NL_STOP;
+}
+
+static int cb_prefix_address_error(struct sockaddr_nl *nla, struct nlmsgerr *err, void *arg)
+{
+	struct prefix_address_query *q = arg;
+
+	q->pending = 0;
+	q->error = err->error;
+	return NL_STOP;
+}
+
+static void prefix_address_message(struct nl_msg *msg, int type)
+{
+	struct nlmsghdr *hdr = nlmsg_hdr(msg);
+
+	hdr->nlmsg_type = type;
+	hdr->nlmsg_flags = NLM_F_REQUEST;
+	if (type == RTM_NEWADDR)
+		hdr->nlmsg_flags |= NLM_F_CREATE | NLM_F_REPLACE;
+	hdr->nlmsg_seq = NL_AUTO_SEQ;
+	hdr->nlmsg_pid = 0;
+}
+
+/* A prefix assignment owns this exact local address. Linux REPLACE does not
+ * change an existing IPv6 prefix length, so read the current kernel object.
+ * Leave other addresses, including deprecated predecessors, untouched.
+ */
+int system_add_prefix_address(struct device *dev, struct device_addr *addr)
+{
+	struct prefix_address_query q = { .dev = dev, .addr = addr, .pending = 1 };
+	struct ifaddrmsg ifa = { .ifa_family = AF_INET6, .ifa_index = dev->ifindex };
+	struct nl_cb *cb;
+	struct nl_msg *msg, *del;
+	struct nlattr *tb[IFA_MAX + 1];
+	time_t started = system_get_rtime();
+	int ret = -ENOMEM;
+	bool deleted;
+
+	cb = nl_cb_alloc(NL_CB_DEFAULT);
+	if (!cb)
+		return ret;
+	msg = nlmsg_alloc_simple(RTM_GETADDR, 0);
+	if (!msg)
+		goto out;
+	if (nlmsg_append(msg, &ifa, sizeof(ifa), 0) ||
+	    nla_put(msg, IFA_LOCAL, sizeof(addr->addr.in6), &addr->addr.in6))
+		goto free_query;
+
+	nl_cb_set(cb, NL_CB_VALID, NL_CB_CUSTOM, cb_prefix_address_valid, &q);
+	nl_cb_set(cb, NL_CB_ACK, NL_CB_CUSTOM, cb_prefix_address_ack, &q);
+	nl_cb_err(cb, NL_CB_CUSTOM, cb_prefix_address_error, &q);
+	ret = nl_send_auto_complete(sock_rtnl, msg);
+	if (ret < 0)
+		goto free_query;
+	while (q.pending) {
+		ret = nl_recvmsgs(sock_rtnl, cb);
+		if (ret < 0)
+			break;
+	}
+	if (q.error == -EADDRNOTAVAIL) {
+		ret = system_add_address(dev, addr);
+		goto free_query;
+	}
+	if (q.error || ret < 0 || !q.old) {
+		ret = q.error ?: (ret < 0 ? ret : -EIO);
+		goto free_query;
+	}
+	if (((struct ifaddrmsg *)nlmsg_data(nlmsg_hdr(q.old)))->ifa_prefixlen == addr->mask) {
+		ret = system_add_address(dev, addr);
+		goto free_query;
+	}
+
+	del = nlmsg_convert(nlmsg_hdr(q.old));
+	if (!del) {
+		ret = -ENOMEM;
+		goto free_query;
+	}
+	prefix_address_message(del, RTM_DELADDR);
+	ret = system_rtnl_call(del);
+	deleted = !ret;
+	if (ret && ret != -NLE_NOADDR && ret != -NLE_OBJ_NOTFOUND)
+		goto free_query;
+
+	ret = system_add_address(dev, addr);
+	if (ret && deleted) {
+		/* Roll back the actual previous flags and remaining lifetimes,
+		 * without refreshing a deprecated address's expiry on retries.
+		 */
+		if (nlmsg_parse(nlmsg_hdr(q.old), sizeof(ifa), tb, IFA_MAX, NULL) ||
+		    !tb[IFA_CACHEINFO] || nla_len(tb[IFA_CACHEINFO]) < (int)sizeof(struct ifa_cacheinfo))
+			goto free_query;
+		struct ifa_cacheinfo *cache = nla_data(tb[IFA_CACHEINFO]);
+		time_t elapsed = system_get_rtime() - started;
+		uint64_t age = elapsed < 0 ? 0 : elapsed;
+		if (cache->ifa_valid != UINT32_MAX && age >= cache->ifa_valid)
+			goto free_query;
+		if (cache->ifa_valid != UINT32_MAX)
+			cache->ifa_valid -= age;
+		if (cache->ifa_prefered != UINT32_MAX)
+			cache->ifa_prefered = age >= cache->ifa_prefered ? 0 : cache->ifa_prefered - age;
+		prefix_address_message(q.old, RTM_NEWADDR);
+		if (system_rtnl_call(q.old))
+			netifd_log_message(L_WARNING, "Failed to restore prior IPv6 address on '%s'\n", dev->ifname);
+		q.old = NULL;
+	}
+
+free_query:
+	nlmsg_free(msg);
+	if (q.old)
+		nlmsg_free(q.old);
+out:
+	nl_cb_put(cb);
+	return ret;
+}
+
