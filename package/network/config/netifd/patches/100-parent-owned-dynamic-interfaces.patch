 static void
+interface_set_dynamic_parent(struct interface *iface, struct interface *parent)
+{
+	list_del_init(&iface->dynamic_list);
+	iface->dynamic_parent = parent;
+	if (parent)
+		list_add_tail(&iface->dynamic_list, &parent->dynamic_children);
+}
+
+void
+interface_remove_dynamic_children(struct interface *parent)
+{
+	struct interface *child, *tmp;
+
+	list_for_each_entry_safe(child, tmp, &parent->dynamic_children, dynamic_list)
+		set_config_state(child, IFC_REMOVE);
+}
+
+static void
 interface_cleanup(struct interface *iface)
 {
 	struct interface_user *dep, *tmp;
+	struct interface *child, *child_tmp;
+	LIST_HEAD(children);
+
+	/* Detach all children before callbacks can observe a dying parent. */
+	list_splice_init(&iface->dynamic_children, &children);
+	list_for_each_entry(child, &children, dynamic_list)
+		child->dynamic_parent = NULL;
+	list_for_each_entry_safe(child, child_tmp, &children, dynamic_list) {
+		list_del_init(&child->dynamic_list);
+		set_config_state(child, IFC_REMOVE);
+	}
+	interface_set_dynamic_parent(iface, NULL);
 
 	uloop_timeout_cancel(&iface->remove_timer);
 	uloop_timeout_cancel(&iface->carrier_loss_timer);
