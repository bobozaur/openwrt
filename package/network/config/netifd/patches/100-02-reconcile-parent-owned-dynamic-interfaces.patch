+static void
+proto_ext_free_children(struct interface **children, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (children[i])
+			interface_free(children[i]);
+	free(children);
+}
+
+/* Prepare the entire desired set before changing parent or child state. */
+static int
+proto_ext_prepare_children(struct proto_ext_state *state, struct blob_attr *attr,
+			   struct interface ***result, int *count)
+{
+	static const struct blobmsg_policy policy[] = {
+		{ .name = "name", .type = BLOBMSG_TYPE_STRING },
+		{ .name = "proto", .type = BLOBMSG_TYPE_STRING },
+	};
+	struct blob_attr *cur, *tb[ARRAY_SIZE(policy)], *config;
+	struct interface **children, *old, *child;
+	const char *name, *proto;
+	size_t rem;
+	int n, i = 0, j, ret = UBUS_STATUS_INVALID_ARGUMENT;
+
+	if (blobmsg_type(attr) != BLOBMSG_TYPE_ARRAY ||
+	    (n = blobmsg_check_array(attr, BLOBMSG_TYPE_TABLE)) < 0)
+		return ret;
+
+	children = calloc(n ? n : 1, sizeof(*children));
+	if (!children)
+		return UBUS_STATUS_UNKNOWN_ERROR;
+
+	blobmsg_for_each_attr(cur, attr, rem) {
+		blobmsg_parse_attr(policy, ARRAY_SIZE(policy), tb, cur);
+		if (!tb[0] || !tb[1])
+			goto error;
+		name = blobmsg_get_string(tb[0]);
+		proto = blobmsg_get_string(tb[1]);
+		if (!name[0] || !proto[0] ||
+		    strspn(name, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-") != strlen(name) ||
+		    !strcmp(name, state->proto.iface->name))
+			goto error;
+		for (j = 0; j < i; j++)
+			if (!strcmp(name, children[j]->name))
+				goto error;
+
+		old = vlist_find(&interfaces, name, old, node);
+		if (old && old->dynamic_parent != state->proto.iface) {
+			ret = UBUS_STATUS_PERMISSION_DENIED;
+			goto error;
+		}
+
+		config = blob_memdup(cur);
+		if (!config) {
+			ret = UBUS_STATUS_UNKNOWN_ERROR;
+			goto error;
+		}
+		child = interface_alloc(name, config, true);
+		if (!child) {
+			free(config);
+			ret = UBUS_STATUS_UNKNOWN_ERROR;
+			goto error;
+		}
+		children[i++] = child;
+		child->config = config;
+		if (strcmp(child->proto_handler->name, proto))
+			goto error;
+		child->dynamic_parent = state->proto.iface;
+	}
+
+	*result = children;
+	*count = n;
+	return 0;
+
+error:
+	proto_ext_free_children(children, i);
+	return ret;
+}
+
+static int
+proto_ext_update_children(struct proto_ext_state *state,
+			  struct interface **children, int n)
+{
+	struct interface *old, *tmp, *child;
+	int i;
+
+	list_for_each_entry_safe(old, tmp, &state->proto.iface->dynamic_children, dynamic_list) {
+		for (i = 0; i < n; i++)
+			if (!strcmp(old->name, children[i]->name))
+				break;
+		if (i == n)
+			vlist_delete(&interfaces, &old->node);
+	}
+
+	for (i = 0; i < n; i++) {
+		child = children[i];
+		if (!interface_add(child, child->config))
+			return UBUS_STATUS_UNKNOWN_ERROR;
+		children[i] = NULL;
+	}
+	return 0;
+}
+
 static int
