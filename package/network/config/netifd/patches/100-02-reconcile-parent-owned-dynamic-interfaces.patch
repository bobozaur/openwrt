+		child_error = proto_ext_prepare_children(state, tb[NOTIFY_CHILDREN], &children, &n);
+	}
 
 	switch(blobmsg_get_u32(tb[NOTIFY_ACTION])) {
 	case 0:
-		return proto_ext_update_link(state, attr, tb);
+		ret = proto_ext_update_link(state, attr, tb);
+		if (!ret && children && state->sm == S_IDLE)
+			ret = proto_ext_update_children(state, children, n);
+		proto_ext_free_children(children, n);
+		/* A rejected child set must not suppress a valid parent lease. */
+		return ret ? ret : child_error;
 	case 1:
 		return proto_ext_run_command(state, tb);
 	case 2:
@@ -799,6 +923,7 @@ proto_ext_run(struct proto_ext_state *st
 		state->restart_pending = false;
 		action = "restart";
 	} else {
+		interface_remove_dynamic_children(proto->iface);
 		switch (state->sm) {
 		case S_SETUP:
 			if (state->script_task.uloop.pending) {
--- a/scripts/netifd-proto.sh
