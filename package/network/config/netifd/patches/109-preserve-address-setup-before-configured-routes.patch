Subject: [PATCH] interface-ip: preserve address setup before configured routes

Native protocol setup installs addresses while preparing the L3 device,
before IFPEV_UP enables configured routes. Gating address updates on the IP
settings enabled flag defers that installation until after configured routes
have been attempted. Point-to-point gateways then lack their connected route
and the failed configured route stays absent.

Keep effective IPv6-family admission separate from the interface settings
lifetime. Apply that family check to the shared address callback so disabled
IPv6 still cannot be reintroduced by a protocol update, while preserving the
native address-before-route setup order. Routes and neighbors continue to
require their IP settings to be enabled.

--- a/interface-ip.c
+++ b/interface-ip.c
@@ -204,12 +204,18 @@
 }
 
 static bool
+interface_ip_family_enabled(struct interface_ip_settings *ip, enum device_addr_flags flags)
+{
+	struct device *dev = ip->iface->l3_dev.dev;
+
+	return (flags & DEVADDR_FAMILY) != DEVADDR_INET6 ||
+		!dev || device_ipv6_enabled(dev);
+}
+
+static bool
 interface_ip_enabled(struct interface_ip_settings *ip, enum device_addr_flags flags)
 {
-	struct device *dev = ip->iface->l3_dev.dev;
-
-	return ip->enabled && ((flags & DEVADDR_FAMILY) != DEVADDR_INET6 ||
-		!dev || device_ipv6_enabled(dev));
+	return ip->enabled && interface_ip_family_enabled(ip, flags);
 }
 
 static void interface_ip_set_policy_rules(struct interface *iface, bool enabled)
@@ -789,7 +795,7 @@
 		keep = true;
 
 		if (a_old->flags != a_new->flags || a_old->failed ||
-		    a_old->enabled != interface_ip_enabled(ip, a_new->flags))
+		    a_old->enabled != interface_ip_family_enabled(ip, a_new->flags))
 			keep = false;
 
 		if (a_old->valid_until != a_new->valid_until ||
@@ -868,7 +874,11 @@
 	if (node_new) {
 		bool v6 = (a_new->flags & DEVADDR_FAMILY) == DEVADDR_INET6;
 
-		a_new->enabled = interface_ip_enabled(ip, a_new->flags);
+		/* Protocol setup installs addresses before IFPEV_UP enables
+		 * configured routes through their connected gateways. Only the
+		 * effective family setting can suppress this early publication.
+		 */
+		a_new->enabled = interface_ip_family_enabled(ip, a_new->flags);
 		a_new->policy_table = (v6) ? iface->ip6table : iface->ip4table;
 
 		if (a_new->enabled && (!keep || replace)) {
