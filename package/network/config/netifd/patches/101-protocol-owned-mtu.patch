Subject: [PATCH] netifd: let protocols own the logical MTU option

A tunnel protocol can use mtu for its own L3 device while retaining other
legacy per-interface device attributes. Filter only that option when the
protocol declares no-device-mtu; explicit device sections keep ownership.

--- a/interface.c
+++ b/interface.c
@@ -705,6 +705,10 @@
 static void
 interface_set_device_config(struct interface *iface, struct device *dev)
 {
+	struct blob_buf config = {};
+	struct blob_attr *cur, *data = iface->config;
+	int rem;
+
 	if (!dev || !dev->default_config)
 		return;
 
@@ -712,9 +716,26 @@
 	    (!dev->iface_config || dev->config_iface != iface))
 		return;
 
+	if (!iface->proto_handler ||
+	    !(iface->proto_handler->flags & PROTO_FLAG_NO_DEVICE_MTU))
+		goto apply;
+
+	/* Preserve legacy device attributes while the protocol owns logical MTU.
+	 * Explicit device sections are already excluded by default_config above.
+	 */
+	if (blob_buf_init(&config, 0))
+		goto out;
+	blobmsg_for_each_attr(cur, iface->config, rem) {
+		if (strcmp(blobmsg_name(cur), "mtu") && blobmsg_add_blob(&config, cur))
+			goto out;
+	}
+	data = config.head;
+apply:
 	dev->config_iface = iface;
 	dev->iface_config = iface->device_config;
-	device_apply_config(dev, dev->type, iface->config);
+	device_apply_config(dev, dev->type, data);
+out:
+	blob_buf_free(&config);
 }
 
 static void
--- a/proto-shell.c
+++ b/proto-shell.c
@@ -116,6 +116,10 @@
 	if (tmp && json_object_get_boolean(tmp))
 		handler->proto.flags |= PROTO_FLAG_NODEV_CONFIG;
 
+	tmp = json_get_field(obj, "no-device-mtu", json_type_boolean);
+	if (tmp && json_object_get_boolean(tmp))
+		handler->proto.flags |= PROTO_FLAG_NO_DEVICE_MTU;
+
 	tmp = json_get_field(obj, "no-proto-task", json_type_boolean);
 	if (tmp && json_object_get_boolean(tmp))
 		handler->proto.flags |= PROTO_FLAG_NO_TASK;
--- a/proto-ucode.c
+++ b/proto-ucode.c
@@ -213,6 +213,10 @@
 	if (ucv_is_truish(flag_val))
 		proto->flags |= PROTO_FLAG_NODEV_CONFIG;
 
+	flag_val = ucv_object_get(obj, "no-device-mtu", NULL);
+	if (ucv_is_truish(flag_val))
+		proto->flags |= PROTO_FLAG_NO_DEVICE_MTU;
+
 	flag_val = ucv_object_get(obj, "no_proto_task", NULL);
 	if (ucv_is_truish(flag_val))
 		proto->flags |= PROTO_FLAG_NO_TASK;
--- a/proto.h
+++ b/proto.h
@@ -45,6 +45,8 @@
 	PROTO_FLAG_NO_TASK = (1 << 7),
 	PROTO_FLAG_NODEV_CONFIG = (1 << 8),
 	PROTO_FLAG_RESTART_AVAILABLE = (1 << 9),
+	/* The protocol's mtu option configures its L3 device, not its underlay. */
+	PROTO_FLAG_NO_DEVICE_MTU = (1 << 10),
 };
 
 struct interface_proto_state {
--- a/scripts/netifd-proto.sh
+++ b/scripts/netifd-proto.sh
@@ -457,6 +457,7 @@
 			add_protocol() {
 				no_device=0
 				no_device_config=0
+				no_device_mtu=0
 				no_proto_task=0
 				available=0
 				renew_handler=0
@@ -473,6 +474,7 @@
 				json_close_array
 				json_add_boolean no-device "$no_device"
 				json_add_boolean no-device-config "$no_device_config"
+				json_add_boolean no-device-mtu "$no_device_mtu"
 				json_add_boolean no-proto-task "$no_proto_task"
 				json_add_boolean available "$available"
 				json_add_boolean renew-handler "$renew_handler"
