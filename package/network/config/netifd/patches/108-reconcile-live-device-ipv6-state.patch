+++ b/alias.c
@@ -89,6 +89,12 @@
 	struct alias_device *alias;
 
 	alias = container_of(dep, struct alias_device, dep);
+	/* An alias has no independent sysctl state. Mirror its current owner
+	 * before publishing presence or a live IPv6-family change. */
+	if (ev == DEV_EVENT_ADD || ev == DEV_EVENT_UP || ev == DEV_EVENT_IPV6_CHANGE) {
+		alias->dev.orig_settings.ipv6 = device_ipv6_enabled(dep->dev);
+		alias->dev.orig_settings.valid_flags |= DEV_OPT_IPV6;
+	}
 	switch (ev) {
 	case DEV_EVENT_ADD:
 		device_set_present(&alias->dev, true);
