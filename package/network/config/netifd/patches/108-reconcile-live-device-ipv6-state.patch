 static void
+interface_prefix_set_enabled(struct device_prefix *prefix, bool enabled)
+{
+	struct device_route route = {
+		.flags = DEVADDR_INET6,
+		.metric = INT32_MAX,
+		.mask = prefix->length,
+		.addr.in6 = prefix->addr,
+	};
+
+	if (prefix->enabled == enabled)
+		return;
+
+	/* The retained prefix owns this null route, including while it has no
+	 * downlink assignment. IPv6 disable must retire that ownership too. */
+	if (enabled)
+		system_add_route(NULL, &route);
+	else
+		system_del_route(NULL, &route);
+	prefix->enabled = enabled;
+}
