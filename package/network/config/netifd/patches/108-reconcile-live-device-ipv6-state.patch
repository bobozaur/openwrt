+
+static void
+interface_ip_invalidate_external_v6(struct interface_ip_settings *ip)
+{
+	struct device_addr *addr, *addr_tmp;
+	struct device_route *route, *route_tmp;
+	const unsigned int mask = DEVADDR_FAMILY | DEVADDR_EXTERNAL;
+	const unsigned int flags = DEVADDR_INET6 | DEVADDR_EXTERNAL;
+
+	/* disable_ipv6 removes external kernel state too. The protocol must
+	 * announce a fresh snapshot; netifd cannot recreate those addresses or
+	 * claim that a cached external route survived a family transition. */
+	vlist_for_each_element_safe(&ip->addr, addr, node, addr_tmp)
+		if ((addr->flags & mask) == flags)
+			vlist_delete(&ip->addr, &addr->node);
+	vlist_for_each_element_safe(&ip->route, route, node, route_tmp)
+		if ((route->flags & mask) == flags)
+			vlist_delete(&ip->route, &route->node);
+}
+
+void
+interface_ip_update_ipv6(struct interface *iface)
+{
+	interface_ip_invalidate_external_v6(&iface->config_ip);
+	interface_ip_invalidate_external_v6(&iface->proto_ip);
+	interface_ip_set_enabled(&iface->config_ip, iface->config_ip.enabled);
+	interface_ip_set_enabled(&iface->proto_ip, iface->proto_ip.enabled);
 }
 
