--- a/proto-ucode.c
+++ b/proto-ucode.c
@@ -116,6 +116,56 @@
 	return proto_ext_run(state, cmd, force, proto_ucode_start);
 }
 
+static bool
+proto_ucode_config_update(struct interface_proto_state *proto, struct blob_attr *config)
+{
+	struct proto_ext_state *state = container_of(proto, struct proto_ext_state, proto);
+	struct proto_ucode_handler *handler = container_of(proto->handler, struct proto_ucode_handler, proto);
+	struct blob_attr *old, *new, *copy, *previous;
+	uc_value_t *fn, *result;
+	bool accepted;
+
+	if (state->sm != S_IDLE || !(proto->handler->flags & PROTO_FLAG_RENEW_AVAILABLE))
+		return false;
+
+	fn = ucv_resource_value_get(handler->res, 1);
+	if (!ucv_is_callable(fn))
+		return false;
+
+	blobmsg_parse_attr(&proto_ucode_policy, 1, &old, state->config);
+	blobmsg_parse_attr(&proto_ucode_policy, 1, &new, config);
+	if (!old || !new)
+		return false;
+
+	/* A pure callback decides which changes can use the existing instance.
+	 * Pass the serialized configs so no shell or device operation runs here.
+	 */
+	uc_vm_stack_push(&vm, ucv_get(fn));
+	uc_vm_stack_push(&vm, ucv_string_new(blobmsg_get_string(old)));
+	uc_vm_stack_push(&vm, ucv_string_new(blobmsg_get_string(new)));
+	if (uc_vm_call(&vm, false, 2) != EXCEPTION_NONE)
+		return false;
+	result = uc_vm_stack_pop(&vm);
+	accepted = ucv_type(result) == UC_BOOLEAN && ucv_boolean_get(result);
+	ucv_put(result);
+	if (!accepted)
+		return false;
+
+	copy = malloc(blob_pad_len(config));
+	if (!copy)
+		return false;
+	memcpy(copy, config, blob_pad_len(config));
+	previous = state->config;
+	state->config = copy;
+	if (proto->cb(proto, PROTO_CMD_RENEW, false)) {
+		state->config = previous;
+		free(copy);
+		return false;
+	}
+	free(previous);
+	return true;
+}
+
 static struct interface_proto_state *
 proto_ucode_attach(const struct proto_handler *h, struct interface *iface,
 		   struct blob_attr *attr)
@@ -133,6 +183,7 @@
 	}
 
