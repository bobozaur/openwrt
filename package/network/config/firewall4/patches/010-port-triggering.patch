From dbeefb2f41230b202db84c199e500c89a3d40cb3 Mon Sep 17 00:00:00 2001
From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Date: Tue, 20 Oct 2026 12:18:24 +0300
Subject: [PATCH] fw4: own timed IPv4 port triggers and reservations

Publish timed owner maps and device/protocol port reservations in the
native ruleset transaction. Keep triggered flows outside offload and
withdraw owners on reload or interface down. Competing UPnP allocation
uses the existing fw4 lock. Requires scalar map binary operands in nftables.

Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---
 root/etc/hotplug.d/iface/20-firewall          |  9 +-
 .../share/firewall4/templates/port-trigger.uc | 28 ++++++
 root/usr/share/firewall4/templates/ruleset.uc | 16 ++++
 root/usr/share/ucode/fw4.uc                   | 92 +++++++++++++++++++
 4 files changed, 144 insertions(+), 1 deletion(-)
 create mode 100644 root/usr/share/firewall4/templates/port-trigger.uc

diff --git a/root/etc/hotplug.d/iface/20-firewall b/root/etc/hotplug.d/iface/20-firewall
index d0f030b..a0e2a87 100644
--- a/root/etc/hotplug.d/iface/20-firewall
+++ b/root/etc/hotplug.d/iface/20-firewall
@@ -6,7 +6,14 @@ has_zone() {
 	fw4 -q zone "$ZONE" >/dev/null
 }
 
-[ "$ACTION" = ifup -o "$ACTION" = ifupdate ] || exit 0
+case "$ACTION" in
+	ifup|ifupdate) ;;
+	ifdown)
+		# A down/up cycle must not revive a previous trigger owner.
+		uci -q show firewall | grep -q '=port_trigger$' || exit 0
+		;;
+	*) exit 0 ;;
+esac
 [ "$ACTION" = ifupdate -a -z "$IFUPDATE_ADDRESSES" -a -z "$IFUPDATE_DATA" ] && exit 0
 
 /etc/init.d/firewall enabled || exit 0
diff --git a/root/usr/share/firewall4/templates/port-trigger.uc b/root/usr/share/firewall4/templates/port-trigger.uc
new file mode 100644
index 0000000..c311562
--- /dev/null
+++ b/root/usr/share/firewall4/templates/port-trigger.uc
@@ -0,0 +1,28 @@
+{% for (let trigger in filter(fw4.port_triggers(), t => length(t.devices))): %}
+{%  for (let source in filter(trigger.src.zone.match_rules, r => r.family != 6)): %}
+{%   for (let dest in filter(trigger.dest.zone.match_rules, r => r.family != 6)): %}
+{%    if (mode == 'offload'): %}
+{%     for (let kind in ['trigger']): %}
+{%      for (let proto in trigger[`${kind}_proto`]): %}
+{%       for (let reverse in [false, true]): %}
+		meta nfproto ipv4 {%+ include('zone-match.uc', { fw4, rule: reverse ? dest : source, egress: false }) -%}
+{%+ include('zone-match.uc', { fw4, rule: reverse ? source : dest, egress: true }) -%}
+{{ reverse ? 'iifname' : 'oifname' }} {{ fw4.set(trigger.devices) }} meta l4proto {{ proto.name }} th {{ (reverse == (kind == 'trigger')) ? 'sport' : 'dport' }} {{ fw4.port(trigger[`${kind}_port`]) }} return comment {{ fw4.quote(`!fw4: Keep port trigger ${trigger.name} in software`, true) }}
+{%       endfor %}
+{%      endfor %}
+{%     endfor %}
+{%    else %}
+{%     for (let proto in trigger.trigger_proto): %}
+{%      for (let refresh in [true, false]): %}
+		meta nfproto ipv4 {%+ include('zone-match.uc', { fw4, rule: source, egress: false }) -%}
+{%+ include('zone-match.uc', { fw4, rule: dest, egress: true }) -%}
+oifname {{ fw4.set(trigger.devices) }} ct direction original meta l4proto {{ proto.name }} th dport {{ fw4.port(trigger.trigger_port) }} {%+
+ if (refresh): -%}
+((meta mark & 0 | {{ trigger.id }}) . oifname map @port_trigger_owners) ^ (ip saddr) == 0.0.0.0 {%+ endif -%}
+{{ refresh ? 'update' : 'add' }} @port_trigger_owners { {{ trigger.id }} . oifname timeout {{ trigger.timeout }}s : ip saddr } counter comment {{ fw4.quote(`!fw4: ${refresh ? 'Refresh' : 'Claim'} port trigger ${trigger.name}`, true) }}
+{%      endfor %}
+{%     endfor %}
+{%    endif %}
+{%   endfor %}
+{%  endfor %}
+{% endfor %}
diff --git a/root/usr/share/firewall4/templates/ruleset.uc b/root/usr/share/firewall4/templates/ruleset.uc
index 83a25fc..be8d805 100644
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -7,6 +7,15 @@
 
 table inet fw4
 flush table inet fw4
+# Fixed owned objects also exist without configured triggers, so deleting the last
+# section withdraws its leases and reservations in this same transaction.
+add map inet fw4 port_trigger_owners { type mark . ifname : ipv4_addr; flags dynamic,timeout; timeout 600s; size 4096; }
+flush map inet fw4 port_trigger_owners
+add set inet fw4 port_trigger_ports { type ifname . inet_proto . inet_service; flags interval; auto-merge; }
+flush set inet fw4 port_trigger_ports
+{% if (length(fw4.trigger_reservations())): %}
+add element inet fw4 port_trigger_ports { {{ join(', ', fw4.trigger_reservations()) }} }
+{% endif %}
 {% if (fw4.check_flowtable()): %}
 delete flowtable inet fw4 ft
 {% endif %}
@@ -153,6 +162,7 @@ table inet fw4 {
 
 {% if (length(flowtable_devices)): %}
 	chain flow_offload {
+{%+ include('port-trigger.uc', { fw4, mode: 'offload' }) %}
 		meta l4proto { tcp, udp } flow offload @ft;
 	}
 
@@ -330,6 +340,11 @@ table inet fw4 {
 {%  if (zone.dflags.dnat): %}
 	chain dstnat_{{ zone.name }} {
 {%   fw4.includes('chain-prepend', `dstnat_${zone.name}`) %}
+{%   for (let trigger in filter(fw4.port_triggers(zone.name), t => length(t.devices))): %}
+{%    for (let proto in trigger.open_proto): %}
+		meta nfproto ipv4 iifname {{ fw4.set(trigger.devices) }} fib daddr type local meta l4proto {{ proto.name }} th dport {{ fw4.port(trigger.open_port) }} counter dnat ip to (meta mark & 0 | {{ trigger.id }}) . iifname map @port_trigger_owners comment {{ fw4.quote(`!fw4: Port trigger ${trigger.name}`, true) }}
+{%    endfor %}
+{%   endfor %}
 {%   for (let redirect in fw4.redirects(`dstnat_${zone.name}`)): %}
 		{%+ include("redirect.uc", { fw4, zone, redirect }) %}
 {%   endfor %}
@@ -438,6 +453,7 @@ table inet fw4 {
 {%  endif %}
 {% endfor %}
 {% fw4.includes('chain-append', 'mangle_postrouting') %}
+{%+ include('port-trigger.uc', { fw4, mode: 'arm' }) %}
 	}
 
 	chain mangle_input {
diff --git a/root/usr/share/ucode/fw4.uc b/root/usr/share/ucode/fw4.uc
index bde27da..8a05275 100644
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -836,6 +836,8 @@ return {
 		map(filter(this.state.ubus_rules, r => (r.type == "redirect")), r => self.parse_redirect(r));
 		this.cursor.foreach("firewall", "redirect", r => self.parse_redirect(r));
 
+		this.cursor.foreach("firewall", "port_trigger", t => self.parse_port_trigger(t));
+
 
 		//
 		// Build list of snats
@@ -1868,6 +1870,96 @@ return {
 		return filter(this.state.redirects, r => (r.chain == chain));
 	},
 
+	port_triggers: function(zone) {
+		return filter(this.state.port_triggers, t => (!zone || t.dest.zone.name == zone));
+	},
+
+	trigger_devices: function(zone) {
+		let matches = (dev, pattern) =>
+			(substr(pattern, -1) == '*') ? index(dev, substr(pattern, 0, length(pattern) - 1)) == 0 : dev == pattern;
+		let devices = [];
+
+		for (let dev in fs.lsdir('/sys/class/net')) {
+			for (let rule in zone.match_rules) {
+				if (rule.family == 6 ||
+				    (length(rule.devices_pos) && !length(filter(rule.devices_pos, p => matches(dev, p)))) ||
+				    length(filter(rule.devices_neg, p => matches(dev, p))) ||
+				    length(filter(rule.devices_neg_wildcard, p => matches(dev, p))))
+					continue;
+				push(devices, dev);
+				break;
+			}
+		}
+		return sort(uniq(devices));
+	},
+
+	trigger_reservations: function() {
+		let entries = [];
+		for (let trigger in this.port_triggers())
+			for (let dev in trigger.devices)
+				for (let proto in trigger.open_proto)
+					push(entries, `${this.quote(dev, true)} . ${proto.name} . ${this.port(trigger.open_port)}`);
+		return sort(uniq(entries));
+	},
+
+	parse_port_trigger: function(data) {
+		let trigger = this.parse_options(data, {
+			enabled: [ 'bool', '1' ],
+			name: [ 'string', this.section_id(data['.name']) ],
+			src: [ 'zone_ref', null, REQUIRED ],
+			dest: [ 'zone_ref', null, REQUIRED ],
+			trigger_proto: [ 'protocol', 'tcp', PARSE_LIST | FLATTEN_LIST ],
+			trigger_port: [ 'port', null, REQUIRED | NO_INVERT ],
+			open_proto: [ 'protocol', 'tcpudp', PARSE_LIST | FLATTEN_LIST ],
+			open_port: [ 'port', null, REQUIRED | NO_INVERT ],
+			timeout: [ 'int', '600' ]
+		});
+
+		if (trigger === false)
+			return this.warn_section(data, 'skipped due to invalid port trigger options');
+		if (!trigger.enabled)
+			return;
+		if (trigger.src.any || trigger.dest.any || trigger.src.zone == trigger.dest.zone ||
+		    trigger.src.zone.family == 6 || trigger.dest.zone.family == 6)
+			return this.warn_section(data, 'requires distinct IPv4 internal and external zones');
+		if (trigger.timeout < 1 || trigger.timeout > 86400 || trigger.timeout % 1 != 0 ||
+		    trigger.trigger_port.min == 0 || trigger.open_port.min == 0)
+			return this.warn_section(data, 'requires nonzero ports and an integer timeout from 1 to 86400 seconds');
+		for (let name in [ 'trigger_proto', 'open_proto' ]) {
+			if (!length(trigger[name]) ||
+			    length(filter(trigger[name], p => p.invert || !(p.name in [ 'tcp', 'udp' ]))))
+				return this.warn_section(data, 'supports only TCP and UDP protocols');
+		}
+
+		// Packet eligibility and UPnP reservations use the same device snapshot.
+		trigger.devices = this.trigger_devices(trigger.dest.zone);
+		let same_wan = other => other.name == trigger.dest.zone.name ||
+			length(filter(this.trigger_devices(other), dev => dev in trigger.devices));
+		let overlap = port => port.invert
+			? !(trigger.open_port.min >= port.min && trigger.open_port.max <= port.max)
+			: (trigger.open_port.min <= port.max && trigger.open_port.max >= port.min);
+
+		// A portless DNAT is a fallback (DMZ). Specific allocations have one owner.
+		for (let redirect in this.state.redirects) {
+			if (redirect.family == 6 || !redirect.src?.zone ||
+			    !same_wan(redirect.src.zone) || !redirect.src_dport ||
+			    !(redirect.target in [ 'dnat', 'redirect' ]) ||
+			    (!redirect.proto.any && !length(filter(trigger.open_proto, p => p.name == redirect.proto.name))))
+				continue;
+			if (overlap(redirect.src_dport))
+				return this.warn_section(data, `conflicts with port forward '${redirect.name}'`);
+		}
+		for (let other in this.port_triggers()) {
+			if (same_wan(other.dest.zone) && overlap(other.open_port) &&
+			    length(filter(trigger.open_proto, p => length(filter(other.open_proto, q => p.name == q.name)))))
+				return this.warn_section(data, `conflicts with port trigger '${other.name}'`);
+		}
+
+		trigger.id = length(this.state.port_triggers) + 1;
+		trigger.dest.zone.dflags.dnat = true;
+		push(this.state.port_triggers ||= [], trigger);
+	},
+
 	ipsets: function() {
 		return this.state.ipsets;
 	},
-- 
2.43.0

