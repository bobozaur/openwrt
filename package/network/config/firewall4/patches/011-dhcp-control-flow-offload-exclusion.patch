Subject: [PATCH] fw4: keep DHCP control traffic outside flow offload

A previously local DHCP conntrack can become eligible for forwarding when
the client removes its address. An ingress offload hit then consumes unicast
replies before protocol-specific packet sockets, preventing reacquisition.
Keep DHCP control endpoints on the normal path, including replies and relay
traffic, without changing the forwarding verdict or other offload policy.

--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -144,11 +144,7 @@
 		type filter hook forward priority filter; policy {{ fw4.forward_policy(true) }};
 
 {% if (length(flowtable_devices) > 0): %}
-{%  if (length(fw4.port_triggers())): %}
 		jump flow_offload
-{%  else %}
-		meta l4proto { tcp, udp } flow offload @ft;
-{%  endif %}
 {% endif %}
 {% fw4.includes('chain-prepend', 'forward') %}
 		ct state vmap { established : accept, related : accept{% if (fw4.default_option("drop_invalid")): %}, invalid : drop{% endif %} } comment "!fw4: Handle forwarded flows"
@@ -164,8 +160,12 @@
 {% endif %}
 	}
 
-{% if (length(flowtable_devices) && length(fw4.port_triggers())): %}
+{% if (length(flowtable_devices)): %}
 	chain flow_offload {
+		meta nfproto ipv4 udp sport { 67, 68 } counter return comment "!fw4: Keep DHCPv4 source in slow path"
+		meta nfproto ipv4 udp dport { 67, 68 } counter return comment "!fw4: Keep DHCPv4 destination in slow path"
+		meta nfproto ipv6 udp sport { 546, 547 } counter return comment "!fw4: Keep DHCPv6 source in slow path"
+		meta nfproto ipv6 udp dport { 546, 547 } counter return comment "!fw4: Keep DHCPv6 destination in slow path"
 {%+ include('port-trigger.uc', { fw4, mode: 'offload' }) %}
 		meta l4proto { tcp, udp } flow offload @ft;
 	}
