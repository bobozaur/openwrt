From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] fw4: isolate flow offload in its own chain

Give packet policies a native chain boundary before forwarding accepts established traffic. This infrastructure does not depend on port triggers.

Upstream-Status: Pending

Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -135,7 +135,7 @@
 		type filter hook forward priority filter; policy {{ fw4.forward_policy(true) }};
 
 {% if (length(flowtable_devices) > 0): %}
-		meta l4proto { tcp, udp } flow offload @ft;
+		jump flow_offload
 {% endif %}
 {% fw4.includes('chain-prepend', 'forward') %}
 		ct state vmap { established : accept, related : accept{% if (fw4.default_option("drop_invalid")): %}, invalid : drop{% endif %} } comment "!fw4: Handle forwarded flows"
@@ -151,6 +151,12 @@
 {% endif %}
 	}
 
+{% if (length(flowtable_devices)): %}
+	chain flow_offload {
+		meta l4proto { tcp, udp } flow offload @ft;
+	}
+
+{% endif %}
 	chain output {
 		type filter hook output priority filter; policy {{ fw4.output_policy(true) }};
 
