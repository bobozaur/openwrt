#!/bin/sh
[ "$SEEN" -lt 3 ] && exit 1
[ "$ACTION" = "released" ] || exit 1

# The native supplicant selects the connected credential and rpcd owns its
# conditional persistence. A global event listener cannot identify that owner.
wps_done=0
ubusobjs="$( ubus -S list wpa_supplicant.* )"
for ubusobj in $ubusobjs; do
	ubus -S call "$ubusobj" wps_start '{}' && wps_done=1
done
[ $wps_done = 0 ] && exit 1

exit 0
