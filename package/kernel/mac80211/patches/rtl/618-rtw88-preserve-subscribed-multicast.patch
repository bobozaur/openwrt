From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] wifi: rtw88: retain subscribed multicast reception

An ALLMULTI on-to-off transition currently disables every multicast frame,
even when interfaces still subscribe to IPv6 all-nodes and solicited-node
addresses. Report the combined subscription count to configure_filter and
recompute multicast acceptance when either subscriptions or flags change.

Not submitted upstream.

Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---
--- a/drivers/net/wireless/realtek/rtw88/mac80211.c
+++ b/drivers/net/wireless/realtek/rtw88/mac80211.c
@@ -273,6 +273,12 @@
 	return rtw_ops_add_interface(hw, vif);
 }
 
+static u64 rtw_ops_prepare_multicast(struct ieee80211_hw *hw,
+				     struct netdev_hw_addr_list *mc_list)
+{
+	return netdev_hw_addr_list_count(mc_list);
+}
+
 static void rtw_ops_configure_filter(struct ieee80211_hw *hw,
 				     unsigned int changed_flags,
 				     unsigned int *new_flags,
@@ -287,12 +293,11 @@
 
 	rtw_leave_lps_deep(rtwdev);
 
-	if (changed_flags & FIF_ALLMULTI) {
-		if (*new_flags & FIF_ALLMULTI)
-			rtwdev->hal.rcr |= BIT_AM;
-		else
-			rtwdev->hal.rcr &= ~(BIT_AM);
-	}
+	/* Subscriptions can change without a change to FIF_ALLMULTI. */
+	if ((*new_flags & FIF_ALLMULTI) || multicast)
+		rtwdev->hal.rcr |= BIT_AM;
+	else
+		rtwdev->hal.rcr &= ~BIT_AM;
 	if (changed_flags & FIF_FCSFAIL) {
 		if (*new_flags & FIF_FCSFAIL)
 			rtwdev->hal.rcr |= BIT_ACRC32;
@@ -974,6 +979,7 @@
 	.add_interface		= rtw_ops_add_interface,
 	.remove_interface	= rtw_ops_remove_interface,
 	.change_interface	= rtw_ops_change_interface,
+	.prepare_multicast	= rtw_ops_prepare_multicast,
 	.configure_filter	= rtw_ops_configure_filter,
 	.bss_info_changed	= rtw_ops_bss_info_changed,
 	.start_ap		= rtw_ops_start_ap,
