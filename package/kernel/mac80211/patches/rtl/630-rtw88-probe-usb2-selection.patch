Subject: [STAGED] rtw88: add checked RTL8822B probe-time USB2 selection

Default policy and ordinary register access are unchanged. Selection is only
executed by a fresh native probe, before mac80211 registration. The source
owner must separately admit the new physical speed and own the return path.

--- a/drivers/net/wireless/realtek/rtw88/usb.c
+++ b/drivers/net/wireless/realtek/rtw88/usb.c
@@ -22,6 +22,12 @@
 module_param_named(switch_usb_mode, rtw_switch_usb_mode, bool, 0644);
 MODULE_PARM_DESC(switch_usb_mode,
 		 "Set to N to disable switching to USB 3 mode to avoid potential interference in the 2.4 GHz band (default: Y)");
+
+/* Probe-time policy; changing it does not touch an attached interface. */
+static bool rtw_force_usb2;
+module_param_named(force_usb2, rtw_force_usb2, bool, 0644);
+MODULE_PARM_DESC(force_usb2,
+                 "Select USB 2 mode at RTL8822B probe (default: N)");
 
 #define RTW_USB_MAX_RXQ_LEN	512
 #define RTW_USB_TX_DRAIN_TIMEOUT_MS	3000
@@ -1371,6 +1377,108 @@
 	usb_set_intfdata(intf, NULL);
 }
 
+/* Unlike ordinary register access, a short/failed transfer cannot supply a
+ * value for this probe-time mode transition. Preserve the native always-on
+ * register synchronization write, and require its complete transfer too.
+ */
+static int rtw_usb_mode_reg(struct rtw_dev *rtwdev, u16 addr, u32 *value,
+			    u16 len, bool write)
+{
+	struct usb_device *udev = rtw_get_usb_priv(rtwdev)->udev;
+	__le32 *data;
+	int ret;
+
+	data = kmalloc(sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	*data = write ? cpu_to_le32(*value) : 0;
+	ret = usb_control_msg(udev, write ? usb_sndctrlpipe(udev, 0) :
+					   usb_rcvctrlpipe(udev, 0),
+			      RTW_USB_CMD_REQ,
+			      write ? RTW_USB_CMD_WRITE : RTW_USB_CMD_READ,
+			      addr, RTW_USB_VENQT_CMD_IDX, data, len,
+			      write ? 500 : 1000);
+	if (ret != len) {
+		ret = ret < 0 ? ret : -EREMOTEIO;
+		goto out;
+	}
+	ret = usb_control_msg(udev, usb_sndctrlpipe(udev, 0),
+			      RTW_USB_CMD_REQ, RTW_USB_CMD_WRITE,
+			      0x4e0, 0, data, 1, 500);
+	if (ret != 1) {
+		ret = ret < 0 ? ret : -EREMOTEIO;
+		goto out;
+	}
+	if (!write)
+		*value = le32_to_cpu(*data);
+	ret = 0;
+out:
+	kfree(data);
+	return ret;
+}
+
+static int rtw_usb_force_mode_u2(struct rtw_dev *rtwdev)
+{
+	struct usb_device *udev = rtw_get_usb_priv(rtwdev)->udev;
+	u32 value, pad_ctrl2;
+	int ret;
+
+	if (udev->speed == USB_SPEED_HIGH)
+		return 0;
+	if (udev->speed != USB_SPEED_SUPER)
+		return -EOPNOTSUPP;
+	ret = rtw_usb_mode_reg(rtwdev, REG_SYS_CFG2 + 3, &value, 1, false);
+	if (ret)
+		return ret;
+	if (value != 0x20)
+		return -EIO;
+	ret = rtw_usb_mode_reg(rtwdev, REG_PAD_CTRL2, &pad_ctrl2, 4, false);
+	if (ret)
+		return ret;
+	if (!(pad_ctrl2 & (BIT_MASK_USB23_SW_MODE_V1 |
+			  BIT_USB3_USB2_TRANSITION)))
+		return -EOPNOTSUPP;
+
+	/* RTL8822B HALMAC set_usb_mode_88xx(), at the existing probe boundary
+	 * after chip setup and before rtw_register_hw()/USB RX submission.
+	 */
+	ret = rtw_usb_mode_reg(rtwdev, REG_SW_MDIO + 3, &value, 1, false);
+	if (ret)
+		return ret;
+	value &= ~BIT(0);
+	ret = rtw_usb_mode_reg(rtwdev, REG_SW_MDIO + 3, &value, 1, true);
+	if (ret)
+		return ret;
+	u32p_replace_bits(&pad_ctrl2, BIT_USB_MODE_U2, BIT_MASK_USB23_SW_MODE_V1);
+	pad_ctrl2 |= BIT_RSM_EN_V1;
+	ret = rtw_usb_mode_reg(rtwdev, REG_PAD_CTRL2, &pad_ctrl2, 4, true);
+	if (ret)
+		return ret;
+	value = 4;
+	ret = rtw_usb_mode_reg(rtwdev, REG_PAD_CTRL2 + 1, &value, 1, true);
+	if (ret)
+		return ret;
+	ret = rtw_usb_mode_reg(rtwdev, REG_SYS_PW_CTRL, &value, 2, false);
+	if (ret)
+		return ret;
+	value |= BIT_APFM_OFFMAC;
+	ret = rtw_usb_mode_reg(rtwdev, REG_SYS_PW_CTRL, &value, 2, true);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1001);
+	ret = rtw_usb_mode_reg(rtwdev, REG_PAD_CTRL2, &pad_ctrl2, 4, false);
+	if (ret)
+		return ret;
+	pad_ctrl2 |= BIT_NO_PDN_CHIPOFF_V1;
+	ret = rtw_usb_mode_reg(rtwdev, REG_PAD_CTRL2, &pad_ctrl2, 4, true);
+	if (ret)
+		return ret;
+	/* Request issued, not a completed speed transition. The old probe
+	 * must retire; only the next enumeration can establish USB2.
+	 */
+	return 1;
+}
+
 static int rtw_usb_switch_mode_old(struct rtw_dev *rtwdev)
 {
 	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
@@ -1462,6 +1570,12 @@
 {
 	u8 id = rtwdev->chip->id;
 
+	if (READ_ONCE(rtw_force_usb2)) {
+		if (id != RTW_CHIP_TYPE_8822B || !rtwdev->efuse.usb_mode_switch)
+			return -EOPNOTSUPP;
+		return rtw_usb_force_mode_u2(rtwdev);
+	}
+
 	if (!rtw_usb3_chip_new(id) && !rtw_usb3_chip_old(id))
 		return 0;
 
@@ -1607,9 +1721,13 @@
 	rtw_usb_phy_cfg(rtwdev, USB_SPEED_SUPER);
 
 	ret = rtw_usb_switch_mode(rtwdev);
+	if (ret < 0) {
+		rtw_err(rtwdev, "USB mode request failed: %d\n", ret);
+		goto err_destroy_rxwq;
+	}
 	if (ret) {
 		/* Not a fail, but we do need to skip rtw_register_hw. */
-		rtw_dbg(rtwdev, RTW_DBG_USB, "switching to USB 3 mode\n");
+		rtw_dbg(rtwdev, RTW_DBG_USB, "USB mode request awaits re-enumeration\n");
 		ret = 0;
 		goto err_destroy_rxwq;
 	}
