--- a/drivers/net/wireless/realtek/rtw88/hci.h
+++ b/drivers/net/wireless/realtek/rtw88/hci.h
@@ -30,6 +30,9 @@
 	int (*write_data_rsvd_page)(struct rtw_dev *rtwdev, u8 *buf, u32 size);
 	int (*write_data_h2c)(struct rtw_dev *rtwdev, u8 *buf, u32 size);
 
+	/* Optional status-bearing access for security ownership transitions. */
+	int (*read_reg)(struct rtw_dev *rtwdev, u32 addr, u32 *val, u16 len);
+	int (*write_reg)(struct rtw_dev *rtwdev, u32 addr, u32 val, u16 len);
 	u8 (*read8)(struct rtw_dev *rtwdev, u32 addr);
 	u16 (*read16)(struct rtw_dev *rtwdev, u32 addr);
 	u32 (*read32)(struct rtw_dev *rtwdev, u32 addr);
@@ -134,6 +137,47 @@
 	rtwdev->hci.ops->write32(rtwdev, addr, val);
 }
 
+static inline int rtw_read_checked(struct rtw_dev *rtwdev, u32 addr,
+				   u32 *val, u16 len)
+{
+	if (rtwdev->hci.ops->read_reg)
+		return rtwdev->hci.ops->read_reg(rtwdev, addr, val, len);
+
+	switch (len) {
+	case 1:
+		*val = rtw_read8(rtwdev, addr);
+		break;
+	case 2:
+		*val = rtw_read16(rtwdev, addr);
+		break;
+	case 4:
+		*val = rtw_read32(rtwdev, addr);
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static inline int rtw_write_checked(struct rtw_dev *rtwdev, u32 addr,
+				    u32 val, u16 len)
+{
+	if (rtwdev->hci.ops->write_reg)
+		return rtwdev->hci.ops->write_reg(rtwdev, addr, val, len);
+
+	switch (len) {
+	case 2:
+		rtw_write16(rtwdev, addr, val);
+		break;
+	case 4:
+		rtw_write32(rtwdev, addr, val);
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
 static inline void rtw_write8_set(struct rtw_dev *rtwdev, u32 addr, u8 bit)
 {
 	u8 val;
