 	set_bit(hw_key_idx, sec->cam_map);
 	cam->valid = true;
 	cam->group = !(key->flags & IEEE80211_KEY_FLAG_PAIRWISE);
@@ -42,7 +91,6 @@
 	else
 		eth_broadcast_addr(cam->addr);
 
-	write_cmd = RTW_SEC_CMD_WRITE_ENABLE | RTW_SEC_CMD_POLLING;
 	addr = hw_key_idx << RTW_SEC_CAM_ENTRY_SHIFT;
 	for (i = 7; i >= 0; i--) {
 		switch (i) {
@@ -73,31 +121,31 @@
 			break;
 		}
 
-		command = write_cmd | (addr + i);
-		rtw_write32(rtwdev, RTW_SEC_WRITE_REG, content);
-		rtw_write32(rtwdev, RTW_SEC_CMD_REG, command);
+		ret = rtw_sec_cam_write_word(rtwdev, addr + i, content);
+		if (ret)
+			return ret;
 	}
-}
-
-void rtw_sec_clear_cam(struct rtw_dev *rtwdev,
-		       struct rtw_sec_desc *sec,
-		       u8 hw_key_idx)
+	sec->cam_table[hw_key_idx] = entry;
+	return 0;
+}
+
+int rtw_sec_clear_cam(struct rtw_dev *rtwdev,
+		      struct rtw_sec_desc *sec,
+		      u8 hw_key_idx)
 {
 	struct rtw_cam_entry *cam = &sec->cam_table[hw_key_idx];
-	u32 write_cmd;
-	u32 command;
-	u32 addr;
-
+	u32 addr = hw_key_idx << RTW_SEC_CAM_ENTRY_SHIFT;
+	int ret;
+
+	/* Do not release ownership until the hardware valid bit is cleared. */
+	ret = rtw_sec_cam_write_word(rtwdev, addr, 0);
+	if (ret)
+		return ret;
 	clear_bit(hw_key_idx, sec->cam_map);
 	cam->valid = false;
 	cam->key = NULL;
 	eth_zero_addr(cam->addr);
-
-	write_cmd = RTW_SEC_CMD_WRITE_ENABLE | RTW_SEC_CMD_POLLING;
-	addr = hw_key_idx << RTW_SEC_CAM_ENTRY_SHIFT;
-	command = write_cmd | addr;
-	rtw_write32(rtwdev, RTW_SEC_WRITE_REG, 0);
-	rtw_write32(rtwdev, RTW_SEC_CMD_REG, command);
+	return 0;
 }
 EXPORT_SYMBOL(rtw_sec_clear_cam);
 
