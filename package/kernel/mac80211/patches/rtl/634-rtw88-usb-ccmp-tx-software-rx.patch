-	rtw_write16(rtwdev, REG_CR, ctrl_reg);
-
-	sec_config = rtw_read16(rtwdev, RTW_SEC_CONFIG);
-
+	ret = rtw_write_checked(rtwdev, REG_CR, ctrl_reg, 2);
+	if (ret)
+		return ret;
+	ret = rtw_read_checked(rtwdev, RTW_SEC_CONFIG, &sec_config, 2);
+	if (ret)
+		return ret;
 	sec_config |= RTW_SEC_TX_DEC_EN | RTW_SEC_RX_DEC_EN;
+	/* Independent TX/RX gates: preserve ciphertext and MIC for mac80211. */
+	if (rtw_use_sw_rx_crypto(rtwdev))
+		sec_config &= ~RTW_SEC_RX_DEC_EN;
 	if (sec->default_key_search)
 		sec_config |= RTW_SEC_TX_UNI_USE_DK | RTW_SEC_RX_UNI_USE_DK |
 			      RTW_SEC_TX_BC_USE_DK | RTW_SEC_RX_BC_USE_DK;
-
-	rtw_write16(rtwdev, RTW_SEC_CONFIG, sec_config);
-}
+	ret = rtw_write_checked(rtwdev, RTW_SEC_CONFIG, sec_config, 2);
+	if (ret || !rtwdev->hci.ops->read_reg)
+		return ret;
+	ret = rtw_read_checked(rtwdev, REG_CR, &readback, 2);
+	if (ret)
+		return ret;
+	if (!(readback & RTW_SEC_ENGINE_EN))
+		return -EIO;
+	ret = rtw_read_checked(rtwdev, RTW_SEC_CONFIG, &readback, 2);
+	if (ret)
+		return ret;
+	return ((readback ^ sec_config) &
+		(RTW_SEC_TX_DEC_EN | RTW_SEC_RX_DEC_EN)) ? -EIO : 0;
+}
