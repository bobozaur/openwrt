Subject: [PATCH] wifi: rtw88: expose a cancellable binary TX FIFO snapshot

Expose a root-readable snapshot of the physical TX FIFO byte range.
Capture once at open under the mutex, then serve the owned copy.
This avoids repeated hardware reads when seq_file grows its output buffer.
Reject unavailable or restarting hardware and interrupt long register walks
on a pending signal or terminal USB teardown, restoring the selector and
clock-gate state before returning. The snapshot is sequential, not atomic;
it neither identifies queue heads nor proves transmission or retention.

---

--- a/drivers/net/wireless/realtek/rtw88/fw.c
+++ b/drivers/net/wireless/realtek/rtw88/fw.c
@@ -3,6 +3,7 @@
  */
 
 #include <linux/iopoll.h>
+#include <linux/sched/signal.h>
 #include <linux/unaligned.h>
 
 #include "main.h"
@@ -1806,13 +1807,14 @@
 	mutex_unlock(&rtwdev->mutex);
 }
 
-static void rtw_fw_read_fifo_page(struct rtw_dev *rtwdev, u32 size,
-				  u32 *buf, u32 residue, u16 start_pg)
+static int rtw_fw_read_fifo_page(struct rtw_dev *rtwdev, u32 size,
+				 u32 *buf, u32 residue, u16 start_pg)
 {
 	u32 i;
 	u16 idx = 0;
 	u16 ctl;
 	bool clock_gate_disabled;
+	int ret = 0;
 
 	ctl = rtw_read16(rtwdev, REG_PKTBUF_DBG_CTRL);
 	clock_gate_disabled = rtw_read32(rtwdev, REG_RCR) & BIT_DISGCLK;
@@ -1824,6 +1826,15 @@
 
 		for (i = FIFO_DUMP_ADDR + residue;
 		     i < FIFO_DUMP_ADDR + FIFO_PAGE_SIZE; i += 4) {
+			/* A full FIFO can require many synchronous bus transfers. */
+			if (signal_pending(current)) {
+				ret = -ERESTARTSYS;
+				goto out;
+			}
+			if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags)) {
+				ret = -ENODEV;
+				goto out;
+			}
 			/* Consumers decode the original firmware byte stream. */
 			put_unaligned_le32(rtw_read32(rtwdev, i), &buf[idx++]);
 			size -= 4;
@@ -1839,10 +1850,12 @@
 	rtw_write16(rtwdev, REG_PKTBUF_DBG_CTRL, ctl);
 	if (!clock_gate_disabled)
 		rtw_write32_clr(rtwdev, REG_RCR, BIT_DISGCLK);
-}
-
-static void rtw_fw_read_fifo(struct rtw_dev *rtwdev, enum rtw_fw_fifo_sel sel,
-			     u32 offset, u32 size, u32 *buf)
+
+	return ret;
+}
+
+static int rtw_fw_read_fifo(struct rtw_dev *rtwdev, enum rtw_fw_fifo_sel sel,
+			    u32 offset, u32 size, u32 *buf)
 {
 	const struct rtw_chip_info *chip = rtwdev->chip;
 	u32 start_pg, residue;
@@ -1852,7 +1865,7 @@
 	residue = offset & (FIFO_PAGE_SIZE - 1);
 	start_pg = (offset >> FIFO_PAGE_SIZE_SHIFT) + chip->fw_fifo_addr[sel];
 
-	rtw_fw_read_fifo_page(rtwdev, size, buf, residue, start_pg);
+	return rtw_fw_read_fifo_page(rtwdev, size, buf, residue, start_pg);
 }
 
 static bool rtw_fw_dump_check_size(struct rtw_dev *rtwdev,
@@ -1911,9 +1924,7 @@
 		return -EINVAL;
 	}
 
-	rtw_fw_read_fifo(rtwdev, fifo_sel, addr, size, buffer);
-
-	return 0;
+	return rtw_fw_read_fifo(rtwdev, fifo_sel, addr, size, buffer);
 }
 
 static void __rtw_fw_update_pkt(struct rtw_dev *rtwdev, u8 pkt_id, u16 size,
--- a/drivers/net/wireless/realtek/rtw88/debug.c
+++ b/drivers/net/wireless/realtek/rtw88/debug.c
@@ -4,6 +4,7 @@
 
 #include <linux/debugfs.h>
 #include <linux/seq_file.h>
+#include <linux/vmalloc.h>
 #include "main.h"
 #include "coex.h"
 #include "sec.h"
@@ -164,6 +165,83 @@
 	.release = rtw_debugfs_close,
 };
 
+/* No device pointer survives open: an open file owns only its byte copy. */
+struct rtw_debugfs_tx_buffer {
+	u32 size;
+	u8 data[];
+};
+
+static int rtw_debugfs_tx_buffer_open(struct inode *inode, struct file *file)
+{
+	struct rtw_dev *rtwdev = inode->i_private;
+	struct rtw_debugfs_tx_buffer *snapshot;
+	u32 size = rtwdev->chip->txff_size;
+	int ret;
+
+	/* The complete FIFO need not be physically contiguous in host RAM. */
+	snapshot = vzalloc(struct_size(snapshot, data, size));
+	if (!snapshot)
+		return -ENOMEM;
+	snapshot->size = size;
+
+	ret = mutex_lock_interruptible(&rtwdev->mutex);
+	if (ret)
+		goto free;
+
+	if (!test_bit(RTW_FLAG_RUNNING, rtwdev->flags) ||
+	    !test_bit(RTW_FLAG_POWERON, rtwdev->flags) ||
+	    test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags)) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (test_bit(RTW_FLAG_RESTARTING, rtwdev->flags) ||
+	    test_bit(RTW_FLAG_RESTART_TRIGGERING, rtwdev->flags) ||
+	    test_bit(RTW_FLAG_LEISURE_PS, rtwdev->flags) ||
+	    test_bit(RTW_FLAG_LEISURE_PS_DEEP, rtwdev->flags)) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+
+	/* debugfs pins private data during open; the mutex excludes stop and
+	 * recovery. Hardware can still change FIFO bytes during this walk.
+	 */
+	ret = rtw_fw_dump_fifo(rtwdev, RTW_FW_FIFO_SEL_TX, 0, size,
+			       (u32 *)snapshot->data);
+unlock:
+	mutex_unlock(&rtwdev->mutex);
+	if (ret)
+		goto free;
+
+	file->private_data = snapshot;
+	return 0;
+free:
+	vfree(snapshot);
+	return ret;
+}
+
+static ssize_t rtw_debugfs_tx_buffer_read(struct file *file,
+					  char __user *buffer, size_t count,
+					  loff_t *position)
+{
+	struct rtw_debugfs_tx_buffer *snapshot = file->private_data;
+
+	return simple_read_from_buffer(buffer, count, position,
+				       snapshot->data, snapshot->size);
+}
+
+static int rtw_debugfs_tx_buffer_release(struct inode *inode, struct file *file)
+{
+	vfree(file->private_data);
+	return 0;
+}
+
+static const struct file_operations file_ops_tx_buffer = {
+	.owner = THIS_MODULE,
+	.open = rtw_debugfs_tx_buffer_open,
+	.read = rtw_debugfs_tx_buffer_read,
+	.release = rtw_debugfs_tx_buffer_release,
+};
+
 static int rtw_debugfs_get_read_reg(struct seq_file *m, void *v)
 {
 	struct rtw_debugfs_priv *debugfs_priv = m->private;
@@ -1281,6 +1359,9 @@
 	rtw_debugfs_add_rw(fix_rate);
 	rtw_debugfs_add_rw(dump_cam);
 	rtw_debugfs_add_rw(rsvd_page);
+	if (rtwdev->chip->fw_fifo_addr[RTW_FW_FIFO_SEL_TX])
+		debugfs_create_file("tx_buffer", 0400, debugfs_topdir, rtwdev,
+				    &file_ops_tx_buffer);
 	rtw_debugfs_add_r(phy_info);
 	rtw_debugfs_add_r(coex_info);
 	rtw_debugfs_add_rw(coex_enable);
