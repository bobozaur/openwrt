+
+static void rtw_usb_pause_tx(struct rtw_usb *rtwusb)
+{
+	spin_lock_bh(&rtwusb->tx_lock);
+	rtwusb->tx_paused = true;
+	spin_unlock_bh(&rtwusb->tx_lock);
+
+	/* Retire producers which obtained the old key before mac80211 tainted
+	 * it. The transport lock also excludes enqueue/kick from direct VO TX.
+	 */
+	synchronize_net();
+}
+
+static bool rtw_usb_tx_queues_empty(struct rtw_usb *rtwusb)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(rtwusb->tx_queue); i++)
+		if (!skb_queue_empty(&rtwusb->tx_queue[i]))
+			return false;
+	return true;
+}
+
+/* Data admission is closed and rtwdev->mutex excludes control producers.
+ * A worker invocation is bounded to 200 aggregates per endpoint; repeat
+ * until all accepted frames, including a STA's EAPOL M4, reach the device.
+ * The anchor wait also waits for completion callbacks, not just submission.
+ */
+static int rtw_usb_drain_tx(struct rtw_usb *rtwusb, bool drop)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(RTW_USB_TX_DRAIN_TIMEOUT_MS);
+	unsigned int remaining;
+	int ret;
+
+	if (drop) {
+		cancel_work_sync(&rtwusb->tx_work);
+		rtw_usb_tx_queue_purge(rtwusb);
+	} else {
+		do {
+			queue_work(rtwusb->txwq, &rtwusb->tx_work);
+			flush_work(&rtwusb->tx_work);
+			if (time_after_eq(jiffies, deadline)) {
+				rtw_err(rtwusb->rtwdev, "USB TX software queue drain timed out\n");
+				return -ETIMEDOUT;
+			}
+			if (rtw_usb_tx_queues_empty(rtwusb))
+				break;
+			/* Allocation/submission failure may leave queued frames. */
+			usleep_range(1000, 2000);
+		} while (true);
+	}
+
+	if (time_after_eq(jiffies, deadline)) {
+		rtw_err(rtwusb->rtwdev, "USB TX deadline elapsed before completion wait\n");
+		return -ETIMEDOUT;
+	}
+	remaining = max_t(unsigned int, 1, jiffies_to_msecs(deadline - jiffies));
+	if (!usb_wait_anchor_empty_timeout(&rtwusb->tx_submitted, remaining)) {
+		rtw_err(rtwusb->rtwdev, "USB TX completion wait timed out\n");
+		return -ETIMEDOUT;
+	}
+	ret = atomic_read(&rtwusb->tx_error);
+	if (ret)
+		rtw_err(rtwusb->rtwdev, "USB TX transfer failed (%d)\n", ret);
+	return ret;
+}
+
+static void rtw_usb_abort_tx(struct rtw_usb *rtwusb)
+{
+	cancel_work_sync(&rtwusb->tx_work);
+	rtw_usb_tx_queue_purge(rtwusb);
+	usb_kill_anchored_urbs(&rtwusb->tx_submitted);
+}
+
+static int rtw_usb_prepare_key_update(struct rtw_dev *rtwdev)
+{
+	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
+
+	lockdep_assert_held(&rtwdev->mutex);
+	if (rtwusb->tx_failed)
+		return -EIO;
+	rtw_usb_pause_tx(rtwusb);
+	return rtw_usb_drain_tx(rtwusb, false);
+}
+
+static void rtw_usb_finish_key_update(struct rtw_dev *rtwdev, bool success)
+{
+	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
+
+	lockdep_assert_held(&rtwdev->mutex);
+	if (!success) {
+		/* DISABLE_KEY errors do not prevent mac80211 trying SET_KEY.
+		 * Keep data and subsequent CAM updates blocked until restart.
+		 */
+		if (!rtwusb->tx_failed) {
+			rtwusb->tx_failed = true;
+			rtw_err(rtwdev, "USB TX drain failed; recovering before key reuse\n");
+			rtw_usb_abort_tx(rtwusb);
+			if (test_bit(RTW_FLAG_RUNNING, rtwdev->flags))
+				rtw_fw_recovery(rtwdev);
+		}
+		return;
+	}
+
+	spin_lock_bh(&rtwusb->tx_lock);
+	rtwusb->tx_paused = false;
+	spin_unlock_bh(&rtwusb->tx_lock);
+}
+
+static void rtw_usb_flush_queues(struct rtw_dev *rtwdev, u32 queues, bool drop)
+{
+	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
+	int ret;
+
+	/* USB aggregates ACs onto shared endpoints, so drain every endpoint. */
+	if (rtwusb->tx_failed)
+		return;
+	rtw_usb_pause_tx(rtwusb);
+	ret = rtw_usb_drain_tx(rtwusb, drop);
+	rtw_usb_finish_key_update(rtwdev, !ret);
 }
 
