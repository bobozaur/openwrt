Subject: [PATCH] wifi: rtw88: retire USB teardown before unregistering mac80211

USB core disables endpoints before disconnect. The key and flush callbacks
issued by mac80211 unregistration must retire an unavailable transport,
not schedule firmware recovery or reopen data admission. Fence recovery
and hardware start with terminal ownership, stop accepted USB work, and
join pending recovery outside its mutex before unregistering.

Do not reset a deauthorized device during disconnect. A failed reset can
make usbcore re-enumerate it with the default authorization policy,
undoing the administrator's explicit deauthorization.

Active key-update failures retain their existing fail-closed recovery.

---

--- a/drivers/net/wireless/realtek/rtw88/main.h
+++ b/drivers/net/wireless/realtek/rtw88/main.h
@@ -376,8 +376,9 @@
 	RTW_FLAG_WOWLAN,
 	RTW_FLAG_RESTARTING,
 	RTW_FLAG_RESTART_TRIGGERING,
 	RTW_FLAG_FORCE_LOWEST_RATE,
+	RTW_FLAG_UNREGISTERING,
 
 	NUM_OF_RTW_FLAGS,
 };
 
--- a/drivers/net/wireless/realtek/rtw88/main.c
+++ b/drivers/net/wireless/realtek/rtw88/main.c
@@ -632,9 +632,10 @@
 }
 
 void rtw_fw_recovery(struct rtw_dev *rtwdev)
 {
-	if (!test_bit(RTW_FLAG_RESTARTING, rtwdev->flags))
+	if (!test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags) &&
+	    !test_bit(RTW_FLAG_RESTARTING, rtwdev->flags))
 		ieee80211_queue_work(rtwdev->hw, &rtwdev->fw_recovery_work);
 }
 EXPORT_SYMBOL(rtw_fw_recovery);
 
@@ -682,12 +683,17 @@
 	struct rtw_dev *rtwdev = container_of(work, struct rtw_dev,
 					      fw_recovery_work);
 
 	mutex_lock(&rtwdev->mutex);
+	if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags)) {
+		mutex_unlock(&rtwdev->mutex);
+		return;
+	}
 	__fw_recovery_work(rtwdev);
 	mutex_unlock(&rtwdev->mutex);
 
-	ieee80211_restart_hw(rtwdev->hw);
+	if (!test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags))
+		ieee80211_restart_hw(rtwdev->hw);
 }
 
 struct rtw_txq_ba_iter_data {
 };
@@ -1383,8 +1389,11 @@
 	struct rtw_fw_state *fw = &rtwdev->fw;
 	bool wifi_only;
 	int ret;
 
+	if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags))
+		return -ENODEV;
+
 	ret = rtw_hci_setup(rtwdev);
 	if (ret) {
 		rtw_err(rtwdev, "failed to setup hci\n");
 		goto err;
@@ -1520,8 +1529,11 @@
 
 int rtw_core_start(struct rtw_dev *rtwdev)
 {
 	int ret;
+
+	if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags))
+		return -ENODEV;
 
 	ret = rtwdev->chip->ops->power_on(rtwdev);
 	if (ret)
 		return ret;
--- a/drivers/net/wireless/realtek/rtw88/mac80211.c
+++ b/drivers/net/wireless/realtek/rtw88/mac80211.c
@@ -596,8 +596,16 @@
 	}
 
 	mutex_lock(&rtwdev->mutex);
 
+	/* USB endpoints have already been disabled by the bus owner. Keys are
+	 * being retired with the hardware, not made available for reuse.
+	 */
+	if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags)) {
+		ret = cmd == DISABLE_KEY ? 0 : -ENODEV;
+		goto out;
+	}
+
 	rtw_leave_lps_deep(rtwdev);
 
 	if (cmd == SET_KEY) {
 		if (key->flags & IEEE80211_KEY_FLAG_PAIRWISE)
@@ -759,8 +767,12 @@
 {
 	struct rtw_dev *rtwdev = hw->priv;
 
 	mutex_lock(&rtwdev->mutex);
+	if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags)) {
+		mutex_unlock(&rtwdev->mutex);
+		return;
+	}
 	rtw_leave_lps_deep(rtwdev);
 
 	rtw_hci_flush_queues(rtwdev, queues, drop);
 	rtw_mac_flush_queues(rtwdev, queues, drop);
--- a/drivers/net/wireless/realtek/rtw88/usb.c
+++ b/drivers/net/wireless/realtek/rtw88/usb.c
@@ -617,8 +617,10 @@
 {
 	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
 
 	lockdep_assert_held(&rtwdev->mutex);
+	if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags))
+		return -ENODEV;
 	if (rtwusb->tx_failed)
 		return -EIO;
 	rtw_usb_pause_tx(rtwusb);
 	return rtw_usb_drain_tx(rtwusb, false);
@@ -628,8 +630,10 @@
 {
 	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
 
 	lockdep_assert_held(&rtwdev->mutex);
+	if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags))
+		return;
 	if (!success) {
 		/* DISABLE_KEY errors do not prevent mac80211 trying SET_KEY.
 		 * Keep data and subsequent CAM updates blocked until restart.
 		 */
@@ -1087,8 +1091,11 @@
 	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
 	struct rtw_sec_desc *sec = &rtwdev->sec;
 	unsigned long idx;
 
+	if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags))
+		return -ENODEV;
+
 	/* Only a hardware restart may reopen a failed key transition. */
 	if (rtwusb->tx_failed || test_bit(RTW_FLAG_RESTARTING, rtwdev->flags)) {
 		/* A failed DISABLE_KEY may already have disappeared from
 		 * mac80211's key list. Retire every retained CAM slot after
@@ -1650,15 +1657,29 @@
 
 	rtwdev = hw->priv;
 	rtwusb = rtw_get_usb_priv(rtwdev);
 
+	/* usbcore disables endpoints before disconnect unless soft_unbind is
+	 * requested. Do not treat the ensuing mac80211 key/flush retirement as
+	 * an active transport failure or schedule firmware recovery for it.
+	 */
+	set_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags);
 	rtw_usb_cancel_rx_bufs(rtwusb);
+	mutex_lock(&rtwdev->mutex);
+	rtw_usb_pause_tx(rtwusb);
+	rtw_usb_abort_tx(rtwusb);
+	mutex_unlock(&rtwdev->mutex);
+	cancel_work_sync(&rtwdev->fw_recovery_work);
 
 	rtw_unregister_hw(rtwdev, hw);
 	rtw_usb_deinit_tx(rtwdev);
 	rtw_usb_deinit_rx(rtwdev);
 
-	if (rtwusb->udev->state != USB_STATE_NOTATTACHED)
+	/* A deauthorized device must remain owned by usbcore's authorization
+	 * policy. Reset failure can otherwise re-enumerate it as authorized.
+	 */
+	if (rtwusb->udev->authorized &&
+	    rtwusb->udev->state != USB_STATE_NOTATTACHED)
 		usb_reset_device(rtwusb->udev);
 
 	rtw_usb_free_rx_bufs(rtwusb);
 
