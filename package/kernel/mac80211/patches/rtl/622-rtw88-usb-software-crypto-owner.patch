From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] wifi: rtw88: add a cold USB software-crypto policy

Keep USB keys in mac80211 when selected at module load. Hardware-decrypted
USB frames have no key-generation identity across replacement; software
crypto keeps queued frames authenticated against the selected temporal key.
Use the native per-key software fallback without changing common security
initialization. No key is uploaded and TX descriptors request no hardware
crypto. Fail closed if RX nevertheless reports hardware-decrypted data.
Do not advertise firmware WoWLAN while keys remain software-owned. Other
transports and the hardware-key policy remain unchanged.

Not submitted upstream.

Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---
--- a/drivers/net/wireless/realtek/rtw88/main.c
+++ b/drivers/net/wireless/realtek/rtw88/main.c
@@ -23,8 +23,9 @@
 
 bool rtw_disable_lps_deep_mode;
 EXPORT_SYMBOL(rtw_disable_lps_deep_mode);
 bool rtw_bf_support = true;
+bool rtw_usb_sw_crypto;
 unsigned int rtw_debug_mask;
 EXPORT_SYMBOL(rtw_debug_mask);
 /* EDCCA is enabled during normal behavior. For debugging purpose in
  * a noisy environment, it can be disabled via edcca debugfs. Because
@@ -37,12 +38,14 @@
 
 module_param_named(disable_lps_deep, rtw_disable_lps_deep_mode, bool, 0644);
 module_param_named(support_bf, rtw_bf_support, bool, 0644);
 module_param_named(debug_mask, rtw_debug_mask, uint, 0644);
+module_param_named(usb_sw_crypto, rtw_usb_sw_crypto, bool, 0444);
 
 MODULE_PARM_DESC(disable_lps_deep, "Set Y to disable Deep PS");
 MODULE_PARM_DESC(support_bf, "Set Y to enable beamformee support");
 MODULE_PARM_DESC(debug_mask, "Debugging mask");
+MODULE_PARM_DESC(usb_sw_crypto, "Use mac80211 software crypto on USB (load-time only)");
 
 static struct ieee80211_channel rtw_channeltable_2g[] = {
 	{.center_freq = 2412, .hw_value = 1,},
 	{.center_freq = 2417, .hw_value = 2,},
@@ -2328,9 +2331,11 @@
 	wiphy_ext_feature_set(hw->wiphy, NL80211_EXT_FEATURE_SCAN_RANDOM_SN);
 	wiphy_ext_feature_set(hw->wiphy, NL80211_EXT_FEATURE_SET_SCAN_DWELL);
 
 #ifdef CONFIG_PM
-	hw->wiphy->wowlan = rtwdev->chip->wowlan_stub;
+	/* Firmware sleep offloads cannot own software-only keys. */
+	if (!rtw_use_sw_crypto(rtwdev))
+		hw->wiphy->wowlan = rtwdev->chip->wowlan_stub;
 	hw->wiphy->max_sched_scan_ssids = rtwdev->chip->max_sched_scan_ssids;
 #endif
 	rtw_set_supported_band(hw, rtwdev->chip);
 	SET_IEEE80211_PERM_ADDR(hw, rtwdev->efuse.addr);
--- a/drivers/net/wireless/realtek/rtw88/main.h
+++ b/drivers/net/wireless/realtek/rtw88/main.h
@@ -40,8 +40,9 @@
 
 #define RTW_TP_SHIFT			18 /* bytes/2s --> Mbps */
 
 extern bool rtw_bf_support;
+extern bool rtw_usb_sw_crypto;
 extern bool rtw_disable_lps_deep_mode;
 extern unsigned int rtw_debug_mask;
 extern bool rtw_edcca_enabled;
 extern const struct ieee80211_ops rtw_ops;
@@ -2142,8 +2143,13 @@
 };
 
 #include "hci.h"
 
+static inline bool rtw_use_sw_crypto(struct rtw_dev *rtwdev)
+{
+	return rtw_usb_sw_crypto && rtw_hci_type(rtwdev) == RTW_HCI_TYPE_USB;
+}
+
 static inline bool rtw_is_assoc(struct rtw_dev *rtwdev)
 {
 	return !!rtwdev->sta_cnt;
 }
--- a/drivers/net/wireless/realtek/rtw88/mac80211.c
+++ b/drivers/net/wireless/realtek/rtw88/mac80211.c
@@ -565,8 +565,15 @@
 	bool key_update = false;
 	u8 hw_key_type;
 	u8 hw_key_idx;
 	int ret = 0;
+
+	/* Keep every USB key in mac80211 for the whole module lifetime.
+	 * Queued RX frames then retain their ciphertext and MIC instead of
+	 * untagged plaintext from a hardware key that may have been replaced.
+	 */
+	if (rtw_use_sw_crypto(rtwdev))
+		return cmd == SET_KEY ? -EOPNOTSUPP : 0;
 
 	switch (key->cipher) {
 	case WLAN_CIPHER_SUITE_WEP40:
 		hw_key_type = RTW_CAM_WEP40;
--- a/drivers/net/wireless/realtek/rtw88/rx.c
+++ b/drivers/net/wireless/realtek/rtw88/rx.c
@@ -322,8 +322,14 @@
 	/* c2h cmd pkt's rx/phy status is not interested */
 	if (pkt_stat->is_c2h)
 		return pkt_stat->pkt_len < sizeof(struct rtw_c2h_cmd) ? -EINVAL : 0;
 
+	/* Never relabel unexpected hardware plaintext as software ciphertext.
+	 * Without a hardware key generation, it cannot be admitted safely.
+	 */
+	if (unlikely(rtw_use_sw_crypto(rtwdev) && pkt_stat->decrypted))
+		return -EACCES;
+
 	if (unlikely(pkt_stat->pkt_len < sizeof(hdr->frame_control) + FCS_LEN))
 		return -EINVAL;
 
 	phy_status = rx_desc8 + desc_sz + pkt_stat->shift;
