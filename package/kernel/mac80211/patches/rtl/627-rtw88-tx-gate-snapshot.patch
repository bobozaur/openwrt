Subject: [PATCH] wifi: rtw88: sample 8822B TX gates under driver ownership

Expose a root-readable per-open cached observation of queue and report
state plus source-defined CCA/EDCCA debug outputs. Reject inactive power
or occupied mux states. Restore the original selector and clock on every
exit after mutation, checking the unchanged header as well. Serialize raw
register writers against the short sampler. No wake, policy or threshold
change is performed. These sequential samples are not TX verdicts, and
bus completion must be qualified independently of value-only IO helpers.

---

--- a/drivers/net/wireless/realtek/rtw88/debug.c
+++ b/drivers/net/wireless/realtek/rtw88/debug.c
@@ -3,6 +3,8 @@
  */
 
 #include <linux/debugfs.h>
+#include <linux/ktime.h>
+#include <linux/sched/signal.h>
 #include <linux/seq_file.h>
 #include <linux/vmalloc.h>
 #include "main.h"
@@ -242,6 +244,144 @@
 	.release = rtw_debugfs_tx_buffer_release,
 };
 
+/* 8822B OFDM debug output: header zero, selectors 0 (CCA) and 0x209
+ * (EDCCA). The inactive table state uses selector 0x130, clock bits zero.
+ * These are sequential samples, not busy-time counters or TX verdicts.
+ */
+#define RTW8822B_DBG_HEADER 0x8f8
+#define RTW8822B_DBG_CLOCK 0x198c
+
+static int rtw_debugfs_tx_gate_open(struct inode *inode, struct file *file)
+{
+	static const u16 registers[] = {
+		0x400, 0x404, 0x408, 0x40c, 0x468, 0x46c, 0x470, 0x474,
+		0x1400, 0x1404, 0x1408, 0x140c, 0x4d4, 0x1450,
+		0x100, 0x520, 0x524, 0x47c, 0x8a4, 0xc50, 0xe50,
+	};
+	struct rtw_dev *rtwdev = inode->i_private;
+	struct rtw_debugfs_tx_buffer *snapshot;
+	u32 values[ARRAY_SIZE(registers)], original[3], restored[3];
+	u32 output[2], stop;
+	u64 started, finished;
+	char *text;
+	unsigned int i, used = 0;
+	int ret;
+
+	if (rtwdev->chip->id != RTW_CHIP_TYPE_8822B)
+		return -EOPNOTSUPP;
+
+	snapshot = vzalloc(struct_size(snapshot, data, 2048));
+	if (!snapshot)
+		return -ENOMEM;
+	text = (char *)snapshot->data;
+	ret = mutex_lock_interruptible(&rtwdev->mutex);
+	if (ret)
+		goto free;
+
+	if (!test_bit(RTW_FLAG_RUNNING, rtwdev->flags) ||
+	    !test_bit(RTW_FLAG_POWERON, rtwdev->flags) ||
+	    test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags)) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (test_bit(RTW_FLAG_RESTARTING, rtwdev->flags) ||
+	    test_bit(RTW_FLAG_RESTART_TRIGGERING, rtwdev->flags) ||
+	    test_bit(RTW_FLAG_LEISURE_PS, rtwdev->flags) ||
+	    test_bit(RTW_FLAG_LEISURE_PS_DEEP, rtwdev->flags)) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+
+	started = ktime_get_ns();
+	original[0] = rtw_read32(rtwdev, RTW8822B_DBG_HEADER);
+	original[1] = rtw_read32(rtwdev, REG_DBGSEL);
+	original[2] = rtw_read32(rtwdev, RTW8822B_DBG_CLOCK);
+	if ((original[0] & GENMASK(25, 22)) || original[1] != 0x130 ||
+	    (original[2] & GENMASK(2, 0))) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(registers); i++) {
+		if (signal_pending(current)) {
+			ret = -ERESTARTSYS;
+			goto unlock;
+		}
+		if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags)) {
+			ret = -ENODEV;
+			goto unlock;
+		}
+		values[i] = rtw_read32(rtwdev, registers[i]);
+	}
+	stop = rtw_read8(rtwdev, 0x45c);
+
+	/* No policy or threshold changes. Never leave the mux owned by open. */
+	rtw_write32(rtwdev, RTW8822B_DBG_CLOCK, original[2] | GENMASK(2, 0));
+	for (i = 0; i < ARRAY_SIZE(output); i++) {
+		if (signal_pending(current)) {
+			ret = -ERESTARTSYS;
+			goto restore;
+		}
+		if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags)) {
+			ret = -ENODEV;
+			goto restore;
+		}
+		rtw_write32(rtwdev, REG_DBGSEL, i ? 0x209 : 0);
+		if (rtw_read32(rtwdev, REG_DBGSEL) != (i ? 0x209 : 0) ||
+		    rtw_read32(rtwdev, RTW8822B_DBG_CLOCK) !=
+		    (original[2] | GENMASK(2, 0)) ||
+		    rtw_read32(rtwdev, RTW8822B_DBG_HEADER) != original[0]) {
+			ret = -EIO;
+			goto restore;
+		}
+		output[i] = rtw_read32(rtwdev, REG_DBGRPT);
+	}
+restore:
+	rtw_write32(rtwdev, REG_DBGSEL, original[1]);
+	rtw_write32(rtwdev, RTW8822B_DBG_CLOCK, original[2]);
+	/* The header is never modified; preserve and verify its whole value. */
+	restored[0] = rtw_read32(rtwdev, RTW8822B_DBG_HEADER);
+	restored[1] = rtw_read32(rtwdev, REG_DBGSEL);
+	restored[2] = rtw_read32(rtwdev, RTW8822B_DBG_CLOCK);
+	if (memcmp(original, restored, sizeof(original)))
+		ret = -EIO;
+	finished = ktime_get_ns();
+unlock:
+	mutex_unlock(&rtwdev->mutex);
+	if (ret)
+		goto free;
+
+	/* Bus helpers have no error return: successful open cannot independently
+	 * certify transfer completion. Preserve raw words for bus-side checking.
+	 */
+	used += scnprintf(text + used, 2048 - used,
+			  "begin %llu %llu\n", started, finished);
+	for (i = 0; i < ARRAY_SIZE(registers); i++)
+		used += scnprintf(text + used, 2048 - used,
+				  "%04x 4 %08x\n", registers[i], values[i]);
+	used += scnprintf(text + used, 2048 - used,
+			  "045c 1 %08x\ncca %08x\nedcca %08x\n",
+			  stop, output[0], output[1]);
+	used += scnprintf(text + used, 2048 - used,
+			  "original %08x %08x %08x\n"
+			  "restored %08x %08x %08x\nend\n",
+			  original[0], original[1], original[2],
+			  restored[0], restored[1], restored[2]);
+	snapshot->size = used;
+	file->private_data = snapshot;
+	return 0;
+free:
+	vfree(snapshot);
+	return ret;
+}
+
+static const struct file_operations file_ops_tx_gate = {
+	.owner = THIS_MODULE,
+	.open = rtw_debugfs_tx_gate_open,
+	.read = rtw_debugfs_tx_buffer_read,
+	.release = rtw_debugfs_tx_buffer_release,
+};
+
 static int rtw_debugfs_get_read_reg(struct seq_file *m, void *v)
 {
 	struct rtw_debugfs_priv *debugfs_priv = m->private;
@@ -494,6 +634,10 @@
 
 	if (num !=  3)
 		return -EINVAL;
+
+	ret = mutex_lock_interruptible(&rtwdev->mutex);
+	if (ret)
+		return ret;
 
 	switch (len) {
 	case 1:
@@ -517,6 +661,7 @@
 		break;
 	}
 
+	mutex_unlock(&rtwdev->mutex);
 	return count;
 }
 
@@ -1362,6 +1507,9 @@
 	if (rtwdev->chip->fw_fifo_addr[RTW_FW_FIFO_SEL_TX])
 		debugfs_create_file("tx_buffer", 0400, debugfs_topdir, rtwdev,
 				    &file_ops_tx_buffer);
+	if (rtwdev->chip->id == RTW_CHIP_TYPE_8822B)
+		debugfs_create_file("tx_gate", 0400, debugfs_topdir, rtwdev,
+				    &file_ops_tx_gate);
 	rtw_debugfs_add_r(phy_info);
 	rtw_debugfs_add_r(coex_info);
 	rtw_debugfs_add_rw(coex_enable);
