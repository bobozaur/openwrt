--- a/drivers/net/wireless/realtek/rtw88/mac80211.c
+++ b/drivers/net/wireless/realtek/rtw88/mac80211.c
@@ -597,6 +597,14 @@
 
 	mutex_lock(&rtwdev->mutex);
 
+	/* USB endpoints have already been disabled by the bus owner. Keys are
+	 * being retired with the hardware, not made available for reuse.
+	 */
