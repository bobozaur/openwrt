+	if (test_bit(RTW_FLAG_UNREGISTERING, rtwdev->flags)) {
+		mutex_unlock(&rtwdev->mutex);
+		return;
+	}
 	rtw_leave_lps_deep(rtwdev);
 
 	rtw_hci_flush_queues(rtwdev, queues, drop);
