From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] wifi: mac80211: retire prepared frames before replacing hardware keys

Prepared TXQ fragments and stopped-queue frames can outlive an RCU grace
period while retaining hw_key. Close retired key producers, fence TX queue
consumers and remove only those prepared references before the driver key
transition. Preserve normal draining of frames already owned by the driver.

Use the existing tainted-key state without changing hardware key accounting
or temporary link-key disable/reenable. Retired hardware keys cannot fall
back to plaintext during hardware encapsulation.

Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---
--- a/net/mac80211/key.h
+++ b/net/mac80211/key.h
@@ -32,10 +32,13 @@
  * @KEY_FLAG_UPLOADED_TO_HARDWARE: Indicates that this key is present
  *	in the hardware for TX crypto hardware acceleration.
  * @KEY_FLAG_TAINTED: Key is tainted and packets should be dropped.
+ * @KEY_FLAG_HW_TX_RETIRED: Hardware TX references were retired before permanent
+ *	key replacement/removal. Remains set after hardware disable.
  */
 enum ieee80211_internal_key_flags {
 	KEY_FLAG_UPLOADED_TO_HARDWARE	= BIT(0),
 	KEY_FLAG_TAINTED		= BIT(1),
+	KEY_FLAG_HW_TX_RETIRED	= BIT(2),
 };
 
 enum ieee80211_internal_tkip_state {
--- a/net/mac80211/key.c
+++ b/net/mac80211/key.c
@@ -438,4 +438,80 @@
 }
 
+static void ieee80211_key_unlink_tx_queue(struct ieee80211_key *key,
+					  struct sk_buff_head *queue,
+					  struct sk_buff_head *purge)
+{
+	struct sk_buff *skb, *tmp;
+
+	skb_queue_walk_safe(queue, skb, tmp) {
+		if (IEEE80211_SKB_CB(skb)->control.hw_key != &key->conf)
+			continue;
+		__skb_unlink(skb, queue);
+		__skb_queue_tail(purge, skb);
+	}
+}
+
+static void ieee80211_key_unlink_txq(struct ieee80211_key *key,
+				     struct ieee80211_txq *txq,
+				     struct sk_buff_head *purge)
+{
+	if (txq)
+		ieee80211_key_unlink_tx_queue(key, &to_txq_info(txq)->frags,
+					      purge);
+}
+
+/* Prepared frames keep hw_key across RCU grace periods. Retire those
+ * references before the driver removes or replaces the hardware key.
+ * Frames already handed to the driver still follow its normal TX drain.
+ */
+static void ieee80211_key_retire_hw_tx(struct ieee80211_key *key)
+{
+	struct ieee80211_local *local = key->local;
+	struct ieee80211_sub_if_data *sdata;
+	struct sk_buff_head purge;
+	struct sta_info *sta;
+	unsigned long flags;
+	int i;
+
+	lockdep_assert_wiphy(local->hw.wiphy);
+	__skb_queue_head_init(&purge);
+
+	key->flags |= KEY_FLAG_TAINTED | KEY_FLAG_HW_TX_RETIRED;
+	list_for_each_entry(sta, &local->sta_list, list)
+		ieee80211_check_fast_xmit(sta);
+	if (key->sta)
+		ieee80211_clear_fast_xmit(key->sta);
+
+	ieee80211_stop_queues_by_reason(&local->hw, BIT(local->hw.queues) - 1,
+					IEEE80211_QUEUE_STOP_REASON_FLUSH, true);
+	/* Close both stale key producers and dequeuers before inspecting queues. */
+	synchronize_net();
+
+	spin_lock_bh(&local->fq.lock);
+	list_for_each_entry(sta, &local->sta_list, list) {
+		for (i = 0; i < ARRAY_SIZE(sta->sta.txq); i++)
+			ieee80211_key_unlink_txq(key, sta->sta.txq[i], &purge);
+	}
+	if (key->sta) {
+		for (i = 0; i < ARRAY_SIZE(key->sta->sta.txq); i++)
+			ieee80211_key_unlink_txq(key, key->sta->sta.txq[i],
+						 &purge);
+	}
+	list_for_each_entry(sdata, &local->interfaces, list) {
+		ieee80211_key_unlink_txq(key, sdata->vif.txq, &purge);
+		ieee80211_key_unlink_txq(key, sdata->vif.txq_mgmt, &purge);
+	}
+	spin_unlock_bh(&local->fq.lock);
+
+	spin_lock_irqsave(&local->queue_stop_reason_lock, flags);
+	for (i = 0; i < local->hw.queues; i++)
+		ieee80211_key_unlink_tx_queue(key, &local->pending[i], &purge);
+	spin_unlock_irqrestore(&local->queue_stop_reason_lock, flags);
+
+	ieee80211_purge_tx_queue(&local->hw, &purge);
+	ieee80211_wake_queues_by_reason(&local->hw, BIT(local->hw.queues) - 1,
+					IEEE80211_QUEUE_STOP_REASON_FLUSH, true);
+}
+
 static int ieee80211_key_replace(struct ieee80211_sub_if_data *sdata,
 				 struct ieee80211_link_data *link,
@@ -503,4 +579,7 @@
 		ieee80211_pairwise_rekey(old, new);
 	}
+
+	if (old && old->flags & KEY_FLAG_UPLOADED_TO_HARDWARE)
+		ieee80211_key_retire_hw_tx(old);
 
 	if (old) {
--- a/net/mac80211/tx.c
+++ b/net/mac80211/tx.c
@@ -596,6 +596,7 @@
 	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(tx->skb);
 	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)tx->skb->data;
 
+	info->control.hw_key = NULL;
 	if (unlikely(info->flags & IEEE80211_TX_INTFL_DONT_ENCRYPT)) {
 		tx->key = NULL;
 		return TX_CONTINUE;
@@ -613,6 +614,8 @@
 		tx->key = NULL;
 
 	if (info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) {
+		if (tx->key && tx->key->flags & KEY_FLAG_HW_TX_RETIRED)
+			return TX_DROP;
 		if (tx->key && tx->key->flags & KEY_FLAG_UPLOADED_TO_HARDWARE)
 			info->control.hw_key = &tx->key->conf;
 		return TX_CONTINUE;
@@ -660,7 +663,33 @@
 			     tx->skb->protocol != tx->sdata->control_port_protocol)
 			return TX_DROP;
 
+		if (unlikely(tx->key && tx->key->flags & KEY_FLAG_HW_TX_RETIRED)) {
+			int head_need = max_t(int, IEEE80211_ENCRYPT_HEADROOM -
+					     skb_headroom(tx->skb), 0);
+			int tail_need = max_t(int, IEEE80211_ENCRYPT_TAILROOM -
+					     skb_tailroom(tx->skb), 0);
+
+			/* Filtered retries bypass encryption and cannot fall back. */
+			if (info->flags & IEEE80211_TX_INTFL_RETRANSMISSION)
+				return TX_DROP;
+
+			/* Software fallback cannot recover a hardware-owned TX PN. */
+			if (!(tx->key->conf.flags & IEEE80211_KEY_FLAG_GENERATE_IV) &&
+			    !(ieee80211_is_mgmt(hdr->frame_control) &&
+			      tx->key->conf.flags &
+			      (IEEE80211_KEY_FLAG_GENERATE_IV_MGMT |
+			       IEEE80211_KEY_FLAG_SW_MGMT_TX)))
+				return TX_DROP;
+
+			/* Fresh control frames may have been queued without room
+			 * for software encryption while the key was offloaded.
+			 */
+			if (pskb_expand_head(tx->skb, head_need, tail_need, GFP_ATOMIC))
+				return TX_DROP;
+		}
+
 		if (!skip_hw && tx->key &&
+		    !(tx->key->flags & KEY_FLAG_HW_TX_RETIRED) &&
 		    tx->key->flags & KEY_FLAG_UPLOADED_TO_HARDWARE)
 			info->control.hw_key = &tx->key->conf;
 	} else if (ieee80211_is_data_present(hdr->frame_control) && tx->sta &&
@@ -4870,6 +4899,7 @@
 	}
 
 	if (key && (!(key->flags & KEY_FLAG_UPLOADED_TO_HARDWARE) ||
+		    key->flags & KEY_FLAG_HW_TX_RETIRED ||
 		    key->conf.cipher == WLAN_CIPHER_SUITE_TKIP))
 		goto skip_offload;
 
--- a/net/mac80211/util.c
+++ b/net/mac80211/util.c
@@ -4469,10 +4469,12 @@
 			     unsigned long *frame_cnt,
 			     unsigned long *byte_cnt)
 {
+	struct ieee80211_local *local = vif_to_sdata(txq->vif)->local;
 	struct txq_info *txqi = to_txq_info(txq);
 	u32 frag_cnt = 0, frag_bytes = 0;
 	struct sk_buff *skb;
 
+	spin_lock_bh(&local->fq.lock);
 	skb_queue_walk(&txqi->frags, skb) {
 		frag_cnt++;
 		frag_bytes += skb->len;
@@ -4483,6 +4485,7 @@
 
 	if (byte_cnt)
 		*byte_cnt = txqi->tin.backlog_bytes + frag_bytes;
+	spin_unlock_bh(&local->fq.lock);
 }
 EXPORT_SYMBOL(ieee80211_txq_get_depth);
 
