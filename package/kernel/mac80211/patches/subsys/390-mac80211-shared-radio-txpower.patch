Subject: [PATCH] mac80211: allow a shared radio to own userspace power control

--- a/include/net/mac80211.h
+++ b/include/net/mac80211.h
@@ -4608,6 +4608,15 @@
  *	specified station. The returned value is expressed in Kbps. It returns 0
  *	if the RC algorithm does not have proper data to provide.
  *
+ * @set_txpower: Optional synchronous radio-level userspace power control.
+ *	This replaces mac80211's user power state and must apply the requested
+ *	setting or return an error without publishing unacknowledged state.
+ *	Useful for a radio shared with another cfg80211 control interface.
+ *	The driver remains responsible for combining its user ceiling with
+ *	mac80211 regulatory and peer-AP constraints notified through config and
+ *	BSS_CHANGED_TXPOWER. Does not provide per-interface power settings.
+ *	The wiphy mutex is held. May sleep. See nl80211_tx_power_setting.
+ *
  * @get_txpower: get current maximum tx power (in dBm) based on configuration
  *	and hardware limits.
  *
@@ -5028,6 +5037,8 @@
 	void (*leave_ibss)(struct ieee80211_hw *hw, struct ieee80211_vif *vif);
 	u32 (*get_expected_throughput)(struct ieee80211_hw *hw,
 				       struct ieee80211_sta *sta);
+	int (*set_txpower)(struct ieee80211_hw *hw, int radio_idx,
+			   enum nl80211_tx_power_setting type, int mbm);
 	int (*get_txpower)(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 			   unsigned int link_id, int *dbm);
 
--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -3719,6 +3719,9 @@
 
 	lockdep_assert_wiphy(local->hw.wiphy);
 
+	if (local->ops->set_txpower)
+		return drv_set_txpower(local, radio_idx, type, mbm);
+
 	switch (type) {
 	case NL80211_TX_POWER_AUTOMATIC:
 		user_power_level = IEEE80211_UNSET_POWER_LEVEL;
@@ -3843,7 +3846,7 @@
 	struct ieee80211_link_data *link_data;
 
 	if (local->ops->get_txpower &&
-	    (sdata->flags & IEEE80211_SDATA_IN_DRIVER))
+	    (local->ops->set_txpower || (sdata->flags & IEEE80211_SDATA_IN_DRIVER)))
 		return drv_get_txpower(local, sdata, link_id, dbm);
 
 	if (local->emulate_chanctx) {
--- a/net/mac80211/chan.c
+++ b/net/mac80211/chan.c
@@ -1253,6 +1253,12 @@
 			ieee80211_vif_cfg_change_notify(sdata, BSS_CHANGED_IDLE);
 	}
 
+	/* Link removal can change the strictest power constraint while leaving
+	 * the surviving shared channel context otherwise unchanged.
+	 */
+	if (local->ops->set_txpower && local->emulate_chanctx)
+		ieee80211_hw_conf_chan(local);
+
 	ieee80211_check_fast_xmit_iface(sdata);
 
 	return ret;
--- a/net/mac80211/driver-ops.h
+++ b/net/mac80211/driver-ops.h
@@ -1303,6 +1303,19 @@
 	return ret;
 }
 
+static inline int drv_set_txpower(struct ieee80211_local *local, int radio_idx,
+				 enum nl80211_tx_power_setting type, int mbm)
+{
+	int ret;
+
+	might_sleep();
+	lockdep_assert_wiphy(local->hw.wiphy);
+	trace_drv_set_txpower(local, radio_idx, type, mbm);
+	ret = local->ops->set_txpower(&local->hw, radio_idx, type, mbm);
+	trace_drv_return_int(local, ret);
+	return ret;
+}
+
 static inline int drv_get_txpower(struct ieee80211_local *local,
 				  struct ieee80211_sub_if_data *sdata,
 				  unsigned int link_id, int *dbm)
--- a/net/mac80211/main.c
+++ b/net/mac80211/main.c
@@ -362,6 +362,14 @@
 	if (!check_sdata_in_driver(sdata))
 		return;
 
+	/* Peer constraints can change without a channel or bandwidth change.
+	 * Shared-radio drivers consume the aggregate in ->config().
+	 */
+	if ((changed & BSS_CHANGED_TXPOWER) && local->ops->set_txpower &&
+	    local->emulate_chanctx)
+		ieee80211_hw_conf_chan(local);
+
+
 	if (changed & BSS_CHANGED_VIF_CFG_FLAGS) {
 		u64 ch = changed & BSS_CHANGED_VIF_CFG_FLAGS;
 
@@ -423,6 +431,14 @@
 
 	if (!check_sdata_in_driver(sdata))
 		return;
+
+	/* Peer constraints can change without a channel or bandwidth change.
+	 * Shared-radio drivers consume the aggregate in ->config().
+	 */
+	if ((changed & BSS_CHANGED_TXPOWER) && local->ops->set_txpower &&
+	    local->emulate_chanctx)
+		ieee80211_hw_conf_chan(local);
+
 
 	drv_link_info_changed(local, sdata, link->conf, link->link_id, changed);
 }
@@ -881,10 +897,11 @@
 	wiphy->features |= NL80211_FEATURE_SK_TX_STATUS |
 			   NL80211_FEATURE_SAE |
 			   NL80211_FEATURE_HT_IBSS |
-			   NL80211_FEATURE_VIF_TXPOWER |
 			   NL80211_FEATURE_MAC_ON_CREATE |
 			   NL80211_FEATURE_USERSPACE_MPM |
 			   NL80211_FEATURE_FULL_AP_CLIENT_STATE;
+	if (!ops->set_txpower)
+		wiphy->features |= NL80211_FEATURE_VIF_TXPOWER;
 	wiphy_ext_feature_set(wiphy, NL80211_EXT_FEATURE_FILS_STA);
 	wiphy_ext_feature_set(wiphy,
 			      NL80211_EXT_FEATURE_CONTROL_PORT_OVER_NL80211);
--- a/net/mac80211/trace.h
+++ b/net/mac80211/trace.h
@@ -2234,6 +2234,26 @@
 	TP_ARGS(local, sdata, ch_switch)
 );
 
+TRACE_EVENT(drv_set_txpower,
+	TP_PROTO(struct ieee80211_local *local, int radio_idx,
+		 enum nl80211_tx_power_setting type, int mbm),
+	TP_ARGS(local, radio_idx, type, mbm),
+	TP_STRUCT__entry(
+		LOCAL_ENTRY
+		__field(int, radio_idx)
+		__field(int, type)
+		__field(int, mbm)
+	),
+	TP_fast_assign(
+		LOCAL_ASSIGN;
+		__entry->radio_idx = radio_idx;
+		__entry->type = type;
+		__entry->mbm = mbm;
+	),
+	TP_printk(LOCAL_PR_FMT " radio_id:%d type:%d mbm:%d",
+		  LOCAL_PR_ARG, __entry->radio_idx, __entry->type, __entry->mbm)
+);
+
 TRACE_EVENT(drv_get_txpower,
 	TP_PROTO(struct ieee80211_local *local,
 		 struct ieee80211_sub_if_data *sdata,
