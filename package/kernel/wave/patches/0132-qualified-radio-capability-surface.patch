-/* The monitor's ordinary radiotap TX path uses the native full-buffer PD9
- * representation. No action header is manufactured in the packet itself.
- * Unsupported controls are rejected rather than silently reinterpreted.
- */
-static bool wave_raw_tx_owner(mtlk_hw_t *hw, mtlk_vap_handle_t vap,
-                              const struct sk_buff *skb)
-{
-  struct wireless_dev *wdev;
-  struct mtlk_chan_def *cd;
-  struct ieee80211_channel *channel;
-  mtlk_core_t *core = mtlk_vap_get_core(vap);
-
-  if (!skb || !skb->dev || !(wdev = skb->dev->ieee80211_ptr) ||
-      wdev->iftype != NL80211_IFTYPE_MONITOR ||
-      !READ_ONCE(hw->monitor_tx_enabled) ||
-      !wave_hw_monitor_is_owner(hw, netdev_priv(skb->dev)) ||
-      READ_ONCE(hw->monitor_vap) != vap || wave_hw_monitor_fenced(hw) ||
-      wave_vap_radio_id_get(vap) != 0 || mtlk_vap_get_id(vap) != 0 ||
-      !mtlk_vap_is_master_ap(vap) || !wave_hw_mmb_ready(hw))
-    return false;
-  cd = __wave_core_chandef_get(core);
-  channel = ieee80211_get_channel(wdev->wiphy, cd->chan.center_freq);
-  return is_channel_certain(cd) && cd->width == CW_20 && channel &&
-         !(channel->flags & (IEEE80211_CHAN_DISABLED | IEEE80211_CHAN_NO_IR |
-                             IEEE80211_CHAN_RADAR)) &&
-         (mtlk_core_get_net_state(core) & (NET_STATE_ACTIVATING | NET_STATE_CONNECTED));
-}
