From: OpenWrt WAVE maintainers
Subject: [PATCH] wave: keep statistics timer rearm out of request completion

Statistics request rejection can complete synchronously inside the timer
callback. Rearming from completion invokes timer_delete_sync on the current
timer and prevents its callback from returning. Let the existing periodic
timer own rearm, with one pending statistics request, and quiesce that producer
before monitor recovery joins its serializers. Resume polling only after all
monitor recovery stages and serializer restarts have succeeded.

--- a/wireless/driver/linux/mtlk_df_user.c
+++ b/wireless/driver/linux/mtlk_df_user.c
@@ -41,6 +41,7 @@
 #include <net/gro_cells.h>
 #include <net/sch_generic.h>
 #include <linux/if_bridge.h>
+#include <linux/atomic.h>
 
 #if MTLK_USE_PUMA6_UDMA
 #include <linux/udma_api.h> /* PUMA6 UDMA API*/
@@ -138,6 +139,7 @@
   /*******************/
 
   mtlk_osal_timer_t       stat_timer;
+  atomic_t                stat_pending;
 
   mtlk_df_proc_fs_node_t  *proc_df_node;
   mtlk_df_proc_fs_node_t  *proc_df_debug_node;
@@ -5785,11 +5787,10 @@
            sizeof(df_user->slow_ctx->linux_stats));
   }
 
-  if (!mtlk_osal_timer_is_cancelled(&df_user->slow_ctx->stat_timer)) {
-    /* if timer has been already canceled, don't start it again,
-       thus this callback can be performed from serializer later after timer stop */
-    mtlk_osal_timer_set(&df_user->slow_ctx->stat_timer, _DF_STAT_POLL_PERIOD);
-  }
+  /* Rejection/allocation failure can complete inline in the timer callback.
+   * Never synchronously cancel/rearm that running timer here. Completion
+   * also must not republish a timer after stop has joined its callback. */
+  atomic_set_release(&df_user->slow_ctx->stat_pending, 0);
 }
 
 static uint32
@@ -5799,11 +5800,16 @@
   mtlk_hw_t *hw = mtlk_vap_get_hw(mtlk_df_get_vap_handle(df_user->df));
 
   /* if error is occurred in _pci_probe then serializer is absent */
-  if (!wave_rcvry_pci_probe_error_get(wave_hw_mmb_get_mmb_base(hw))) {
+  if (wave_rcvry_pci_probe_error_get(wave_hw_mmb_get_mmb_base(hw)))
+    return 0;
+
+  /* The timer owns periodic rearm; at most one asynchronous request owns
+   * the cached statistics. Both inline and deferred completion release it. */
+  if (atomic_cmpxchg(&df_user->slow_ctx->stat_pending, 0, 1) == 0) {
     _mtlk_df_user_invoke_core_async(df_user->df, WAVE_CORE_REQ_GET_STATUS,
                                     NULL, 0, _mtlk_df_poll_stats_clb, HANDLE_T(df_user));
   }
-  return 0;
+  return _DF_STAT_POLL_PERIOD;
 }
 
 #define MAX_FW_RX_DATA_OFFSET 7
@@ -6247,15 +6253,16 @@
 }
 
 void __MTLK_IFUNC
-mtlk_df_on_rcvry_restore (mtlk_df_t *df)
+mtlk_df_on_rcvry_restore (mtlk_df_t *df, BOOL start_stats)
 {
   MTLK_ASSERT(df != NULL);
 
   /* Clear waiting events */
   wave_rcvry_mac_hang_evt_reset_all(mtlk_vap_get_hw(mtlk_df_get_vap_handle(df)));
 
-  /* Start stat timer */
-  mtlk_osal_timer_set(&mtlk_df_get_user(df)->slow_ctx->stat_timer, _DF_STAT_POLL_PERIOD);
+  /* Monitor recovery restarts its serializers after restoring the card. */
+  if (start_stats)
+    mtlk_osal_timer_set(&mtlk_df_get_user(df)->slow_ctx->stat_timer, _DF_STAT_POLL_PERIOD);
 }
 
 /**************************************************************
@@ -10216,6 +10223,7 @@
     MTLK_INIT_STEP(df_user, CREATE_DEBUG_DIR, MTLK_OBJ_PTR(df_user),
                    _mtlk_df_ui_create_debug_dir, (df_user));
 
+    atomic_set(&df_user->slow_ctx->stat_pending, 0);
     MTLK_INIT_STEP(df_user, STAT_TIMER, MTLK_OBJ_PTR(df_user),
                    mtlk_osal_timer_init, (&df_user->slow_ctx->stat_timer, _mtlk_df_poll_stats, HANDLE_T(df_user)));
 
--- a/wireless/driver/shared/fw_recovery.c
+++ b/wireless/driver/shared/fw_recovery.c
@@ -1377,14 +1377,14 @@
   return res;
 }
 
-static inline int __rcvry_step_fw_restoration (wave_rcvry_radio_ctx_t *radio_ctx, rcvry_type_e rcvry_type)
+static inline int __rcvry_step_fw_restoration (wave_rcvry_radio_ctx_t *radio_ctx, rcvry_type_e rcvry_type, BOOL start_df_stats)
 {
   wave_rcvry_vap_info_t **vap_info_ptr_temp = radio_ctx->vap_info;
   wave_rcvry_vap_info_t *vap_info_temp = *vap_info_ptr_temp++;
   int res = MTLK_ERR_OK;
 
   while (vap_info_temp) {
-    mtlk_df_on_rcvry_restore(mtlk_vap_get_df(vap_info_temp->vap_handle));
+    mtlk_df_on_rcvry_restore(mtlk_vap_get_df(vap_info_temp->vap_handle), start_df_stats);
     res = core_on_rcvry_restore(mtlk_vap_get_core(vap_info_temp->vap_handle), rcvry_type);
     if (MTLK_ERR_OK != res)
       return res;
@@ -1393,7 +1393,7 @@
   return res;
 }
 
-static int _rcvry_step_fw_restoration (wave_rcvry_card_cfg_t *pcard, uint16 oid)
+static int _rcvry_step_fw_restoration (wave_rcvry_card_cfg_t *pcard, uint16 oid, BOOL start_df_stats)
 {
   int res;
   wave_rcvry_task_ctx_t *rcvry_ctx = &pcard->rcvry_ctx;
@@ -1410,7 +1410,7 @@
     uint32 i;
 
     for (i = 0; i < rcvry_ctx->max_radios_number; i++) {
-      res = __rcvry_step_fw_restoration(&rcvry_ctx->radio_ctx[i], rcvry_type);
+      res = __rcvry_step_fw_restoration(&rcvry_ctx->radio_ctx[i], rcvry_type, start_df_stats);
       if (MTLK_ERR_OK != res)
         break;
     }
@@ -1717,7 +1717,7 @@
       if (MTLK_ERR_OK != res)
         break;
       /* Execute FW Restoration step */
-      res = _rcvry_step_fw_restoration(pcard, oid);
+      res = _rcvry_step_fw_restoration(pcard, oid, TRUE);
       if (MTLK_ERR_OK != res)
         break;
       /* Execute FW Reconfiguration step */
@@ -2061,6 +2061,12 @@
       }
     }
   }
+  /* Stop the statistics producer before closing its serializer. Completion
+   * only releases the pending request; it cannot rearm a stopped timer. */
+  for (r = 0; r < ctx->max_radios_number; r++)
+    for (v = 0; ctx->radio_ctx[r].vap_info[v]; v++)
+      mtlk_df_on_rcvry_isol(mtlk_vap_get_df(ctx->radio_ctx[r].vap_info[v]->vap_handle));
+
   /* Accepted control commands may be blocked waiting for firmware. Native
    * recovery cancellation must release them before joining their workers.
    * Queues/storage stay owned until the existing DMA fence and restore. */
@@ -2088,7 +2094,7 @@
   if (res == MTLK_ERR_OK)
     res = _rcvry_step_fw_isolation(pcard, oid);
   if (res == MTLK_ERR_OK)
-    res = _rcvry_step_fw_restoration(pcard, oid);
+    res = _rcvry_step_fw_restoration(pcard, oid, FALSE);
   if (res == MTLK_ERR_OK)
     res = _rcvry_step_fw_reconfiguration(pcard, oid);
   if (res != MTLK_ERR_OK)
@@ -2103,9 +2109,12 @@
         res = start_res;
     }
   }
-  if (res == MTLK_ERR_OK)
+  if (res == MTLK_ERR_OK) {
     wave_hw_monitor_restarted(hw);
-  else
+    for (r = 0; r < ctx->max_radios_number; r++)
+      for (v = 0; ctx->radio_ctx[r].vap_info[v]; v++)
+        mtlk_df_on_rcvry_restore(mtlk_vap_get_df(ctx->radio_ctx[r].vap_info[v]->vap_handle), TRUE);
+  } else
     wave_hw_mmb_quiesce(hw);
 done:
   __rcvry_type_current_set(ctx, RCVRY_TYPE_UNDEF);
--- a/wireless/driver/shared/mtlk_df.h
+++ b/wireless/driver/shared/mtlk_df.h
@@ -173,7 +173,7 @@
 mtlk_df_on_rcvry_isol(mtlk_df_t *df);
 
 void __MTLK_IFUNC
-mtlk_df_on_rcvry_restore(mtlk_df_t *df);
+mtlk_df_on_rcvry_restore(mtlk_df_t *df, BOOL start_stats);
 
 /* Remove MAC addr from switch DC DP table */
 void __MTLK_IFUNC
