Subject: [PATCH] wave: reject unsupported native RTS length thresholds

The firmware RTS mode and protection-rate commands do not carry a frame-length
threshold. AP ignored this setting and the native station Ethernet path bypasses
mac80211's software RTS decision. Return EOPNOTSUPP so cfg80211 rolls back its
cache instead of publishing a setting that cannot affect native data.

--- a/wireless/driver/linux/wave_radio.c
+++ b/wireless/driver/linux/wave_radio.c
@@ -3276,9 +3276,9 @@
   int res = MTLK_ERR_OK;
   mtlk_df_user_t *df_user;
 
-  /* No firmware fragmentation control is defined by this ABI. Reject the
-   * whole parameter request before any other firmware setting is applied. */
-  if (changed & WIPHY_PARAM_FRAG_THRESHOLD)
+  /* This ABI has no fragmentation or frame-length RTS threshold control.
+   * Reject before applying any other field; cfg80211 restores its cache. */
+  if (changed & (WIPHY_PARAM_FRAG_THRESHOLD | WIPHY_PARAM_RTS_THRESHOLD))
     return -EOPNOTSUPP;
 
   MTLK_ASSERT(NULL != radio);
@@ -3289,7 +3289,6 @@
   ILOG1_SSD("%s: Invoked from %s (%i)", mtlk_df_user_get_name(df_user), current->comm, current->pid);
   ILOG1_D("changed = 0x%X", changed);
 
-  /* ignore WIPHY_PARAM_RTS_THRESHOLD because it is hardcoded in FW */
   /* ignore WIPHY_PARAM_RETRY_SHORT because it is hardcoded in FW */
 
   if (changed & WIPHY_PARAM_RETRY_LONG) {
--- a/wireless/driver/linux/mac80211.c
+++ b/wireless/driver/linux/mac80211.c
@@ -1887,6 +1887,14 @@
 
 static int _wv_ieee80211_op_set_frag_threshold (struct ieee80211_hw *hw, int radio_idx, u32 value)
 {
+  return -EOPNOTSUPP;
+}
+
+static int _wv_ieee80211_op_set_rts_threshold(struct ieee80211_hw *hw,
+                                             int radio_idx, u32 value)
+{
+  /* Ethernet TX bypasses mac80211's software RTS policy. The firmware ABI
+   * exposes RTS bandwidth/rate controls, but no frame-length threshold. */
   return -EOPNOTSUPP;
 }
 
@@ -2814,6 +2822,7 @@
   .get_key_seq = _wv_ieee80211_op_get_key_seq,
 #endif
   .set_frag_threshold       = _wv_ieee80211_op_set_frag_threshold,
+  .set_rts_threshold        = _wv_ieee80211_op_set_rts_threshold,
   .bss_info_changed         = _wv_ieee80211_op_bss_info_changed,
   .link_sta_rc_update       = _wv_ieee80211_op_link_sta_rc_update,
   .conf_tx                  = _wv_ieee80211_op_conf_tx,
