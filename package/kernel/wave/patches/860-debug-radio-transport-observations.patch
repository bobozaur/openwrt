 int __MTLK_IFUNC
+mtlk_hw_seq_write_mhi_stats_layout(mtlk_hw_t *hw, struct seq_file *s)
+{
+    /* The matched A0 schema is fixed at build time. Proc readers drain before
+     * statistics cleanup; no snapshot data or firmware transaction is needed. */
+    mtlk_aux_seq_printf(s, "schema wave600_a0\ndata_bytes %u\nbyte_order little\n",
+                        hw->hw_mhi_stats.db_size);
+    mtlk_aux_seq_printf(s, "block offset bytes\n");
+#define WAVE600_STATS_LAYOUT(field) \
+    mtlk_aux_seq_printf(s, #field " %u %u\n", \
+        (unsigned)MTLK_OFFSET_OF(StatisticsDb_t_wave600, field), \
+        (unsigned)sizeof(((StatisticsDb_t_wave600 *)0)->field))
+    WAVE600_STATS_LAYOUT(hostIfCounters);
+    WAVE600_STATS_LAYOUT(rxCounters);
+    WAVE600_STATS_LAYOUT(baaCounters);
+    WAVE600_STATS_LAYOUT(tsManagerInitiatorTidGlobalStats);
+    WAVE600_STATS_LAYOUT(tsManagerInitiatorStationGlobalStats);
+    WAVE600_STATS_LAYOUT(tsManagerRecipientTidGlobalStats);
+    WAVE600_STATS_LAYOUT(tsManagerRecipientStationGlobalStats);
+    WAVE600_STATS_LAYOUT(linkAdaptationStats);
+    WAVE600_STATS_LAYOUT(multicastStats);
+    WAVE600_STATS_LAYOUT(trainingManagerStats);
+    WAVE600_STATS_LAYOUT(groupManagerStats);
+    WAVE600_STATS_LAYOUT(linkAdaptationMuStats);
+    WAVE600_STATS_LAYOUT(ptaStats);
+    WAVE600_STATS_LAYOUT(twtStats);
+    WAVE600_STATS_LAYOUT(perClientStats);
+    WAVE600_STATS_LAYOUT(generalStats);
+    WAVE600_STATS_LAYOUT(dynamicBwStats);
+    WAVE600_STATS_LAYOUT(phyStatistics);
+    WAVE600_STATS_LAYOUT(currentChannelStats);
+#undef WAVE600_STATS_LAYOUT
+    return MTLK_ERR_OK;
+}
