Subject: [PATCH] wave: report MU control support through its real native owners

The Gen6 A0 MU_OPERATION handler only returns a confirmation and never reads
or applies the payload. Reject legacy MU SET and GET before a message or
cache update, and skip stale legacy requests during recovery. Keep the VHT
MU power-limit family in the conservative cfg80211 report envelope instead
of allowing that ineffective cache to claim the family is disabled. Preserve
other chip paths and the independent acknowledged HE-MU control.

HE-MU GET uses the master-config requested-member protocol. Submit that
member rather than an empty clipboard, which reaches the consumer's NULL
assertion instead of returning the configured value.

--- a/wireless/driver/linux/core_config.c
+++ b/wireless/driver/linux/core_config.c
@@ -5032,6 +5032,16 @@
     return res;
 }
 
+BOOL __MTLK_IFUNC
+mtlk_core_mu_operation_supported (mtlk_core_t *core)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+
+  /* Gen6 A0 acknowledges MU_OPERATION without consuming its payload.
+   * Do not infer the same limitation for other chip generations. */
+  return !mtlk_hw_type_is_gen6(hw) || mtlk_hw_type_is_gen6_b0(hw);
+}
+
 int __MTLK_IFUNC
 mtlk_core_set_mu_operation (mtlk_core_t *core, uint8 mu_operation)
 {
@@ -5042,6 +5052,9 @@
   int                             res;
   wave_radio_t                   *radio = wave_vap_radio_get(vap_handle);
 
+  if (!mtlk_core_mu_operation_supported(core))
+    return MTLK_ERR_NOT_SUPPORTED;
+
   ILOG2_V("Sending UMI_MU_OPERATION_CONFIG");
 
   man_entry = mtlk_txmm_msg_init_with_empty_data(&man_msg, mtlk_vap_get_txmm(vap_handle), NULL);
@@ -5077,6 +5090,9 @@
   UMI_MU_OPERATION_CONFIG        *mu_operation_config = NULL;
   mtlk_vap_handle_t               vap_handle = core->vap_handle;
   int                             res;
+
+  if (!mtlk_core_mu_operation_supported(core))
+    return MTLK_ERR_NOT_SUPPORTED;
 
   man_entry = mtlk_txmm_msg_init_with_empty_data(&man_msg, mtlk_vap_get_txmm(vap_handle), NULL);
   if (NULL == man_entry) {
--- a/wireless/driver/linux/core_config.h
+++ b/wireless/driver/linux/core_config.h
@@ -187,6 +187,7 @@
 void __MTLK_IFUNC mtlk_core_read_fixed_ltf_and_gi (mtlk_core_t *core, mtlk_fixed_ltf_and_gi_t *fixed_ltf_and_gi, uint32 *data_size);
 
 int __MTLK_IFUNC mtlk_core_receive_coex_config (mtlk_core_t *core, uint8 *enabled, uint8 *mode);
+BOOL __MTLK_IFUNC mtlk_core_mu_operation_supported (mtlk_core_t *core);
 int __MTLK_IFUNC mtlk_core_set_mu_operation (mtlk_core_t *core, uint8 mu_operation);
 int __MTLK_IFUNC mtlk_core_receive_mu_operation (mtlk_core_t *core, BOOL *mu_operation);
 int __MTLK_IFUNC mtlk_core_set_rts_mode (mtlk_core_t *core, uint8 dynamic_bw, uint8 static_bw);
--- a/wireless/driver/linux/core.c
+++ b/wireless/driver/linux/core.c
@@ -12486,9 +12486,12 @@
     return MTLK_ERR_NOT_READY;
   power.cur_ant_gain = mtlk_antennas_factor(power.cur_antennas);
   power.power_usr_offs = WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_TX_POWER_LIMIT_OFFSET);
+  /* Unsupported legacy MU control cannot exclude VHT MU from this power
+   * envelope. Keep its limits eligible without claiming an enabled mode. */
   maximum = _mtlk_tx_power_target_max(&power, psdb->rate_pw_table,
     WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_BF_MODE) != BF_STATE_NON_BF,
-    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MU_OPERATION) != 0,
+    !mtlk_core_mu_operation_supported(core) ||
+      WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MU_OPERATION) != 0,
     WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_HE_MU_OPERATION) != 0);
   if (!maximum)
     return MTLK_ERR_NOT_READY;
@@ -14780,7 +14783,10 @@
 {
   uint8 mu_operation = WAVE_RADIO_PDB_GET_INT(wave_vap_radio_get(core->vap_handle), PARAM_DB_RADIO_MU_OPERATION);
 
-  if (MTLK_PARAM_DB_VALUE_IS_INVALID(mu_operation))
+  /* An old cached request must not replay an unsupported no-op or make
+   * recovery fail after the public setter has correctly rejected it. */
+  if (!mtlk_core_mu_operation_supported(core) ||
+      MTLK_PARAM_DB_VALUE_IS_INVALID(mu_operation))
     return MTLK_ERR_OK;
 
   return mtlk_core_set_mu_operation(core, mu_operation);
--- a/wireless/driver/linux/mtlk_df_user.c
+++ b/wireless/driver/linux/mtlk_df_user.c
@@ -4710,7 +4710,7 @@
     _DF_USER_GET_ON_PARAM_MEMBER(PRM_ID_MU_OPERATION, WAVE_RADIO_REQ_GET_MASTER_CFG, FALSE, mtlk_master_core_cfg_t, master_cfg, mu_operation)
       MTLK_CFG_GET_ITEM(master_cfg, mu_operation, *(uint32*)data);
 
-    _DF_USER_GET_ON_PARAM(PRM_ID_HE_MU_OPERATION, WAVE_RADIO_REQ_GET_MASTER_CFG, FALSE, mtlk_master_core_cfg_t, master_cfg)
+    _DF_USER_GET_ON_PARAM_MEMBER(PRM_ID_HE_MU_OPERATION, WAVE_RADIO_REQ_GET_MASTER_CFG, FALSE, mtlk_master_core_cfg_t, master_cfg, he_mu_operation)
       MTLK_CFG_GET_ITEM(master_cfg, he_mu_operation, *(uint32*)data);
 
     _DF_USER_GET_ON_PARAM_MEMBER(PRM_ID_BF_MODE, WAVE_RADIO_REQ_GET_MASTER_CFG, FALSE, mtlk_master_core_cfg_t, master_cfg, bf_mode)
