Subject: [PATCH] wave: apply A0 active power ceilings through the native owner

Gen6 A0 acknowledges SET_TPC_CONFIG after caching its payload. The active
DATA consumers refresh in the native SET_CHANNEL phase. Use that complete
serialized transaction on the unchanged channel for active power updates
and publish requested policy only after its checked completion. Keep scan,
CSA, CAC, DFS and wait-for-beacon ownership intact. Do not claim FIXED support.

That same-channel transaction consumes the complete new table so an older
lower limit cannot survive an increase. Ordinary channel/scan transitions
keep their existing intersection; other chip generations are unchanged.

--- a/wireless/driver/linux/core_config.c
+++ b/wireless/driver/linux/core_config.c
@@ -468,9 +468,30 @@
   return wv_cfg80211_get_chans_dfs_required(wiphy, cd->center_freq2, cw);
 }
 
-/* cpd may be NULL, only needed for the CSA stuff */
-int core_cfg_send_set_chan(mtlk_core_t *core,
-                           const struct mtlk_chan_def *cd, struct set_chan_param_data *cpd)
+static int
+_core_cfg_apply_tx_power(mtlk_core_t *core, unsigned center_freq,
+                        enum chanWidth cfg_width, unsigned cf_primary,
+                        mtlk_country_code_t req_country_code,
+                        unsigned user_limit, unsigned mac_limit,
+                        BOOL reload_calibration, BOOL intersect_previous);
+
+static BOOL
+_core_cfg_tpc_limits_are_deferred(mtlk_core_t *core)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+
+  /* Gen6 A0 SET_TPC_CONFIG stages limits. The native SET_CHANNEL phase
+   * consumes them before its confirmation; the config ACK alone does not. */
+  return mtlk_hw_type_is_gen6(hw) && !mtlk_hw_type_is_gen6_b0(hw);
+}
+
+/* Explicit limits let a power update use the native channel transaction
+ * without publishing an unacknowledged USER/MAC policy in the radio PDB.
+ * cpd may be NULL for an ordinary channel transaction. */
+static int
+_core_cfg_send_set_chan(mtlk_core_t *core, const struct mtlk_chan_def *cd,
+                       struct set_chan_param_data *cpd,
+                       unsigned user_limit, unsigned mac_limit, BOOL power_refresh)
 {
   mtlk_txmm_msg_t       man_msg;
   mtlk_txmm_data_t      *man_entry;
@@ -482,6 +503,7 @@
   u32                   radar_generation = wave_radio_dfs_generation(radio);
   mtlk_country_code_t    country;
   int                   res = MTLK_ERR_OK;
+  BOOL                  power_staged = FALSE;
 
   /* Recovery and scan completion may pass the mutable current chandef. */
   cd = &destination;
@@ -565,13 +587,16 @@
     req->u16SID = HOST_TO_MAC16(cpd->sid);
   }
 
-  /* SET_TPC precedes SET_CHAN in this ABI. Keep a table safe on both
-   * channels until the channel command completes. */
+  /* SET_TPC precedes SET_CHAN. An active power refresh keeps this exact
+   * channel and must consume the new table, including an increased limit.
+   * Actual channel changes retain the existing safe intersection. */
   core_cfg_country_code_get(core, &country);
-  res = core_cfg_set_tx_power_limit(core, cd->center_freq1, cd->width,
-                                     cd->chan.center_freq, country, TRUE);
+  res = _core_cfg_apply_tx_power(core, cd->center_freq1, cd->width,
+                                cd->chan.center_freq, country,
+                                user_limit, mac_limit, TRUE, !power_refresh);
   if (res != MTLK_ERR_OK)
     goto end;
+  power_staged = TRUE;
 
   old_freq1 = ccd->center_freq1;
   ccd->center_freq1 = 0; /* this marks that channel is "uncertain" (in this case changing) */
@@ -589,8 +614,9 @@
   res = core_cfg_send_set_chan_by_msg(core, &man_msg,
               cpd ? cpd->station : wave_radio_channel_is_station(radio));
   if (res == MTLK_ERR_OK)
-    res = core_cfg_set_tx_power_limit(core, cd->center_freq1, cd->width,
-                                       cd->chan.center_freq, country, FALSE);
+    res = _core_cfg_apply_tx_power(core, cd->center_freq1, cd->width,
+                                  cd->chan.center_freq, country,
+                                  user_limit, mac_limit, FALSE, TRUE);
   if (res != MTLK_ERR_OK)
     wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
 
@@ -659,10 +685,26 @@
   }
 
 end:
+  /* Staging may already have replaced the firmware/PDB table even when a
+   * later step (including RF-on) fails. Do not expose an unapplied table
+   * as an operating power policy. Recovery reapplies the old USER/MAC
+   * request, which the active-update caller has not committed. */
+  if (power_refresh && power_staged && res != MTLK_ERR_OK)
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
   (void)mtlk_core_radio_disable_if_needed(core);
 
   mtlk_txmm_msg_cleanup(&man_msg);
   return res;
+}
+
+int core_cfg_send_set_chan(mtlk_core_t *core,
+                           const struct mtlk_chan_def *cd, struct set_chan_param_data *cpd)
+{
+  wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
+
+  return _core_cfg_send_set_chan(core, cd, cpd,
+    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_USER_TX_POWER),
+    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MAC_TX_POWER), FALSE);
 }
 
 /* CFG80211: set_ap_chanwidth(), start_radar_detection() and channel_switch() */
@@ -1760,7 +1802,8 @@
 _core_cfg_apply_tx_power(mtlk_core_t *core, unsigned center_freq,
                         enum chanWidth cfg_width, unsigned cf_primary,
                         mtlk_country_code_t req_country_code,
-                        unsigned user_limit, unsigned mac_limit, BOOL reload_calibration)
+                        unsigned user_limit, unsigned mac_limit,
+                        BOOL reload_calibration, BOOL intersect_previous)
 {
   mtlk_df_t *df               = mtlk_vap_get_df(core->vap_handle); /* this checks vap_handle and df, cannot return NULL */
   mtlk_df_user_t *df_user     = mtlk_df_get_user(df);
@@ -1865,7 +1908,12 @@
         (is_channel_certain(__wave_core_chandef_get(core)) &&
          !previous.pw_limits[PSDB_PHY_CW_OFDM_20]))
       return MTLK_ERR_NOT_READY;
-    _core_cfg_intersect_tx_power(&cfg_pwl, &previous);
+    /* The active-refresh caller owns the unchanged channel. Keeping an
+     * older lower table in that transaction would leave the former limit
+     * active after an increase. All ordinary channel/scan callers retain
+     * their existing intersection. */
+    if (intersect_previous)
+      _core_cfg_intersect_tx_power(&cfg_pwl, &previous);
     _core_cfg_limit_tx_power(&cfg_pwl, user_limit, mac_limit);
     return mtlk_reload_tpc_wrapper(core, ieee80211_frequency_to_channel(center_freq), &cfg_pwl);
   }
@@ -1890,7 +1938,7 @@
   wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
   return _core_cfg_apply_tx_power(core, center_freq, width, primary, country,
     WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_USER_TX_POWER),
-    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MAC_TX_POWER), prepare_channel);
+    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MAC_TX_POWER), prepare_channel, TRUE);
 }
 
 /* The caller owns the master serializer. Before a channel is activated only
@@ -1902,13 +1950,39 @@
   struct mtlk_chan_def *cd = __wave_core_chandef_get(core);
   mtlk_country_code_t country;
 
-  if (!is_channel_certain(cd) ||
-      !mtlk_vap_manager_get_active_vaps_number(mtlk_vap_get_manager(core->vap_handle)))
+  wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
+
+  if (!mtlk_vap_manager_get_active_vaps_number(mtlk_vap_get_manager(core->vap_handle)))
+    return MTLK_ERR_OK;
+
+  if (_core_cfg_tpc_limits_are_deferred(core)) {
+    MTLK_ASSERT(core == mtlk_core_get_master(core));
+    /* A scan/CSA/CAC owns its channel and TX fence. A power request must
+     * not turn that operation into a normal same-channel transaction or
+     * publish a policy which it has not applied. The caller can retry
+     * after that native owner completes. Regulatory failure retains its
+     * existing quiesce path. */
+    if (mtlk_core_scan_is_running(core) || mtlk_core_is_in_scan_mode(core) ||
+        __mtlk_core_is_chan_switch_type_csa_with_block_tx(core) ||
+        wave_radio_cac_active(radio) || wave_radio_dfs_tx_blocked(radio) ||
+        (core->slow_ctx->is_block_tx && cd->wait_for_beacon))
+      return MTLK_ERR_BUSY;
+    if (!is_channel_certain(cd))
+      return MTLK_ERR_NOT_READY;
+
+    /* The current channel is copied inside the common owner before it is
+     * marked uncertain. Its checked SET_CHANNEL completion follows the
+     * calibrated-limit and peer DATA refresh, unlike SET_TPC_CONFIG alone.
+     * USER/MAC caches are committed by the caller only after this returns. */
+    return _core_cfg_send_set_chan(core, cd, NULL, user_limit, mac_limit, TRUE);
+  }
+
+  if (!is_channel_certain(cd))
     return MTLK_ERR_OK;
   core_cfg_country_code_get(core, &country);
   return _core_cfg_apply_tx_power(core, cd->center_freq1, cd->width,
                                   cd->chan.center_freq, country,
-                                  user_limit, mac_limit, FALSE);
+                                  user_limit, mac_limit, FALSE, TRUE);
 }
 
 int core_cfg_tx_power(mtlk_handle_t hcore, const void *data, uint32 data_size)
