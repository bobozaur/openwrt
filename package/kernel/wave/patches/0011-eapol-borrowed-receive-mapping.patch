+struct wave_bss_rx_mapping {
+  void *virt_addr;
+  u32 dma_addr;
+  u32 size;
+};
+
+static bool
+wave_bss_rx_mapping_get(mtlk_hw_t *hw, u32 address, u32 index, bool is_eapol,
+                        struct wave_bss_rx_mapping *mapping)
+{
+  struct mtlk_hw_bss_ind_mirror *mgmt = wave_mgmt_rx_owner(hw, address, index);
+  mtlk_mmb_basic_bdr_t *bdr = &hw->rx.bdr_data;
+  mtlk_hw_data_ind_mirror_t *data;
+  unsigned int i, candidate;
+
+  if (mgmt) {
+    mapping->virt_addr = mgmt->virt_addr;
+    mapping->dma_addr = mgmt->dma_addr;
+    mapping->size = mgmt->size;
+    return true;
+  }
+  if (!is_eapol)
+    return false;
+
+  /* Retained firmware can report Ethernet EAPOL from a data RD on the
+   * management ring. Borrow its live allocation for a copy only: the original
+   * descriptor must be returned on the management ring without freeing or
+   * replacing the data skb. This card's RX tasklet serializes both rings. */
+  for (i = 0; i <= bdr->nof_bds; i++) {
+    candidate = i ? i - 1 : index;
+    if (candidate >= bdr->nof_bds || (i && candidate == index))
+      continue;
+    data = _mtlk_basic_bdr_get_mirror_bd(bdr, candidate, mtlk_hw_data_ind_mirror_t);
+    if (!data->nbuf || !data->dma_addr || address < data->dma_addr ||
+        address - data->dma_addr >= data->size)
+      continue;
+    mapping->virt_addr = data->nbuf->data;
+    mapping->dma_addr = data->dma_addr;
+    mapping->size = data->size;
+    ILOG0_DDDD("BSS EAPOL borrows data RX: descriptor=%u owner=%u delta=%u allocation=%u",
+                index, candidate, address - data->dma_addr, data->size);
+    return true;
+  }
+  return false;
+}
