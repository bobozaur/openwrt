Subject: [PATCH] make legacy Wireless Extensions hooks optional

--- a/wireless/driver/linux/mtlk_df_user.c
+++ b/wireless/driver/linux/mtlk_df_user.c
@@ -9315,6 +9315,7 @@
   df_user->ndev->needs_free_netdev = true;
   df_user->ndev->priv_destructor = _mtlk_netdev_destructor;
 
+#ifdef CONFIG_WEXT_PRIV
   /* Configure core and radio iwpriv handlers */
   if(mtlk_vap_is_master_ap(vap_handle)) {
       df_user->ndev->wireless_handlers = (struct iw_handler_def *)&wave_linux_iw_radio_handler_def;
@@ -9322,6 +9323,7 @@
       wave_linux_iw_core_handler_def.num_private_args = wave_df_get_core_privtab_size();
       df_user->ndev->wireless_handlers = (struct iw_handler_def *)&wave_linux_iw_core_handler_def;
   }
+#endif
 
   return MTLK_ERR_OK;
 }
--- a/wireless/driver/linux/mtlk_mmb_drv.c
+++ b/wireless/driver/linux/mtlk_mmb_drv.c
@@ -396,7 +396,7 @@
   return _mtlk_bcl_ui_iw_mac_data_proc(ndev, info, wrqu, extra, 0);
 }
 
-static const iw_handler  mtlk_bcl_private_handlers[] = {
+static const iw_handler __maybe_unused mtlk_bcl_private_handlers[] = {
   [20] = _mtlk_bcl_ui_iw_mac_data_get,
   [21] = _mtlk_bcl_ui_iw_mac_data_set,
   [31] = NULL,
@@ -404,8 +404,10 @@
 
 const struct iw_handler_def  mtlk_bcl_handler_def = {
   .num_standard     = ARRAY_SIZE(mtlk_bcl_standard_handlers),
+#ifdef CONFIG_WEXT_PRIV
   .num_private      = ARRAY_SIZE(mtlk_bcl_private_handlers),
   .private          = (iw_handler *) mtlk_bcl_private_handlers,
+#endif
   .standard         = (iw_handler *) mtlk_bcl_standard_handlers,
 };
 
@@ -465,7 +467,9 @@
   bcl_user->ndev->needs_free_netdev = true;
 
   /* configure handlers */
+#ifdef CONFIG_WEXT_CORE
   bcl_user->ndev->wireless_handlers = (struct iw_handler_def *)&mtlk_bcl_handler_def;
+#endif
 }
 
 static void
--- a/wireless/driver/linux/mtlk_df_user_tbl.c
+++ b/wireless/driver/linux/mtlk_df_user_tbl.c
@@ -483,7 +483,7 @@
 /********************************************************************
  * IW private IOCTL handlers table
  ********************************************************************/
-static const iw_handler mtlk_linux_private_handler[] = {
+static const iw_handler __maybe_unused mtlk_linux_private_handler[] = {
   [ 0] = mtlk_df_ui_linux_ioctl_set_int,
   [ 1] = mtlk_df_ui_linux_ioctl_get_int,
   [ 4] = mtlk_df_ui_linux_ioctl_set_intvec,
@@ -544,11 +544,19 @@
 
 struct iw_handler_def wave_linux_iw_radio_handler_def = {
   .num_standard = ARRAY_SIZE(_cfg80211_handlers),
+#ifdef CONFIG_WEXT_PRIV
   .num_private = ARRAY_SIZE(mtlk_linux_private_handler),
+#endif
+#ifdef CONFIG_WEXT_PRIV
   .num_private_args = ARRAY_SIZE(wave_linux_iw_core_radio_privtab),
+#endif
   .standard = (iw_handler *) _cfg80211_handlers,
+#ifdef CONFIG_WEXT_PRIV
   .private = (iw_handler *) mtlk_linux_private_handler,
+#endif
+#ifdef CONFIG_WEXT_PRIV
   .private_args = (struct iw_priv_args *) wave_linux_iw_core_radio_privtab,
+#endif
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(2,6,0)
   .get_wireless_stats = mtlk_df_ui_linux_ioctl_get_iw_stats,
 #endif
@@ -556,11 +564,19 @@
 
 struct iw_handler_def wave_linux_iw_core_handler_def = {
   .num_standard = ARRAY_SIZE(_cfg80211_handlers),
+#ifdef CONFIG_WEXT_PRIV
   .num_private = ARRAY_SIZE(mtlk_linux_private_handler),
+#endif
+#ifdef CONFIG_WEXT_PRIV
   .num_private_args = 0,
+#endif
   .standard = (iw_handler *) _cfg80211_handlers,
+#ifdef CONFIG_WEXT_PRIV
   .private = (iw_handler *) mtlk_linux_private_handler,
+#endif
+#ifdef CONFIG_WEXT_PRIV
   .private_args = (struct iw_priv_args *) wave_linux_iw_core_radio_privtab,
+#endif
   .get_wireless_stats = mtlk_df_ui_linux_ioctl_get_iw_stats,
 };
 
