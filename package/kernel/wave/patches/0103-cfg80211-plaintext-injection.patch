+static int wave_raw_tx_frame(mtlk_vap_handle_t vap, const u8 *frame, size_t length)
+{
+  const struct ieee80211_hdr *hdr = (const void *)frame;
+  mtlk_core_t *core = mtlk_vap_get_core(vap);
+  IEEE_ADDR own;
+  u16 fc, ds;
+  unsigned int hdrlen;
+
+  if (length < 24 || length > BSS_MGMT_FRAME_SIZE)
+    return MTLK_ERR_PARAMS;
+  fc = le16_to_cpu(hdr->frame_control);
+  ds = fc & (IEEE80211_FCTL_TODS | IEEE80211_FCTL_FROMDS);
+  /* Qualified plaintext geometry only: no crypto, fragments, HT-Control,
+   * caller-owned sequence, ACK/retry policy or aggregation interpretation. */
+  if ((fc & ~(IEEE80211_FCTL_TODS | IEEE80211_FCTL_FROMDS |
+              IEEE80211_STYPE_QOS_DATA)) != IEEE80211_FTYPE_DATA ||
+      (ds && ds != (IEEE80211_FCTL_TODS | IEEE80211_FCTL_FROMDS)) ||
+      hdr->duration_id || hdr->seq_ctrl ||
+      !is_broadcast_ether_addr(hdr->addr1) ||
+      core->slow_ctx->rsn_enabled || core->slow_ctx->wep_enabled ||
+      mtlk_stadb_stas_num(&core->slow_ctx->stadb))
+    return MTLK_ERR_NOT_SUPPORTED;
+  hdrlen = ds ? 30 : 24;
+  if (fc & IEEE80211_STYPE_QOS_DATA)
+    hdrlen += 2;
+  if (length < hdrlen)
+    return MTLK_ERR_PARAMS;
+  MTLK_CORE_PDB_GET_MAC(core, PARAM_DB_CORE_MAC_ADDR, &own);
+  if (memcmp(hdr->addr2, own.au8Addr, ETH_ALEN) ||
+      (ds ? !is_broadcast_ether_addr(hdr->addr3) ||
+            memcmp(frame + 24, own.au8Addr, ETH_ALEN)
+          : memcmp(hdr->addr3, own.au8Addr, ETH_ALEN)) ||
+      ((fc & IEEE80211_STYPE_QOS_DATA) && get_unaligned_le16(frame + hdrlen - 2)))
+    return MTLK_ERR_NOT_SUPPORTED;
+  return MTLK_ERR_OK;
+}
