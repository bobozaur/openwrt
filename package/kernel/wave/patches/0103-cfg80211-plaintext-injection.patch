+  mtlk_mmb_bss_mgmt_update_free_list_stat(queues);
+  if (entry) {
+    mtlk_dlist_push_back(&queues->tx_bdr.used_list, entry);
+  } else {
+    entry = mtlk_dlist_pop_front(&queues->tx_res_bdr.free_list);
+    mtlk_mmb_bss_mgmt_update_res_free_list_stat(queues);
+    if (!entry) {
+      res = MTLK_ERR_NO_MEM;
+      goto unlock;
+    }
