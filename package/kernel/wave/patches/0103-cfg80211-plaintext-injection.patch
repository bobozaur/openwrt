+                                           hdr.list_entry);
+  id = ++queues->cookie_counter;
+  if (!id)
+    id = ++queues->cookie_counter;
+  request->pmf = NULL;
+  request->dma_addr = 0;
+  request->vap_id = mtlk_vap_get_id(vap);
+  request->radio_id = wave_vap_radio_id_get(vap);
+  request->cookie = id;
+  wave_memcpy(request->virt_addr, BSS_MGMT_FRAME_SIZE, skb->data, skb->len);
+  request->size = skb->len;
+  request->extra_processing = PROCESS_RAW_DATA;
+  /* This is a native PD9 classifier tag, never a replacement packet header. */
+  request->action_code = WLAN_CATEGORY_PUBLIC;
+  request->subtype = (get_unaligned_le16(skb->data) & IEEE80211_FCTL_STYPE) >> 4;
+  request->is_broadcast = TRUE;
+  memcpy(request->dst_addr.au8Addr, skb->data + 4, ETH_ALEN);
+  request->power_mgmt_on = FALSE;
+  request->tid = NTS_TID_USE_DEFAULT;
+  ndev = skb->dev;
+  dev_hold(ndev);
+  request->skb = skb;
+  if (reserve) {
+    mtlk_dlist_push_back(&queues->tx_res_bdr.used_list, entry);
+  } else {
+    res = _mtlk_mmb_bss_mgmt_tx(hw, request, vap);
+    if (res != MTLK_ERR_OK) {
+      request->skb = NULL; /* An unsuccessful caller still owns its skb. */
+      dev_put(ndev);
+      mtlk_dlist_remove(&queues->tx_bdr.used_list, entry);
+      mtlk_dlist_push_back(&queues->tx_bdr.free_list, entry);
+      goto unlock;
+    }
+  }
+  *cookie = id;
+  res = MTLK_ERR_OK;
+unlock:
+  mtlk_osal_lock_release(&queues->tx_bdr.lock);
+  return res;
+}
