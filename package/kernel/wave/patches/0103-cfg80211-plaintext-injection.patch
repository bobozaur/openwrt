+/* A successful queue publication holds the exact monitor netdev until native
+ * CFM or post-DMA-fence retirement. This is not a mac80211 STA skb. */
+static void wave_bss_complete_raw(struct mtlk_hw_bss_req_mirror *entry,
+                                  bool completed)
+{
+  struct sk_buff *skb = xchg(&entry->skb, NULL);
+  struct net_device *ndev;
+
+  if (!skb)
+    return;
+  ndev = skb->dev;
+  if (completed) {
+    ndev->stats.tx_packets++;
+    ndev->stats.tx_bytes += skb->len;
+  } else {
+    ndev->stats.tx_dropped++;
+    ndev->stats.tx_errors++;
+  }
+  dev_kfree_skb_any(skb);
+  dev_put(ndev);
+}
