+static int wave_raw_tx_radiotap(struct sk_buff *skb, int frequency)
+{
+  struct ieee80211_radiotap_iterator iterator;
+  struct ieee80211_radiotap_header *header;
+  unsigned int rtlen;
+  bool fcs = false;
+  int res;
+
+  if (skb_is_gso(skb) || skb->ip_summed == CHECKSUM_PARTIAL ||
+      !pskb_may_pull(skb, sizeof(*header)))
+    return MTLK_ERR_PARAMS;
+  header = (void *)skb->data;
+  rtlen = le16_to_cpu(header->it_len);
+  if (header->it_version || rtlen < sizeof(*header) ||
+      rtlen > skb->len || skb->len - rtlen < 24 ||
+      skb->len - rtlen > BSS_MGMT_FRAME_SIZE + 4 ||
+      !pskb_may_pull(skb, rtlen))
+    return MTLK_ERR_PARAMS;
+  header = (void *)skb->data;
+  /* The native iterator also returns ENOENT on unknown field alignment.
+   * Admit only this explicit first-namespace mask before walking anything. */
+  if (get_unaligned_le32(&header->it_present) &
+      ~(BIT(IEEE80211_RADIOTAP_TSFT) | BIT(IEEE80211_RADIOTAP_FLAGS) |
+        BIT(IEEE80211_RADIOTAP_CHANNEL) | BIT(IEEE80211_RADIOTAP_DBM_ANTSIGNAL) |
+        BIT(IEEE80211_RADIOTAP_DBM_ANTNOISE) | BIT(IEEE80211_RADIOTAP_ANTENNA) |
+        BIT(IEEE80211_RADIOTAP_RX_FLAGS) | BIT(IEEE80211_RADIOTAP_TX_FLAGS)))
+    return MTLK_ERR_NOT_SUPPORTED;
+  res = ieee80211_radiotap_iterator_init(&iterator, header, rtlen, NULL);
+  if (res)
+    return MTLK_ERR_PARAMS;
+  while (!(res = ieee80211_radiotap_iterator_next(&iterator))) {
+    if (!iterator.is_radiotap_ns)
+      return MTLK_ERR_NOT_SUPPORTED;
+    switch (iterator.this_arg_index) {
+    case IEEE80211_RADIOTAP_FLAGS:
+      if (*iterator.this_arg & ~IEEE80211_RADIOTAP_F_FCS)
+        return MTLK_ERR_NOT_SUPPORTED;
+      fcs = *iterator.this_arg & IEEE80211_RADIOTAP_F_FCS;
+      break;
+    case IEEE80211_RADIOTAP_TX_FLAGS:
+      /* In particular NOSEQNO, NOACK, RTS/CTS and forced ordering are not
+       * implemented by this hardware owner. Broadcast has no RF ACK claim. */
+      if (get_unaligned_le16(iterator.this_arg))
+        return MTLK_ERR_NOT_SUPPORTED;
+      break;
+    case IEEE80211_RADIOTAP_CHANNEL:
+      if (get_unaligned_le16(iterator.this_arg) != frequency)
+        return MTLK_ERR_PARAMS;
+      break;
+    case IEEE80211_RADIOTAP_TSFT:
+    case IEEE80211_RADIOTAP_DBM_ANTSIGNAL:
+    case IEEE80211_RADIOTAP_DBM_ANTNOISE:
+    case IEEE80211_RADIOTAP_ANTENNA:
+    case IEEE80211_RADIOTAP_RX_FLAGS:
+      /* Receive annotations do not request a transmit policy. */
+      break;
+    default:
+      return MTLK_ERR_NOT_SUPPORTED;
+    }
+  }
+  if (res != -ENOENT)
+    return MTLK_ERR_PARAMS;
+  skb_pull(skb, rtlen);
+  if (fcs) {
+    if (skb->len < 28)
+      return MTLK_ERR_PARAMS;
+    if (pskb_trim(skb, skb->len - 4))
+      return MTLK_ERR_NO_MEM;
+  }
+  if (skb_linearize(skb))
+    return MTLK_ERR_NO_MEM;
+  return MTLK_ERR_OK;
+}
