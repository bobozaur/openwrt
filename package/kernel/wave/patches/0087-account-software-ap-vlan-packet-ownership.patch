Subject: [PATCH] wave: account software AP_VLAN packet ownership

Software AP_VLAN devices carry packets but expose permanently zero RX/TX
counters. Give these Linux ports native per-CPU statistics with netdevice
registration owning allocation and cleanup.

Count valid child RX before the existing RCU-protected stack handoff, and
count child TX only after native submission accepts the packet. Retain the
original child and Ethernet length through synchronous transmission; the
hardware-owned skb still points to its parent. Include child RX rejection
and early/native TX drops without counting NETDEV_TX_BUSY retries.

These are Ethernet port counters, not firmware or over-air acknowledgments.
No station, key, multicast pin or firmware descriptor ownership changes.

--- a/wireless/driver/linux/core.c
+++ b/wireless/driver/linux/core.c
@@ -1213,7 +1213,13 @@
   uint32         nbuf_flags = 0;
   sta_db        *stadb;
   mtlk_core_handle_tx_data_t tx_data = { .msg = msg };
-
+  struct net_device *vlan_ndev = NULL;
+  unsigned int vlan_bytes = nbuf->len;
+  int res = MTLK_ERR_PKT_DROPPED;
+
+  if (mtlk_vap_is_ap(vap_handle) &&
+      nbuf->dev->ieee80211_ptr->iftype == NL80211_IFTYPE_AP_VLAN)
+    vlan_ndev = nbuf->dev;
   MTLK_ASSERT(NULL != nic);
   stadb = &nic->slow_ctx->stadb;
 
@@ -1352,13 +1358,21 @@
 send_tx_data:
   tx_data.nbuf = nbuf;
   tx_data.dst_sta = sta;
-  mtlk_mc_transmit(nic, &tx_data, nbuf_flags, bridge_mode, src_sta);
+  res = mtlk_mc_transmit(nic, &tx_data, nbuf_flags, bridge_mode, src_sta);
   goto out;
 
 tx_error:
   mtlk_df_nbuf_free(nbuf);
   if (sta) mtlk_sta_decref(sta); /* De-reference of find or get_ap */
 out:
+  /* The caller owns this child until TX returns; hardware retains the parent.
+   * Count accepted Ethernet frames, not firmware/air acknowledgements. */
+  if (vlan_ndev) {
+    if (res == MTLK_ERR_OK)
+      dev_sw_netstats_tx_add(vlan_ndev, 1, vlan_bytes);
+    else
+      dev_core_stats_tx_dropped_inc(vlan_ndev);
+  }
   if (src_sta) mtlk_sta_decref(src_sta);
   /* Early discards and WDS clone-only transmission leave this unused. */
   if (tx_data.msg)
--- a/wireless/driver/linux/mtlk_df_user.c
+++ b/wireless/driver/linux/mtlk_df_user.c
@@ -873,6 +873,7 @@
   dev_net_set(ndev, dev_net(parent->netdev));
   ndev->ieee80211_ptr = &vlan->wdev;
   ndev->netdev_ops = &wave_ap_vlan_ops;
+  ndev->pcpu_stat_type = NETDEV_PCPU_STAT_TSTATS;
   ndev->mtu = parent->netdev->mtu;
   ndev->min_mtu = parent->netdev->min_mtu;
   ndev->max_mtu = parent->netdev->max_mtu;
@@ -6061,12 +6062,14 @@
     handled = true;
     if (!netif_running(ndev) || mtlk_core_is_looped_packet(core, nbuf) ||
         mtlk_core_get_net_state(core) != NET_STATE_CONNECTED) {
+      dev_core_stats_rx_dropped_inc(ndev);
       mtlk_df_nbuf_free(nbuf);
     } else {
       flags = is_broadcast_ether_addr(eth->h_dest) ? MTLK_NBUFF_BROADCAST :
               is_multicast_ether_addr(eth->h_dest) ? MTLK_NBUFF_MULTICAST :
               MTLK_NBUFF_UNICAST;
       mtlk_sta_on_packet_indicated(sta, nbuf, flags);
+      dev_sw_netstats_rx_add(ndev, nbuf->len);
       wave_df_indicate_rx_data(mtlk_vap_get_df(sta->vap_handle), nbuf, ndev);
     }
   }
