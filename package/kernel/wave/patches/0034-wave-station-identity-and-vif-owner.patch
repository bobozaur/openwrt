Subject: [PATCH] wave: leave station VIF creation to netifd

--- a/wireless/driver/linux/mac80211.c
+++ b/wireless/driver/linux/mac80211.c
@@ -2117,6 +2117,7 @@
     IEEE80211_HW_SW_CRYPTO_CONTROL |
     IEEE80211_HW_AMPDU_AGGREGATION;
 #else
+  ieee80211_hw_set(hw, NO_AUTO_VIF);
   ieee80211_hw_set(hw, SIGNAL_DBM);
   ieee80211_hw_set(hw, SPECTRUM_MGMT);
   ieee80211_hw_set(hw, REPORTS_TX_ACK_STATUS);
@@ -2231,7 +2232,18 @@
   register_vendor_commands(hw->wiphy);
   register_vendor_events(hw->wiphy);
 
-  /* Register hw with mac80211 kernel framework and add one default STA interface */
+  /* The calibrated AP master is already registered. Both role wiphys refer
+   * to this radio; netifd supplies any configured per-interface MAC override.
+   * Leave interface creation to its ordinary supplicant lifecycle.
+   */
+  {
+    struct net_device *master = mtlk_df_user_get_ndev(
+      mtlk_df_get_user(wave_radio_df_get(mac80211->radio)));
+    if (!is_valid_ether_addr(master->dev_addr))
+      return MTLK_ERR_PARAMS;
+    SET_IEEE80211_PERM_ADDR(hw, master->dev_addr);
+  }
+
   ret = ieee80211_register_hw(hw);
   if (ret) {
     ELOG_D("ieee80211 HW registration failed. Error code: %d", ret);
