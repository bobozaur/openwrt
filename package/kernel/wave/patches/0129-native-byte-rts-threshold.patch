+int wave_radio_rts_threshold_set(wave_radio_t *radio, uint32 threshold)
+{
+  mtlk_clpb_t *clpb = NULL;
+  mtlk_df_t *df;
+  int res;
+
+  if (!smp_load_acquire(&radio->control_ready))
+    return -EBUSY;
+  df = mtlk_vap_manager_get_master_df(radio->vap_manager);
+  res = _mtlk_df_user_invoke_core(df, WAVE_RADIO_REQ_RTS_THRESHOLD, &clpb,
+                                  &threshold, sizeof(threshold));
+  res = _mtlk_df_user_process_core_retval(res, clpb, WAVE_RADIO_REQ_RTS_THRESHOLD, TRUE);
+  return _mtlk_df_mtlk_to_linux_error_code(res);
+}
