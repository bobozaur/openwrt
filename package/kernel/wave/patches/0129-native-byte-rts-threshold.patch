+static BOOL
+_core_cfg_rts_supported(mtlk_core_t *core)
+{
+  return wave_hw_fw_feature_supported(mtlk_vap_get_hw(core->vap_handle),
+                                      WAVE_FW_FEATURE_RTS_THRESHOLD);
+}
+
+static int
+_core_cfg_rts_command(mtlk_core_t *core, uint8 operation, uint16 threshold,
+                      struct wave_rts_request *reply)
+{
+  mtlk_txmm_msg_t msg;
+  mtlk_txmm_data_t *entry;
+  struct wave_rts_request *req;
+  int res;
+
+  MTLK_STATIC_ASSERT(sizeof(*req) == 8);
+  if (!_core_cfg_rts_supported(core))
+    return MTLK_ERR_NOT_SUPPORTED;
+  entry = mtlk_txmm_msg_init_with_empty_data(&msg,
+              mtlk_vap_get_txmm(core->vap_handle), NULL);
+  if (!entry)
+    return MTLK_ERR_NO_RESOURCES;
+  entry->id = UM_MAN_FIXED_POWER_REQ;
+  entry->payload_size = sizeof(*req);
+  req = (void *)entry->payload;
+  memset(req, 0, sizeof(*req));
+  req->threshold = HOST_TO_MAC16(threshold);
+  req->magic = WAVE_RTS_MAGIC;
+  req->operation = operation;
+  req->status = 0xff;
+  req->abi = WAVE_RTS_ABI;
+  res = mtlk_txmm_msg_send_blocked(&msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
+  if (res == MTLK_ERR_OK) {
+    if (req->magic != WAVE_RTS_MAGIC || req->abi != WAVE_RTS_ABI ||
+        req->operation != operation || req->active > 1 ||
+        MAC_TO_HOST16(req->threshold) > WAVE_RTS_MAX ||
+        (req->pending && req->pending != WAVE_RTS_STAGE &&
+                         req->pending != WAVE_RTS_DISABLE)) {
+      res = MTLK_ERR_UNKNOWN;
+    } else {
+      switch (req->status) {
+      case 0:
+        if (req->pending ||
+            (operation != WAVE_RTS_QUERY &&
+             (req->active || MAC_TO_HOST16(req->threshold) != threshold)) ||
+            (operation == WAVE_RTS_QUERY && !req->active && req->threshold))
+          res = MTLK_ERR_UNKNOWN;
+        else if (reply)
+          *reply = *req;
+        break;
+      case 1:
+        res = MTLK_ERR_PARAMS;
+        break;
+      case 2:
+        res = MTLK_ERR_BUSY;
+        break;
+      case 4:
+        res = MTLK_ERR_NOT_READY;
+        break;
+      default:
+        res = MTLK_ERR_UNKNOWN;
+      }
+    }
+  }
+  mtlk_txmm_msg_cleanup(&msg);
+  return res;
+}
+
+static int
+_core_cfg_rts_begin(mtlk_core_t *core, uint32 threshold, unsigned switch_type,
+                    BOOL *submitted)
+{
+  struct wave_rts_request state;
+  BOOL enabled = threshold != WAVE_RTS_DISABLED;
+  int res;
+
+  *submitted = FALSE;
+  if (!_core_cfg_rts_supported(core))
+    return enabled ? MTLK_ERR_NOT_SUPPORTED : MTLK_ERR_OK;
+  res = _core_cfg_rts_command(core, WAVE_RTS_QUERY, 0, &state);
+  if (res != MTLK_ERR_OK)
+    return res;
+  if (!enabled && !state.active)
+    return MTLK_ERR_OK;
+  if (switch_type > ST_NORMAL_AFTER_RSSI)
+    return MTLK_ERR_BUSY;
+  /* Even a lost stage reply may leave a native pending tuple. */
+  *submitted = TRUE;
+  return _core_cfg_rts_command(core, enabled ? WAVE_RTS_STAGE : WAVE_RTS_DISABLE,
+                                enabled ? threshold : 0, NULL);
+}
+
+static int
+_core_cfg_rts_finish(mtlk_core_t *core, uint32 threshold)
+{
+  struct wave_rts_request state;
+  BOOL enabled = threshold != WAVE_RTS_DISABLED;
+  int res = _core_cfg_rts_command(core, WAVE_RTS_QUERY, 0, &state);
+
+  if (res != MTLK_ERR_OK)
+    return res;
+  if (state.active != enabled ||
+      MAC_TO_HOST16(state.threshold) != (enabled ? threshold : 0))
+    return MTLK_ERR_UNKNOWN;
+  return MTLK_ERR_OK;
+}
