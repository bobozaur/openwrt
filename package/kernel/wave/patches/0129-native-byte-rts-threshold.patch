+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef WAVE_RTS_THRESHOLD_H
+#define WAVE_RTS_THRESHOLD_H
+
+/* A separately typed extension of the persistent host/lower transport.
+ * Admit the actual upper route and both lower implementations before use.
+ */
+#define WAVE_RTS_ABI       1
+#define WAVE_RTS_MAGIC     0xa6
+#define WAVE_RTS_STAGE     0x90
+#define WAVE_RTS_DISABLE   0x91
+#define WAVE_RTS_QUERY     0x92
+#define WAVE_RTS_MAX       IEEE80211_MAX_RTS_THRESHOLD
+#define WAVE_RTS_DISABLED ((uint32)-1)
+struct wave_rts_request {
+  uint16 threshold; /* little endian */
+  uint8 magic;
+  uint8 operation;
+  uint8 status;
+  uint8 abi;
+  uint8 active;
+  uint8 pending;
+};
+/* STAGE publishes only pending state. Native212/45 and QUERY precede user
+ * success. Lost replies retain last-ACK radio policy and quiesce/recover.
+ * Enable selects paired RTS/CTS size protection, retaining native FORCE;
+ * disable restores latest native methods and the original selector.
+ */
+#endif
