-  uint64                  max_int_tasklet_time;  /* time between interrupt to tasklet */
-  uint64                  max_int_processed_cfm; /* time between interrupt and cfm processed */
+  atomic64_t                  max_int_tasklet_time;  /* time between interrupt to tasklet */
+  atomic64_t                  max_int_processed_cfm; /* time between interrupt and cfm processed */
 #endif
