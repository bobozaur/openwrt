+#ifdef MTLK_DEBUG
+/* IRQ timestamps and maxima cross hardirq/tasklet/control contexts on 32-bit
+ * hosts. Monotonic atomic64 values avoid clock steps and torn snapshots.
+ */
+static void wave_hw_stamp_data_irq(mtlk_hw_t *hw, uint32 pending)
+{
+  uint64 now = ktime_get_ns();
+
+  if (pending & MTLK_IRQ_TXOUT)
+    atomic64_set(&hw->tx_interrupt_time_ns, now);
+  if (pending & MTLK_IRQ_RX)
+    atomic64_set(&hw->rx_interrupt_time_ns, now);
+}
+
+static uint64 wave_hw_data_irq_time(mtlk_irq_handler_data *ihd, uint32 type)
+{
+  mtlk_hw_t *hw = ihd->hw;
+  uint32 pending = hw->irq_mode == MTLK_IRQ_MODE_LEGACY ?
+                   ihd->status : ihd->irq_no;
+
+  /* The shared tasklet also visits rings that did not raise this IRQ. */
+  if (!(pending & type))
+    return 0;
+  return atomic64_read(type == MTLK_IRQ_TXOUT ?
+                       &hw->tx_interrupt_time_ns : &hw->rx_interrupt_time_ns);
+}
+
+static void wave_hw_update_irq_delay(atomic64_t *maximum, uint64 started)
+{
+  uint64 now, elapsed;
+  s64 previous;
+
+  if (!started)
+    return;
+  now = ktime_get_ns();
+  if (now < started)
+    return;
+  elapsed = now - started;
+  previous = atomic64_read(maximum);
+  while (elapsed > (uint64)previous &&
+         !atomic64_try_cmpxchg(maximum, &previous, elapsed))
+    ;
+}
+#endif
