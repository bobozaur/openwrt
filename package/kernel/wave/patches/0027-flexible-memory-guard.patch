Subject: [PATCH] declare the allocation guard as a flexible array

--- a/wireless/shared/mem_leak.c
+++ b/wireless/shared/mem_leak.c
@@ -40,7 +40,7 @@
 {
   mtlk_objpool_context_t objpool_ctx;
   uint32 size;
-  uint8  front_guard[1]; /* The actual length is FRONT_GUARD_LEN, to have the total struct size MTLK_MEM_ALLOC_ALIGN */
+  uint8  front_guard[]; /* The actual length is FRONT_GUARD_LEN, to have the total struct size MTLK_MEM_ALLOC_ALIGN */
 };
 
 #define MIN_BACK_GUARD_SIZE (4)          /* The minimum number of back guard characters */
