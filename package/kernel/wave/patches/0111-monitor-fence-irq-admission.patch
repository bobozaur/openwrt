Subject: [PATCH] wave: close restart IRQ admission before draining handlers

A shared interrupt can still invoke the driver after PCI INTx is disabled.
The restartable monitor fence must reject such calls before joining IRQs and
tasklets, and prevent a finishing tasklet or interrupt-recovery timer from
re-enabling device interrupts across reset. Terminal quiescing already has
this admission boundary; keep its irreversible semantics.

Track restart IRQ admission separately from the completed DMA/reset fence.
Reopen it under the register lock only after fresh tasklets and PCI DMA have
been restored successfully, before starting firmware CPUs. Apply the same
admission check to both legacy and MSI handlers.

--- a/wireless/driver/shared/hw_mmb.c
+++ b/wireless/driver/shared/hw_mmb.c
@@ -869,6 +869,7 @@
   u32                   fw_features;
   bool                  monitor_dirty;
   bool                  monitor_fenced;
+  bool                  monitor_irqs_blocked; /* protected by reg_lock */
   bool                  monitor_tx_enabled; /* protected by BSS tx_bdr.lock */
   mtlk_ccr_t            *ccr;
   mtlk_hw_mmb_t         *mmb;
@@ -7493,6 +7494,9 @@
   }
   wave_hw_monitor_disable_tx(hw);
   flags = mtlk_osal_lock_acquire_irq(&hw->reg_lock);
+  /* Shared IRQs can still call our handler after PCI INTx is disabled.
+   * Close admission before the join; monitor_fenced means reset completed. */
+  hw->monitor_irqs_blocked = true;
   WRITE_ONCE(hw->state, MTLK_HW_STATE_APPFATAL);
   _mtlk_mmb_stop_events_completely(hw);
   mtlk_ccr_disable_interrupts(hw->ccr, MTLK_IRQ_ALL);
@@ -7778,6 +7782,7 @@
   mutex_init(&hw->quiesce_lock);
   spin_lock_init(&hw->monitor_lock);
   hw->quiescing = false;
+  hw->monitor_irqs_blocked = false;
 
   hw->mmb_base = mmb_pas;
 
@@ -10347,6 +10352,10 @@
 
   lock = mtlk_osal_lock_acquire_irq(&hw->reg_lock);
 
+  if (hw->quiescing || hw->monitor_irqs_blocked) {
+    mtlk_osal_lock_release_irq(&hw->reg_lock, lock);
+    return 0;
+  }
   irq_status = mtlk_ccr_is_interrupt_pending(hw->ccr);
   if (irq_status == 0xFFFFFFFF ) {
     /* PCIE bus stuck is detected. Do not reschedule timer */
@@ -10409,6 +10418,7 @@
 mtlk_hw_mmb_interrupt_handler_msi (mtlk_irq_handler_data *ihd)
 {
   mtlk_hw_t    *hw;
+  mtlk_handle_t lock;
   MTLK_ASSERT(NULL != ihd);
 
   hw = ihd->hw;
@@ -10416,10 +10426,16 @@
   MTLK_ASSERT(NULL != hw);
   MTLK_ASSERT(NULL != hw->ccr);
 
+  lock = mtlk_osal_lock_acquire_irq(&hw->reg_lock);
+  if (hw->quiescing || hw->monitor_irqs_blocked) {
+    mtlk_osal_lock_release_irq(&hw->reg_lock, lock);
+    return MTLK_ERR_UNKNOWN;
+  }
 #ifdef MTLK_DEBUG
   wave_hw_stamp_data_irq(hw, ihd->irq_no);
 #endif
   hw->perform_isr_action(hw, ihd);
+  mtlk_osal_lock_release_irq(&hw->reg_lock, lock);
   return MTLK_ERR_OK;
 }
 
@@ -10438,7 +10454,7 @@
 
   lock = mtlk_osal_lock_acquire_irq(&hw->reg_lock);
 
-  if (hw->quiescing) {
+  if (hw->quiescing || hw->monitor_irqs_blocked) {
     mtlk_osal_lock_release_irq(&hw->reg_lock, lock);
     return MTLK_ERR_UNKNOWN;
   }
@@ -10493,7 +10509,7 @@
 /* TODO: make a CPU optimization in IRQ_ENABLE_OR_RESCHEDULE (return rescheduling of tasklet) */
 #define IRQ_ENABLE_OR_RESCHEDULE(ihd){ \
     mtlk_handle_t lock_val = mtlk_osal_lock_acquire_irq(&ihd->hw->reg_lock); \
-    if (!ihd->hw->quiescing) \
+    if (!ihd->hw->quiescing && !ihd->hw->monitor_irqs_blocked) \
       mtlk_ccr_enable_interrupts(ihd->hw->ccr, ihd->irq_no); \
     MTLK_TRACER_ADD_ENTRY(ihd->hw, MTLK_TR_INTR_ENABLE_INT, ihd->irq_no); \
     mtlk_osal_lock_release_irq(&ihd->hw->reg_lock, lock_val); }
@@ -10789,10 +10805,17 @@
   }
 
   if (hw->monitor_fenced) {
+    mtlk_handle_t flags;
+
     res = wave_mmb_drv_restart_dma(mtlk_ccr_get_device(hw->ccr));
     if (res != MTLK_ERR_OK)
       return res;
+    /* Fresh tasklets and PCI admission are ready; firmware CPUs are still
+     * reset. Bootstrap IRQs may now run the existing initialization action. */
+    flags = mtlk_osal_lock_acquire_irq(&hw->reg_lock);
+    hw->monitor_irqs_blocked = false;
     WRITE_ONCE(hw->monitor_fenced, false);
+    mtlk_osal_lock_release_irq(&hw->reg_lock, flags);
   }
   _mtlk_mmb_run_firmware(hw);
 
