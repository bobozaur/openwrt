-  MTLK_CLPB_END
+  if (!addr || addr_size != sizeof(*addr))
+    return MTLK_ERR_PARAMS;
+
+  /* Reserve both reply records before firmware can allocate the SID. */
+  reply = mtlk_osal_mem_alloc(sizeof(*reply), MTLK_MEM_TAG_CLPB);
+  if (!reply)
+    return MTLK_ERR_NO_MEM;
+  res = mtlk_clpb_push_nocopy(clpb, reply, sizeof(*reply));
+  if (res != MTLK_ERR_OK) {
+    mtlk_osal_mem_free(reply);
+    return res;
+  }
+  sid = mtlk_osal_mem_alloc(sizeof(*sid), MTLK_MEM_TAG_CLPB);
+  if (!sid)
+    return MTLK_ERR_NO_MEM;
+  res = mtlk_clpb_push_nocopy(clpb, sid, sizeof(*sid));
+  if (res != MTLK_ERR_OK) {
+    mtlk_osal_mem_free(sid);
+    return res;
+  }
+  *sid = DB_UNKNOWN_SID;
+
+  if (mtlk_vap_is_ap(nic->vap_handle) &&
+      !mtlk_mmb_is_sync_hostapd_done(mtlk_vap_get_hw(nic->vap_handle))) {
+    *reply = MTLK_ERR_NOT_READY;
+  } else if (_core_cfg_check_sid_connected(nic, addr)) {
+    *reply = MTLK_ERR_ALREADY_EXISTS;
+  } else {
+    *reply = core_cfg_internal_request_sid(nic, addr, sid);
+    /* Lost command acknowledgement cannot permit a new SID admission. */
+    if (*reply != MTLK_ERR_OK && *reply != MTLK_ERR_NO_MEM &&
