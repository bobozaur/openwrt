@@ -7009,6 +7026,48 @@
 _mtlk_hw_is_sid_valid (mtlk_hw_t *hw, uint32 sid)
 {
     return (sid < __mtlk_hw_get_max_sid(hw));
+}
+
+uint64 __MTLK_IFUNC
+wave_hw_stats_sta_connected (mtlk_hw_t *hw, uint32 sid)
+{
+    uint64 generation = 0;
+
+    MTLK_STATIC_ASSERT(GEN5_MAX_SID <= GEN6_MAX_SID);
+    mtlk_osal_mutex_acquire(&hw->phy_rx_status.mutex);
+    if (_mtlk_hw_is_sid_valid(hw, sid)) {
+        if (++hw->stats_generation == 0)
+            ++hw->stats_generation;
+        generation = hw->stats_generation;
+        hw->sta_stats_generation[sid] = generation;
+    }
+    mtlk_osal_mutex_release(&hw->phy_rx_status.mutex);
+    return generation;
+}
+
+void __MTLK_IFUNC
+wave_hw_stats_sta_disconnected (mtlk_hw_t *hw, uint32 sid, uint64 generation)
+{
+    mtlk_osal_mutex_acquire(&hw->phy_rx_status.mutex);
+    if (_mtlk_hw_is_sid_valid(hw, sid) && generation &&
+        hw->sta_stats_generation[sid] == generation)
+        hw->sta_stats_generation[sid] = 0;
+    mtlk_osal_mutex_release(&hw->phy_rx_status.mutex);
+}
+
+static void
+_wave_hw_stats_reset_lifetime (mtlk_hw_t *hw)
+{
+    /* Native recovery has stopped the old firmware and its DMA producers. */
+    mtlk_osal_mutex_acquire(&hw->phy_rx_status.mutex);
+    mtlk_osal_lock_acquire(&hw->hw_mhi_stats.lock);
+    memset(hw->sta_stats_generation, 0, sizeof(hw->sta_stats_generation));
+    hw->hw_mhi_stats.sta_generation = 0;
+    memset(hw->hw_mhi_stats.db_copy, 0, hw->hw_mhi_stats.db_size);
+    hw->phy_rx_status.sta_generation = 0;
+    hw->phy_rx_status.valid = FALSE;
+    mtlk_osal_lock_release(&hw->hw_mhi_stats.lock);
+    mtlk_osal_mutex_release(&hw->phy_rx_status.mutex);
 }
 
