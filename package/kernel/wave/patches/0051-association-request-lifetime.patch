Subject: [PATCH] preserve pending association metadata across peer replacement

Hostapd removes an existing protected peer before adding its replacement.
The metadata captured from the new association request must survive that
removal. Consume the request atomically when adding the replacement and
retain AP-stop invalidation and bounded expiry. This also prevents a late
add completion from deleting metadata for a newer request.

--- a/wireless/driver/linux/mtlk_df_user.c
+++ b/wireless/driver/linux/mtlk_df_user.c
@@ -9431,7 +9431,7 @@
   spin_unlock_irqrestore(&df_user->assoc_lock, flags);
 }
 
-bool wave_df_assoc_get(mtlk_df_user_t *df_user, const u8 *mac,
+bool wave_df_assoc_take(mtlk_df_user_t *df_user, const u8 *mac,
                        struct wave_assoc_metadata *metadata)
 {
   unsigned long flags;
@@ -9440,9 +9440,10 @@
 
   spin_lock_irqsave(&df_user->assoc_lock, flags);
   for (i = 0; i < ARRAY_SIZE(df_user->assoc_metadata); i++) {
-    const struct wave_assoc_metadata *entry = &df_user->assoc_metadata[i];
+    struct wave_assoc_metadata *entry = &df_user->assoc_metadata[i];
     if (ether_addr_equal(entry->mac, mac) && time_before(jiffies, entry->expires)) {
       *metadata = *entry;
+      memset(entry, 0, sizeof(*entry));
       found = true;
       break;
     }
@@ -9451,17 +9452,12 @@
   return found;
 }
 
-void wave_df_assoc_forget(mtlk_df_user_t *df_user, const u8 *mac)
+void wave_df_assoc_clear(mtlk_df_user_t *df_user)
 {
   unsigned long flags;
-  unsigned int i;
 
   spin_lock_irqsave(&df_user->assoc_lock, flags);
-  for (i = 0; i < ARRAY_SIZE(df_user->assoc_metadata); i++) {
-    struct wave_assoc_metadata *entry = &df_user->assoc_metadata[i];
-    if (!mac || ether_addr_equal(entry->mac, mac))
-      memset(entry, 0, sizeof(*entry));
-  }
+  memset(df_user->assoc_metadata, 0, sizeof(df_user->assoc_metadata));
   spin_unlock_irqrestore(&df_user->assoc_lock, flags);
 }
 
--- a/wireless/driver/linux/mtlk_df_user_priv.h
+++ b/wireless/driver/linux/mtlk_df_user_priv.h
@@ -711,11 +711,14 @@
   bool pbac;
   unsigned long expires;
 };
+/* Pending receive metadata belongs to the association request, independently
+ * of an installed peer. Peer/key removal preserves it; add consumes it once,
+ * and BSS stop clears all pending requests. Entries expire after 30 seconds. */
 void wave_df_assoc_record(mtlk_df_user_t *df_user,
                           const struct wave_assoc_metadata *metadata);
-bool wave_df_assoc_get(mtlk_df_user_t *df_user, const u8 *mac,
+bool wave_df_assoc_take(mtlk_df_user_t *df_user, const u8 *mac,
                        struct wave_assoc_metadata *metadata);
-void wave_df_assoc_forget(mtlk_df_user_t *df_user, const u8 *mac);
+void wave_df_assoc_clear(mtlk_df_user_t *df_user);
 
 void wave_df_tx_queue_start(mtlk_df_user_t *df_user);
 void wave_df_tx_queue_stop(mtlk_df_user_t *df_user);
--- a/wireless/driver/linux/wave_radio.c
+++ b/wireless/driver/linux/wave_radio.c
@@ -2285,7 +2285,7 @@
     mtlk_osal_msleep(100);
   }
   if (res == MTLK_ERR_OK)
-    wave_df_assoc_forget(df_user, NULL);
+    wave_df_assoc_clear(df_user);
 
 finish:
   if (scan_paused == 1 && _wave_radio_allow_or_resume_scan(radio) != MTLK_ERR_OK)
@@ -2459,7 +2459,7 @@
   /* This AP does not advertise pre-association station creation. */
   if (!params->aid || params->aid > IEEE80211_MAX_AID)
     return MTLK_ERR_PARAMS;
-  if (!wave_df_assoc_get(df_user, mac, &metadata))
+  if (!wave_df_assoc_take(df_user, mac, &metadata))
     return MTLK_ERR_NOT_READY;
   info->bss_coex_20_40 = metadata.coexistence;
   info->vendor = metadata.vendor;
@@ -2602,15 +2602,12 @@
 
   res = _wave_radio_sta_param_process(ndev, mac, params, &info);
   if (MTLK_ERR_OK != res) {
-    ELOG_S("%s: Error parsing parameters", ndev->name);
-    res = MTLK_ERR_PARAMS;
+    ELOG_SD("%s: Station parameters unavailable or invalid (%d)", ndev->name, res);
     goto finish;
   }
 
   res = _mtlk_df_user_invoke_core(mtlk_df_user_get_df(df_user), WAVE_CORE_REQ_AP_CONNECT_STA, &clpb, &info, sizeof(info));
   res = _mtlk_df_user_process_core_retval(res, clpb, WAVE_CORE_REQ_AP_CONNECT_STA, TRUE);
-  if (res == MTLK_ERR_OK)
-    wave_df_assoc_forget(df_user, mac);
 
 finish:
   return _mtlk_df_mtlk_to_linux_error_code(res);
@@ -2701,8 +2698,8 @@
     res = _mtlk_df_user_process_core_retval(res, clpb, WAVE_CORE_REQ_AP_DISCONNECT_STA, TRUE);
   }
 
-  if (res == MTLK_ERR_OK)
-    wave_df_assoc_forget(df_user, mtlk_osal_eth_is_broadcast(addr) ? NULL : addr);
+  if (res == MTLK_ERR_OK && mtlk_osal_eth_is_broadcast(addr))
+    wave_df_assoc_clear(df_user);
 
 finish:
   return _mtlk_df_mtlk_to_linux_error_code(res);
--- a/wireless/driver/linux/cfg80211.c
+++ b/wireless/driver/linux/cfg80211.c
@@ -632,7 +632,7 @@
     pmf->enabled = elems.rsne_capab && (get_unaligned_le16(elems.rsne_capab) & BIT(7));
     spin_unlock_irqrestore(&pmf->lock, flags);
   }
-  wave_df_assoc_forget(df_user, NULL);
+  wave_df_assoc_clear(df_user);
   wave_df_notifications_start_locked(df_user);
   res = wave_radio_ap_start(wiphy, cfg80211->radio, ndev, info);
   if (res)
@@ -1236,10 +1236,9 @@
     return _mtlk_df_mtlk_to_linux_error_code(res);
   }
   if (removed == WAVE_KEY_PEER_REMOVED) {
-    wave_df_assoc_forget(df_user, mac_addr);
     cfg80211_del_sta(wdev, mac_addr, GFP_KERNEL);
   } else if (removed == WAVE_KEY_VAP_REMOVED) {
