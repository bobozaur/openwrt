From: OpenWrt WAVE maintainers
Subject: [PATCH] wave: read statistics status before releasing its TXMM payload

TXMM cleanup returns the response payload to the shared message pool. Validate
and log the firmware status while the message still owns that storage, then
unconditionally release it before publishing a successful statistics snapshot.
A transport failure continues to bypass the unconfirmed response status.

--- a/wireless/driver/shared/hw_mmb.c
+++ b/wireless/driver/shared/hw_mmb.c
@@ -6209,14 +6209,14 @@
                               dma_addr, mhi_stats->db_size,
                               MTLK_DATA_FROM_DEVICE);
 
-    mtlk_txmm_msg_cleanup(&man_msg);
-
     if (res != MTLK_ERR_OK) {
         ELOG_DD("card_idx %d: Sending failed, err=%i", hw->card_idx, res);
     } else if (UMI_OK != req->u8status) {
         ELOG_D("Failed to retrieve MHI statistics, error %d", req->u8status);
         res = MTLK_ERR_MAC;
     }
+
+    mtlk_txmm_msg_cleanup(&man_msg);
 
     if (res == MTLK_ERR_OK) {
         mtlk_osal_lock_acquire(&mhi_stats->lock);
