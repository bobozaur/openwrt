Subject: [PATCH] wave: preserve four-address AP VLAN admission and requested MACs

Keep the AP four-address flag after the legacy capability mask. Advertise MAC on
create only with an implemented AP MAC setter before netdevice registration;
this also allows nl80211 to pass the explicit parent MAC to software AP VLAN
creation. Unwind a failed MAC update through the existing VAP owner.

--- a/wireless/driver/linux/cfg80211.c
+++ b/wireless/driver/linux/cfg80211.c
@@ -410,7 +410,8 @@
    * allocated net_device and we only need to set it in df_user ) */
   mbss_cfg.ndev = NULL;
 
-  return (struct wireless_dev *)wave_radio_virtual_interface_add(cfg80211->radio, &mbss_cfg, iftype);
+  return (struct wireless_dev *)wave_radio_virtual_interface_add(cfg80211->radio, &mbss_cfg, iftype,
+                      is_zero_ether_addr(params->macaddr) ? NULL : params->macaddr);
 }
 
 static struct wireless_dev * API_WRAPPER(_wave_cfg80211_op_add_virtual_iface) (
@@ -2121,7 +2122,6 @@
 #if !MTLK_USE_DIRECTCONNECT_DP_API && !MTLK_USE_PUMA6_UDMA
   wiphy->interface_modes |= BIT(NL80211_IFTYPE_AP_VLAN);
   wiphy->software_iftypes |= BIT(NL80211_IFTYPE_AP_VLAN);
-  wiphy->flags |= WIPHY_FLAG_4ADDR_AP;
 #endif
   wv_cfg80211_sysfs_init(wiphy);
 
@@ -2224,6 +2224,9 @@
 #endif
     );
 
+#if !MTLK_USE_DIRECTCONNECT_DP_API && !MTLK_USE_PUMA6_UDMA
+  wiphy->flags |= WIPHY_FLAG_4ADDR_AP;
+#endif
   /* FIXCFG80211: Unset TMP or TBD */
   wiphy->flags &= ~(WIPHY_FLAG_CONTROL_PORT_PROTOCOL |
 #if LINUX_VERSION_CODE < KERNEL_VERSION(3, 14, 0)
@@ -2233,8 +2236,10 @@
                     WIPHY_FLAG_NETNS_OK |
                     WIPHY_FLAG_PS_ON_BY_DEFAULT);
 
-  /* set WIPHY features */
-  wiphy->features = (NL80211_FEATURE_SK_TX_STATUS |
+  /* AP creation applies its MAC before registration; AP_VLAN uses it to
+   * select the active parent on this wiphy. */
+  wiphy->features = (NL80211_FEATURE_MAC_ON_CREATE |
+                     NL80211_FEATURE_SK_TX_STATUS |
                      NL80211_FEATURE_AP_MODE_CHAN_WIDTH_CHANGE |
                      NL80211_FEATURE_STATIC_SMPS
     );
--- a/wireless/driver/linux/wave_radio.c
+++ b/wireless/driver/linux/wave_radio.c
@@ -1828,7 +1828,8 @@
 void *wave_radio_virtual_interface_add(
   wave_radio_t *radio,
   mtlk_mbss_cfg_t *mbss_cfg,
-  enum nl80211_iftype iftype)
+  enum nl80211_iftype iftype,
+  const u8 *macaddr)
 {
   int res = MTLK_ERR_OK;
   mtlk_clpb_t *clpb = NULL;
@@ -1870,10 +1871,13 @@
     if (!IS_ERR(wdev)) {
       struct wireless_dev *new_wdev = wdev;
       df_user = mtlk_df_user_from_ndev(new_wdev->netdev);
-      res = wave_df_register_netdev_locked(df_user);
+      if (macaddr)
+        res = wave_df_user_set_mac_addr(df_user, macaddr);
+      if (!res)
+        res = wave_df_register_netdev_locked(df_user);
       if (res) {
         mtlk_vap_handle_t vap = mtlk_df_get_vap_handle(mtlk_df_user_get_df(df_user));
-        /* Registration failed, but the radio manager already owns this VAP. */
+        /* MAC setup/registration failed; the radio manager owns this VAP. */
         wave_core_delete_vap(vap);
         wdev = ERR_PTR(res);
       }
--- a/wireless/driver/linux/wave_radio.h
+++ b/wireless/driver/linux/wave_radio.h
@@ -157,7 +157,8 @@
 int   wave_radio_vap_handle_get (wave_radio_t *radio, mtlk_vap_handle_t  *vap_handle);
 void *wave_radio_beacon_man_private_get(wave_radio_t *radio);
 
-void *wave_radio_virtual_interface_add(wave_radio_t *radio, mtlk_mbss_cfg_t *mbss_cfg, enum nl80211_iftype iftype);
+void *wave_radio_virtual_interface_add(wave_radio_t *radio, mtlk_mbss_cfg_t *mbss_cfg,
+                                      enum nl80211_iftype iftype, const u8 *macaddr);
 int wave_radio_virtual_interface_del(wave_radio_t *radio, struct net_device *ndev);
 int wave_radio_virtual_interface_change(struct net_device *ndev, enum nl80211_iftype iftype);
 /* Radio-level cfg80211/mac80211 power control; all firmware work is serialized.
--- a/wireless/driver/linux/mtlk_df_user.c
+++ b/wireless/driver/linux/mtlk_df_user.c
@@ -2429,6 +2429,14 @@
 _mtlk_df_user_set_mac_addr (struct net_device *ndev, void* p)
 {
   return _mtlk_df_user_set_mac_addr_internal(ndev, (struct sockaddr *)p);
+}
+
+int wave_df_user_set_mac_addr(mtlk_df_user_t *df_user, const u8 *macaddr)
+{
+  struct sockaddr addr = { .sa_family = ARPHRD_ETHER };
+
+  ether_addr_copy((u8 *)addr.sa_data, macaddr);
+  return _mtlk_df_user_set_mac_addr_internal(df_user->ndev, &addr);
 }
 
 int __MTLK_IFUNC
--- a/wireless/driver/linux/mtlk_df_user_priv.h
+++ b/wireless/driver/linux/mtlk_df_user_priv.h
@@ -741,6 +741,7 @@
 void wave_df_tx_queue_start(mtlk_df_user_t *df_user);
 void wave_df_tx_queue_stop(mtlk_df_user_t *df_user);
 int wave_df_register_netdev_locked(mtlk_df_user_t *df_user);
+int wave_df_user_set_mac_addr(mtlk_df_user_t *df_user, const u8 *macaddr);
 void wave_df_unregister_netdev_locked(mtlk_df_user_t *df_user);
 void mtlk_df_user_handle_radar_event(mtlk_df_user_t *df_user,
     struct wireless_dev *wdev, struct mtlk_chan_def *mcd,
