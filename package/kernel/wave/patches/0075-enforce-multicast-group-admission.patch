 }
 
+/* Group IDs are shared by all VAPs of this hardware. Match semantic keys,
+ * and admit the requested ID under the same lock as reference changes. A
+ * failed request must leave every existing owner and reference unchanged. */
+static BOOL
+_mtlk_hw_mc_addr_equal (const mtlk_mc_addr_t *a, const mtlk_mc_addr_t *b)
+{
+  if (a->type != b->type)
+    return FALSE;
+  if (a->type == MTLK_IPv4)
+    return a->src_ip.ip4_addr.s_addr == b->src_ip.ip4_addr.s_addr &&
+           a->grp_ip.ip4_addr.s_addr == b->grp_ip.ip4_addr.s_addr;
+  return !memcmp(&a->src_ip.ip6_addr, &b->src_ip.ip6_addr, sizeof(struct in6_addr)) &&
+         !memcmp(&a->grp_ip.ip6_addr, &b->grp_ip.ip6_addr, sizeof(struct in6_addr));
+}
+
+static int
+_mtlk_hw_mc_group_action (mtlk_hw_t *hw, mtlk_core_ui_mc_grid_action_t *req)
+{
+  mtlk_hw_mc_t *group;
+  int i, first_free = 0, found = MC_GROUPS;
+  int res = MTLK_ERR_VALUE;
+  uint8 requested = req->grp_id;
+
+  req->grp_id = MCAST_GROUP_UNDEF;
+  if (req->action != MTLK_GRID_ADD && req->action != MTLK_GRID_DEL)
+    return res;
+  /* An undefined deletion owns no reference, even if the key exists. */
+  if (req->action == MTLK_GRID_DEL && requested == MCAST_GROUP_UNDEF)
+    return MTLK_ERR_OK;
+  if ((requested != MCAST_GROUP_UNDEF &&
+       (requested < MC_MIN_GROUP || requested >= MC_GROUPS)) ||
+      (req->mc_addr.type != MTLK_IPv4 && req->mc_addr.type != MTLK_IPv6))
+    return res;
+
+  mtlk_osal_lock_acquire(&hw->mc_group_lock);
+  for (i = MC_MIN_GROUP; i < MC_GROUPS; i++) {
+    if (hw->mc_groups[i].ref_cnt) {
+      if (_mtlk_hw_mc_addr_equal(&hw->mc_groups[i].mc_addr, &req->mc_addr))
+        found = i;
+    } else if (!first_free) {
+      first_free = i;
+    }
+  }
+
+  if (found != MC_GROUPS) {
+    if (requested != MCAST_GROUP_UNDEF && requested != found)
+      goto out;
+    group = &hw->mc_groups[found];
+    if (req->action == MTLK_GRID_ADD) {
+      if (group->ref_cnt == (uint32)~0U) {
+        res = MTLK_ERR_NO_RESOURCES;
+        goto out;
+      }
+      group->ref_cnt++;
+    } else {
+      if (!--group->ref_cnt)
+        memset(group, 0, sizeof(*group));
+    }
+    req->grp_id = found;
+    res = MTLK_ERR_OK;
+    goto out;
+  }
+
+  if (req->action == MTLK_GRID_DEL)
+    goto out;
+  if (requested != MCAST_GROUP_UNDEF) {
+    if (hw->mc_groups[requested].ref_cnt)
+      goto out;
+    first_free = requested;
+  }
+  if (!first_free) {
+    res = MTLK_ERR_NO_RESOURCES;
+    goto out;
+  }
+
+  group = &hw->mc_groups[first_free];
+  memset(group, 0, sizeof(*group));
+  group->mc_addr.type = req->mc_addr.type;
+  if (req->mc_addr.type == MTLK_IPv4) {
+    group->mc_addr.src_ip.ip4_addr = req->mc_addr.src_ip.ip4_addr;
+    group->mc_addr.grp_ip.ip4_addr = req->mc_addr.grp_ip.ip4_addr;
+  } else {
+    group->mc_addr.src_ip.ip6_addr = req->mc_addr.src_ip.ip6_addr;
+    group->mc_addr.grp_ip.ip6_addr = req->mc_addr.grp_ip.ip6_addr;
+  }
+  group->ref_cnt = 1;
+  req->grp_id = first_free;
+  res = MTLK_ERR_OK;
+out:
+  mtlk_osal_lock_release(&hw->mc_group_lock);
+  return res;
+}
