Subject: [PATCH] wave: preserve native HE BSS operation parameters

--- a/wireless/driver/linux/beacon_manager.c
+++ b/wireless/driver/linux/beacon_manager.c
@@ -456,6 +456,7 @@
 
   /* Native HE elements were validated before publishing any template. */
   wave_pdb_set_int(param_db_core, PARAM_DB_CORE_TWT_OPERATION_MODE, 0);
+  wave_pdb_set_int(param_db_core, PARAM_DB_CORE_HE_BSS_COLOR, he->color);
   wave_pdb_set_binary(param_db_core, PARAM_DB_CORE_HE_MCS_NSS,
                       he->mcs, sizeof(he->mcs));
   if (he->enabled)
@@ -586,6 +587,24 @@
     if (wave_he_parse_ap_beacon(&he, beacon_data->tail, beacon_data->tail_len))
       MTLK_CLPB_EXIT(MTLK_ERR_PARAMS);
 
+    /* Live color transitions are not advertised. Normal configuration changes
+     * restart the BSS. Reject before publishing probe responses or changing
+     * PDB state, since the beacon queue can defer its firmware submission.
+     */
+    if (beacon_data->tail &&
+        mtlk_core_get_net_state(core) == NET_STATE_CONNECTED) {
+      mtlk_pdb_t *pdb = mtlk_vap_get_param_db(core->vap_handle);
+      unsigned char mcs[8];
+      mtlk_pdb_size_t mcs_len = sizeof(mcs);
+      unsigned int flags = wave_pdb_get_int(pdb, PARAM_DB_CORE_SET_BSS_FLAGS);
+
+      if (wave_pdb_get_binary(pdb, PARAM_DB_CORE_HE_MCS_NSS, mcs, &mcs_len) ||
+          he.enabled != MTLK_BFIELD_GET(flags, VAP_ADD_FLAGS_HE) ||
+          he.color != wave_pdb_get_int(pdb, PARAM_DB_CORE_HE_BSS_COLOR) ||
+          memcmp(he.mcs, mcs, sizeof(mcs)))
+        MTLK_CLPB_EXIT(MTLK_ERR_NOT_SUPPORTED);
+    }
+
     if (beacon_data->probe_resp && beacon_data->probe_resp_len) /* if a new probe resp template is provided */
     {
       u8 *probe_resp_templ = mtlk_osal_mem_alloc(beacon_data->probe_resp_len, MTLK_MEM_TAG_BEACON_MNGR);
--- a/wireless/driver/linux/cfg80211.c
+++ b/wireless/driver/linux/cfg80211.c
@@ -491,10 +491,14 @@
 {
   wv_cfg80211_t *cfg80211 = wiphy_priv(wiphy);
   MTLK_ASSERT(NULL != cfg80211);
-  if (beacon->he_bss_color_valid &&
-      (!beacon->he_bss_color.enabled || beacon->he_bss_color.partial ||
-       beacon->he_bss_color.color != 4))
-    return -EOPNOTSUPP;
+  struct wave_he_ap_beacon he;
+
+  if (beacon->tail &&
+      (wave_he_parse_ap_beacon(&he, beacon->tail, beacon->tail_len) ||
+       (beacon->he_bss_color_valid &&
+        (beacon->he_bss_color.partial ||
+         he.color != (beacon->he_bss_color.enabled ? beacon->he_bss_color.color : 0)))))
+    return -EINVAL;
   return wave_radio_beacon_change(cfg80211->radio, ndev, beacon);
 }
 
@@ -563,8 +567,8 @@
   if (wave_he_parse_ap_beacon(&he, info->beacon.tail, info->beacon.tail_len) ||
       (!!info->he_cap != !!he.enabled) ||
       (info->beacon.he_bss_color_valid &&
-       (!info->beacon.he_bss_color.enabled || info->beacon.he_bss_color.partial ||
-        info->beacon.he_bss_color.color != 4)))
+       (info->beacon.he_bss_color.partial ||
+        he.color != (info->beacon.he_bss_color.enabled ? info->beacon.he_bss_color.color : 0))))
     return -EINVAL;
   wave_df_assoc_forget(df_user, NULL);
   wave_df_notifications_start_locked(df_user);
--- a/wireless/driver/linux/core.c
+++ b/wireless/driver/linux/core.c
@@ -84,7 +84,6 @@
 
 #define MTLK_CORE_WIDAN_UNCONNECTED_STATION_RATE     140
 
-#define HE_BSS_COLOR   4
 static void
 __log_set_mib_item(uint32 line, uint32 oid, uint32 mibid, uint32 val)
 {
@@ -2507,7 +2506,7 @@
       memset(req->u8HE_Mcs_Nss, 0xff, sizeof(req->u8HE_Mcs_Nss));
       wave_pdb_get_binary(param_db_core, PARAM_DB_CORE_HE_MCS_NSS, &req->u8HE_Mcs_Nss, &mcs_len);
       mtlk_dump(1, &req->u8HE_Mcs_Nss, mcs_len, "dump of u8HE_Mcs_Nss:");
-	  req->u8HE_Bss_Color = HE_BSS_COLOR;
+      req->u8HE_Bss_Color = wave_pdb_get_int(param_db_core, PARAM_DB_CORE_HE_BSS_COLOR);
     }
 }
 
@@ -2587,7 +2586,6 @@
       ILOG2_V("NOT setting twt_operation_mode due to lack of support in FW");
     }
 #endif
-    req->u8HE_Bss_Color = HE_BSS_COLOR;
     ILOG1_D("UMI_SET_BSS->u8HE_Bss_Color:%d", req->u8HE_Bss_Color);
 
     finish_and_prevent_fw_set_chan(context_core, TRUE); /* set_bss is a "process", so need this; core is the core on which we're running */
@@ -2669,18 +2667,19 @@
     wave_pdb_set_int(param_db_core, PARAM_DB_CORE_AP_FORWARDING, FALSE);
   }
 
-  /* Propagate down the he_bss_color to FW via param db */
-  wave_pdb_set_int(param_db_core, PARAM_DB_CORE_HE_BSS_COLOR, params->he_bss_color);
-
   /* Fill UMI_SET_BSS FW request */
   _mtlk_core_fill_set_bss_request(core, &fw_request, params);
+  if (!mtlk_vap_is_ap(core->vap_handle))
+    fw_request.u8HE_Bss_Color = params->he_bss_color;
 
   /* Process UM_BSS_SET_BSS_REQ */
   res = mtlk_core_set_bss(core, master_core, &fw_request);
 
   /* Update params db */
-  if (MTLK_ERR_OK == res)
-      _mtlk_core_update_bss_params(core, &fw_request, params);
+  if (MTLK_ERR_OK == res) {
+    _mtlk_core_update_bss_params(core, &fw_request, params);
+    wave_pdb_set_int(param_db_core, PARAM_DB_CORE_HE_BSS_COLOR, fw_request.u8HE_Bss_Color);
+  }
 
 end:
   return res;
@@ -11613,6 +11612,8 @@
   bp.ht_opmode = bss_change_params->info->ht_operation_mode;
   bp.p2p_ctwindow = bss_change_params->info->p2p_noa_attr.oppps_ctwindow;
   bp.p2p_opp_ps = 0;
+  bp.he_bss_color = bss_change_params->info->he_bss_color.enabled ?
+                     bss_change_params->info->he_bss_color.color : 0;
 
   for_each_set_bit(i, &basic_rates, BITS_PER_LONG) {
     bp.basic_rates[bp.basic_rates_len++] =
@@ -11646,7 +11647,8 @@
       MTLK_CLPB_EXIT(MTLK_ERR_RETRY);
     }
 
-    if ((bss_change_params->changed & BSS_CHANGED_BASIC_RATES) ||
+    if ((bss_change_params->changed & BSS_CHANGED_HE_BSS_COLOR) ||
+        (bss_change_params->changed & BSS_CHANGED_BASIC_RATES) ||
         (bss_change_params->changed & BSS_CHANGED_ERP_PREAMBLE) ||
         (bss_change_params->changed & BSS_CHANGED_ERP_SLOT) ||
         (bss_change_params->changed & BSS_CHANGED_ERP_CTS_PROT)) {
--- a/wireless/driver/linux/wave_he_compat.h
+++ b/wireless/driver/linux/wave_he_compat.h
@@ -141,12 +141,14 @@
 
 struct wave_he_ap_beacon {
   unsigned char enabled;
+  unsigned char color; /* Zero disables coloring in SET_BSS. */
   unsigned char mcs[8];
 };
 
-/* The retained SET_BSS ABI fixes enabled BSS color4. Accept only the matching
- * SU operation profile rendered by native hostapd. All offsets below are the
- * final IEEE layout, not the old D3 capability prefix used by STA_ADD.
+/* Decode the native SU operation profile for SET_BSS. The requested color
+ * belongs to the BSS, not the radio or driver. ER SU Disable is an operating
+ * restriction, independent of the ER capability bits that we do not advertise.
+ * Offsets are the final IEEE layout, not the D3 prefix used by STA_ADD.
  */
 static inline int
 wave_he_parse_ap_beacon(struct wave_he_ap_beacon *out,
@@ -182,10 +184,11 @@
   if (cap || op) {
     if (!cap || !op || cap_len < 21 || op_len < 6)
       return -1;
-    /* <=80MHz, no AP PPE/TWT, fixed color, PE16us, ER SU disabled. */
+    /* <=80MHz, no AP PPE/TWT/partial color/6GHz operation, PE16us. */
     if ((cap[6] & 0x18) || (cap[12] & WAVE_HE_PPE_PRESENT) ||
         (cap[0] & 0x06) || (op[0] & 0x0f) != 4 ||
-        (op[1] & 0x80) || (op[2] & 0x03) != 1 || op[3] != 4 ||
+        (op[1] & 0x80) || (op[2] & 0x02) || (op[3] & 0x40) ||
+        (!(op[3] & 0x80) && !(op[3] & 0x3f)) ||
         op[4] != 0xfc || op[5] != 0xff)
       return -1;
     needed = 6 + ((op[1] & 0x40) ? 3 : 0);
@@ -194,6 +197,7 @@
     for (i = 0; i < 4; i++)
       result.mcs[i] = cap[17 + i];
     result.enabled = 1;
+    result.color = (op[3] & 0x80) ? 0 : (op[3] & 0x3f);
   }
   *out = result;
   return 0;
--- a/wireless/driver/linux/wave_radio.c
+++ b/wireless/driver/linux/wave_radio.c
@@ -2241,7 +2241,8 @@
   bp.p2p_ctwindow = params->p2p_ctwindow;
   bp.p2p_opp_ps = params->p2p_opp_ps;
   bp.basic_rates_len = params->basic_rates_len;
-  bp.he_bss_color = 0; /* HE is not advertised by this bring-up profile. */
+  bp.he_bss_color = wave_pdb_get_int(mtlk_vap_get_param_db(mtlk_df_get_vap_handle(df)),
+                                    PARAM_DB_CORE_HE_BSS_COLOR);
   wave_memcpy(bp.basic_rates, sizeof(bp.basic_rates), params->basic_rates, bp.basic_rates_len);
 
   /* Keep trying in case scan is in progress for the current radio */
