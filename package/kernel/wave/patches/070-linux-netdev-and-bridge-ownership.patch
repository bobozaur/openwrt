+/* AP_VLAN owns a Linux port, never a firmware VAP. The first member is NULL
+ * until first open selects the parent for cfg80211 station/key operations.
+ * ap_vlan_lock protects both sides of the binding and the station retirement
+ * flag. RX additionally uses RCU through the network-stack handoff.
+ */
+struct wave_ap_vlan {
+  mtlk_df_user_t *parent;
+  struct net_device *parent_ndev;
+  struct wireless_dev wdev;
+  struct list_head node;
+  struct wave_tx_queue tx_queue;
+  sta_entry *sta;
+};
+
+static int wave_ap_vlan_open(struct net_device *ndev)
+{
+  struct wave_ap_vlan *vlan = netdev_priv(ndev);
+  struct wiphy *wiphy = vlan->wdev.wiphy;
+  struct wireless_dev *iter;
+  mtlk_df_user_t *parent = NULL;
+  struct net_device *parent_ndev;
+  mtlk_vap_handle_t vap;
+  int err = 0;
+
+  ASSERT_RTNL();
+  wiphy_lock(wiphy);
+  /* Standard hostapd assigns the BSS MAC after NEW_INTERFACE and before UP.
+   * Resolve that final address here, without guessing from the child name. */
+  list_for_each_entry(iter, &wiphy->wdev_list, list) {
+    mtlk_df_user_t *candidate;
+    mtlk_core_t *core;
+
+    if (iter->iftype != NL80211_IFTYPE_AP || !iter->netdev ||
+        !netif_running(iter->netdev) ||
+        !ether_addr_equal(iter->netdev->dev_addr, ndev->dev_addr))
+      continue;
+    candidate = mtlk_df_user_from_ndev(iter->netdev);
+    core = mtlk_vap_get_core(mtlk_df_get_vap_handle(candidate->df));
+    if (!READ_ONCE(core->slow_ctx->ap_started))
+      continue;
+    if (parent) {
+      err = -EINVAL;
+      goto out;
+    }
+    parent = candidate;
+  }
+  if (!parent || (vlan->parent && vlan->parent != parent)) {
+    err = -ENOLINK;
+    goto out;
+  }
+  parent_ndev = parent->ndev;
+  /* Registration/upper attachment already consumed these reservations.
+   * Do not change them, or the administrator's MTU, during first open. */
+  if (ndev->needed_headroom < parent_ndev->needed_headroom ||
+      ndev->needed_tailroom < parent_ndev->needed_tailroom ||
+      ndev->mtu < parent_ndev->min_mtu ||
+      (parent_ndev->max_mtu && ndev->mtu > parent_ndev->max_mtu)) {
+    err = -EINVAL;
+    goto out;
+  }
+  if (!vlan->parent) {
+    ndev->min_mtu = parent_ndev->min_mtu;
+    ndev->max_mtu = parent_ndev->max_mtu;
+    dev_hold(parent_ndev);
+    WRITE_ONCE(vlan->parent_ndev, parent_ndev);
+    WRITE_ONCE(vlan->parent, parent);
+    list_add_tail(&vlan->node, &parent->ap_vlans);
+  }
+  vap = mtlk_df_get_vap_handle(parent->df);
+  wave_hw_tx_queue_start(mtlk_vap_get_hw(vap), &vlan->tx_queue);
+out:
+  wiphy_unlock(wiphy);
+  return err;
+}
+
+static int wave_ap_vlan_stop(struct net_device *ndev)
+{
+  struct wave_ap_vlan *vlan = netdev_priv(ndev);
+  mtlk_vap_handle_t vap;
+
+  if (!vlan->parent)
+    return 0;
+  vap = mtlk_df_get_vap_handle(vlan->parent->df);
+  wave_hw_tx_queue_stop(mtlk_vap_get_hw(vap), &vlan->tx_queue);
+  return 0;
+}
+
+static int wave_ap_vlan_iflink(const struct net_device *ndev)
+{
+  const struct wave_ap_vlan *vlan = netdev_priv(ndev);
+  struct net_device *parent = READ_ONCE(vlan->parent_ndev);
+
+  return parent ? parent->ifindex : ndev->ifindex;
+}
+
+static int wave_ap_vlan_set_mac(struct net_device *ndev, void *addr)
+{
+  struct wave_ap_vlan *vlan = netdev_priv(ndev);
+
+  ASSERT_RTNL();
+  /* Once selected, the BSS owns this child's bindings until deletion.
+   * A same-address ioctl is handled by netif_set_mac_address itself. */
+  if (vlan->parent)
+    return -EBUSY;
+  return eth_mac_addr(ndev, addr);
+}
+
+static const struct net_device_ops wave_ap_vlan_ops = {
+  .ndo_open = wave_ap_vlan_open,
+  .ndo_stop = wave_ap_vlan_stop,
+  .ndo_start_xmit = _mtlk_df_user_linux_start_tx,
+  .ndo_get_iflink = wave_ap_vlan_iflink,
+  .ndo_set_mac_address = wave_ap_vlan_set_mac,
+  .ndo_validate_addr = eth_validate_addr,
+};
+
+static void wave_ap_vlan_destructor(struct net_device *ndev)
+{
+  struct wave_ap_vlan *vlan = netdev_priv(ndev);
+
+  if (vlan->parent_ndev)
+    dev_put(vlan->parent_ndev);
+}
+
+/* netifd enables bridge hairpin for non-isolated WAVE APs. Every bridged
+ * frame is handed to that owner; an explicit hairpin-off choice is never
+ * bypassed by driver-local forwarding, VLAN learning or a second querier.
+ */
+bool wave_df_intra_bss_forwarding(mtlk_df_user_t *df_user)
+{
+#if !MTLK_USE_DIRECTCONNECT_DP_API && !MTLK_USE_PUMA6_UDMA
+  return !netif_is_bridge_port(df_user->ndev);
+#else
+  return true;
+#endif
+}
+
+/* A bridged parent has already passed VLAN and source policy. Remaining
+ * group frames use BSS flooding rather than the native VLAN-blind cache.
+ * Standalone RX shortcuts use their native membership owner. Bridged
+ * forwarding remains entirely subject to Linux VLAN/source/port policy.
+ */
+bool wave_df_bridge_mcast_owned(mtlk_df_user_t *df_user)
+{
+#if !MTLK_USE_DIRECTCONNECT_DP_API && !MTLK_USE_PUMA6_UDMA
+  return netif_is_bridge_port(df_user->ndev);
+#else
+  return false;
+#endif
+}
