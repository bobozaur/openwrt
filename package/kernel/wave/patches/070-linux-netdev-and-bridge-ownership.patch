@@ -655,6 +662,30 @@
 
   df_user = mtlk_df_user_from_ndev(ndev);
   if (__UNLIKELY(NULL == df_user)) {
+    goto drop;
+  }
+
+  if (ndev->ieee80211_ptr->iftype == NL80211_IFTYPE_AP_VLAN &&
+      !netif_running(df_user->ndev))
+    goto drop;
+
+  /* Header inspection must not modify an skb that may be returned BUSY. */
+  eth = skb_header_pointer(skb, 0, sizeof(buffer), &buffer);
+  if (!eth)
+    goto drop;
+  if (eth->h_proto == htons(ETH_P_PAE)) {
+    int res = MTLK_ERR_NO_MEM;
+
+    /* Authentication belongs to the parent BSS. Its management-ring path
+     * resolves DA independently and must never bypass a child binding.
+     */
+    if (ndev->ieee80211_ptr->iftype == NL80211_IFTYPE_AP_VLAN)
+      goto drop;
+    if (!skb_linearize(skb))
+      res = mtlk_core_tx_eapol(mtlk_df_get_vap_handle(df_user->df),
+                              skb->data, skb->len);
+    if (res != MTLK_ERR_OK)
+      dev_core_stats_tx_dropped_inc(ndev);
     dev_kfree_skb_any(skb);
     return NETDEV_TX_OK;
   }
@@ -686,10 +717,34 @@
       ++df_user->dcdp.litepath_stats.tx_discarded_no_peers;
   }
 #endif
-  return _mtlk_df_user_start_skb_tx(skb, df_user);
+  vap = mtlk_df_get_vap_handle(df_user->df);
+  msg = mtlk_hw_get_msg_to_send(mtlk_vap_get_hwapi(vap), vap, &error);
+  if (!msg) {
+    if (error == MTLK_ERR_NO_RESOURCES)
+      return NETDEV_TX_BUSY;
+    goto drop;
+  }
+  if (!pskb_may_pull(skb, ETH_HLEN)) {
+    mtlk_hw_release_msg_to_send(mtlk_vap_get_hwapi(vap), msg);
+    goto drop;
+  }
+  return _mtlk_df_user_start_skb_tx(skb, df_user, msg);
+drop:
+  dev_core_stats_tx_dropped_inc(ndev);
+  dev_kfree_skb_any(skb);
+  return NETDEV_TX_OK;
 }
 EXPORT_SYMBOL(_mtlk_df_user_linux_start_tx);
 
