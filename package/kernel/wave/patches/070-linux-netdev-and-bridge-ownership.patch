+static int wave_vendor_native_call(struct wiphy *wiphy, struct wireless_dev *wdev,
+    const void *data, int length,
+    int (*call)(struct wiphy *, struct wireless_dev *, const void *, int))
+{
+  wave_radio_t *radio;
+  mtlk_core_t *master;
+  mtlk_hw_t *hw;
+  int res;
+
+  if (wdev && wdev->iftype == NL80211_IFTYPE_MONITOR)
+    return -EOPNOTSUPP;
+  radio = wave_wiphy_radio(wiphy);
+  if (!radio || !wave_radio_control_ready_get(radio))
+    return -EBUSY;
+  master = wave_radio_master_core_get(radio);
+  hw = mtlk_vap_get_hw(master->vap_handle);
+  if (!wave_hw_monitor_user_get(hw))
+    return -EBUSY;
+  res = call(wiphy, wdev, data, length);
+  wave_hw_monitor_user_put(hw);
+  return res;
+}
