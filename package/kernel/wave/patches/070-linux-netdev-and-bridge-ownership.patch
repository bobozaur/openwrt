+bool wave_df_ap_vlan_rx(sta_entry *sta, mtlk_nbuf_t *nbuf)
+{
+  struct net_device *ndev;
+  mtlk_core_t *core = mtlk_vap_get_core(sta->vap_handle);
+  bool handled = false;
+  const struct ethhdr *eth = (const struct ethhdr *)nbuf->data;
+  uint32 flags;
+
+  rcu_read_lock();
+  ndev = rcu_dereference(sta->ap_vlan);
