+        mtlk_core_get_net_state(core) != NET_STATE_CONNECTED) {
+      dev_core_stats_rx_dropped_inc(ndev);
+      mtlk_df_nbuf_free(nbuf);
+    } else {
+      flags = is_broadcast_ether_addr(eth->h_dest) ? MTLK_NBUFF_BROADCAST :
+              is_multicast_ether_addr(eth->h_dest) ? MTLK_NBUFF_MULTICAST :
+              MTLK_NBUFF_UNICAST;
+      mtlk_sta_on_packet_indicated(sta, nbuf, flags);
+      dev_sw_netstats_rx_add(ndev, nbuf->len);
+      wave_df_indicate_rx_data(mtlk_vap_get_df(sta->vap_handle), nbuf, ndev);
+    }
+  }
+  rcu_read_unlock();
+  return handled;
 }
 
