 int __MTLK_IFUNC
 _mtlk_df_user_linux_start_tx (struct sk_buff *skb, struct net_device *ndev)
 {
   mtlk_df_user_t *df_user;
+  mtlk_vap_handle_t vap;
+  mtlk_hw_msg_t *msg;
+  struct ethhdr buffer;
+  const struct ethhdr *eth;
