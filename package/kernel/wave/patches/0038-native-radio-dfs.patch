+/* Master serializer, one native firmware submission at a time. */
+static int wave_beacon_man_schedule(mtlk_core_t *core, unsigned int after)
+{
+  mtlk_vap_manager_t *mgr = mtlk_vap_get_manager(core->vap_handle);
+  beacon_manager_priv_t *priv = wave_radio_beacon_man_private_get(wave_vap_radio_get(core->vap_handle));
+  unsigned int i, count = mtlk_vap_manager_get_max_vaps_count(mgr);
+  mtlk_vap_handle_t vap;
+
+  if (priv->fw_is_busy || !wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle)))
+    return MTLK_ERR_OK;
+  for (i = 0; i < count; i++) {
+    unsigned int idx = (after + 1 + i) % count;
+    beacon_manager_t *bmgr;
+    beacon_template_t *cache;
+    mtlk_beacon_data_t data = {0};
+    int res;
+
+    if (mtlk_vap_manager_get_vap_handle(mgr, idx, &vap) != MTLK_ERR_OK)
+      continue;
+    core = mtlk_vap_get_core(vap);
+    bmgr = &core->slow_ctx->beacon_man_data;
+    if (!bmgr->updated || bmgr->switch_pending || !core->slow_ctx->ap_started)
+      continue;
+    cache = &bmgr->tmpl[MTLK_BEACON_MAN_RCVRY_TMPL_IDX];
+    data.head = cache->ptr;
+    data.head_len = cache->head_len;
+    data.tail = cache->ptr + cache->head_len;
+    data.tail_len = cache->tail_len;
+    res = _wave_beacon_man_template_save(&bmgr->tmpl[bmgr->drv_idx], &data);
+    if (res == MTLK_ERR_OK)
+      res = __wave_beacon_man_template_push_wrap(core, &bmgr->tmpl[bmgr->drv_idx], bmgr, priv);
+    if (res != MTLK_ERR_OK) {
+      bmgr->updated = FALSE;
+      /* Radar interrupts an accepted update through the ordinary radar event.
+       * Other asynchronous failures cannot silently strand accepted state. */
+      if (!wave_radio_dfs_tx_blocked(wave_vap_radio_get(vap)))
+        wave_hw_mmb_quiesce(mtlk_vap_get_hw(vap));
+    }
+    return res;
+  }
+  return MTLK_ERR_OK;
+}
+
+/* RX wakes a drain independently of queued master work. A REMOVE acknowledgement
+ * alone says nothing about an earlier indication still waiting in that queue. */
+void wave_beacon_man_indication_receive(mtlk_core_t *core, const UMI_BEACON_SET *ind)
+{
+  beacon_manager_priv_t *priv = wave_radio_beacon_man_private_get(wave_vap_radio_get(core->vap_handle));
+  unsigned long flags;
+  int res;
+
+  spin_lock_irqsave(&priv->indication_lock, flags);
+  if (ind->u8vapIndex != READ_ONCE(priv->for_vap_idx)) {
+    spin_unlock_irqrestore(&priv->indication_lock, flags);
+    return;
+  }
+  priv->indication.ind = *ind;
+  priv->indication.epoch = atomic_read(&priv->submission_epoch);
+  priv->receiver = core;
+  if (ind->u8vapIndex == READ_ONCE(priv->for_vap_idx))
+    WRITE_ONCE(priv->received_epoch, priv->indication.epoch);
+  spin_unlock_irqrestore(&priv->indication_lock, flags);
+  wake_up_all(&priv->indication_wait);
+
+  res = mtlk_core_schedule_hw_command(core, &priv->indication_command,
+                                     wave_beacon_command_complete, HANDLE_T(priv));
+  /* BUSY means this same queued command will consume the latest snapshot.
+   * NOT_READY is terminal serializer teardown; there is no RX allocation. */
+  if (res != MTLK_ERR_OK && res != MTLK_ERR_BUSY && res != MTLK_ERR_NOT_READY)
