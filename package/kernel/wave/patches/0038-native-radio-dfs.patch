+static int wave_core_sta_role(mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  mtlk_core_t *core = HANDLE_T_PTR(mtlk_core_t, hcore);
+  mtlk_clpb_t *clpb = *(mtlk_clpb_t **)data;
+  struct wave_sta_role_request *request;
