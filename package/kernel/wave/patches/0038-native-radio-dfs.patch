+/* Master serializer, before STOP/REMOVE can suppress a pending indication.
+ * No new submission can start while this owner waits. Once RX observed it,
+ * resetting the epoch safely rejects all queued work for the old submission. */
+int wave_beacon_man_drain(mtlk_core_t *core)
+{
+  wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
+  beacon_manager_priv_t *priv = wave_radio_beacon_man_private_get(radio);
+  u32 epoch = atomic_read(&priv->submission_epoch);
+  unsigned int period = WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_BEACON_PERIOD);
+
+  if (!wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle)) ||
+      !priv->fw_is_busy || priv->for_vap_idx != mtlk_vap_get_id(core->vap_handle))
+    return MTLK_ERR_OK;
+  if (!wait_event_timeout(priv->indication_wait,
+        READ_ONCE(priv->received_epoch) == epoch,
+        msecs_to_jiffies(250 + div_u64((u64)period * 1024 + 999, 1000)))) {
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+    return MTLK_ERR_NOT_READY;
+  }
+  return MTLK_ERR_OK;
 }
 
