+  int res = MTLK_ERR_OK;
+
+  request = mtlk_clpb_enum_get_next(clpb, &size);
+  MTLK_CLPB_TRY(request, size)
+    if (mtlk_vap_is_ap(core->vap_handle))
+      MTLK_CLPB_EXIT(MTLK_ERR_PARAMS);
+    if (request->active) {
+      if (!wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle)))
+        MTLK_CLPB_EXIT(MTLK_ERR_NOT_READY);
+      if (!mtlk_core_is_chandef_identical(&request->chandef,
+                        __wave_core_chandef_get(mtlk_core_get_master(core))))
+        MTLK_CLPB_EXIT(MTLK_ERR_BUSY);
+      res = wave_radio_role_check(wave_vap_radio_get(core->vap_handle), true);
+      if (res != MTLK_ERR_OK)
+        MTLK_CLPB_EXIT(res);
+    }
+    core->slow_ctx->sta_connecting = request->active;
+  MTLK_CLPB_FINALLY(res)
+    return mtlk_clpb_push_res(clpb, res);
+  MTLK_CLPB_END;
 }
 
