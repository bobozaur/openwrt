+/* These predicates run on the physical radio's master serializer. */
+bool wave_radio_ap_active(wave_radio_t *radio)
+{
+  unsigned int i, count = mtlk_vap_manager_get_max_vaps_count(radio->vap_manager);
+  mtlk_vap_handle_t vap;
+
+  for (i = 0; i < count; i++)
+    if (mtlk_vap_manager_get_vap_handle(radio->vap_manager, i, &vap) == MTLK_ERR_OK &&
+        mtlk_vap_is_ap(vap) && (mtlk_vap_get_core(vap)->slow_ctx->ap_started ||
+                              mtlk_vap_get_core(vap)->slow_ctx->ap_preparing))
+      return true;
+  return false;
+}
+
+bool wave_radio_sta_active(wave_radio_t *radio)
+{
+  unsigned int i, count = mtlk_vap_manager_get_max_vaps_count(radio->vap_manager);
+  mtlk_vap_handle_t vap;
+
+  for (i = 0; i < count; i++)
+    if (mtlk_vap_manager_get_vap_handle(radio->vap_manager, i, &vap) == MTLK_ERR_OK &&
+        !mtlk_vap_is_ap(vap) && mtlk_vap_get_core(vap)->slow_ctx->sta_connecting)
+      return true;
+  return false;
+}
