+    return mtlk_clpb_push_res(clpb, res);
+  MTLK_CLPB_END;
+}
+
+static int wave_radio_cac_request(wave_radio_t *radio, u32 session, bool abort)
+{
+  struct wave_cac_request request = { .session = session, .abort = abort };
+  mtlk_clpb_t *clpb = NULL;
+  mtlk_df_t *df = mtlk_vap_manager_get_master_df(radio->vap_manager);
+  int res = _mtlk_df_user_invoke_core(df, WAVE_RADIO_REQ_CAC_TIMEOUT,
+                                     &clpb, &request, sizeof(request));
+
+  return _mtlk_df_user_process_core_retval(res, clpb, WAVE_RADIO_REQ_CAC_TIMEOUT, TRUE);
+}
+
+static void wave_radio_cac_work(struct wiphy *wiphy, struct wiphy_work *work)
+{
+  struct _wave_radio_radar_ctx_t *ctx = container_of(work,
+                                struct _wave_radio_radar_ctx_t, work.work);
+  wave_radio_t *radio = container_of(ctx, wave_radio_t, radar_ctx);
+  struct cfg80211_chan_def cd;
+  struct net_device *ndev;
+  struct wireless_dev *wdev;
+  unsigned long flags, deadline;
+  u32 session;
+  bool abort;
+  int res;
+
+  spin_lock_irqsave(&ctx->lock, flags);
+  ndev = ctx->ndev;
+  if (!ndev || ctx->stopping) {
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    return;
+  }
+  wdev = ndev->ieee80211_ptr;
+  session = ctx->session;
+  abort = ctx->aborted || !netif_running(ndev) ||
+    ndev->reg_state != NETREG_REGISTERED || !wdev->links[0].cac_started ||
+    !wave_radio_native_chandef(radio, &ctx->chandef, &cd) ||
+    !cfg80211_chandef_identical(&cd, &wdev->links[0].ap.chandef);
+  deadline = wdev->links[0].cac_start_time +
+             msecs_to_jiffies(wdev->links[0].cac_time_ms);
+  if (time_after(ctx->deadline, deadline))
+    deadline = ctx->deadline;
+  if (!abort && time_before(jiffies, deadline)) {
+    wiphy_delayed_work_queue(wiphy, &ctx->work, deadline - jiffies);
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    return;
+  }
+  spin_unlock_irqrestore(&ctx->lock, flags);
+
+  res = wave_radio_cac_request(radio, session, abort);
+  if (res == MTLK_ERR_CANCELED && !abort) {
+    abort = true;
+    res = wave_radio_cac_request(radio, session, true);
+  }
+  if (res != MTLK_ERR_OK)
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(mtlk_vap_manager_get_master_core(radio->vap_manager)->vap_handle));
+  /* Radar may have arrived while the command was queued. Its NOP publication
+   * and this completion share the lock, so AVAILABLE can never overwrite it. */
+  spin_lock_irqsave(&ctx->lock, flags);
+  if (ctx->ndev == ndev && ctx->session == session && ctx->aborted && !abort) {
+    /* Radar can arrive after the finish CFM. Fence the firmware before
+     * publishing ABORTED; holding wiphy keeps this requester alive. */
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    abort = true;
+    res = wave_radio_cac_request(radio, session, true);
+    if (res != MTLK_ERR_OK)
+      wave_hw_mmb_quiesce(mtlk_vap_get_hw(mtlk_vap_manager_get_master_core(radio->vap_manager)->vap_handle));
+    spin_lock_irqsave(&ctx->lock, flags);
+  }
+  if (ctx->ndev == ndev && ctx->session == session) {
+    abort |= ctx->aborted || res != MTLK_ERR_OK;
+    if (wdev->links[0].cac_started) {
+      wave_radio_native_chandef(radio, &ctx->chandef, &cd);
+      cfg80211_cac_event(ndev, &cd, abort ? NL80211_RADAR_CAC_ABORTED :
+                         NL80211_RADAR_CAC_FINISHED, GFP_ATOMIC, 0);
+    }
+    if (!abort)
+      ctx->tx_blocked = false;
+    ctx->ndev = NULL;
+  } else {
+    ndev = NULL;
+  }
+  spin_unlock_irqrestore(&ctx->lock, flags);
+  if (ndev)
+    dev_put(ndev);
+}
+
+/* Begin/arm run in the master serializer. No opposite-role connection or AP
+ * start can pass their final admission while this session owns the radio. */
+int wave_radio_cac_begin(wave_radio_t *radio, const struct set_chan_param_data *cpd)
+{
+  struct _wave_radio_radar_ctx_t *ctx = &radio->radar_ctx;
+  mtlk_core_t *core = mtlk_vap_manager_get_master_core(radio->vap_manager);
+  mtlk_vap_handle_t vap;
+  struct cfg80211_chan_def cd;
+  struct wiphy *wiphy = wv_cfg80211_wiphy_get(radio->cfg80211);
+  unsigned long flags;
+  unsigned int i;
+  int res;
+
+  if (ctx->stopping || wave_radio_cac_active(radio) || wave_radio_ap_active(radio) ||
+      wave_radio_sta_active(radio) || is_mac_scan_running(wave_radio_scan_support_get(radio)))
+    return MTLK_ERR_BUSY;
+  if (!wave_radio_native_chandef(radio, &cpd->chandef, &cd) ||
+      !cfg80211_chandef_dfs_usable(wiphy, &cd))
+    return MTLK_ERR_PARAMS;
+  res = abort_scan_sync(core);
+  if (res != MTLK_ERR_OK)
+    return res;
+  WRITE_ONCE(ctx->tx_blocked, true);
+  synchronize_net();
+  for (i = 0; i < mtlk_vap_manager_get_max_vaps_count(radio->vap_manager); i++) {
+    if (mtlk_vap_manager_get_vap_handle(radio->vap_manager, i, &vap) != MTLK_ERR_OK)
+      continue;
+    res = mtlk_wait_all_packets_confirmed(mtlk_vap_get_core(vap));
+    if (res != MTLK_ERR_OK) {
+      wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+      return res;
+    }
+  }
+  dev_hold(cpd->ndev);
+  spin_lock_irqsave(&ctx->lock, flags);
+  if (ctx->stopping || !cfg80211_chandef_dfs_usable(wiphy, &cd)) {
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    dev_put(cpd->ndev);
+    return MTLK_ERR_NOT_READY;
+  }
+  ctx->ndev = cpd->ndev;
+  ctx->chandef = cpd->chandef;
+  ctx->session++;
+  ctx->aborted = false;
+  spin_unlock_irqrestore(&ctx->lock, flags);
+  return MTLK_ERR_OK;
+}
+
+void wave_radio_cac_arm(wave_radio_t *radio, u32 duration, bool failed)
+{
+  struct _wave_radio_radar_ctx_t *ctx = &radio->radar_ctx;
+  unsigned long flags;
+
+  spin_lock_irqsave(&ctx->lock, flags);
+  if (ctx->ndev && !ctx->stopping) {
+    ctx->aborted |= failed;
+    ctx->deadline = jiffies + msecs_to_jiffies(duration);
+    wiphy_delayed_work_queue(wv_cfg80211_wiphy_get(radio->cfg80211), &ctx->work,
+                              ctx->aborted ? 0 : msecs_to_jiffies(duration));
+  }
+  spin_unlock_irqrestore(&ctx->lock, flags);
+}
+
+/* Native end_cac is called with this wiphy locked. Clear before returning so
+ * unregister may destroy df_user/core; a held netdev alone is not sufficient. */
+void wave_radio_end_cac(wave_radio_t *radio, struct net_device *ndev)
+{
+  struct _wave_radio_radar_ctx_t *ctx = &radio->radar_ctx;
+  struct wiphy *wiphy = wv_cfg80211_wiphy_get(radio->cfg80211);
+  unsigned long flags;
+  u32 session;
+  int res;
+
+  lockdep_assert_wiphy(wiphy);
+  spin_lock_irqsave(&ctx->lock, flags);
+  if (ctx->ndev != ndev) {
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    return;
+  }
+  session = ctx->session;
+  spin_unlock_irqrestore(&ctx->lock, flags);
+  res = wave_radio_cac_request(radio, session, true);
+  if (res != MTLK_ERR_OK)
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(mtlk_vap_manager_get_master_core(radio->vap_manager)->vap_handle));
+  spin_lock_irqsave(&ctx->lock, flags);
+  ctx->ndev = NULL;
+  ctx->aborted = true;
+  spin_unlock_irqrestore(&ctx->lock, flags);
+  wiphy_delayed_work_cancel(wiphy, &ctx->work);
+  /* Match mac80211 end_cac: cfg80211 owns abort notification and CAC state. */
+  ndev->ieee80211_ptr->links[0].cac_started = false;
+  dev_put(ndev);
+}
+
+void wave_radio_radar_event(wave_radio_t *radio, const struct mtlk_chan_def *mcd)
+{
+  struct _wave_radio_radar_ctx_t *ctx = &radio->radar_ctx;
+  struct cfg80211_chan_def cd;
+  struct wiphy *wiphy = wv_cfg80211_wiphy_get(radio->cfg80211);
+  unsigned long flags;
+
+  if (!wave_radio_native_chandef(radio, mcd, &cd))
+    return;
+  spin_lock_irqsave(&ctx->lock, flags);
+  if (ctx->stopping) {
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    return;
+  }
+  ctx->radar_generation++;
+  ctx->tx_blocked = true;
+  ctx->aborted = true;
+  /* Never defer or cancel the real radar/NOP indication with AP teardown. */
+  cfg80211_radar_event(wiphy, &cd, GFP_ATOMIC);
+  if (ctx->ndev && !ctx->stopping)
+    wiphy_delayed_work_queue(wiphy, &ctx->work, 0);
+  spin_unlock_irqrestore(&ctx->lock, flags);
+}
+
+static int _wave_radio_radar_ctx_init(wave_radio_t *radio)
+{
+  spin_lock_init(&radio->radar_ctx.lock);
+  wiphy_delayed_work_init(&radio->radar_ctx.work, wave_radio_cac_work);
+  return MTLK_ERR_OK;
+}
+
+static void _wave_radio_radar_ctx_cleanup(wave_radio_t *radio)
+{
+  struct _wave_radio_radar_ctx_t *ctx = &radio->radar_ctx;
+  struct wiphy *wiphy = wv_cfg80211_wiphy_get(radio->cfg80211);
+  struct net_device *ndev;
+  unsigned long flags;
+
+  wiphy_lock(wiphy);
+  spin_lock_irqsave(&ctx->lock, flags);
+  ctx->stopping = true;
+  ndev = ctx->ndev;
+  ctx->ndev = NULL;
+  spin_unlock_irqrestore(&ctx->lock, flags);
+  wiphy_delayed_work_cancel(wiphy, &ctx->work);
+  if (ndev)
+    dev_put(ndev);
+  wiphy_unlock(wiphy);
+}
+
+void wave_radio_on_rcvry_isolate(wave_radio_t *radio)
+{
+  wave_radio_cac_arm(radio, 0, true);
 }
 
