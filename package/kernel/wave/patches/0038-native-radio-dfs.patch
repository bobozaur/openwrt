+static bool wave_beacon_frame_valid(const void *data, unsigned int len, u8 subtype)
+{
+  const u8 *frame = data;
+  unsigned int pos = sizeof(frame_head_t) + sizeof(frame_beacon_head_t);
+
+  if (!frame || len < pos || frame[0] != subtype)
+    return false;
+  while (pos < len) {
+    if (len - pos < 2 || frame[pos + 1] > len - pos - 2)
+      return false;
+    pos += 2 + frame[pos + 1];
+  }
+  return true;
+}
+
+static bool wave_beacon_cap_changed(const mtlk_beacon_data_t *data,
+                                    const beacon_template_t *old, int id)
+{
+  const u8 *a = cfg80211_find_ie(id, data->tail, data->tail_len);
+  const u8 *b = cfg80211_find_ie(id, old->ptr + old->head_len, old->tail_len);
+
+  return (!!a != !!b) || (a && (a[1] != b[1] || memcmp(a, b, a[1] + 2)));
+}
