-    data = nla_data(attr);
-    if (NULL == data) {
-      ELOG_V("Fail to receive Notification message from application: payload is absent.");
-    }
-    else {
-      _wave_nl_parse_msg((struct mtlk_nl_msghdr *)data);
-    }
-  }
-  else {
-    ELOG_D("Fail to receive Notification message from application: "
-           "no genl_info.attrs[%d].", MTLK_GENL_CMD_EVENT);
-  }
-
+  const struct nlattr *attr = info->attrs[MTLK_GENL_ATTR_EVENT];
+  struct mtlk_nl_msghdr *hdr;
+  int ret;
+
+  if (!attr || nla_len(attr) < sizeof(*hdr))
+    return -EINVAL;
+
+  hdr = nla_data(attr);
+  /* This is the original native-endian userspace protocol. The attribute
+   * length excludes netlink padding, so the declared payload must match. */
+  if (hdr->data_len != nla_len(attr) - sizeof(*hdr))
+    return -EINVAL;
+
+  ret = wave_nl_validate_payload(hdr);
+  if (ret)
+    return ret;
+  _wave_nl_parse_msg(hdr);
   return 0;
 }
 
