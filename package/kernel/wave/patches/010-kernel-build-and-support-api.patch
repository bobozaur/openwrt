+/* Validate the complete original userspace wire contract before callbacks
+ * that consume typed payloads without receiving their length. */
+static int wave_nl_validate_payload(const struct mtlk_nl_msghdr *hdr)
+{
+  const rtlog_app_drv_msg_t *msg = (const void *)(hdr + 1);
+  size_t len = hdr->data_len;
+
+  switch (hdr->cmd_id) {
+  case NL_DRV_CMD_FAPI_NOTIFY:
+    /* wave_fapi_msghdr_t: subcommand and card index, one byte each. */
+    return len == 2 ? 0 : -EINVAL;
+  case NL_DRV_CMD_RTLOG_NOTIFY:
+    if (len < sizeof(*msg) || msg->hdr.length < sizeof(msg->data) ||
+        sizeof(msg->hdr) + msg->hdr.length != len ||
+        !memchr(msg->data.name, '\0', sizeof(msg->data.name)))
+      return -EINVAL;
+    switch (msg->hdr.cmd_id) {
+    case RTLOG_APP_DRV_CMDID_STARTUP:
+    case RTLOG_APP_DRV_CMDID_CLEANUP:
+      return len == sizeof(*msg) ? 0 : -EINVAL;
+    case RTLOG_APP_DRV_CMDID_LOG:
+      return len - sizeof(*msg) <= 2047 ? 0 : -EMSGSIZE;
+    default:
+      return -EOPNOTSUPP;
+    }
+  default:
+    return -EOPNOTSUPP;
+  }
+}
