+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef WAVE_HE_BF_MODE_H
+#define WAVE_HE_BF_MODE_H
+
+#include "wave_he_compat.h"
+
+/* Radio master serializer. A global mode change must not invalidate an
+ * accepted AP profile. Explicit and auto permit SU BF; stopping the last
+ * such BSS releases the restriction without changing another VAP's mode.
+ */
+static inline int
+wave_he_bf_mode_check(mtlk_core_t *core, BeamformingMode_e mode)
+{
+  mtlk_vap_manager_t *mgr;
+  unsigned int i, count;
+
+  if (mode == BF_STATE_EXPLICIT || mode == BF_STATE_AUTO_MODE)
+    return MTLK_ERR_OK;
+
+  mgr = mtlk_vap_get_manager(core->vap_handle);
+  count = mtlk_vap_manager_get_max_vaps_count(mgr);
+  for (i = 0; i < count; i++) {
+    mtlk_vap_handle_t vap;
+    mtlk_core_t *ap;
+    struct wave_he_bf_profile bf;
+    mtlk_pdb_size_t size = sizeof(bf);
+
+    if (mtlk_vap_manager_get_vap_handle(mgr, i, &vap) != MTLK_ERR_OK ||
+        !mtlk_vap_is_ap(vap))
+      continue;
+    ap = mtlk_vap_get_core(vap);
+    if (!ap->slow_ctx->ap_started && !ap->slow_ctx->ap_preparing)
+      continue;
+    if (MTLK_CORE_PDB_GET_BINARY(ap, PARAM_DB_CORE_HE_BF, &bf, &size) != MTLK_ERR_OK ||
+        size != sizeof(bf))
+      return MTLK_ERR_NOT_READY;
+    if (bf.enabled)
+      return MTLK_ERR_BUSY;
+  }
+  return MTLK_ERR_OK;
+}
+
+#endif /* WAVE_HE_BF_MODE_H */
