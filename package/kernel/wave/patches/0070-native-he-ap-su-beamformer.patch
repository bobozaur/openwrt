 #define WAVE_HE_LDPC 0x20
 #define WAVE_HE_STBC_TX_80 0x04
 #define WAVE_HE_STBC_RX_80 0x08
+#define WAVE_HE_NDP_4XLTF_32GI 0x02
+#define WAVE_HE_SU_BEAMFORMER 0x80
+#define WAVE_HE_SU_BEAMFORMEE 0x01
+#define WAVE_HE_SU_CODEBOOK_42 0x01
+#define WAVE_HE_TRIG_SU_FEEDBACK 0x04
+#define WAVE_HE_TRIG_CQI_FEEDBACK 0x10
+#define WAVE_HE_SU_FEEDBACK (WAVE_HE_TRIG_SU_FEEDBACK | WAVE_HE_TRIG_CQI_FEEDBACK)
 #define WAVE_HE_PPE_PRESENT 0x80
 #define WAVE_HE_4XLTF_08GI 0x04
+
+/* Effective AP profile from the accepted beacon, not the radio capability.
+ * Dimension fields retain their on-air encoding: zero means one dimension.
+ */
+struct wave_he_bf_profile {
+  unsigned char enabled;
+  unsigned char dimensions; /* PHY5 bits 0..2 (<=80), 3..5 (>80). */
+  unsigned char feedback;   /* PHY6 triggered SU/CQI, no MU or Ng16. */
+};
+
+static inline int
+wave_he_bf_valid(const struct wave_he_bf_profile *bf,
+                 unsigned int tx_chains, unsigned int rx_chains)
+{
+  if (!bf->enabled)
+    return !bf->dimensions && !bf->feedback;
+  /* Retained AP sounding uses at most two dimensions <=80 MHz and one
+   * above 80 MHz. Feedback reception requires an available RX chain.
+   */
+  return bf->enabled == 1 && tx_chains >= 2 && rx_chains &&
+         bf->dimensions <= 1 && !(bf->feedback & ~WAVE_HE_SU_FEEDBACK);
+}
 
