Subject: [PATCH] wave: admit AP recovery scans through the native channel owner

--- a/wireless/driver/shared/scan_support.c
+++ b/wireless/driver/shared/scan_support.c
@@ -1290,6 +1290,52 @@
   return i;
 }
 
+/* The first AP coexistence scan after an aborted CAC may find RF off while
+ * the radar TX fence is still set. Bare RF-on cannot retire that fence. With
+ * no operating role, first complete a normal channel command to a channel
+ * already requested by this scan and currently legal for AP transmission.
+ * The shared SET_CHAN owner retains regulatory/generation/CFM checks and is
+ * the only owner allowed to clear the fence; no DFS state is overridden. */
+static int scan_prepare_ap_recovery(mtlk_core_t *core,
+                                    const struct mtlk_scan_request *request)
+{
+  wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
+  struct wiphy *wiphy = wv_cfg80211_wiphy_get(wave_radio_cfg80211_get(radio));
+  struct set_chan_param_data cpd = {0};
+  struct cfg80211_chan_def native;
+  unsigned int i;
+
+  if (request->type != MTLK_SCAN_AP || wave_radio_ap_active(radio) ||
+      wave_radio_sta_active(radio) || wave_radio_cac_active(radio) ||
+      mtlk_vap_manager_has_peer_connections(mtlk_vap_get_manager(core->vap_handle)))
+    return MTLK_ERR_BUSY;
+  if (request->n_channels > ARRAY_SIZE(request->channels))
+    return MTLK_ERR_VALUE;
+
+  for (i = 0; i < request->n_channels; i++) {
+    struct ieee80211_channel *channel;
+
+    if (mtlk_core_is_band_supported(core, request->channels[i].band) != MTLK_ERR_OK)
+      continue;
+    channel = ieee80211_get_channel(wiphy, request->channels[i].center_freq);
+    if (!channel)
+      continue;
+    cfg80211_chandef_create(&native, channel, NL80211_CHAN_HT20);
+    if (!cfg80211_reg_can_beacon(wiphy, &native, NL80211_IFTYPE_AP))
+      continue;
+
+    cpd.chandef.chan = request->channels[i];
+    cpd.chandef.width = CW_20;
+    cpd.chandef.center_freq1 = channel->center_freq;
+    cpd.switch_type = ST_NORMAL;
+    cpd.dont_notify_kernel = TRUE;
+    cpd.vap_id = mtlk_vap_get_id(core->vap_handle);
+    cpd.ndev = mtlk_df_user_get_ndev(mtlk_df_get_user(mtlk_vap_get_df(core->vap_handle)));
+    return core_cfg_set_chan(core, &cpd.chandef, &cpd);
+  }
+  return MTLK_ERR_BUSY;
+}
+
 /* supposed to be run on the Master VAP's serializer */
 int _scan_do_scan(mtlk_core_t *core, struct mtlk_scan_request *request)
 {
@@ -1414,6 +1460,15 @@
 
   radio_mode = WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MODE_CURRENT);
   ILOG0_D("radio mode %d", radio_mode);
+  if (radio_mode == WAVE_RADIO_OFF && wave_radio_dfs_tx_blocked(radio)) {
+    res = scan_prepare_ap_recovery(core, request);
+    if (res != MTLK_ERR_OK)
+      goto error_exit;
+    /* Error cleanup and normal scan completion must return to the legally
+     * acknowledged channel, never the retired CAC/NOP channel. */
+    ss->orig_chandef = *current_chandef;
+    ss->orig_station = FALSE;
+  }
   res = mtlk_core_radio_enable_if_needed(core);
   if (MTLK_ERR_OK != res) {
     goto error_exit;
