+/* Maximum eligible rate target, in 1/8 dBm. The firmware calibration value
+ * and the acknowledged country/user table both bound the reported power.
+ */
+static unsigned
+_mtlk_tx_power_target_max(const mtlk_tx_power_data_t *power,
+                          const psdb_rate_pw_table_t *rates,
+                          BOOL bf, BOOL mu, BOOL he_mu)
+{
+  unsigned i, width, maximum = 0;
+
+  if (!power->power_hw.pw_size || power->power_hw.pw_size > PHY_STAT_RATE_CBW_NUM ||
+      power->cur_cbw >= power->power_hw.pw_size ||
+      !power->cur_antennas || power->cur_antennas > PHY_STAT_RATE_NSS_MAX)
+    return 0;
+
+  for (i = 0; i < ARRAY_SIZE(rates->rates_all); i++) {
+    const mtlk_rate_pw_entry_t *rate = &rates->rates_all[i];
+    int base, target;
+    unsigned last = power->cur_cbw;
+
+    if (!rate->nss || rate->nss > power->cur_antennas ||
+        (rate->phy_mode == PHY_MODE_B && power->cur_band != MTLK_HW_BAND_2_4_GHZ) ||
+        (rate->phy_mode == PHY_MODE_AC && power->cur_band != MTLK_HW_BAND_5_2_GHZ))
+      continue;
+    base = IS_QAM256_OR_HIGHER(rate->phy_mode, rate->mcs) ?
+      power->power_hw.pw_min_ant[power->cur_cbw] :
+      power->power_hw.pw_max_ant[power->cur_cbw];
+    /* pw_size is set before statistics arrive; zero data is not a sample. */
+    if (!base)
+      continue;
+    target = base + power->cur_ant_gain + rate->pw_offs;
+    if (target <= 0)
+      continue;
+    if (rate->phy_mode == PHY_MODE_B || rate->phy_mode == PHY_MODE_AG)
+      last = CW_20;
+    else if (rate->phy_mode == PHY_MODE_N)
+      last = min_t(unsigned, last, CW_40);
+    for (width = CW_20; width <= last; width++) {
+      unsigned idx = rate->phy_mode == PHY_MODE_B ? PSDB_PHY_CW_11B :
+                     PSDB_PHY_CW_OFDM_20 + width;
+      unsigned limit = power->power_tpc_cfg.pw_limits[idx];
+      /* The single PSDB 11b entry represents all 11b rates. */
+      if (rate->phy_mode != PHY_MODE_B &&
+          !mtlk_bitrate_params_supported(rate->phy_mode, width, 0, rate->mcs, rate->nss))
+        continue;
+      if (bf && rate->phy_mode >= PHY_MODE_N)
+        limit = max_t(unsigned, limit, power->power_tpc_cfg.pw_limits[PSDB_PHY_CW_BF_20 + width]);
+      if ((mu && rate->phy_mode == PHY_MODE_AC) ||
+          (he_mu && rate->phy_mode == PHY_MODE_AX))
+        limit = max_t(unsigned, limit, power->power_tpc_cfg.pw_limits[PSDB_PHY_CW_MU_20 + width]);
+      if (limit <= power->power_usr_offs)
+        continue;
+      limit -= power->power_usr_offs;
+      maximum = max_t(unsigned, maximum, min_t(unsigned, limit, target));
+    }
+  }
+  return maximum;
+}
+
+int mtlk_core_get_tx_power(mtlk_core_t *core, int *dbm)
+{
+  wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
+  hw_psdb_t *psdb = mtlk_core_get_psdb(core);
+  mtlk_tx_power_data_t power = {};
+  mtlk_pdb_size_t size = sizeof(power.power_tpc_cfg);
+  unsigned maximum;
+  int res;
+
+  if (!psdb || !psdb->rate_pw_table)
+    return MTLK_ERR_NOT_READY;
+  res = WAVE_RADIO_PDB_GET_BINARY(radio, PARAM_DB_RADIO_TPC_PW_LIMITS_CFG,
+                                  &power.power_tpc_cfg, &size);
+  if (res != MTLK_ERR_OK || size != sizeof(power.power_tpc_cfg))
+    return MTLK_ERR_NOT_READY;
+  mtlk_hw_mhi_get_tx_power(mtlk_vap_get_hw(core->vap_handle),
+                          &power.power_hw, wave_radio_id_get(radio));
+  power.cur_band = core_cfg_get_freq_band_cfg(core);
+  power.cur_cbw = __wave_core_chandef_get(core)->width;
+  power.cur_antennas = mtlk_coc_get_current_params(__wave_core_coc_mgmt_get(core))->num_tx_antennas;
+  if (!power.cur_antennas || power.cur_antennas > PHY_STAT_RATE_NSS_MAX)
+    return MTLK_ERR_NOT_READY;
+  power.cur_ant_gain = mtlk_antennas_factor(power.cur_antennas);
+  power.power_usr_offs = WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_TX_POWER_LIMIT_OFFSET);
+  /* Unsupported legacy MU control cannot exclude VHT MU from this power
+   * envelope. Keep its limits eligible without claiming an enabled mode. */
+  maximum = _mtlk_tx_power_target_max(&power, psdb->rate_pw_table,
+    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_BF_MODE) != BF_STATE_NON_BF,
+    !mtlk_core_mu_operation_supported(core) ||
+      WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MU_OPERATION) != 0,
+    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_HE_MU_OPERATION) != 0);
+  if (!maximum)
+    return MTLK_ERR_NOT_READY;
+  *dbm = maximum / 8;
+  return MTLK_ERR_OK;
+}
