+/* Native A0 ATF is one policy per radio. The radio master serializer owns
+ * peer ADD/REMOVE and SID reservation; the card lock excludes global MU and
+ * numeric-SID TXOP writers. A host MAC lookup supplies identity, never AID.
+ */
+#define WAVE_AIRTIME_DEFAULT_WEIGHT 256
+
+struct wave_airtime_vector {
+  u16 grant[GEN6_MAX_SID];
+  u16 count;
+};
+
+static bool wave_airtime_peer_supported(const sta_info *info)
+{
+  return MTLK_BFIELD_GET(info->flags, STA_FLAGS_11ax) ||
+    !MTLK_BFIELD_GET(info->flags, STA_FLAGS_11ac) ||
+    !(MAC_TO_HOST32(info->vht_cap_info) & IEEE80211_VHT_CAP_MU_BEAMFORMEE_CAPABLE);
+}
+
+int wave_core_airtime_sta_admit(mtlk_core_t *core, const sta_info *info)
+{
+  /* The same master serializer owns both this predicate and first claim. */
+  if (!mtlk_core_get_master(core)->airtime_standard && !info->airtime_weight)
+    return MTLK_ERR_OK;
+  return mtlk_vap_is_ap(core->vap_handle) && wave_airtime_peer_supported(info) ?
+    MTLK_ERR_OK : MTLK_ERR_NOT_SUPPORTED;
+}
