+void
+core_cfg_apply_assoc_four_addr(mtlk_core_t *core,
+                               struct wave_peer_connect_request *request)
+{
+  /* The request carries peer declarations, not a policy decision made before
+   * entering the master serializer. STATIC/LIST/WDS-WPA are applied by the
+   * native station owner immediately after this association-time decision. */
+  if ((MTLK_CORE_PDB_GET_INT(core, PARAM_DB_CORE_4ADDR_MODE) == MTLK_CORE_4ADDR_DYNAMIC &&
+       request->four_addr) ||
+      (request->multi_ap_backhaul_sta &&
+       wave_df_multi_ap_backhaul(mtlk_df_get_user(mtlk_vap_get_df(core->vap_handle)))))
+    request->peer.WDS_client_type = FOUR_ADDRESSES_STATION;
+}
