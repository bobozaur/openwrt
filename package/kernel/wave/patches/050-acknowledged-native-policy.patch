+static BOOL
+_core_cfg_rts_supported(mtlk_core_t *core)
+{
+  return wave_hw_fw_feature_supported(mtlk_vap_get_hw(core->vap_handle),
+                                      WAVE_FW_FEATURE_RTS_THRESHOLD);
