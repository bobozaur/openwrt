+int core_cfg_tx_power(mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  mtlk_core_t *core = HANDLE_T_PTR(mtlk_core_t, hcore);
+  wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
+  mtlk_clpb_t *clpb = *(mtlk_clpb_t **)data;
+  const struct wave_tx_power_request *request;
+  unsigned size, user_limit, mac_limit;
+  int res = MTLK_ERR_OK, dbm = 0, *reply;
+
+  MTLK_ASSERT(data_size == sizeof(mtlk_clpb_t *));
+  if (!wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle)))
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_NOT_READY);
+  request = mtlk_clpb_enum_get_next(clpb, &size);
+  if (!request || size != sizeof(*request) || request->limit > 32767)
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_PARAMS);
+
+  if (request->operation == WAVE_TX_POWER_GET) {
+    if (!is_channel_certain(__wave_core_chandef_get(core)) ||
+        !mtlk_vap_manager_get_active_vaps_number(mtlk_vap_get_manager(core->vap_handle)))
+      return mtlk_clpb_push_res(clpb, MTLK_ERR_NOT_READY);
+    res = mtlk_core_get_tx_power(core, &dbm);
+    return mtlk_clpb_push_res_data(clpb, res, &dbm, sizeof(dbm));
+  }
+
+  user_limit = WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_USER_TX_POWER);
+  mac_limit = WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MAC_TX_POWER);
+  if (request->operation == WAVE_TX_POWER_USER) {
+    user_limit = request->limit;
+  } else if (request->operation == WAVE_TX_POWER_MAC) {
+    /* mac80211 initializes an idle STA with its existing unset ceiling.
+     * A repeated constraint is not a power change and must not initiate
+     * a same-channel transaction while scan/CSA or initial channel setup
+     * owns that operation. Every channel commit independently reapplies
+     * the saved ceiling; errors in real changes keep the quiesce path.
+     */
+    if (mac_limit == request->limit)
+      return mtlk_clpb_push_res(clpb, MTLK_ERR_OK);
+    mac_limit = request->limit;
   } else {
-      /* Store value of current tx power limit (it depends from network mode and channel width)
-       * as a current value of Tx Power in parameters DB */
-      WAVE_RADIO_PDB_SET_INT(radio, PARAM_DB_RADIO_TX_POWER_CFG, cfg_pwl.pw_limits[phy_cw]); /* power units */
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_PARAMS);
+  }
+
+  /* Reserve the result before changing acknowledged radio policy. */
+  reply = mtlk_osal_mem_alloc(sizeof(*reply), MTLK_MEM_TAG_CLPB);
+  if (!reply)
+    return MTLK_ERR_NO_MEM;
+  res = mtlk_clpb_push_nocopy(clpb, reply, sizeof(*reply));
+  if (res != MTLK_ERR_OK) {
+    mtlk_osal_mem_free(reply);
+    return res;
   }
+  res = _core_cfg_refresh_tx_power(core, user_limit, mac_limit);
+  if (res == MTLK_ERR_OK) {
+    WAVE_RADIO_PDB_SET_INT(radio, PARAM_DB_RADIO_USER_TX_POWER, user_limit);
+    WAVE_RADIO_PDB_SET_INT(radio, PARAM_DB_RADIO_MAC_TX_POWER, mac_limit);
+  }
+  *reply = res;
+  return MTLK_ERR_OK;
 }
 
