+int mtlk_core_get_tx_power(mtlk_core_t *core, int *dbm)
+{
+  wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
+  hw_psdb_t *psdb = mtlk_core_get_psdb(core);
+  mtlk_tx_power_data_t power = {};
+  mtlk_pdb_size_t size = sizeof(power.power_tpc_cfg);
+  unsigned maximum;
+  int res;
+
+  if (!psdb || !psdb->rate_pw_table)
+    return MTLK_ERR_NOT_READY;
+  res = WAVE_RADIO_PDB_GET_BINARY(radio, PARAM_DB_RADIO_TPC_PW_LIMITS_CFG,
+                                  &power.power_tpc_cfg, &size);
+  if (res != MTLK_ERR_OK || size != sizeof(power.power_tpc_cfg))
+    return MTLK_ERR_NOT_READY;
+  mtlk_hw_mhi_get_tx_power(mtlk_vap_get_hw(core->vap_handle),
+                          &power.power_hw, wave_radio_id_get(radio));
+  power.cur_band = core_cfg_get_freq_band_cfg(core);
+  power.cur_cbw = __wave_core_chandef_get(core)->width;
+  power.cur_antennas = mtlk_coc_get_current_params(__wave_core_coc_mgmt_get(core))->num_tx_antennas;
+  if (!power.cur_antennas || power.cur_antennas > PHY_STAT_RATE_NSS_MAX)
+    return MTLK_ERR_NOT_READY;
+  power.cur_ant_gain = mtlk_antennas_factor(power.cur_antennas);
+  power.power_usr_offs = WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_TX_POWER_LIMIT_OFFSET);
+  /* Unsupported legacy MU control cannot exclude VHT MU from this power
+   * envelope. Keep its limits eligible without claiming an enabled mode. */
+  maximum = _mtlk_tx_power_target_max(&power, psdb->rate_pw_table,
+    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_BF_MODE) != BF_STATE_NON_BF,
+    !mtlk_core_mu_operation_supported(core) ||
+      WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MU_OPERATION) != 0,
+    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_HE_MU_OPERATION) != 0);
+  if (!maximum)
+    return MTLK_ERR_NOT_READY;
+  *dbm = maximum / 8;
+  return MTLK_ERR_OK;
+}
