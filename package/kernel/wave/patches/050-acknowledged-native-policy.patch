+static int wave_airtime_insert(struct wave_airtime_vector *vector,
+                               const sta_info *info, unsigned weight,
+                               unsigned capacity)
+{
+  unsigned sid = info->sid;
+
+  /* The native VHT GroupManager admits only non-HE MU beamformees to the
+   * override-producing state. Its per-peer override is not the saved policy
+   * returned by the public TXOP query, so these peers cannot join this owner.
+   * HE group admission is independently gated by the actual global GET below.
+   */
+  if (!wave_airtime_peer_supported(info))
+    return MTLK_ERR_NOT_SUPPORTED;
+  if (sid >= GEN6_MAX_SID || sid >= capacity || vector->grant[sid] ||
+      !weight || weight > U16_MAX)
+    return MTLK_ERR_PARAMS;
+  vector->grant[sid] = weight;
+  vector->count++;
+  return MTLK_ERR_OK;
+}
+
+static int wave_airtime_snapshot(mtlk_core_t *core,
+                                 struct wave_airtime_vector *vector,
+                                 const sta_info *replace, unsigned weight,
+                                 const sta_info *extra, unsigned excluded_sid)
+{
+  mtlk_vap_manager_t *manager = mtlk_vap_get_manager(core->vap_handle);
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  unsigned v, maximum = 0, capacity = wave_hw_max_sid_get(hw);
+  int res = MTLK_ERR_OK;
+
+  memset(vector, 0, sizeof(*vector));
+  for (v = 0; v < mtlk_vap_manager_get_max_vaps_count(manager); v++) {
+    mtlk_vap_handle_t vap;
+    mtlk_core_t *peer_core;
+    mtlk_stadb_iterator_t iter = { 0 };
+    const sta_entry *sta;
+
+    if (mtlk_vap_manager_get_vap_handle(manager, v, &vap) != MTLK_ERR_OK)
+      continue;
+    peer_core = mtlk_vap_get_core(vap);
+    sta = mtlk_stadb_iterate_first(&peer_core->slow_ctx->stadb, &iter);
+    if (!sta) {
+      if (iter.size)
+        return MTLK_ERR_NO_MEM;
+      continue;
+    }
+    do {
+      const sta_info *info = &sta->info;
+
+      if (info->sid == excluded_sid)
+        continue;
+      if (!mtlk_vap_is_ap(vap)) {
+        res = MTLK_ERR_NOT_SUPPORTED;
+        break;
+      }
+      res = wave_airtime_insert(vector, info,
+        info == replace ? weight :
+          (info->airtime_weight ?: WAVE_AIRTIME_DEFAULT_WEIGHT), capacity);
+      if (res != MTLK_ERR_OK)
+        break;
+    } while ((sta = mtlk_stadb_iterate_next(&iter)) != NULL);
+    mtlk_stadb_iterate_done(&iter);
+    if (res != MTLK_ERR_OK)
+      return res;
+  }
+  if (extra) {
+    res = wave_airtime_insert(vector, extra,
+      extra->airtime_weight ?: WAVE_AIRTIME_DEFAULT_WEIGHT, capacity);
+    if (res != MTLK_ERR_OK)
+      return res;
+  }
+  for (v = 0; v < GEN6_MAX_SID; v++)
+    maximum = MAX(maximum, vector->grant[v]);
+  for (v = 0; v < GEN6_MAX_SID; v++) {
+    unsigned quantum;
+
+    if (!vector->grant[v])
+      continue;
+    /* The native weighted producer divides by the maximum, not the sum.
+     * Preserve its <1 quantum floor rounding, but reject the lower clamp
+     * instead of accepting a ratio the firmware would silently flatten.
+     */
+    quantum = ((u32)32767 * vector->grant[v] / maximum) >> 7;
+    if (quantum < 20)
+      return MTLK_ERR_NOT_SUPPORTED;
+  }
+  return MTLK_ERR_OK;
+}
+
+static int wave_airtime_check_modes(mtlk_core_t *core,
+                                    const struct wave_airtime_vector *vector)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  mtlk_txmm_msg_t mu_msg;
+  mtlk_txmm_data_t *mu_entry;
+  UMI_HE_MU_OPERATION_CONFIG *mu;
+  unsigned sid;
+  int status;
+
+  if (!wave_hw_fw_feature_supported(hw, WAVE_FW_FEATURE_TXOP_READ))
+    return MTLK_ERR_NOT_SUPPORTED;
+  /* Native GET stays nonzero while HE groups are enabled or draining. Do
+   * not change that policy here: the caller must disable it explicitly.
+   * The held card lock excludes enable/static-plan writes until release of
+   * the last standard owner, including from the other radio's serializer.
+   */
+  mu_entry = mtlk_txmm_msg_init_with_empty_data(&mu_msg,
+    mtlk_vap_get_txmm(core->vap_handle), NULL);
+  if (!mu_entry)
+    return MTLK_ERR_NO_RESOURCES;
+  mu_entry->id = UM_MAN_HE_MU_OPERATION_CONFIG_REQ;
+  mu_entry->payload_size = sizeof(*mu);
+  mu = (UMI_HE_MU_OPERATION_CONFIG *)mu_entry->payload;
+  memset(mu, 0, sizeof(*mu));
+  mu->getSetOperation = API_GET_OPERATION;
+  status = mtlk_txmm_msg_send_blocked(&mu_msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
+  if (status == MTLK_ERR_OK &&
+      (mu->getSetOperation != API_GET_OPERATION || mu->enableHeMuOperation))
+    status = MTLK_ERR_NOT_SUPPORTED;
+  mtlk_txmm_msg_cleanup(&mu_msg);
+  if (status != MTLK_ERR_OK)
+    return status;
+  /* Read the saved individual policy only after excluding both native MU
+   * override producers. The ATF SET still checks its effective native mode.
+   */
+  for (sid = 0; sid < GEN6_MAX_SID; sid++) {
+    mtlk_txmm_msg_t msg;
+    mtlk_txmm_data_t *entry;
+    UMI_SET_TXOP_CONFIG_t *req;
+    int res;
+
+    if (!vector->grant[sid])
+      continue;
+    entry = mtlk_txmm_msg_init_with_empty_data(&msg,
+      mtlk_vap_get_txmm(core->vap_handle), NULL);
+    if (!entry)
+      return MTLK_ERR_NO_RESOURCES;
+    entry->id = UM_MAN_SET_TXOP_CONFIG_REQ;
+    entry->payload_size = sizeof(*req);
+    req = (UMI_SET_TXOP_CONFIG_t *)entry->payload;
+    memset(req, 0, sizeof(*req));
+    req->staId = HOST_TO_MAC32(sid);
+    req->getSetOperation = API_GET_OPERATION;
+    res = mtlk_txmm_msg_send_blocked(&msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
+    if (res == MTLK_ERR_OK &&
+        (MAC_TO_HOST32(req->staId) != sid ||
+         req->getSetOperation != API_GET_OPERATION ||
+         (req->mode != UMI_TXOP_MODE_FORCED &&
+          req->mode != UMI_TXOP_MODE_DYNAMIC)))
+      res = MTLK_ERR_NOT_SUPPORTED;
+    mtlk_txmm_msg_cleanup(&msg);
+    if (res != MTLK_ERR_OK)
+      return res;
+  }
+  return MTLK_ERR_OK;
+}
+
+static int wave_airtime_send(mtlk_core_t *core,
+                             const struct wave_airtime_vector *vector,
+                             bool *submitted)
+{
+  mtlk_txmm_msg_t msg;
+  mtlk_txmm_data_t *entry;
+  UMI_ATF_QUOTAS *req;
+  unsigned sid;
+  int res;
+
+  *submitted = false;
+  entry = mtlk_txmm_msg_init_with_empty_data(&msg,
+    mtlk_vap_get_txmm(core->vap_handle), NULL);
+  if (!entry)
+    return MTLK_ERR_NO_RESOURCES;
+  entry->id = UM_MAN_ATF_QUOTAS_REQ;
+  entry->payload_size = sizeof(*req);
+  req = (UMI_ATF_QUOTAS *)entry->payload;
+  memset(req, 0, sizeof(*req));
+  req->u32interval = HOST_TO_MAC32(ATF_MIN_INTERVAL_TIME_MS);
+  req->u8AtmAlgorithemType = ATM_ALGORITHM_TYPE_WEIGHTED;
+  req->u8AtmWeightedType = ATM_WEIGHTED_TYPE_PER_STATION;
+  /* This A0 handler selects a radio from the originating VAP and consumes
+   * distribution[0] for its entire current-SID membership bitmap. */
+  req->u8nof_vaps = 1;
+  if (vector && vector->count) {
+    req->AtmDistributionType[0] = ATM_DISTRIBUTION_TYPE_DYNAMIC;
+    req->u16nof_sta = HOST_TO_MAC16(vector->count);
+    for (sid = 0; sid < GEN6_MAX_SID; sid++)
+      req->stationGrant[sid] = HOST_TO_MAC16(vector->grant[sid]);
+  }
+  *submitted = true;
+  res = mtlk_txmm_msg_send_blocked(&msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
+  if (res != MTLK_ERR_OK) {
+    /* The previous policy may already be withdrawn. An uncertain write
+     * cannot be rolled back by submitting another unowned transaction. */
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+  } else if (req->u8error_code != ATF_NO_ERRORS) {
+    res = req->u8error_code == ATF_MULTIPLE_DATA_IS_DISABLED ?
+            MTLK_ERR_NOT_SUPPORTED : MTLK_ERR_MAC;
+  }
+  mtlk_txmm_msg_cleanup(&msg);
+  return res;
+}
+
+static int wave_airtime_ready(mtlk_core_t *core)
+{
+  mtlk_core_t *master = mtlk_core_get_master(core);
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+
+  if (!mtlk_vap_is_ap(core->vap_handle) ||
+      !wave_hw_fw_feature_supported(hw, WAVE_FW_FEATURE_TXOP_READ))
+    return MTLK_ERR_NOT_SUPPORTED;
+  if (!wave_hw_mmb_ready(hw) || mtlk_core_rcvry_is_running(core) ||
+      wave_rcvry_mac_fatal_pending_get(hw) || master->airtime_vendor)
+    return MTLK_ERR_BUSY;
+  return MTLK_ERR_OK;
+}
+
+static int _wave_core_airtime_weight(mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  mtlk_core_t *core = HANDLE_T_PTR(mtlk_core_t, hcore);
+  mtlk_core_t *master = mtlk_core_get_master(core);
+  mtlk_clpb_t *clpb = *(mtlk_clpb_t **)data;
+  const struct wave_airtime_weight_request *request;
+  struct wave_airtime_vector *old = NULL, *next = NULL;
+  sta_entry *sta = NULL;
+  unsigned size;
+  int res, rollback, *reply;
+  bool submitted, old_applied, old_standard;
+
+  MTLK_ASSERT(data_size == sizeof(mtlk_clpb_t *));
+  request = mtlk_clpb_enum_get_next(clpb, &size);
+  if (!request || size != sizeof(*request) || !request->weight)
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_PARAMS);
+  /* Reserve the result before a firmware update can commit. */
+  reply = mtlk_osal_mem_alloc(sizeof(*reply), MTLK_MEM_TAG_CLPB);
+  if (!reply)
+    return MTLK_ERR_NO_MEM;
+  res = mtlk_clpb_push_nocopy(clpb, reply, sizeof(*reply));
+  if (res != MTLK_ERR_OK) {
+    mtlk_osal_mem_free(reply);
+    return res;
+  }
+  res = wave_airtime_ready(core);
+  if (res != MTLK_ERR_OK)
+    goto end;
+  sta = mtlk_stadb_find_sta(&core->slow_ctx->stadb, request->addr.au8Addr);
+  if (!sta) {
+    res = MTLK_ERR_NO_ENTRY;
+    goto end;
+  }
+  if (master->airtime_standard &&
+      smp_load_acquire(&master->airtime_applied) &&
+      (sta->info.airtime_weight ?: WAVE_AIRTIME_DEFAULT_WEIGHT) == request->weight) {
+    res = MTLK_ERR_OK;
+    goto end;
+  }
+  old = kzalloc(sizeof(*old), GFP_KERNEL);
+  next = kzalloc(sizeof(*next), GFP_KERNEL);
+  if (!old || !next) {
+    res = MTLK_ERR_NO_MEM;
+    goto end;
+  }
+  res = wave_airtime_snapshot(core, old, NULL, 0, NULL, DB_UNKNOWN_SID);
+  if (res == MTLK_ERR_OK)
+    res = wave_airtime_snapshot(core, next, &sta->info, request->weight,
+                                NULL, DB_UNKNOWN_SID);
+  if (res == MTLK_ERR_OK)
+    res = wave_airtime_check_modes(master, next);
+  if (res != MTLK_ERR_OK)
+    goto end;
+
+  old_standard = master->airtime_standard;
+  old_applied = master->airtime_applied;
+  WRITE_ONCE(master->airtime_applied, false);
+  res = wave_airtime_send(master, next, &submitted);
+  if (res == MTLK_ERR_OK) {
+    WRITE_ONCE(sta->info.airtime_weight, request->weight);
+    master->airtime_standard = true;
+    wave_hw_airtime_mark(mtlk_vap_get_hw(core->vap_handle),
+                        wave_vap_radio_id_get(core->vap_handle), true);
+    smp_store_release(&master->airtime_applied, true);
+  } else if (!submitted) {
+    smp_store_release(&master->airtime_applied, old_applied);
+  } else if (wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle))) {
+    /* An acknowledged rejection can already have disabled the old vector.
+     * Restore its whole mapping; do not merely roll back a host cache. */
+    rollback = wave_airtime_send(master, old_standard ? old : NULL, &submitted);
+    if (rollback != MTLK_ERR_OK)
+      wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+    else
+      smp_store_release(&master->airtime_applied, old_standard);
+  }
+end:
+  if (sta)
+    mtlk_sta_decref(sta);
+  kfree(next);
+  kfree(old);
+  *reply = res;
+  return MTLK_ERR_OK;
+}
+
+static int _wave_core_airtime_sta_added(mtlk_core_t *core, const sta_info *info)
+{
+  mtlk_core_t *master = mtlk_core_get_master(core);
+  struct wave_airtime_vector *next;
+  bool submitted, old_applied;
+  int res;
+
+  if (!master->airtime_standard && !info->airtime_weight)
+    return MTLK_ERR_OK;
+  res = wave_airtime_ready(core);
+  if (res != MTLK_ERR_OK)
+    return res;
+  next = kzalloc(sizeof(*next), GFP_KERNEL);
+  if (!next)
+    return MTLK_ERR_NO_MEM;
+  res = wave_airtime_snapshot(core, next, NULL, 0, info, DB_UNKNOWN_SID);
+  if (res == MTLK_ERR_OK)
+    res = wave_airtime_check_modes(master, next);
+  if (res == MTLK_ERR_OK) {
+    old_applied = master->airtime_applied;
+    WRITE_ONCE(master->airtime_applied, false);
+    res = wave_airtime_send(master, next, &submitted);
+    if (res == MTLK_ERR_OK) {
+      master->airtime_standard = true;
+      wave_hw_airtime_mark(mtlk_vap_get_hw(core->vap_handle),
+                          wave_vap_radio_id_get(core->vap_handle), true);
+      smp_store_release(&master->airtime_applied, true);
+    } else if (!submitted) {
+      smp_store_release(&master->airtime_applied, old_applied);
+    } else if (!master->airtime_standard &&
+               wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle))) {
+      bool disabled;
+
+      if (wave_airtime_send(master, NULL, &disabled) != MTLK_ERR_OK)
+        wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+    }
+    /* The caller owns rollback of this just-added native peer. When a
+     * previous standard policy existed, its REMOVE hook restores the old
+     * vector only after the new SID has left native ATF membership. */
+  }
+  kfree(next);
+  return res;
+}
+
+static int _wave_core_airtime_pause(mtlk_core_t *core, bool *paused)
+{
+  mtlk_core_t *master = mtlk_core_get_master(core);
+  bool submitted;
+  int res;
+
+  *paused = false;
+  if (!master->airtime_standard)
+    return MTLK_ERR_OK;
+  if (!wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle)))
+    return MTLK_ERR_NOT_READY;
+  res = wave_airtime_send(master, NULL, &submitted);
+  if (res == MTLK_ERR_OK) {
+    WRITE_ONCE(master->airtime_applied, false);
+    *paused = true;
+  } else if (submitted) {
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+  }
+  return res;
+}
+
+static int _wave_core_airtime_resume(mtlk_core_t *core, unsigned excluded_sid)
+{
+  mtlk_core_t *master = mtlk_core_get_master(core);
+  struct wave_airtime_vector *next;
+  bool submitted;
+  int res;
+
+  if (!master->airtime_standard)
+    return MTLK_ERR_OK;
+  if (!wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle)))
+    return MTLK_ERR_NOT_READY;
+  WRITE_ONCE(master->airtime_applied, false);
+  next = kzalloc(sizeof(*next), GFP_KERNEL);
+  if (!next) {
+    res = MTLK_ERR_NO_MEM;
+    goto failed;
+  }
+  res = wave_airtime_snapshot(core, next, NULL, 0, NULL, excluded_sid);
+  if (res == MTLK_ERR_OK && next->count)
+    res = wave_airtime_check_modes(master, next);
+  if (res == MTLK_ERR_OK && next->count)
+    res = wave_airtime_send(master, next, &submitted);
+  if (res == MTLK_ERR_OK) {
+    master->airtime_standard = next->count != 0;
+    wave_hw_airtime_mark(mtlk_vap_get_hw(core->vap_handle),
+                        wave_vap_radio_id_get(core->vap_handle), next->count != 0);
+    smp_store_release(&master->airtime_applied, next->count != 0);
+  }
+  kfree(next);
+failed:
+  if (res != MTLK_ERR_OK)
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+  return res;
+}
+
+void wave_core_airtime_reset(mtlk_core_t *core)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+
+  if (!mtlk_vap_is_master(core->vap_handle))
+    return;
+  /* Recovery has retired the old firmware and every STADB incarnation.
+   * New peer admission/hostapd supplies new weights; never reuse old SIDs. */
+  wave_hw_airtime_lock(hw);
+  wave_hw_airtime_mark(hw, wave_vap_radio_id_get(core->vap_handle), false);
+  core->airtime_standard = false;
+  core->airtime_vendor = false;
+  smp_store_release(&core->airtime_applied, false);
+  wave_hw_airtime_unlock(hw);
+}
+
+int wave_core_airtime_weight(mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  mtlk_core_t *core = HANDLE_T_PTR(mtlk_core_t, hcore);
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  int res;
+
+  wave_hw_airtime_lock(hw);
+  res = _wave_core_airtime_weight(hcore, data, data_size);
+  wave_hw_airtime_unlock(hw);
+  return res;
+}
+
+int wave_core_airtime_sta_added(mtlk_core_t *core, const sta_info *info)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  int res;
+
+  wave_hw_airtime_lock(hw);
+  res = _wave_core_airtime_sta_added(core, info);
+  wave_hw_airtime_unlock(hw);
+  return res;
+}
+
+int wave_core_airtime_pause(mtlk_core_t *core, bool *paused)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  int res;
+
+  wave_hw_airtime_lock(hw);
+  res = _wave_core_airtime_pause(core, paused);
+  wave_hw_airtime_unlock(hw);
+  return res;
+}
+
+int wave_core_airtime_resume(mtlk_core_t *core, unsigned excluded_sid)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  int res;
+
+  wave_hw_airtime_lock(hw);
+  res = _wave_core_airtime_resume(core, excluded_sid);
+  wave_hw_airtime_unlock(hw);
+  return res;
+}
