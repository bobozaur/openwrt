+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef WAVE_RTS_THRESHOLD_H
+#define WAVE_RTS_THRESHOLD_H
+
+/* A separately typed extension of the persistent host/lower transport.
+ * Admit the actual upper route and both lower implementations before use.
+ */
+#define WAVE_RTS_ABI       1
+#define WAVE_RTS_MAGIC     0xa6
+#define WAVE_RTS_STAGE     0x90
+#define WAVE_RTS_DISABLE   0x91
+#define WAVE_RTS_QUERY     0x92
