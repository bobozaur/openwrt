@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Private, unselected W15 candidate. This is a NEW paired host/firmware ABI.
+ * It is not the four-byte OEM FixedPower_t ABI and must never be submitted
+ * unless the exact loaded firmware implementation has been admitted.
+ */
+#ifndef AX50_FIXED_DATA_ABI_H
+#define AX50_FIXED_DATA_ABI_H
+
+#define AX50_FIXED_DATA_ABI             1
+#define AX50_FIXED_DATA_MAGIC           0xa5
+#define AX50_FIXED_DATA_STAGE           0x80
+#define AX50_FIXED_DATA_DISABLE         0x81
+#define AX50_FIXED_DATA_QUERY           0x82
+#define AX50_FIXED_DATA_REPLAY          0x83
+#define AX50_FIXED_DATA_INCLUDE_11B     0x01
+
+#define AX50_FIXED_DATA_OK              0
+#define AX50_FIXED_DATA_BAD_REQUEST     1
+#define AX50_FIXED_DATA_CONFLICT        2
+#define AX50_FIXED_DATA_UNREPRESENTABLE 3
+#define AX50_FIXED_DATA_NOT_READY       4
+
+/* Byte units are one half dBm. This first ABI admits6..31.5dBm, exactly
+ * representable without rounding. Its minimum covers the maximum admitted
+ * two-chain/calibration correction12 and keeps the native unsigned DL-group
+ * byte nonnegative. It does not assume an unproved signed group encoding.
+ * These are protocol limits, not a claim about RF measurement resolution.
+ */
+#define AX50_FIXED_DATA_MIN_HALF_DBM    12
+#define AX50_FIXED_DATA_MAX_HALF_DBM    63
+
+struct ax50_fixed_data_request {
+  /* Only INCLUDE_11B is defined. The host derives it from the admitted
+   * destination channel; the original UMI header still owns VAP/radio
+   * routing. A zero/unconfigured 11b table on 5 GHz is not a power ceiling.
+   */
+  unsigned char policy_flags;
+  unsigned char magic;
+  unsigned char half_dbm;
+  unsigned char operation;
+  unsigned char status;
+  unsigned char abi;
+  unsigned char active;
+  /* Zero in every request; returned current admissible aggregate ceiling
+   * in QUERY. It is a configured/calibrated bound, not measured RF power.
+   */
+  unsigned char admissible_half_dbm;
+};
+
+/* 0x147c acknowledges only validated staging. The host may acknowledge a
+ * standard FIXED change only after the existing full ST_NORMAL channel
+ * transaction has completed, including the lower 0x212 refresh and paired
+ * group publication. A stage timeout or later refresh failure must retain
+ * the previous host policy and quiesce/recover the affected native owner.
+ * QUERY is an explicit new non-mutating operation, not OEM getSetOperation.
+ * REPLAY is for the host's last acknowledged policy during the existing
+ * channel/recovery owner. A later lower legal/calibration ceiling may clamp
+ * that policy; a new user STAGE above the ceiling is rejected after212 and
+ * invokes the host's existing quiesce/recovery path, without a cache commit.
+ */
+#endif
