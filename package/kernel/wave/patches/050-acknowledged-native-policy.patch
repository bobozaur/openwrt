+     * existing quiesce path. */
+    if (mtlk_core_scan_is_running(core) || mtlk_core_is_in_scan_mode(core) ||
+        __mtlk_core_is_chan_switch_type_csa_with_block_tx(core) ||
+        wave_radio_cac_active(radio) || wave_radio_dfs_tx_blocked(radio) ||
+        (core->slow_ctx->is_block_tx && cd->wait_for_beacon))
+      return MTLK_ERR_BUSY;
+    if (!is_channel_certain(cd))
+      return MTLK_ERR_NOT_READY;
+
+    /* The current channel is copied inside the common owner before it is
+     * marked uncertain. Its checked SET_CHANNEL completion follows the
+     * calibrated-limit and peer DATA refresh, unlike SET_TPC_CONFIG alone.
+     * USER/MAC caches are committed by the caller only after this returns. */
+    return _core_cfg_send_set_chan(core, cd, NULL, user_limit, mac_limit, TRUE,
+                                    fixed, new_fixed_request, rts_threshold);
+  }
+
+  if (!is_channel_certain(cd))
+    return MTLK_ERR_OK;
+  core_cfg_country_code_get(core, &country);
+  return _core_cfg_apply_tx_power(core, cd->center_freq1, cd->width,
+                                  cd->chan.center_freq, country,
+                                  user_limit, mac_limit, FALSE, TRUE);
+}
