+int wave_core_set_txq_params(mtlk_df_t *df, const struct mtlk_txq_params *params)
+{
+  mtlk_vap_handle_t vap = mtlk_df_get_vap_handle(df);
+  mtlk_df_t *master_df = mtlk_vap_manager_get_master_df(mtlk_vap_get_manager(vap));
+  struct mtlk_wmm_settings settings = {
+    .vap_id = mtlk_vap_get_id(vap),
+    .txq_params = *params,
+  };
+  unsigned attempt;
+  int res;
+
+  for (attempt = 0; attempt < MAX_SCAN_WAIT_RETRIES; attempt++) {
+    mtlk_clpb_t *clpb = NULL;
+
+    res = _mtlk_df_user_invoke_core(master_df, WAVE_CORE_REQ_SET_WMM_PARAM,
+                                   &clpb, &settings, sizeof(settings));
+    res = _mtlk_df_user_process_core_retval(res, clpb, WAVE_CORE_REQ_SET_WMM_PARAM, TRUE);
+    if (res != MTLK_ERR_RETRY)
+      return res;
+    mtlk_osal_msleep(50);
+  }
+  return res;
+}
