+/* Both role wiphys submit to one radio policy and master serializer. Cold
+ * policy is replayed by the ordinary channel owner before TX. Active updates
+ * commit the cache only after the complete stage/channel/query transaction.
+ */
+int core_cfg_rts_threshold(mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  mtlk_core_t *core = HANDLE_T_PTR(mtlk_core_t, hcore);
+  wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
+  mtlk_clpb_t *clpb = *(mtlk_clpb_t **)data;
+  const uint32 *threshold;
+  unsigned size;
+  int res, *reply;
+
+  MTLK_ASSERT(data_size == sizeof(mtlk_clpb_t *));
+  if (!wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle)))
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_NOT_READY);
+  threshold = mtlk_clpb_enum_get_next(clpb, &size);
+  if (!threshold || size != sizeof(*threshold) ||
+      (*threshold != WAVE_RTS_DISABLED && *threshold > WAVE_RTS_MAX))
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_PARAMS);
+  if ((uint32)WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_RTS_THRESH) == *threshold)
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_OK);
+  if (!_core_cfg_rts_supported(core))
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_NOT_SUPPORTED);
+  /* Reserve the result before changing acknowledged radio policy. */
+  reply = mtlk_osal_mem_alloc(sizeof(*reply), MTLK_MEM_TAG_CLPB);
+  if (!reply)
+    return MTLK_ERR_NO_MEM;
+  res = mtlk_clpb_push_nocopy(clpb, reply, sizeof(*reply));
+  if (res != MTLK_ERR_OK) {
+    mtlk_osal_mem_free(reply);
+    return res;
+  }
+  res = _core_cfg_refresh_radio_policy(core,
+      WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_USER_TX_POWER),
+      WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MAC_TX_POWER),
+      WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_USER_TX_POWER_FIXED), FALSE,
+      *threshold);
+  if (res == MTLK_ERR_OK)
+    WAVE_RADIO_PDB_SET_INT(radio, PARAM_DB_RADIO_RTS_THRESH, *threshold);
+  *reply = res;
+  return MTLK_ERR_OK;
+}
