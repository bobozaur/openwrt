--- a/wireless/driver/linux/wave_radio.c
+++ b/wireless/driver/linux/wave_radio.c
@@ -231,6 +231,7 @@
   BOOL                  is_interfdet_enabled; /* Interference Detection */
   BOOL                  init_done;
   bool                  control_ready;
+  unsigned int          master_ifindex;
   bool                  watchdog_started, watchdog_replied;
   unsigned long         watchdog_started_at, watchdog_last_reply;
   BOOL                  sta_vifs_exist;
@@ -610,6 +611,7 @@
     wave_radio_t *radio = &radio_descr->radio[i];
     struct wiphy *wiphy = wv_cfg80211_wiphy_get(radio->cfg80211);
     wiphy_lock(wiphy);
+    WRITE_ONCE(radio->master_ifindex, 0);
     smp_store_release(&radio->control_ready, false);
     wiphy_unlock(wiphy);
   }
@@ -652,8 +654,11 @@
     rtnl_lock();
     wiphy_lock(wiphy);
     res = wave_df_register_netdev_locked(mtlk_df_get_user(wave_radio_df_get(radio)));
-    if (!res)
+    if (!res) {
+      WRITE_ONCE(radio->master_ifindex,
+        mtlk_df_user_get_ndev(mtlk_df_get_user(wave_radio_df_get(radio)))->ifindex);
       smp_store_release(&radio->control_ready, true);
+    }
     wiphy_unlock(wiphy);
     rtnl_unlock();
     if (res) {
@@ -964,6 +969,13 @@
 }
 
 /*** Context accessors ***/
+
+/* Copy only the published index: sysfs must not follow a master netdev
+ * pointer while teardown is unregistering and freeing that interface. */
+unsigned int wave_radio_master_ifindex_get(wave_radio_t *radio)
+{
+  return READ_ONCE(radio->master_ifindex);
+}
 
 bool wave_radio_control_ready_get(wave_radio_t *radio)
 {
