Subject: [PATCH] expose a stable LED trigger for each physical radio

--- a/wireless/driver/linux/wave_radio.c
+++ b/wireless/driver/linux/wave_radio.c
@@ -20,6 +20,7 @@
 #include "mtlkinc.h"
 #include <net/cfg80211.h>
 #include <linux/unaligned.h>
+#include <linux/leds.h>
 
 #include "mtlk_coreui.h"
 #include "mtlk_fast_mem.h"
@@ -247,6 +248,10 @@
   BOOL                  init_done;
   bool                  control_ready;
   unsigned int          master_ifindex;
+  struct led_trigger   *radio_led;
+  char                  radio_led_name[64];
+  spinlock_t            radio_led_lock;
+  bool                  radio_led_ap;
   bool                  watchdog_started, watchdog_replied;
   unsigned long         watchdog_started_at, watchdog_last_reply;
   BOOL                  sta_vifs_exist;
@@ -293,6 +298,7 @@
 MTLK_START_STEPS_LIST_BEGIN(wave_radio)
   MTLK_START_STEPS_LIST_ENTRY(wave_radio, WAVE_RADIO_PDB_INIT)
   MTLK_START_STEPS_LIST_ENTRY(wave_radio, WAVE_RADIO_CONTEXT_INIT)
+  MTLK_START_STEPS_LIST_ENTRY(wave_radio, WAVE_RADIO_LED_INIT)
   MTLK_START_STEPS_LIST_ENTRY(wave_radio, WAVE_RADIO_ABMGR_INIT)
   MTLK_START_STEPS_LIST_ENTRY(wave_radio, WAVE_RADIO_ABMGR_REGISTER)
 
@@ -340,6 +346,7 @@
 
 static int _wave_radio_create(wave_radio_t *radio, mtlk_work_mode_e work_mode)
 {
+  spin_lock_init(&radio->radio_led_lock);
   MTLK_INIT_TRY(wave_radio, MTLK_OBJ_PTR(radio));
     MTLK_INIT_STEP_EX(wave_radio, WAVE_RADIO_CFG80211_CREATE, MTLK_OBJ_PTR(radio),
                       wv_cfg80211_create, (),
@@ -1157,6 +1164,52 @@
   wave_radio_cac_arm(radio, 0, true);
 }
 
+/* One trigger follows the physical radio across AP/STA wiphy changes. The
+ * device name and hardware radio index are independent of probe ordering.
+ */
+static void wave_radio_led_init(wave_radio_t *radio, struct device *dev)
+{
+  snprintf(radio->radio_led_name, sizeof(radio->radio_led_name),
+           "wave-%s-%u-radio", dev_name(dev), radio->idx);
+  led_trigger_register_simple(radio->radio_led_name, &radio->radio_led);
+}
+
+static void wave_radio_led_cleanup(wave_radio_t *radio)
+{
+  struct led_trigger *trigger;
+  unsigned long flags;
+
+  spin_lock_irqsave(&radio->radio_led_lock, flags);
+  trigger = radio->radio_led;
+  radio->radio_led = NULL;
+  spin_unlock_irqrestore(&radio->radio_led_lock, flags);
+  led_trigger_unregister_simple(trigger);
+}
+
+/* Both role owners hold radio_led_lock when publishing their combined state. */
+static void wave_radio_led_event(wave_radio_t *radio)
+{
+  led_trigger_event(radio->radio_led,
+    wave_hw_mmb_ready(radio->hw_api->hw) &&
+    (radio->radio_led_ap || radio->sta_vifs_exist) ? LED_FULL : LED_OFF);
+}
+
+void wave_radio_leds_off(wave_radio_descr_t *descr)
+{
+  unsigned int i;
+  unsigned long flags;
+
+  if (!descr)
+    return;
+  for (i = 0; i < descr->num_radios; i++) {
+    wave_radio_t *radio = &descr->radio[i];
+
+    spin_lock_irqsave(&radio->radio_led_lock, flags);
+    led_trigger_event(radio->radio_led, LED_OFF);
+    spin_unlock_irqrestore(&radio->radio_led_lock, flags);
+  }
+}
+
 static void _wave_radio_deinit(wave_radio_t *radio)
 {
   MTLK_STOP_BEGIN(wave_radio, MTLK_OBJ_PTR(radio))
@@ -1195,6 +1248,8 @@
                    _wave_radio_ab_unregister, (radio));
     MTLK_STOP_STEP(wave_radio, WAVE_RADIO_ABMGR_INIT, MTLK_OBJ_PTR(radio),
                    mtlk_abmgr_delete, (radio->abmgr));
+    MTLK_STOP_STEP(wave_radio, WAVE_RADIO_LED_INIT, MTLK_OBJ_PTR(radio),
+                   wave_radio_led_cleanup, (radio));
     MTLK_STOP_STEP(wave_radio, WAVE_RADIO_CONTEXT_INIT, MTLK_OBJ_PTR(radio),
                    MTLK_NOACTION, ());
     MTLK_STOP_STEP(wave_radio, WAVE_RADIO_PDB_INIT, MTLK_OBJ_PTR(radio),
@@ -1238,6 +1293,8 @@
 
     MTLK_START_STEP(wave_radio, WAVE_RADIO_CONTEXT_INIT, MTLK_OBJ_PTR(radio),
                     _wave_radio_context_init, (radio));
+    MTLK_START_STEP_VOID(wave_radio, WAVE_RADIO_LED_INIT, MTLK_OBJ_PTR(radio),
+                         wave_radio_led_init, (radio, dev));
 
     MTLK_START_STEP_EX(wave_radio, WAVE_RADIO_ABMGR_INIT, MTLK_OBJ_PTR(radio),
                        mtlk_abmgr_create, (),
@@ -4713,8 +4770,13 @@
 void __MTLK_IFUNC
 wave_radio_set_sta_vifs_exist(wave_radio_t *radio, BOOL sta_exists)
 {
+  unsigned long flags;
+
   MTLK_ASSERT(radio != NULL);
+  spin_lock_irqsave(&radio->radio_led_lock, flags);
   radio->sta_vifs_exist = sta_exists;
+  wave_radio_led_event(radio);
+  spin_unlock_irqrestore(&radio->radio_led_lock, flags);
 }
 
 BOOL __MTLK_IFUNC
@@ -4722,6 +4784,28 @@
 {
   MTLK_ASSERT(radio != NULL);
   return radio->sta_vifs_exist;
+}
+
+/* Called on the master serializer after completed AP start/stop. A control
+ * VAP used for scanning or channel preparation is not an active AP BSS.
+ */
+void wave_radio_led_ap_update(wave_radio_t *radio)
+{
+  unsigned int i, count = mtlk_vap_manager_get_max_vaps_count(radio->vap_manager);
+  mtlk_vap_handle_t vap;
+  unsigned long flags;
+  bool active = false;
+
+  for (i = 0; i < count; i++)
+    if (mtlk_vap_manager_get_vap_handle(radio->vap_manager, i, &vap) == MTLK_ERR_OK &&
+        mtlk_vap_is_ap(vap) && mtlk_vap_get_core(vap)->slow_ctx->ap_started) {
+      active = true;
+      break;
+    }
+  spin_lock_irqsave(&radio->radio_led_lock, flags);
+  radio->radio_led_ap = active;
+  wave_radio_led_event(radio);
+  spin_unlock_irqrestore(&radio->radio_led_lock, flags);
 }
 
 /* These predicates run on the physical radio's master serializer. */
--- a/wireless/driver/linux/wave_radio.h
+++ b/wireless/driver/linux/wave_radio.h
@@ -136,6 +136,11 @@
 void wave_radio_destroy(wave_radio_descr_t *radio_descr);
 void wave_radio_deinit(wave_radio_descr_t *radio_descr);
 void wave_radio_deinit_finalize(wave_radio_descr_t *radio_descr);
+/* AP state is published by the master serializer; terminal hardware shutdown
+ * turns both role indicators off before draining the remaining producers.
+ */
+void wave_radio_led_ap_update(wave_radio_t *radio);
+void wave_radio_leds_off(wave_radio_descr_t *radio_descr);
 void wave_radio_prepare_stop(wave_radio_descr_t *radio_descr);
 void wave_radio_mac80211_deinit(wave_radio_descr_t *radio_descr);
 
--- a/wireless/driver/linux/core.c
+++ b/wireless/driver/linux/core.c
@@ -3556,6 +3556,8 @@
       /* Initial template was validated and cached before ADD_VAP. Submit only
        * now, so a failed admission never gives firmware an unowned DMA buffer. */
       res = wave_beacon_man_beacon_update(hcore, NULL, 0);
+      if (res == MTLK_ERR_OK)
+        wave_radio_led_ap_update(radio);
     }
   }
   MTLK_CLPB_FINALLY(res) {
@@ -3702,6 +3704,7 @@
     res = deactivate_res;
   if (nic->is_stopped || !wave_hw_mmb_ready(mtlk_vap_get_hw(nic->vap_handle))) {
     nic->slow_ctx->ap_started = false;
+    wave_radio_led_ap_update(wave_vap_radio_get(nic->vap_handle));
     nic->slow_ctx->ap_preparing = false;
     nic->slow_ctx->sta_connecting = false;
     wave_beacon_man_stop(nic);
--- a/wireless/driver/shared/hw_mmb.c
+++ b/wireless/driver/shared/hw_mmb.c
@@ -6990,6 +6990,8 @@
   _mtlk_mmb_stop_events_completely(hw);
   mtlk_ccr_disable_interrupts(hw->ccr, MTLK_IRQ_ALL);
   mtlk_osal_lock_release_irq(&hw->reg_lock, flags);
+
+  wave_radio_leds_off(hw->radio_descr);
 
   /* Firmware cannot answer once terminal shutdown starts. Reject new work,
    * wake blocked control senders and stop timeouts before draining cores. */
