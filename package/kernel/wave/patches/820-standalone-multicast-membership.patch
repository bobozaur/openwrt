+#ifndef _WAVE_MC_POLICY_H_
+#define _WAVE_MC_POLICY_H_
+
+#include <linux/gfp.h>
+#include <linux/in6.h>
+#include <linux/types.h>
+
+struct _sta_entry;
+struct wave_mc_policy;
+
+union wave_mc_ip {
+  __be32 ip4;
+  struct in6_addr ip6;
+};
+
+struct wave_mc_key {
+  u32 vlan;
+  __be16 proto;
+  union wave_mc_ip group;
+};
+
+/* IGMPv3 and MLDv2 use these same record numbers. */
+enum wave_mc_record {
+  WAVE_MC_IS_INCLUDE = 1,
+  WAVE_MC_IS_EXCLUDE,
+  WAVE_MC_TO_INCLUDE,
+  WAVE_MC_TO_EXCLUDE,
+  WAVE_MC_ALLOW,
+  WAVE_MC_BLOCK,
+  WAVE_MC_ASM_JOIN,
+  WAVE_MC_ASM_LEAVE,
+};
+
+#define WAVE_MC_MAX_GROUPS 128
+#define WAVE_MC_MAX_REPORTERS 512
+#define WAVE_MC_MAX_SOURCES 4096
+#define WAVE_MC_QUERY_SOURCES 64
+
+/* All calls after create, including callbacks, require the caller's multicast
+ * lock. The caller owns timer/work scheduling, packet validation, VLAN identity,
+ * firmware admission. There is no private workqueue.
+ * Each reporter holds the exact station incarnation until drop/clear/destroy.
+ * Sources are packed network-order IPv4 (4-byte) or IPv6 (16-byte) addresses.
+ */
+struct wave_mc_policy *wave_mc_policy_create(gfp_t flags);
+void wave_mc_policy_destroy(struct wave_mc_policy *policy);
+void wave_mc_policy_clear(struct wave_mc_policy *policy);
+
+/* Activate only a protocol/VLAN domain known to the caller's live interface or
+ * validated traffic. This starts general queries before any membership exists,
+ * retaining untagged interface domains until clear/destroy. Tagged activation
+ * expires one learned membership interval after its last observed activity;
+ * live membership or an external querier independently retains the domain.
+ * Repeated activation refreshes only activity, preserving query cadence,
+ * learned intervals and election. Returns 1 when newly activated, 0 when
+ * already active, or a negative errno on failure; creates no reporter/station.
+ */
+int wave_mc_policy_activate(struct wave_mc_policy *policy, u32 vlan,
+                            __be16 proto, unsigned long now);
+
+/* Failure leaves the previous complete record intact. The caller must close
+ * its forwarding/admission contribution with drop_reporter before continuing
+ * after an allocation/capacity failure; other reporters remain independent.
+ */
+int wave_mc_policy_report(struct wave_mc_policy *policy,
+                          const struct wave_mc_key *key,
+                          struct _sta_entry *sta, const u8 reporter[6],
+                          u8 type, const void *sources, unsigned int nsrc,
+                          unsigned long now);
+void wave_mc_policy_drop_reporter(struct wave_mc_policy *policy,
+                                  const struct wave_mc_key *key,
+                                  struct _sta_entry *sta,
+                                  const u8 reporter[6]);
+void wave_mc_policy_drop_sta(struct wave_mc_policy *policy,
+                             struct _sta_entry *sta);
+
+/* key.group == zero identifies a general query. Supply validated external
+ * queries, never a locally generated query echo. The domain elects the lowest
+ * external source (IPv4 elected zero is replaceable, as in the Linux bridge).
+ * Native queries are a fallback subordinate to observed external queriers,
+ * including IPv6; this is not election against the interface's own LL address.
+ * QRV/QQI zero retain the learned value; maxresp is already decoded to jiffies.
+ * A suppressed query does not lower group/source timers.
+ */
+int wave_mc_policy_query(struct wave_mc_policy *policy,
+                         const struct wave_mc_key *key,
+                         const union wave_mc_ip *querier_source,
+                         const void *sources, unsigned int nsrc, u8 qrv,
+                         unsigned long qqi, unsigned long maxresp,
+                         bool suppress, unsigned long now);
+void wave_mc_policy_expire(struct wave_mc_policy *policy, unsigned long now);
+u64 wave_mc_policy_generation(const struct wave_mc_policy *policy);
+bool wave_mc_policy_next_deadline(const struct wave_mc_policy *policy,
+                                  unsigned long *deadline);
+
+typedef void (*wave_mc_receiver_fn)(void *ctx, struct _sta_entry *sta);
+/* Reports the union of matching hosts; a station may be reported more than once.
+ * A receiver pointer is borrowed under the lock. Retain a station reference
+ * before using it after the callback. No aggregate-air filtering is implied.
+ */
+void wave_mc_policy_foreach_receiver(struct wave_mc_policy *policy,
+                                     const struct wave_mc_key *key,
+                                     const union wave_mc_ip *source,
+                                     unsigned long now,
+                                     wave_mc_receiver_fn receive, void *ctx);
+
+typedef int (*wave_mc_query_fn)(void *ctx, const struct wave_mc_key *key,
+                               const void *sources, unsigned int nsrc,
+                               u8 qrv, unsigned long qqi,
+                               unsigned long maxresp, bool suppress);
+/* emit returns zero only after accepting ownership for prompt TX. It must not
