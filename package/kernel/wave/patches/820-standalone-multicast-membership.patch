+static int _wave_mc_queue_locked(mtlk_core_t *nic, mc_action_t action, int group,
+                                  sta_entry *sta, const mtlk_mc_addr_t *addr);
+
+/* Host membership is published only after hardware admission. Retry an
+ * undefined ID instead of treating a previous allocation failure as success.
+ * Existing members need JOINs if a previously undefined group is recovered. */
+static BOOL
+_mtlk_mc_admit_group (mtlk_core_t *nic, mtlk_mc_addr_t *addr,
+                     mcast_group_info_t *info, int requested)
+{
+  mcast_sta_t *mcsta;
+
+  if (info->grp_id != MCAST_GROUP_UNDEF)
+    return requested == MCAST_GROUP_UNDEF || requested == info->grp_id;
+  info->grp_id = mtlk_core_mcast_handle_grid(nic, addr, MTLK_GRID_ADD, requested);
+  if (info->grp_id == MCAST_GROUP_UNDEF)
+    return FALSE;
+  for (mcsta = info->mcsta; mcsta; mcsta = mcsta->next) {
+    if (_wave_mc_queue_locked(nic, MTLK_MC_STA_JOIN_GROUP, info->grp_id,
+                               mcsta->sta, addr) != MTLK_ERR_OK) {
+      /* The lock prevents earlier queued JOINs from validating this rolled
+       * back admission. Their pins keep the old ID retired until they finish. */
+      mtlk_core_mcast_handle_grid(nic, addr, MTLK_GRID_DEL, info->grp_id);
+      info->grp_id = MCAST_GROUP_UNDEF;
+      return FALSE;
+    }
+  }
+  return TRUE;
+}
