+/* Host groups, commands, applied memberships and TX descriptors each own
+ * their lifetime independently. A retiring ID is not available even to the
+ * same key until every prior owner has drained. Quarantine lasts this probe. */
+BOOL wave_hw_mc_get(mtlk_hw_t *hw, uint8 id, BOOL pin)
+{
+  mtlk_hw_mc_t *group;
+  BOOL valid = FALSE;
+
+  if (id < MC_MIN_GROUP || id >= MC_GROUPS)
+    return FALSE;
+  mtlk_osal_lock_acquire(&hw->mc_group_lock);
+  group = &hw->mc_groups[id];
+  if (!READ_ONCE(hw->quiescing) && group->ref_cnt && !group->quarantined &&
+      (!pin || group->pins != (uint32)~0U)) {
+    if (pin)
+      group->pins++;
+    valid = TRUE;
+  }
+  mtlk_osal_lock_release(&hw->mc_group_lock);
+  return valid;
+}
+
+void wave_hw_mc_put(mtlk_hw_t *hw, uint8 id)
+{
+  mtlk_hw_mc_t *group;
+
+  MTLK_ASSERT(id >= MC_MIN_GROUP && id < MC_GROUPS);
+  mtlk_osal_lock_acquire(&hw->mc_group_lock);
+  group = &hw->mc_groups[id];
+  MTLK_ASSERT(group->pins);
+  if (group->pins && !--group->pins && !group->ref_cnt && !group->quarantined)
+    memset(group, 0, sizeof(*group));
+  mtlk_osal_lock_release(&hw->mc_group_lock);
+}
+
+void wave_hw_mc_quarantine(mtlk_hw_t *hw, uint8 id)
+{
+  MTLK_ASSERT(id >= MC_MIN_GROUP && id < MC_GROUPS);
+  mtlk_osal_lock_acquire(&hw->mc_group_lock);
+  hw->mc_groups[id].quarantined = true;
+  mtlk_osal_lock_release(&hw->mc_group_lock);
+}
+
+/* Native source policy owns immutable recipient sets. These IDs share the
+ * same pin/quarantine pool, but never alias an address-keyed helper group or
+ * another VAP's recipient set. A host owner is released only after its command
+ * and applied-membership owners have withdrawn; DAT_CFM may retain TX pins.
+ */
+int wave_hw_mc_alloc_native(mtlk_hw_t *hw)
+{
+  int id, result = MCAST_GROUP_UNDEF;
+
+  mtlk_osal_lock_acquire(&hw->mc_group_lock);
+  if (!READ_ONCE(hw->quiescing)) {
+    for (id = MC_MIN_GROUP; id < MC_GROUPS; id++) {
+      mtlk_hw_mc_t *group = &hw->mc_groups[id];
+
+      if (group->ref_cnt || group->pins || group->quarantined)
+        continue;
+      memset(group, 0, sizeof(*group));
+      group->native = true;
+      group->ref_cnt = 1;
+      result = id;
+      break;
+    }
+  }
+  mtlk_osal_lock_release(&hw->mc_group_lock);
+  return result;
+}
+
+void wave_hw_mc_release_native(mtlk_hw_t *hw, uint8 id)
+{
+  mtlk_hw_mc_t *group;
+
+  MTLK_ASSERT(id >= MC_MIN_GROUP && id < MC_GROUPS);
+  mtlk_osal_lock_acquire(&hw->mc_group_lock);
+  group = &hw->mc_groups[id];
+  MTLK_ASSERT(group->native && group->ref_cnt == 1);
+  if (group->native && group->ref_cnt == 1) {
+    group->ref_cnt = 0;
+    if (!group->pins && !group->quarantined)
+      memset(group, 0, sizeof(*group));
+  }
+  mtlk_osal_lock_release(&hw->mc_group_lock);
+}
+
+/* Group IDs are shared by all VAPs of this hardware. Match semantic keys,
+ * and admit the requested ID under the same lock as reference changes. A
+ * failed request must leave every existing owner and reference unchanged. */
+static BOOL
+_mtlk_hw_mc_addr_equal (const mtlk_mc_addr_t *a, const mtlk_mc_addr_t *b)
+{
+  if (a->type != b->type)
+    return FALSE;
+  if (a->type == MTLK_IPv4)
+    return a->src_ip.ip4_addr.s_addr == b->src_ip.ip4_addr.s_addr &&
+           a->grp_ip.ip4_addr.s_addr == b->grp_ip.ip4_addr.s_addr;
+  return !memcmp(&a->src_ip.ip6_addr, &b->src_ip.ip6_addr, sizeof(struct in6_addr)) &&
+         !memcmp(&a->grp_ip.ip6_addr, &b->grp_ip.ip6_addr, sizeof(struct in6_addr));
+}
+
+static int
+_mtlk_hw_mc_group_action (mtlk_hw_t *hw, mtlk_core_ui_mc_grid_action_t *req)
+{
+  mtlk_hw_mc_t *group;
+  int i, first_free = 0, found = MC_GROUPS;
+  int res = MTLK_ERR_VALUE;
+  uint8 requested = req->grp_id;
+
+  req->grp_id = MCAST_GROUP_UNDEF;
+  if (req->action != MTLK_GRID_ADD && req->action != MTLK_GRID_DEL)
+    return res;
+  /* An undefined deletion owns no reference, even if the key exists. */
+  if (req->action == MTLK_GRID_DEL && requested == MCAST_GROUP_UNDEF)
+    return MTLK_ERR_OK;
+  if ((requested != MCAST_GROUP_UNDEF &&
+       (requested < MC_MIN_GROUP || requested >= MC_GROUPS)) ||
+      (req->mc_addr.type != MTLK_IPv4 && req->mc_addr.type != MTLK_IPv6))
+    return res;
+
+  mtlk_osal_lock_acquire(&hw->mc_group_lock);
+  for (i = MC_MIN_GROUP; i < MC_GROUPS; i++) {
+    if (hw->mc_groups[i].ref_cnt || hw->mc_groups[i].pins || hw->mc_groups[i].quarantined) {
+      if (!hw->mc_groups[i].native &&
+          _mtlk_hw_mc_addr_equal(&hw->mc_groups[i].mc_addr, &req->mc_addr))
+        found = i;
+    } else if (!first_free) {
+      first_free = i;
+    }
+  }
+
+  if (found != MC_GROUPS) {
+    if (requested != MCAST_GROUP_UNDEF && requested != found)
+      goto out;
+    group = &hw->mc_groups[found];
+    if (req->action == MTLK_GRID_ADD) {
+      if (!group->ref_cnt || group->quarantined || READ_ONCE(hw->quiescing))
+        goto out;
+      if (group->ref_cnt == (uint32)~0U) {
+        res = MTLK_ERR_NO_RESOURCES;
+        goto out;
+      }
+      group->ref_cnt++;
+    } else {
+      if (!group->ref_cnt)
+        goto out;
+      if (!--group->ref_cnt && !group->pins && !group->quarantined)
+        memset(group, 0, sizeof(*group));
+    }
+    req->grp_id = found;
+    res = MTLK_ERR_OK;
+    goto out;
+  }
+
+  if (req->action == MTLK_GRID_DEL || READ_ONCE(hw->quiescing))
+    goto out;
+  if (requested != MCAST_GROUP_UNDEF) {
+    if (hw->mc_groups[requested].ref_cnt || hw->mc_groups[requested].pins ||
+        hw->mc_groups[requested].quarantined)
+      goto out;
+    first_free = requested;
+  }
+  if (!first_free) {
+    res = MTLK_ERR_NO_RESOURCES;
+    goto out;
+  }
+
+  group = &hw->mc_groups[first_free];
+  memset(group, 0, sizeof(*group));
+  group->mc_addr.type = req->mc_addr.type;
+  if (req->mc_addr.type == MTLK_IPv4) {
+    group->mc_addr.src_ip.ip4_addr = req->mc_addr.src_ip.ip4_addr;
+    group->mc_addr.grp_ip.ip4_addr = req->mc_addr.grp_ip.ip4_addr;
+  } else {
+    group->mc_addr.src_ip.ip6_addr = req->mc_addr.src_ip.ip6_addr;
+    group->mc_addr.grp_ip.ip6_addr = req->mc_addr.grp_ip.ip6_addr;
+  }
+  group->ref_cnt = 1;
+  req->grp_id = first_free;
+  res = MTLK_ERR_OK;
+out:
+  mtlk_osal_lock_release(&hw->mc_group_lock);
+  return res;
+}
