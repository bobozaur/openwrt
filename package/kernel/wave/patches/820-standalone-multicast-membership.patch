+int __MTLK_IFUNC
+mtlk_mc_parse (mtlk_core_t* nic, struct sk_buff *skb, sta_entry *sta)
+{
+  struct ethhdr *ether_header;
+  unsigned length, header_length;
+
+  /* The helper owns membership when present. Otherwise validate the entire
+   * advertised IP payload before handing a linear report to the snooper.
+   * Ethernet padding must not complete a truncated IGMP or MLD record.
+   */
+  if (mtlk_core_mcast_module_is_available(nic))
+    return -1;
+  if (nic->mcast.native)
+    return wave_mc_native_observe(nic, skb, sta);
+  if (!pskb_may_pull(skb, ETH_HLEN))
+    return MTLK_ERR_NOT_IN_USE;
+  ether_header = (struct ethhdr *)skb->data;
+
+  switch (ntohs(ether_header->h_proto)) {
+  case ETH_P_IP:
+    {
+      struct iphdr *ip_header;
+
+      if (!pskb_may_pull(skb, ETH_HLEN + sizeof(*ip_header)))
+        return MTLK_ERR_NOT_IN_USE;
+      ip_header = (struct iphdr *)(skb->data + ETH_HLEN);
+      if (ip_header->version != 4 || ip_header->protocol != IPPROTO_IGMP ||
+          (ntohs(ip_header->frag_off) & (IP_MF | IP_OFFSET)))
+        return MTLK_ERR_NOT_IN_USE;
+      header_length = ip_header->ihl * 4;
+      length = ntohs(ip_header->tot_len);
+      if (header_length < sizeof(*ip_header) ||
+          length < header_length + sizeof(struct igmphdr) ||
+          !pskb_may_pull(skb, ETH_HLEN + length))
+        return MTLK_ERR_NOT_IN_USE;
+      return parse_igmp(nic, (struct igmphdr *)(skb->data + ETH_HLEN + header_length),
+                        length - header_length, sta);
+    }
+  case ETH_P_IPV6:
+    {
+      struct ipv6hdr *ip_header;
+      struct ipv6_opt_hdr *hop_header;
+      const uint8 *options;
+      unsigned offset, option_length;
+      BOOL router_alert = FALSE;
+
+      if (!pskb_may_pull(skb, ETH_HLEN + sizeof(*ip_header)))
+        return MTLK_ERR_NOT_IN_USE;
+      ip_header = (struct ipv6hdr *)(skb->data + ETH_HLEN);
+      if (ip_header->version != 6 || ip_header->nexthdr != IPPROTO_HOPOPTS)
+        return MTLK_ERR_NOT_IN_USE;
+      length = ntohs(ip_header->payload_len);
+      if (length < 8 + sizeof(struct icmp6hdr) ||
+          !pskb_may_pull(skb, ETH_HLEN + sizeof(*ip_header) + length))
+        return MTLK_ERR_NOT_IN_USE;
+      hop_header = (struct ipv6_opt_hdr *)(skb->data + ETH_HLEN + sizeof(*ip_header));
+      header_length = 8 * (hop_header->hdrlen + 1);
+      if (hop_header->nexthdr != IPPROTO_ICMPV6 ||
+          header_length > length - sizeof(struct icmp6hdr))
+        return MTLK_ERR_NOT_IN_USE;
+      options = (const uint8 *)hop_header;
+      for (offset = sizeof(*hop_header); offset < header_length; offset += option_length) {
+        if (options[offset] == 0) { /* Pad1 */
+          option_length = 1;
+          continue;
+        }
+        if (header_length - offset < 2)
+          return MTLK_ERR_NOT_IN_USE;
+        option_length = options[offset + 1] + 2;
+        if (option_length > header_length - offset)
+          return MTLK_ERR_NOT_IN_USE;
+        if (options[offset] == 5 && option_length == 4 &&
+            options[offset + 2] == 0 && options[offset + 3] == 0)
+          router_alert = TRUE;
+      }
+      if (router_alert)
+        return parse_icmp6(nic, (struct icmp6hdr *)((uint8 *)hop_header + header_length),
+                           length - header_length, sta);
+      break;
+    }
+  default:
+    break;
+  }
+  return -1;
+}
 
