+    ILOG2_V("    -- none --");
+  }
+  ILOG2_V("  List of sources");
+  if (grp->ip6_src_list) {
+    mcast_ip6_src_t *src;
+    for (src = grp->ip6_src_list; src != NULL; src = src->next) {
+      ILOG2_K("    src: %K", src->ip6_src_addr.s6_addr);
+      ILOG2_V("    List of STA");
+      if (src->info.mcsta) {
+        for (mcsta = src->info.mcsta; mcsta != NULL; mcsta = mcsta->next) {
+          ILOG2_Y("      %Y", mcsta->sta->info.addr.au8Addr);
+        }
+      }
+      else {
+        ILOG2_V("      -- none --");
+      }
+    }
+  }
+  else {
+    ILOG2_V("    -- none --");
+  }
+#endif
+}
