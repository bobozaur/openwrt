Subject: [PATCH] wave: stop waiting for terminal firmware recovery

--- a/wireless/driver/linux/mac80211.c
+++ b/wireless/driver/linux/mac80211.c
@@ -327,9 +327,16 @@
   int wait_iter_in_ms = 10;
   int no_of_retries = RCVRY_RETRY_TIMEOUT_MS / wait_iter_in_ms;
   int retry_counter = no_of_retries;
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
 
   while (retry_counter && (mtlk_core_rcvry_is_running(core) ||
-         wave_rcvry_mac_fatal_pending_get(mtlk_vap_get_hw(core->vap_handle)))) {
+         wave_rcvry_mac_fatal_pending_get(hw))) {
+    rcvry_type_e type = wave_rcvry_type_current_get(hw);
+
+    /* Terminal recovery will never clear the fatal flag. Preserve the
+     * active-recovery lifetime barrier, but do not stall native teardown. */
+    if (type == RCVRY_TYPE_DUT || type == RCVRY_TYPE_IGNORE)
+      return MTLK_ERR_NOT_READY;
     if (retry_counter == no_of_retries)
       ILOG0_V("Recovery is running, waiting for process to complete...");
     mtlk_osal_msleep(wait_iter_in_ms);
@@ -339,7 +346,7 @@
   if (retry_counter != no_of_retries)
     ILOG0_D("Waited %d ms for recovery procedure to complete", (no_of_retries - retry_counter) * wait_iter_in_ms);
 
-  if (retry_counter)
+  if (retry_counter && wave_hw_mmb_ready(hw))
     return MTLK_ERR_OK;
   else
     return MTLK_ERR_NOT_READY;
@@ -1973,14 +1980,13 @@
 
   vap_handle = mtlk_df_get_vap_handle(mtlk_df_user_get_df(df_user));
   core = mtlk_vap_get_core(vap_handle);
+  if ((changed & BSS_CHANGED_ASSOC) && !vif->cfg.assoc) {
+    wiphy_work_cancel(hw->wiphy, &wv_iface_inf->stop_work);
+    wv_iface_inf->stop_pending = false;
+  }
   if (wait_rcvry_completion_if_needed(core) != MTLK_ERR_OK){
     ELOG_V("Recovery is running, can't change bss info");
     return;
-  }
-
-  if ((changed & BSS_CHANGED_ASSOC) && !vif->cfg.assoc) {
-    wiphy_work_cancel(hw->wiphy, &wv_iface_inf->stop_work);
-    wv_iface_inf->stop_pending = false;
   }
   if (wv_iface_inf->vap_stopped) {
     /* mac80211 publishes the new BSSID before the first upward sta_state.
