Subject: [PATCH] wave: preserve firmware CSA ownership and accept width updates

Firmware synthesizes CSA beacons/actions and confirms SET_CHAN after its
countdown. Allow hostapd's subsequent HT/VHT width advertisement updates
without permitting changes to the other live BSS capabilities or MCS maps.

Reject unrepresentable CSA delays before narrowing them to the firmware
u16 field, and allow the requested countdown before the normal command
confirmation timeout. No host countdown or new firmware event is added.

--- a/wireless/driver/linux/beacon_manager.c
+++ b/wireless/driver/linux/beacon_manager.c
@@ -612,8 +612,20 @@
 {
   const u8 *a = cfg80211_find_ie(id, data->tail, data->tail_len);
   const u8 *b = cfg80211_find_ie(id, old->ptr + old->head_len, old->tail_len);
-
-  return (!!a != !!b) || (a && (a[1] != b[1] || memcmp(a, b, a[1] + 2)));
+  u8 width_mask = id == IE_HT_CAPABILITIES ? IEEE80211_HT_CAP_SUP_WIDTH_20_40 :
+    id == IE_VHT_CAPABILITIES ? IEEE80211_VHT_CAP_SUPP_CHAN_WIDTH_MASK : 0;
+
+  if (!a || !b)
+    return !!a != !!b;
+  if (a[1] != b[1])
+    return true;
+  if (!a[1])
+    return false;
+
+  /* Hostapd updates these advertised width bits after CSA. They do not
+   * alter SET_BSS state; keep all other capability, MCS and SMPS bytes
+   * immutable while the BSS runs. SET_CHAN owns channel/DFS permission. */
+  return ((a[2] ^ b[2]) & ~width_mask) || memcmp(a + 3, b + 3, a[1] - 1);
 }
 
 int wave_beacon_man_beacon_set(mtlk_handle_t hcore, const void* data, uint32 data_size)
--- a/wireless/driver/linux/core_config.c
+++ b/wireless/driver/linux/core_config.c
@@ -357,6 +357,7 @@
 {
   mtlk_txmm_data_t *man_entry = man_msg->data;
   UM_SET_CHAN_PARAMS *req = (UM_SET_CHAN_PARAMS *) man_entry->payload;
+  u32 timeout = MTLK_MM_BLOCKED_SEND_TIMEOUT;
   int res;
 
   /* FW expects bg_scan as a flag 0 or 1, make sure it is the case */
@@ -377,7 +378,10 @@
           req->isRadarDetectionNeeded);
   if (res != MTLK_ERR_OK)
     return res;
-  res = mtlk_txmm_msg_send_blocked(man_msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
+  /* CSA confirmation follows the firmware-owned countdown and switch. */
+  if (req->switch_type == ST_CSA)
+    timeout += MAC_TO_HOST16(req->chan_switch_time);
+  res = mtlk_txmm_msg_send_blocked(man_msg, timeout);
 
   if (res != MTLK_ERR_OK)
   {
--- a/wireless/driver/linux/wave_radio.c
+++ b/wireless/driver/linux/wave_radio.c
@@ -3762,6 +3762,7 @@
   mtlk_df_t *master_df;
   mtlk_scan_support_t *scan_support;
   int beacon_period;
+  unsigned int count;
   void *wiphy;
   struct mtlk_chan_def *ccd;
   mtlk_sb_dfs_params_t *sb_dfs;
@@ -3793,11 +3794,15 @@
   cpd.vap_id = mtlk_vap_get_id(vap_handle);
 
   if (scan_support->dfs_debug_params.beacon_count > 0) {
-    cpd.chan_switch_time = scan_support->dfs_debug_params.beacon_count * beacon_period;
+    count = scan_support->dfs_debug_params.beacon_count;
     ILOG1_D("Using debug CSA Beacon count: %d", scan_support->dfs_debug_params.beacon_count);
   } else {
-    cpd.chan_switch_time = csas->count * beacon_period;
-  }
+    count = csas->count;
+  }
+  /* The firmware delay is u16. Never silently shorten the announced count. */
+  if (beacon_period <= 0 || count > U16_MAX / (unsigned int)beacon_period)
+    return -EINVAL;
+  cpd.chan_switch_time = count * beacon_period;
 
   cpd.block_tx_pre = csas->block_tx; /* hostapd always sets this to 1, BTW */
   cpd.block_tx_post = FALSE; /* TRUE is meant for waiting for radars, but hostapd has ensured it's switching to a safe range */
