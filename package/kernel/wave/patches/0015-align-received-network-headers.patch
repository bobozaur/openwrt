+/* CPU delivery/reassembly storage is never published as a firmware buffer.
+ * Keep the normal private-data/object-pool allocation owner, with Linux's
+ * Ethernet-to-IP alignment reserved before any bytes are copied. */
+static __INLINE mtlk_nbuf_t *
+_mtlk_mmb_nbuf_alloc_rx_cpu (uint32 size)
+{
+  mtlk_nbuf_t *nbuf;
+
+  if (unlikely(size > UINT_MAX - NET_IP_ALIGN))
+    return NULL;
+  nbuf = mtlk_df_nbuf_alloc(size + NET_IP_ALIGN);
+  if (nbuf)
+    mtlk_df_nbuf_reserve(nbuf, NET_IP_ALIGN);
+  return nbuf;
+}
