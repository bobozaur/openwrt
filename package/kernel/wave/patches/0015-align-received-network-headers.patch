@@ -11142,7 +11142,26 @@
 _mtlk_core_handle_rx_data (mtlk_vap_handle_t vap_handle, mtlk_core_handle_rx_data_t *data)
 {
   mtlk_nbuf_t *nbuf = data->nbuf;
-  MTLK_ASSERT(nbuf != NULL);
+  unsigned int shift, len;
+  u8 *source;
+
+  /* The native handoff normally supplies aligned CPU storage. Keep this
+   * in-place fallback for allocation failure and other receive owners.
+   * DMA is unmapped and reassembly complete; no header offsets or clones
+   * exist yet. Firmware RX buffer/address requirements stay unchanged. */
+  if (unlikely(!nbuf || nbuf->len < ETH_HLEN || skb_is_nonlinear(nbuf) ||
+               skb_shared(nbuf) || skb_cloned(nbuf)))
+    return MTLK_ERR_NOT_IN_USE;
+  shift = ((unsigned long)nbuf->data + ETH_HLEN) & 3;
+  if (shift) {
+    if (unlikely(skb_headroom(nbuf) < shift))
+      return MTLK_ERR_NOT_IN_USE;
+    len = nbuf->len;
+    source = nbuf->data;
+    skb_push(nbuf, shift);
+    memmove(nbuf->data, source, len);
+    skb_trim(nbuf, len);
+  }
   return _handle_rx_ind(mtlk_vap_get_core(vap_handle), nbuf, data);
 }
 

