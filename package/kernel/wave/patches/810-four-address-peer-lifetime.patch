--- a/wireless/driver/linux/mcast.c
+++ b/wireless/driver/linux/mcast.c
@@ -128,6 +128,8 @@
 mtlk_mc_transmit (mtlk_core_t* nic, mtlk_core_handle_tx_data_t *tx_data, uint32 nbuf_flags, int bridge_mode, sta_entry *src_sta)
 {
   int res = MTLK_ERR_OK;
+  const sta_entry *sta = NULL;
+  mtlk_stadb_iterator_t iter;
 
 #ifdef MTLK_DEBUG_IPERF_PAYLOAD_TX
   debug_ooo_analyze_packet(FALSE, tx_data->nbuf, 0);
@@ -136,6 +138,67 @@
   /* analyze and adjust packet's priority */
   qos_adjust_priority(nic->vap_handle, nic->dscp_table, tx_data->nbuf);
 
+  /* Four-address peers cannot consume the BSS's three-address group frames.
+   * Replicate according to peer state, independently of legacy bridge mode. */
+  if (mtlk_vap_is_ap(nic->vap_handle) &&
+      (nbuf_flags & (MTLK_NBUFF_BROADCAST | MTLK_NBUFF_MULTICAST)) &&
+      (BR_MODE_WDS == bridge_mode ||
+       mtlk_stadb_get_four_addr_sta_cnt(&nic->slow_ctx->stadb)))
+  {
+    bool send_group = true;
+    mtlk_core_handle_tx_data_t clone_data = {0};
+
+    /* copy rx_if's into cloned buffer tx_data */
+    clone_data.rx_if = tx_data->rx_if;
+    clone_data.rx_subif = tx_data->rx_subif;
+
+    /* Each copy targets the peer SID. Preserve an ordinary BSS group copy only
+     * for ordinary receivers, and never send a peer copy back to its source. */
+    sta = mtlk_stadb_iterate_first(&nic->slow_ctx->stadb, &iter);
+    if (sta) {
+      /* If the referenced snapshot could not be allocated, leave the ordinary
+       * group path available. Only a complete snapshot can rule out receivers. */
+      send_group = false;
+      for (; sta; sta = mtlk_stadb_iterate_next(&iter)) {
+        if (sta == src_sta || rcu_access_pointer(sta->ap_vlan))
+          continue;
+        if (!sta->peer_ap && !mtlk_sta_is_4addr(sta)) {
+          send_group = true;
+          continue;
+        }
+        clone_data.dst_sta = (sta_entry *)sta;
+
+        clone_data.nbuf = mtlk_df_nbuf_clone_no_priv(tx_data->nbuf);
+
+        if (!clone_data.nbuf) {
+          mtlk_sta_on_packet_dropped(clone_data.dst_sta, MTLK_TX_DISCARDED_DRV_NO_RESOURCES);
+          /* One failed recipient must not hide later ordinary/group peers. */
+          continue;
+        }
+        /* Adjust cloned packet's priority */
+        mtlk_df_nbuf_set_priority(clone_data.nbuf, mtlk_df_nbuf_get_priority(tx_data->nbuf));
+
+        mtlk_sta_incref(clone_data.dst_sta);
+
+        ILOG3_Y("Broadcast packet sending to 4addr sta %Y", mtlk_sta_get_addr(clone_data.dst_sta));
+        res = _mtlk_do_send_data_to_sta(nic, &clone_data, nbuf_flags);
+        if (clone_data.msg) {
+          mtlk_hw_release_msg_to_send(mtlk_vap_get_hwapi(nic->vap_handle), clone_data.msg);
+          clone_data.msg = NULL;
+        }
+      }
+      mtlk_stadb_iterate_done(&iter);
+    } /* End of "for each 4addr client" */
+
+    /* Count receivers, not clones: the source is not a group destination. */
+    if (!send_group) {
+      /* drop original buffer*/
+      mtlk_df_nbuf_free(tx_data->nbuf);
+      return MTLK_ERR_OK;
+    }
+
+  } /* End of broadcasting over WDS */
+
   res = _mtlk_do_send_data_to_sta(nic, tx_data, nbuf_flags);
   return res;
 }
