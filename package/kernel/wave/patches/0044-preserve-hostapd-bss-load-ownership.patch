Subject: [PATCH] retain hostapd BSS Load IE without duplicate firmware insertion

--- a/wireless/driver/linux/beacon_manager.c
+++ b/wireless/driver/linux/beacon_manager.c
@@ -235,8 +235,6 @@
       *part3_len += ie_len;
       break;
     case IE_BSS_LOAD:
-      ELOG_V("BSS Load IE must not be present in beacon template");
-      /* Drop down */
     case IE_EDCA_PARAM_SET:
     case IE_HT_CAPABILITIES:
     case IE_QOS_CAPABILITY:
@@ -364,8 +362,13 @@
   psUmiBeacon->u16part4Len    = HOST_TO_MAC16(part4_len);
   psUmiBeacon->u16part5Len    = HOST_TO_MAC16(part5_len);
   psUmiBeacon->u8vapIndex     = mtlk_vap_get_id(core->vap_handle);
-  psUmiBeacon->addBssLoadIe   = mtlk_df_user_get_hs20_status(mtlk_vap_get_df(core->vap_handle)) ? 1 : 0;
-  psUmiBeacon->addBssLoadIe  |= MTLK_CORE_PDB_GET_INT(core, PARAM_DB_CORE_IS_BSS_LOAD_ENABLE) ? 1 : 0;
+  /* Hostapd owns a BSS Load IE supplied in its beacon template. Firmware
+   * insertion is only needed when the template does not already contain it.
+   */
+  psUmiBeacon->addBssLoadIe =
+    !cfg80211_find_ie(IE_BSS_LOAD, tmpl->ptr + tmpl->head_len, tmpl->tail_len) &&
+    (mtlk_df_user_get_hs20_status(mtlk_vap_get_df(core->vap_handle)) ||
+     MTLK_CORE_PDB_GET_INT(core, PARAM_DB_CORE_IS_BSS_LOAD_ENABLE));
 
   mtlk_dump(2, psUmiBeacon, sizeof(UMI_BEACON_SET), "dump of UMI_BEACON_SET:");
 
