+void __MTLK_IFUNC mtlk_txmm_quiesce(mtlk_txmm_base_t *obj)
+{
+  /* Early card-start failures precede TXMM initialization. Never touch an
+   * uninitialized lock, event or timer, and retain storage until core drain. */
+  if (!(READ_ONCE(obj->flags) & TXMM_FLAGS_INITIALIZED))
+    return;
+
+  mtlk_osal_lock_acquire(&obj->lock);
+  WRITE_ONCE(obj->flags, obj->flags | TXMM_FLAGS_QUIESCED);
+  mtlk_osal_event_set(&obj->bsend.evt);
+  mtlk_osal_lock_release(&obj->lock);
+  mtlk_txmm_stop(obj);
+}
+
+void __MTLK_IFUNC mtlk_txmm_pause(mtlk_txmm_base_t *obj)
+{
+  if (!(READ_ONCE(obj->flags) & TXMM_FLAGS_INITIALIZED))
+    return;
+
+  /* A serializer may be waiting for firmware. Close both blocked and
+   * asynchronous admission before joining it, and wake its real waiter.
+   * Use the same lock as blocked-send admission/event reset so this wake
+   * cannot be lost. Keep all slots/storage until the normal reset/restore. */
+  mtlk_osal_lock_acquire(&obj->lock);
+  WRITE_ONCE(obj->flags, (obj->flags | TXMM_FLAGS_PAUSED) & ~TXMM_FLAGS_ACTIVE);
+  mtlk_osal_event_set(&obj->bsend.evt);
+  mtlk_osal_lock_release(&obj->lock);
+  mtlk_txmm_stop(obj);
