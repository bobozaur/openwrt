+/* The same card owns both native radios. Normal user commands enter/leave
+ * this admission gate at execution, not at asynchronous submission. */
+bool wave_hw_monitor_user_get(mtlk_hw_t *hw)
+{
+  unsigned long flags;
+  bool allowed;
+
+  spin_lock_irqsave(&hw->monitor_lock, flags);
+  allowed = !hw->monitor && !hw->quiescing;
+  if (allowed)
+    hw->monitor_users++;
+  spin_unlock_irqrestore(&hw->monitor_lock, flags);
+  return allowed;
+}
+
+void wave_hw_monitor_user_put(mtlk_hw_t *hw)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&hw->monitor_lock, flags);
+  if (WARN_ON_ONCE(!hw->monitor_users)) {
+    spin_unlock_irqrestore(&hw->monitor_lock, flags);
+    return;
+  }
+  hw->monitor_users--;
+  spin_unlock_irqrestore(&hw->monitor_lock, flags);
+}
+
+bool wave_hw_fw_feature_supported(mtlk_hw_t *hw, u32 feature)
+{
+  return (READ_ONCE(hw->fw_features) & feature) == feature;
+}
+
+bool wave_hw_monitor_supported(mtlk_hw_t *hw)
+{
+  return mtlk_hw_type_is_gen6(hw) && !mtlk_hw_type_is_gen6_b0(hw) &&
+         wave_hw_mmb_card_is_asic(hw) &&
+         !MTLK_USE_DIRECTCONNECT_DP_API && !MTLK_USE_PUMA6_UDMA &&
+         wave_hw_fw_feature_supported(hw, WAVE_FW_FEATURE_RX_STREAM);
+}
+
+bool wave_hw_monitor_held(mtlk_hw_t *hw)
+{
+  return READ_ONCE(hw->monitor) != NULL;
+}
+
+bool wave_hw_monitor_is_owner(mtlk_hw_t *hw, const struct wave_monitor *mon)
+{
+  return READ_ONCE(hw->monitor) == mon && !READ_ONCE(hw->quiescing);
+}
+
+/* Callers hold their radio master serializer before this card-wide lock.
+ * Neither native confirmations nor DMA/IRQ retirement acquire this lock. */
+void wave_hw_airtime_lock(mtlk_hw_t *hw) { mutex_lock(&hw->airtime_lock); }
+void wave_hw_airtime_unlock(mtlk_hw_t *hw) { mutex_unlock(&hw->airtime_lock); }
+bool wave_hw_airtime_owned(mtlk_hw_t *hw)
+{
+  lockdep_assert_held(&hw->airtime_lock);
+  return hw->airtime_radios != 0;
+}
+void wave_hw_airtime_mark(mtlk_hw_t *hw, unsigned radio, bool owned)
+{
+  lockdep_assert_held(&hw->airtime_lock);
+  if (WARN_ON(radio >= BITS_PER_LONG))
+    return;
+  if (owned)
+    hw->airtime_radios |= BIT(radio);
+  else
+    hw->airtime_radios &= ~BIT(radio);
+}
+
+bool wave_hw_monitor_fenced(mtlk_hw_t *hw)
+{
+  return smp_load_acquire(&hw->monitor_fenced);
+}
+
+bool wave_hw_monitor_set_tx(mtlk_hw_t *hw, const struct wave_monitor *mon, bool enable)
+{
+  bool valid = false;
+
+  if (!(hw->flags & HW_FLAGS_PREPARED_BSS_REQ_BDR))
+    return false;
+  mtlk_osal_lock_acquire(&hw->bss_mgmt.tx_bdr.lock);
+  if (READ_ONCE(hw->monitor) == mon) {
+    /* Sniffer TX has no qualified over-air contract. Keep the existing
+     * queue-lock publication boundary, but never grant transmit ownership. */
+    valid = !enable;
+    WRITE_ONCE(hw->monitor_tx_enabled, false);
+  }
+  mtlk_osal_lock_release(&hw->bss_mgmt.tx_bdr.lock);
+  return valid;
+}
+
+static void wave_hw_monitor_disable_tx(mtlk_hw_t *hw)
+{
+  if (!(hw->flags & HW_FLAGS_PREPARED_BSS_REQ_BDR)) {
+    WRITE_ONCE(hw->monitor_tx_enabled, false);
+    return;
+  }
+  mtlk_osal_lock_acquire(&hw->bss_mgmt.tx_bdr.lock);
+  WRITE_ONCE(hw->monitor_tx_enabled, false);
+  mtlk_osal_lock_release(&hw->bss_mgmt.tx_bdr.lock);
+}
+
+
+bool wave_hw_monitor_dirty(mtlk_hw_t *hw)
+{
+  return READ_ONCE(hw->monitor_dirty);
+}
+
+int wave_hw_monitor_claim(mtlk_hw_t *hw, mtlk_vap_handle_t vap,
+                          struct wave_monitor *mon)
+{
+  unsigned long flags;
+  unsigned int r, v;
+  int res = MTLK_ERR_BUSY;
+
+  if (!wave_hw_monitor_supported(hw) || wave_vap_radio_id_get(vap) != 0 ||
+      !mtlk_vap_is_master_ap(vap) || mtlk_vap_get_id(vap) != 0)
+    return MTLK_ERR_NOT_SUPPORTED;
+  spin_lock_irqsave(&hw->monitor_lock, flags);
+  if (hw->monitor || hw->monitor_users || !wave_hw_mmb_ready(hw) ||
+      wave_rcvry_type_current_get(hw) != RCVRY_TYPE_UNDEF)
+    goto out;
+  for (r = 0; r < hw->radio_descr->num_radios; r++) {
+    wave_radio_t *radio = wave_radio_descr_wave_radio_get(hw->radio_descr, r);
+    mtlk_vap_manager_t *manager = wave_radio_descr_vap_manager_get(hw->radio_descr, r);
+    mtlk_core_t *master = wave_radio_master_core_get(radio);
+
+    if (!master || wave_radio_get_sta_vifs_exist(radio) ||
+        mtlk_vap_manager_get_active_vaps_number(manager) ||
+        mtlk_core_scan_is_running(master) || wave_radio_cac_active(radio))
+      goto out;
+    for (v = 0; v < wave_radio_max_vaps_get(radio); v++) {
+      mtlk_vap_handle_t existing;
+      mtlk_core_t *core;
+
+      if (mtlk_vap_manager_get_vap_handle(manager, v, &existing) != MTLK_ERR_OK)
+        continue;
+      core = mtlk_vap_get_core(existing);
+      if (mtlk_core_get_net_state(core) &
+          (NET_STATE_ACTIVATING | NET_STATE_CONNECTED | NET_STATE_DEACTIVATING))
+        goto out;
+      if (core->is_stopping || core->is_iface_stopping)
+        goto out;
+    }
+  }
+  hw->monitor_vap = vap;
+  hw->monitor_saved_net_state = mtlk_core_get_net_state(mtlk_vap_get_core(vap));
+  hw->monitor_dirty = false;
+  WRITE_ONCE(hw->monitor_tx_enabled, false);
+  rcu_assign_pointer(hw->monitor, mon);
+  res = MTLK_ERR_OK;
+out:
+  spin_unlock_irqrestore(&hw->monitor_lock, flags);
+  return res;
+}
+
+void wave_hw_monitor_release(mtlk_hw_t *hw, struct wave_monitor *mon)
+{
+  unsigned long flags;
+
+  wave_hw_monitor_set_tx(hw, mon, false);
+
+  spin_lock_irqsave(&hw->monitor_lock, flags);
+  if (hw->monitor == mon) {
+    /* A failed restart retains the terminal fence, never an unfenced stream. */
+    WARN_ON_ONCE(hw->monitor_dirty && !hw->quiescing);
+    RCU_INIT_POINTER(hw->monitor, NULL);
+    hw->monitor_vap = NULL;
+  }
+  spin_unlock_irqrestore(&hw->monitor_lock, flags);
+  synchronize_net();
+}
+
+int wave_hw_monitor_activation_begin(mtlk_vap_handle_t vap, BOOL monitor)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(vap);
+
+  if (monitor)
+    return wave_hw_monitor_held(hw) && READ_ONCE(hw->monitor_vap) == vap &&
+           !READ_ONCE(hw->quiescing) ? MTLK_ERR_OK : MTLK_ERR_NOT_READY;
+  if (wave_hw_monitor_held(hw) && wave_rcvry_type_current_get(hw) != RCVRY_TYPE_UNDEF)
+    return MTLK_ERR_OK; /* Only the joined/blocked recovery owner can reach this. */
+  return wave_hw_monitor_user_get(hw) ? MTLK_ERR_OK : MTLK_ERR_BUSY;
+}
+
+void wave_hw_monitor_activation_end(mtlk_vap_handle_t vap, BOOL monitor)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(vap);
+
+  if (!monitor && !(wave_hw_monitor_held(hw) && wave_rcvry_type_current_get(hw) != RCVRY_TYPE_UNDEF))
+    wave_hw_monitor_user_put(hw);
+}
+
+u32 wave_hw_monitor_recovery_state(mtlk_hw_t *hw, mtlk_vap_handle_t vap, u32 state)
+{
+  return READ_ONCE(hw->monitor_vap) == vap ? hw->monitor_saved_net_state : state;
+}
