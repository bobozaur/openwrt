+/* Terminal for this probe. Only a fresh PCI probe may restart the card. */
+static void wave_hw_mmb_quiesce_locked(mtlk_hw_t *hw)
+{
+  mtlk_handle_t flags;
+
+  lockdep_assert_held(&hw->quiesce_lock);
+  if (hw->quiescing)
+    return;
+  wave_hw_monitor_disable_tx(hw);
+  flags = mtlk_osal_lock_acquire_irq(&hw->reg_lock);
+  WRITE_ONCE(hw->quiescing, true);
+  WRITE_ONCE(hw->state, MTLK_HW_STATE_UNLOADING);
+  _mtlk_mmb_stop_events_completely(hw);
+  mtlk_ccr_disable_interrupts(hw->ccr, MTLK_IRQ_ALL);
+  mtlk_osal_lock_release_irq(&hw->reg_lock, flags);
+
+  if (hw->flags & HW_FLAGS_PREPARED_DATA_REQ_BDR) {
+    mtlk_osal_lock_acquire(&hw->tx.bdr_data.lock);
+    wave_hw_tx_stop_locked(hw);
+    mtlk_osal_lock_release(&hw->tx.bdr_data.lock);
+  }
+  wave_radio_leds_off(hw->radio_descr);
+
+  /* Firmware cannot answer once terminal shutdown starts. Reject new work,
+   * wake blocked control senders and stop timeouts before draining cores. */
+  mtlk_txmm_quiesce(&hw->txmm_base);
+  mtlk_txmm_quiesce(&hw->txdm_base);
+  mtlk_osal_timer_cancel_sync(&hw->rx.pending.timer);
+#ifdef MTCFG_LEGACY_INT_RECOVERY_MON
+  mtlk_osal_timer_cancel_sync(&hw->recover_timer);
+#endif
+  wave_mmb_drv_drain_dma(mtlk_ccr_get_device(hw->ccr));
+  wave_rcvry_dump_before_reset(hw);
+  _mtlk_mmb_cleanup_reset_mac(hw);
+  mtlk_ccr_reset_mac(hw->ccr);
+  wave_hw_monitor_flush_tx(hw);
+}
+
+void wave_hw_mmb_quiesce(mtlk_hw_t *hw)
+{
+  mutex_lock(&hw->quiesce_lock);
+  wave_hw_mmb_quiesce_locked(hw);
+  mutex_unlock(&hw->quiesce_lock);
+}
