+/* device_shutdown() must fence the card without releasing shared BARs or
+ * host allocations. The auxiliary endpoint may be visited before the main
+ * endpoint, whose terminal reset still needs those mappings. */
+static void
+_pci_shutdown (struct pci_dev *pdev)
+{
+  mtlk_mmb_drv_t *obj = pci_get_drvdata(pdev);
+  u16 command;
+
+  if (!obj)
+    return;
+
+  if (!obj->g6_pci_aux) {
+    wave_hw_mmb_quiesce(obj->hw_api->hw);
+  } else {
+    pci_intx(pdev, 0);
+    pci_clear_master(pdev);
+    if (pci_read_config_word(pdev, PCI_COMMAND, &command) ||
+        (command & PCI_COMMAND_MASTER))
+      panic("WAVE: cannot fence auxiliary PCI DMA at shutdown");
+  }
+  dev_info(&pdev->dev, "WAVE DMA fenced for shutdown\n");
 }
 
