+/* Called after the hardware owner has blocked all new submissions. */
+void wave_mmb_drv_drain_dma(struct device *dev)
+{
+  mtlk_mmb_drv_t *obj = dev_get_drvdata(dev);
+  u16 command;
+  unsigned int i;
+
+  pci_intx(obj->pdev, 0);
+  pci_clear_master(obj->pdev);
+  if (pci_read_config_word(obj->pdev, PCI_COMMAND, &command) ||
+      (command & PCI_COMMAND_MASTER))
+    panic("AX50 WAVE: cannot fence DMA; refusing to free live buffers");
+  for (i = 0; i < obj->nof_irqs; i++) {
+    if (test_bit(i, &obj->irqs_requested))
+      synchronize_irq(obj->irq_out[i]);
+  }
+  kill_all_tasklets(obj);
+  /* This drains outstanding reads; the hardware owner also resets the
+   * WLAN DMA engines before releasing any buffer or mapping. */
+  pci_wait_for_pending_transaction(obj->pdev);
+  synchronize_net();
+}
+
+static int wave_pci_start_dma(mtlk_mmb_drv_t *obj)
+{
+  u16 command;
+
+  /* IRQ handlers and tasklets are ready, and the WAVE core is reset. */
+  pci_set_master(obj->pdev);
+  pci_intx(obj->pdev, 1);
+  if (pci_read_config_word(obj->pdev, PCI_COMMAND, &command) ||
+      !(command & PCI_COMMAND_MASTER) || (command & PCI_COMMAND_INTX_DISABLE)) {
+    pci_intx(obj->pdev, 0);
+    pci_clear_master(obj->pdev);
+    return MTLK_ERR_NOT_READY;
+  }
+  /* Program the device output after PCI INTx is enabled, with its source
+   * still masked and firmware CPUs held in reset. IRQ handlers already own
+   * the line. This preserves the retained driver's PCI/device ordering. */
+  mtlk_hw_mmb_set_msi_intr_mode(obj->hw_api->hw, obj->irq_mode);
+  mtlk_ccr_print_irq_regs(&obj->ccr);
+  return MTLK_ERR_OK;
+}
+
+/* Reuse the requested IRQ identities after the hardware owner has masked
+ * sources, fenced PCI DMA, joined IRQs/tasklets, and reset the device. */
+int wave_mmb_drv_restart_dma(struct device *dev)
+{
+  mtlk_mmb_drv_t *obj = dev_get_drvdata(dev);
+  tasklet_func **tasklets;
+  unsigned int i;
+
+  if (obj->ihd_pending || obj->tasklets_initialized)
+    return MTLK_ERR_NOT_READY;
+  switch (obj->nof_irqs) {
+    case 6: tasklets = tasklets_8; break;
+    case 4: tasklets = tasklets_4; break;
+    case 1: tasklets = tasklets_1; break;
+    default: return MTLK_ERR_NOT_SUPPORTED;
+  }
+  for (i = 0; i < obj->nof_irqs; i++) {
+    if (!test_bit(i, &obj->irqs_requested))
+      continue;
+    /* Do not overwrite irq_handler_data: shared IRQs still reference it. */
+    obj->irq_handler_data[i].status = MTLK_IRQ_NONE;
+    tasklet_init(&obj->irq_tasklet[i], tasklets[i], (mtlk_handle_t)&obj->irq_handler_data[i]);
+    set_bit(i, &obj->tasklets_initialized);
+  }
+  return wave_pci_start_dma(obj);
 }
 
