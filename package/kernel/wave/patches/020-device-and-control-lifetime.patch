+
+static void wave_hw_tx_wake_locked(mtlk_hw_t *hw)
+{
+  struct wave_tx_queue *queue;
+
+  if (READ_ONCE(hw->quiescing))
+    return;
+  list_for_each_entry(queue, &hw->tx.queues, node) {
+    if (netif_running(queue->ndev))
+      netif_tx_wake_all_queues(queue->ndev);
+  }
+}
+
+void wave_hw_tx_queue_start(mtlk_hw_t *hw, struct wave_tx_queue *queue)
+{
+  mtlk_osal_lock_acquire(&hw->tx.bdr_data.lock);
+  list_add_tail(&queue->node, &hw->tx.queues);
+  if (READ_ONCE(hw->quiescing) || !hw->tx.nof_free_bds)
+    netif_tx_stop_all_queues(queue->ndev);
+  else
+    netif_tx_start_all_queues(queue->ndev);
+  mtlk_osal_lock_release(&hw->tx.bdr_data.lock);
+}
+
+void wave_hw_tx_queue_stop(mtlk_hw_t *hw, struct wave_tx_queue *queue)
+{
+  mtlk_osal_lock_acquire(&hw->tx.bdr_data.lock);
+  list_del_init(&queue->node);
+  netif_tx_stop_all_queues(queue->ndev);
+  mtlk_osal_lock_release(&hw->tx.bdr_data.lock);
