+static struct mtlk_hw_bss_ind_mirror *
+wave_mgmt_rx_owner(mtlk_hw_t *hw, u32 address, u32 index)
+{
+  mtlk_mmb_basic_bdr_t *bdr = &hw->bss_mgmt.rx_bdr.basic;
+  struct mtlk_hw_bss_ind_mirror *entry;
+  unsigned int i;
+
+  /* Firmware is given a local RD index. Verify it against the DMA owner;
+   * Ethernet decapsulation can move the payload within the allocation. */
+  if (index < bdr->nof_bds) {
+    entry = _mtlk_basic_bdr_get_mirror_bd(bdr, index, struct mtlk_hw_bss_ind_mirror);
+    if (entry->dma_addr && address >= entry->dma_addr &&
+        address - entry->dma_addr < entry->size)
+      return entry;
+  }
+  for (i = 0; i < bdr->nof_bds; i++) {
+    if (i == index)
+      continue;
+    entry = _mtlk_basic_bdr_get_mirror_bd(bdr, i, struct mtlk_hw_bss_ind_mirror);
+    if (entry->dma_addr && address >= entry->dma_addr &&
+        address - entry->dma_addr < entry->size)
+      return entry;
+  }
+  return NULL;
+}
