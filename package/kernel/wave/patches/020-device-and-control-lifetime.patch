+static void wave_bss_complete_pmf(struct mtlk_hw_bss_req_mirror *entry)
+{
+  struct wave_pmf *pmf = xchg(&entry->pmf, NULL);
+
+  if (pmf)
+    wave_pmf_complete(pmf, entry->pmf_slot);
+}
+
+/* Called after terminal quiesce or the complete restartable monitor fence.
+ * The VAP lifetime excludes process producers; both fences join IRQ/tasklet
+ * producers and reset firmware before any pending PMF reference is detached. */
+void wave_hw_mmb_detach_pmf(mtlk_hw_t *hw, struct wave_pmf *pmf)
+{
+  mtlk_mmb_basic_bdr_t *ring = &hw->bss_mgmt.tx_bdr.basic;
+  unsigned int i;
+
+  if (WARN_ON(!READ_ONCE(hw->quiescing) && !wave_hw_monitor_fenced(hw)))
+    return;
+  for (i = 0; i < ring->nof_bds; i++) {
+    struct mtlk_hw_bss_req_mirror *entry =
+      _mtlk_basic_bdr_get_mirror_bd(ring, i, struct mtlk_hw_bss_req_mirror);
+    if (READ_ONCE(entry->pmf) == pmf)
+      wave_bss_complete_pmf(entry);
+  }
+}
+
+/* A successful queue publication holds the exact monitor netdev until native
+ * CFM or post-DMA-fence retirement. This is not a mac80211 STA skb. */
+static void wave_bss_complete_raw(struct mtlk_hw_bss_req_mirror *entry,
+                                  bool completed)
+{
+  struct sk_buff *skb = xchg(&entry->skb, NULL);
+  struct net_device *ndev;
+
+  if (!skb)
+    return;
+  ndev = skb->dev;
+  if (completed) {
+    ndev->stats.tx_packets++;
+    ndev->stats.tx_bytes += skb->len;
+  } else {
+    ndev->stats.tx_dropped++;
+    ndev->stats.tx_errors++;
+  }
+  dev_kfree_skb_any(skb);
+  dev_put(ndev);
+}
+
+static void wave_hw_monitor_flush_tx(mtlk_hw_t *hw)
+{
+  mtlk_mmb_advanced_bdr_t *queues[] = { &hw->bss_mgmt.tx_bdr, &hw->bss_mgmt.tx_res_bdr };
+  unsigned int q, i;
+
+  if (WARN_ON(!READ_ONCE(hw->quiescing) && !wave_hw_monitor_fenced(hw)))
+    return;
+  if (!(hw->flags & HW_FLAGS_PREPARED_BSS_REQ_BDR))
+    return;
+  /* RAW producers have joined the queue gate; IRQ/tasklet/DMA are fenced.
+   * Keep native BD/list ownership for its existing reset/free operation. */
+  for (q = 0; q < ARRAY_SIZE(queues); q++) {
+    for (i = 0; i < queues[q]->basic.nof_bds; i++) {
+      struct mtlk_hw_bss_req_mirror *entry =
+        _mtlk_basic_bdr_get_mirror_bd(&queues[q]->basic, i, struct mtlk_hw_bss_req_mirror);
+      if (entry->extra_processing != PROCESS_RAW_DATA || !entry->skb)
+        continue;
+      if (entry->dma_addr) {
+        mtlk_osal_unmap_phys_addr(mtlk_ccr_get_dev_ctx(hw->ccr), entry->dma_addr,
+                                  entry->size, MTLK_DATA_TO_DEVICE);
+        entry->dma_addr = 0;
+      }
+      wave_bss_complete_raw(entry, false);
+    }
+  }
+}
+
+
+static void wave_bss_discard_skb(mtlk_hw_t *hw, struct mtlk_hw_bss_req_mirror *entry)
+{
+  wave_radio_t *radio;
+
+  if (!entry->skb)
+    return;
+  if (entry->extra_processing == PROCESS_RAW_DATA) {
+    wave_bss_complete_raw(entry, false);
+    return;
+  }
+  radio = __mtlk_hw_wave_radio_get(hw, entry->radio_id);
+  if (WARN_ON(!radio || !wave_radio_mac80211_get(radio)))
+    return;
+  ieee80211_free_txskb(wave_radio_ieee80211_hw_get(radio), entry->skb);
+  entry->skb = NULL;
+}
