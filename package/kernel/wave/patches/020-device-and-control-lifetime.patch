+/* Called only after all native core serializers have been joined, or after
+ * the existing recovery owner has blocked all its slave VAP serializers.
+ * It has the same PCI/IRQ/tasklet/DMA/reset boundary as terminal quiesce but
+ * retains restartable TXMM and core objects. It never clears quiescing. */
+static int _wave_hw_monitor_fence_locked(mtlk_hw_t *hw)
+{
+  mtlk_handle_t flags;
+  int res = MTLK_ERR_NOT_READY;
+
+  lockdep_assert_held(&hw->quiesce_lock);
+  if (hw->quiescing || !wave_hw_monitor_held(hw))
+    goto out;
+  if (hw->monitor_fenced) {
+    res = MTLK_ERR_OK;
+    goto out;
+  }
+  wave_hw_monitor_disable_tx(hw);
+  flags = mtlk_osal_lock_acquire_irq(&hw->reg_lock);
+  /* Shared IRQs can still call our handler after PCI INTx is disabled.
+   * Close admission before the join; monitor_fenced means reset completed. */
+  hw->monitor_irqs_blocked = true;
+  WRITE_ONCE(hw->state, MTLK_HW_STATE_APPFATAL);
+  _mtlk_mmb_stop_events_completely(hw);
+  mtlk_ccr_disable_interrupts(hw->ccr, MTLK_IRQ_ALL);
+  mtlk_osal_lock_release_irq(&hw->reg_lock, flags);
+  if (hw->flags & HW_FLAGS_PREPARED_DATA_REQ_BDR) {
+    mtlk_osal_lock_acquire(&hw->tx.bdr_data.lock);
+    wave_hw_tx_stop_locked(hw);
+    mtlk_osal_lock_release(&hw->tx.bdr_data.lock);
+  }
+  mtlk_osal_timer_cancel_sync(&hw->rx.pending.timer);
+#ifdef MTCFG_LEGACY_INT_RECOVERY_MON
+  mtlk_osal_timer_cancel_sync(&hw->recover_timer);
+#endif
+  wave_mmb_drv_drain_dma(mtlk_ccr_get_device(hw->ccr));
+  wave_rcvry_dump_before_reset(hw);
+  _mtlk_mmb_cleanup_reset_mac(hw);
+  mtlk_ccr_reset_mac(hw->ccr);
+  smp_store_release(&hw->monitor_fenced, true);
+  wave_hw_monitor_flush_tx(hw);
+  res = MTLK_ERR_OK;
+out:
+  return res;
+}
