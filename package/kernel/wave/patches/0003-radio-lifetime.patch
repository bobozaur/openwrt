+/* The caller has fenced DMA/drained IRQs and still owns the mac80211 hw. */
+void wave_hw_mmb_flush_sta_tx(mtlk_hw_t *hw, unsigned int radio_id)
+{
+  mtlk_mmb_advanced_bdr_t *queues[] = { &hw->bss_mgmt.tx_bdr, &hw->bss_mgmt.tx_res_bdr };
+  unsigned int q, i;
+
+  if (WARN_ON(!READ_ONCE(hw->quiescing)))
+    return;
+  for (q = 0; q < ARRAY_SIZE(queues); q++) {
+    for (i = 0; i < queues[q]->basic.nof_bds; i++) {
+      struct mtlk_hw_bss_req_mirror *entry =
+        _mtlk_basic_bdr_get_mirror_bd(&queues[q]->basic, i, struct mtlk_hw_bss_req_mirror);
+      if (entry->radio_id == radio_id)
+        wave_bss_discard_skb(hw, entry);
+    }
+  }
+}
