@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef WAVE_BSS_COLOR_H
+#define WAVE_BSS_COLOR_H
+
+/* Native BSS, peer and VAP operations share the radio master serializer.
+ * Firmware keeps color state per VAP. Other VAPs may have peers, but this
+ * VAP's connected peers keep their negotiated color. The AP beacon/PDB can
+ * already contain a newly requested value, so use the acknowledged color. */
+static inline int
+wave_bss_color_check(mtlk_core_t *core, uint8 color)
+{
+  if (color > 63)
+    return MTLK_ERR_PARAMS;
+  if (!mtlk_stadb_is_empty(&core->slow_ctx->stadb) &&
+      (!core->fw_bss_color_valid || color != core->fw_bss_color))
+    return MTLK_ERR_NOT_SUPPORTED;
+
+  return MTLK_ERR_OK;
+}
+
+static inline void
+wave_bss_color_complete(mtlk_core_t *core, uint8 color, int result)
+{
+  if (result == MTLK_ERR_OK) {
+    /* Firmware has accepted this value even if a later AP permission or
+     * WMM step rejects activation. REMOVE_VAP or recovery clears it. */
+    core->fw_bss_color = color;
+    core->fw_bss_color_valid = TRUE;
+  } else if (!core->fw_bss_color_valid || core->fw_bss_color != color) {
+    /* A lost reply cannot leave a changed color usable as the old one. */
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+    core->fw_bss_color_valid = FALSE;
+  }
+}
+
+#endif /* WAVE_BSS_COLOR_H */
