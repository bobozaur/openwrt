+
+  if (mode == BF_STATE_EXPLICIT || mode == BF_STATE_AUTO_MODE)
+    return MTLK_ERR_OK;
+
+  mgr = mtlk_vap_get_manager(core->vap_handle);
+  count = mtlk_vap_manager_get_max_vaps_count(mgr);
+  for (i = 0; i < count; i++) {
+    mtlk_vap_handle_t vap;
+    mtlk_core_t *ap;
+    struct wave_he_bf_profile bf;
+    mtlk_pdb_size_t size = sizeof(bf);
+
+    if (mtlk_vap_manager_get_vap_handle(mgr, i, &vap) != MTLK_ERR_OK ||
+        !mtlk_vap_is_ap(vap))
+      continue;
+    ap = mtlk_vap_get_core(vap);
+    if (!ap->slow_ctx->ap_started && !ap->slow_ctx->ap_preparing)
+      continue;
+    if (MTLK_CORE_PDB_GET_BINARY(ap, PARAM_DB_CORE_HE_BF, &bf, &size) != MTLK_ERR_OK ||
+        size != sizeof(bf))
+      return MTLK_ERR_NOT_READY;
+    if (bf.enabled)
+      return MTLK_ERR_BUSY;
+  }
+  return MTLK_ERR_OK;
+}
+
+#endif /* WAVE_HE_BF_MODE_H */
--- a/wireless/driver/linux/wave_he_caps.h
+++ b/wireless/driver/linux/wave_he_caps.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef WAVE_HE_CAPS_H
+#define WAVE_HE_CAPS_H
+
+#include <net/cfg80211.h>
+#include "wave_he_compat.h"
+
+static inline void
+wave_he_cap_init(struct ieee80211_sband_iftype_data *data,
+                 enum nl80211_band band, unsigned int nss, unsigned int rx_chains,
+                 enum nl80211_iftype type, bool has_160)
+{
+  struct ieee80211_sta_he_cap *he = &data->he_cap;
+  u16 mcs = 0xffff;
+  unsigned int i;
+
+  memset(data, 0, sizeof(*data));
+  data->types_mask = BIT(type);
+  he->has_he = true;
+  /* Retained AX templates support LDPC, 4xLTF/0.8GI and MCS0..11.
+   * Clamp their generic stream counts to this board. Optional features
+   * requiring additional control/legacy peer fields remain unadvertised.
+   */
+  he->he_cap_elem.mac_cap_info[0] = WAVE_HE_HTC;
+  if (type == NL80211_IFTYPE_STATION)
+    he->he_cap_elem.mac_cap_info[1] = IEEE80211_HE_MAC_CAP1_TF_MAC_PAD_DUR_16US;
+  he->he_cap_elem.mac_cap_info[2] = WAVE_HE_ACK_EN;
+  he->he_cap_elem.mac_cap_info[3] = WAVE_HE_AMPDU_EXT_2;
+  he->he_cap_elem.phy_cap_info[0] = band == NL80211_BAND_2GHZ ?
+                                   WAVE_HE_WIDTH_2G : WAVE_HE_WIDTH_5G;
+  has_160 = has_160 && band == NL80211_BAND_5GHZ;
+  if (has_160)
+    he->he_cap_elem.phy_cap_info[0] |= WAVE_HE_WIDTH_160;
+  he->he_cap_elem.phy_cap_info[1] = WAVE_HE_LDPC;
+  /* HE STBC directions remain unadvertised: forced native STBC failed PHY
+   * qualification. Keep the independently qualified SU beamformer below. */
+  if (type == NL80211_IFTYPE_AP && nss >= 2 && rx_chains) {
+    he->he_cap_elem.phy_cap_info[3] = WAVE_HE_SU_BEAMFORMER;
+    /* Donor AP: two sounding dimensions <=80 MHz, one above 80 MHz.
+     * Both fields encode count minus one. HE160 keeps its two data streams;
+     * the zero >80 sounding field does not mean beamforming is disabled.
+     * Native STA sounding and Ng16 feedback are not advertised.
+     */
+    he->he_cap_elem.phy_cap_info[5] = 1;
+    he->he_cap_elem.phy_cap_info[6] = WAVE_HE_SU_FEEDBACK;
+  }
+  he->he_cap_elem.phy_cap_info[7] = WAVE_HE_4XLTF_08GI;
+  /* Request conservative receive padding on air; the peer encoder separately
+   * translates the upstream AP's receive requirements into the old ABI. */
+  he->he_cap_elem.phy_cap_info[9] =
+    IEEE80211_HE_PHY_CAP9_NOMINAL_PKT_PADDING_16US <<
+    IEEE80211_HE_PHY_CAP9_NOMINAL_PKT_PADDING_POS;
+  for (i = 0; i < nss; i++) {
+    mcs &= ~(3U << (2 * i));
+    mcs |= IEEE80211_HE_MCS_SUPPORT_0_11 << (2 * i);
+  }
+  he->he_mcs_nss_supp.rx_mcs_80 = cpu_to_le16(mcs);
+  he->he_mcs_nss_supp.tx_mcs_80 = cpu_to_le16(mcs);
+  he->he_mcs_nss_supp.rx_mcs_160 = cpu_to_le16(has_160 ? mcs : 0xffff);
+  he->he_mcs_nss_supp.tx_mcs_160 = cpu_to_le16(has_160 ? mcs : 0xffff);
+  he->he_mcs_nss_supp.rx_mcs_80p80 = cpu_to_le16(0xffff);
+  he->he_mcs_nss_supp.tx_mcs_80p80 = cpu_to_le16(0xffff);
+}
+
+#endif /* WAVE_HE_CAPS_H */
--- a/wireless/driver/linux/wave_he_compat.h
+++ b/wireless/driver/linux/wave_he_compat.h
@@ -0,0 +1,312 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef WAVE_HE_COMPAT_H
+#define WAVE_HE_COMPAT_H
+
+/* The retained D3 STA_ADD contract stores extension ID, six MAC bytes and
+ * eight PHY bytes. The remaining three UMI PHY bytes stay zero. Keep this
+ * byte codec independent of native structure packing and host endianness.
+ */
+struct wave_he_peer {
+  unsigned char mac_phy[15];
+  unsigned char mcs[8];
+  unsigned char ppe[13];
+};
+
+#define WAVE_HE_MAX_NSS 2
+#define WAVE_HE_WIDTH_2G 0x02
+#define WAVE_HE_WIDTH_5G 0x04
+#define WAVE_HE_WIDTH_160 0x08
+#define WAVE_HE_WIDTH_80P80 0x10
+#define WAVE_HE_HTC 0x01
+#define WAVE_HE_ACK_EN 0x80
+#define WAVE_HE_AMPDU_EXT_MASK 0x18
+#define WAVE_HE_AMPDU_EXT_2 0x10
+#define WAVE_HE_LDPC 0x20
+#define WAVE_HE_STBC_TX_80 0x04
+#define WAVE_HE_STBC_RX_80 0x08
+#define WAVE_HE_NDP_4XLTF_32GI 0x02
+#define WAVE_HE_SU_BEAMFORMER 0x80
+#define WAVE_HE_SU_BEAMFORMEE 0x01
+#define WAVE_HE_SU_CODEBOOK_42 0x01
+#define WAVE_HE_TRIG_SU_FEEDBACK 0x04
+#define WAVE_HE_TRIG_CQI_FEEDBACK 0x10
+#define WAVE_HE_SU_FEEDBACK (WAVE_HE_TRIG_SU_FEEDBACK | WAVE_HE_TRIG_CQI_FEEDBACK)
+#define WAVE_HE_PPE_PRESENT 0x80
+#define WAVE_HE_4XLTF_08GI 0x04
+
+/* Effective AP profile from the accepted beacon, not the radio capability.
+ * Dimension fields retain their on-air encoding: zero means one dimension.
+ */
+struct wave_he_bf_profile {
+  unsigned char enabled;
+  unsigned char dimensions; /* PHY5 bits 0..2 (<=80), 3..5 (>80). */
+  unsigned char feedback;   /* PHY6 triggered SU/CQI, no MU or Ng16. */
+};
+
+static inline int
+wave_he_bf_valid(const struct wave_he_bf_profile *bf,
+                 unsigned int tx_chains, unsigned int rx_chains)
+{
+  if (!bf->enabled)
+    return !bf->dimensions && !bf->feedback;
+  /* Retained AP sounding uses at most two dimensions <=80 MHz and one
+   * above 80 MHz. Feedback reception requires an available RX chain.
+   */
+  return bf->enabled == 1 && tx_chains >= 2 && rx_chains &&
+         bf->dimensions <= 1 && !(bf->feedback & ~WAVE_HE_SU_FEEDBACK);
+}
+
+/* Inputs are the validated native 17-byte HE MAC/PHY element and the LE16
+ * RX/TX MCS maps for <=80 and, when advertised, 160 MHz. The width mask is
+ * this radio's capability; the peer determines which maps are present.
+ * local_phy2 is our advertised PHY2, not the peer's transmit capability.
+ * Return -1 for malformed/unrepresentable input; never downgrade a station
+ * that mac80211 has already negotiated as HE. Output is published on success.
+ * HE STBC, TWT, DCM, MU and ER remain omitted. AP SU beamforming is encoded
+ * separately below; peer receive padding keeps its independent contract.
+ */
+static inline int
+wave_he_encode_peer(struct wave_he_peer *out,
+                    const unsigned char cap[17],
+                    const unsigned char *mcs,
+                    const unsigned char *ppe, unsigned int ppe_len,
+                    unsigned int nss, unsigned int width,
+                    unsigned int local_phy2)
+{
+  struct wave_he_peer result = { 0 };
+  unsigned int i, bit, mask, rx, tx, rx_nss = 0, ppe_nss, ru_count, bits;
+  unsigned int maps, map_nss;
+  unsigned int extension, padding, ppet16, ppet8, value;
+
+  if (!nss || nss > WAVE_HE_MAX_NSS ||
+      (local_phy2 & (WAVE_HE_STBC_TX_80 | WAVE_HE_STBC_RX_80)) ||
+      (width != WAVE_HE_WIDTH_2G && width != WAVE_HE_WIDTH_5G &&
+       width != (WAVE_HE_WIDTH_5G | WAVE_HE_WIDTH_160)))
+    return -1;
+
+  width &= cap[6];
+  maps = (width & WAVE_HE_WIDTH_160) ? 2 : 1;
+  mask = (1U << (2 * nss)) - 1;
+  for (i = 0; i < sizeof(result.mcs); i++)
+    result.mcs[i] = 0xff;
+  for (i = 0; i < maps * 4; i += 4) {
+    rx = ((mcs[i] | (mcs[i + 1] << 8)) & mask) | (0xffffU & ~mask);
+    tx = ((mcs[i + 2] | (mcs[i + 3] << 8)) & mask) | (0xffffU & ~mask);
+    if ((rx & 3) == 3 || (tx & 3) == 3)
+      return -1;
+    map_nss = nss;
+    while (((rx >> (2 * (map_nss - 1))) & 3) == 3)
+      map_nss--;
+    if (map_nss > rx_nss)
+      rx_nss = map_nss;
+    result.mcs[i] = rx;
+    result.mcs[i + 1] = rx >> 8;
+    result.mcs[i + 2] = tx;
+    result.mcs[i + 3] = tx >> 8;
+  }
+
+  result.mac_phy[0] = 35; /* WLAN_EID_EXT_HE_CAPABILITY */
+  result.mac_phy[1] = cap[0] & WAVE_HE_HTC;
+  result.mac_phy[3] = cap[2] & WAVE_HE_ACK_EN;
+  /* This numeric field must be minimized, not bitwise intersected. */
+  extension = cap[3] & WAVE_HE_AMPDU_EXT_MASK;
+  result.mac_phy[4] = extension < WAVE_HE_AMPDU_EXT_2 ?
+                       extension : WAVE_HE_AMPDU_EXT_2;
+  result.mac_phy[7] = width;
+  result.mac_phy[8] = cap[7] & WAVE_HE_LDPC;
+  /* Do not negotiate an unqualified local STBC direction from peer bits. */
+  result.mac_phy[14] = cap[13] & WAVE_HE_4XLTF_08GI;
+
+  /* Peer padding is a receive requirement, independent of our optional PHY
+   * features. Modern PHY9 is outside the retained prefix: encode its nominal
+   * padding as equivalent PPE thresholds instead of silently dropping it.
+   */
+  if (cap[12] & WAVE_HE_PPE_PRESENT) {
+    if (!ppe || !ppe_len)
+      return -1;
+    ppe_nss = (ppe[0] & 7) + 1;
+    ru_count = 0;
+    for (i = 3; i < 7; i++)
+      ru_count += (ppe[0] >> i) & 1;
+    if (!ru_count || (7 + 6 * ppe_nss * ru_count + 7) / 8 > ppe_len)
+      return -1;
+    if (ppe_nss > rx_nss)
+      ppe_nss = rx_nss;
+    bits = 7 + 6 * ppe_nss * ru_count;
+    /* Entries are NSS-major. Retaining the RU bitmap means the supported
+     * streams are a bounded prefix; no RU reordering/repacking is needed.
+     * Bit 7 of byte 0 already belongs to the first PPET16 value.
+     */
+    for (i = 0; i < (bits + 7) / 8; i++)
+      result.ppe[i] = ppe[i];
+    result.ppe[0] = (result.ppe[0] & ~7U) | (ppe_nss - 1);
+    if (bits & 7)
+      result.ppe[bits / 8] &= (1U << (bits & 7)) - 1;
+  } else {
+    padding = cap[15] >> 6;
+    if (padding == 3) /* Reserved, no standards-defined equivalent. */
+      return -1;
+    ppet16 = padding == 2 ? 0 : 7;
+    ppet8 = padding == 1 ? 0 : 7;
+    result.ppe[0] = (rx_nss - 1) | (15U << 3);
+    value = ppet16 | (ppet8 << 3);
+    for (i = 0; i < 4 * rx_nss; i++) {
+      for (bit = 0; bit < 6; bit++) {
+        unsigned int offset = 7 + 6 * i + bit;
+        result.ppe[offset / 8] |= ((value >> bit) & 1) << (offset & 7);
+      }
+    }
+  }
+  result.mac_phy[13] = WAVE_HE_PPE_PRESENT;
+  *out = result;
+  return 0;
+}
+
+/* Hostapd passes the complete peer capability, including optional wide-band
+ * maps before PPE. Unlike mac80211, it does not intersect these maps first.
+ * Our symmetric MCS0..11 profile only needs the existing per-direction NSS
+ * clamp. Do not mistake a 160/80+80 map for the PPE header.
+ */
+static inline int
+wave_he_encode_raw_peer(struct wave_he_peer *out, const unsigned char *cap,
+                        unsigned int length, unsigned int nss,
+                        unsigned int width, unsigned int local_phy2)
+{
+  unsigned int offset = 21;
+
+  if (!cap || length < offset)
+    return -1;
+  if (cap[6] & WAVE_HE_WIDTH_160)
+    offset += 4;
+  if (cap[6] & WAVE_HE_WIDTH_80P80)
+    offset += 4;
+  if (length < offset)
+    return -1;
+  return wave_he_encode_peer(out, cap, cap + 17, cap + offset,
+                             length - offset, nss, width, local_phy2);
+}
+
+/* The donor's AP SU beamformer consumes the peer's beamformee capability.
+ * Keep the STA-role encoder above unchanged until STA sounding is supported.
+ */
+static inline int
+wave_he_encode_ap_peer(struct wave_he_peer *out, const unsigned char *cap,
+                       unsigned int length, unsigned int nss,
+                       unsigned int width, unsigned int local_phy2,
+                       const struct wave_he_bf_profile *bf)
+{
+  struct wave_he_peer result;
+  unsigned int local_sts, peer_sts, nc;
+
+  if (!wave_he_bf_valid(bf, nss, 1) ||
+      wave_he_encode_raw_peer(&result, cap, length, nss, width, local_phy2))
+    return -1;
+  if (bf->enabled && (cap[10] & WAVE_HE_SU_BEAMFORMEE)) {
+    local_sts = bf->dimensions & 7;
+    peer_sts = (cap[10] >> 2) & 7;
+    if (peer_sts > local_sts)
+      peer_sts = local_sts;
+    result.mac_phy[11] = WAVE_HE_SU_BEAMFORMEE | (peer_sts << 2);
+    if (result.mac_phy[7] & WAVE_HE_WIDTH_160) {
+      local_sts = (bf->dimensions >> 3) & 7;
+      peer_sts = cap[10] >> 5;
+      if (peer_sts > local_sts)
+        peer_sts = local_sts;
+      result.mac_phy[11] |= peer_sts << 5;
+    }
+    /* The retained non-advertised transmit profile supports this NDP and
+     * SU codebook. Ng16 changed subcarrier indices after D3; keep it clear.
+     * No local beamformee or peer beamformer capability is implied.
+     */
+    result.mac_phy[9] |= cap[8] & WAVE_HE_NDP_4XLTF_32GI;
+    result.mac_phy[13] |= cap[12] & (WAVE_HE_SU_CODEBOOK_42 | bf->feedback);
+    nc = (cap[13] >> 3) & 7;
+    local_sts = bf->dimensions & 7;
+    if (nc > local_sts)
+      nc = local_sts;
+    result.mac_phy[14] |= nc << 3;
+  }
+  *out = result;
+  return 0;
+}
+
+struct wave_he_ap_beacon {
+  unsigned char enabled;
+  unsigned char color; /* Zero disables coloring in SET_BSS. */
+  unsigned char mcs[8];
+  struct wave_he_bf_profile bf;
+};
+
+/* Decode the native SU operation profile for SET_BSS. The requested color
+ * belongs to the BSS, not the radio or driver. ER SU Disable is an operating
+ * restriction, independent of the ER capability bits that we do not advertise.
+ * Offsets are the final IEEE layout, not the D3 prefix used by STA_ADD.
+ */
+static inline int
+wave_he_parse_ap_beacon(struct wave_he_ap_beacon *out,
+                        const unsigned char *ies, unsigned int length)
+{
+  struct wave_he_ap_beacon result = { 0 };
+  const unsigned char *cap = 0, *op = 0;
+  unsigned int cap_len = 0, op_len = 0, offset = 0, i, needed;
+
+  for (i = 0; i < sizeof(result.mcs); i++)
+    result.mcs[i] = 0xff;
+  if (!ies && length)
+    return -1;
+  while (offset < length) {
+    const unsigned char *ie = ies + offset;
+    if (length - offset < 2 || ie[1] > length - offset - 2)
+      return -1;
+    if (ie[0] == 255 && ie[1]) {
+      if (ie[2] == 35) {
+        if (cap)
+          return -1;
+        cap = ie + 3;
+        cap_len = ie[1] - 1;
+      } else if (ie[2] == 36) {
+        if (op)
+          return -1;
+        op = ie + 3;
+        op_len = ie[1] - 1;
+      }
+    }
+    offset += 2 + ie[1];
+  }
+  if (cap || op) {
+    if (!cap || !op || cap_len < 21 || op_len < 6)
+      return -1;
+    /* Contiguous widths, no AP PPE/TWT/partial color/6GHz operation, PE16us.
+     * Reject local HE STBC (PHY2/7), DCM (PHY3/8) and ER (PHY8), including
+     * caller-supplied beacon capabilities outside the advertised profile.
+     * SU beamformee, MU feedback and Ng16 remain unsupported locally. */
+    if ((cap[8] & (WAVE_HE_STBC_TX_80 | WAVE_HE_STBC_RX_80)) ||
+        (cap[13] & 0xc0) || (cap[9] & 0x3f) || (cap[14] & 0xd1) ||
+        (cap[6] & WAVE_HE_WIDTH_80P80) || (cap[12] & WAVE_HE_PPE_PRESENT) ||
+        (cap[10] & 0x03) || (cap[11] & 0xc0) || (cap[12] & 0x0b) ||
+        (cap[0] & 0x06) || (op[0] & 0x0f) != 4 ||
+        (op[1] & 0x80) || (op[2] & 0x02) || (op[3] & 0x40) ||
+        (!(op[3] & 0x80) && !(op[3] & 0x3f)) ||
+        op[4] != 0xfc || op[5] != 0xff)
+      return -1;
+    needed = 6 + ((op[1] & 0x40) ? 3 : 0);
+    if (op_len != needed ||
+        cap_len != 21U + ((cap[6] & WAVE_HE_WIDTH_160) ? 4U : 0U))
+      return -1;
+    for (i = 0; i < cap_len - 17; i++)
+      result.mcs[i] = cap[17 + i];
+    result.enabled = 1;
+    result.color = (op[3] & 0x80) ? 0 : (op[3] & 0x3f);
+    if (cap[9] & WAVE_HE_SU_BEAMFORMER) {
+      result.bf.enabled = 1;
+      result.bf.dimensions = cap[11] & 0x3f;
+      result.bf.feedback = cap[12] & WAVE_HE_SU_FEEDBACK;
+      if (!wave_he_bf_valid(&result.bf, WAVE_HE_MAX_NSS, 1))
+        return -1;
+    }
+  }
+  *out = result;
+  return 0;
+}
+
+#endif /* WAVE_HE_COMPAT_H */
