+#define WAVE_MULTI_AP_EXTENSION    6
+#define WAVE_MULTI_AP_BACKHAUL_BSS BIT(6)
+#define WAVE_MULTI_AP_BACKHAUL_STA BIT(7)
+
+/* Select the Multi-AP IE itself: a later WFA IE may have a different type.
+ * Only one complete extension declaration can authorize a local/peer role. */
+static bool wave_multi_ap_role(const u8 *ies, size_t len, u8 role)
+{
+  bool found = false, extension = false, backhaul = false;
+
+  if (!ies)
+    return false;
+  while (len) {
+    const u8 *attr;
+    size_t size, left;
+
+    if (len < 2 || ies[1] > len - 2)
+      return false;
+    size = ies[1] + 2;
+    if (ies[0] == WLAN_EID_VENDOR_SPECIFIC && ies[1] >= 4 &&
+        ies[2] == ((WLAN_OUI_WFA >> 16) & 0xff) &&
+        ies[3] == ((WLAN_OUI_WFA >> 8) & 0xff) &&
+        ies[4] == (WLAN_OUI_WFA & 0xff) &&
+        ies[5] == WLAN_OUI_TYPE_WFA_MULTI_AP) {
+      if (found)
+        return false;
+      found = true;
+      attr = ies + 6;
+      left = ies[1] - 4;
+      while (left) {
+        if (left < 2 || attr[1] > left - 2)
+          return false;
+        if (attr[0] == WAVE_MULTI_AP_EXTENSION) {
+          if (extension || attr[1] != 1)
+            return false;
+          extension = true;
+          backhaul = !!(attr[2] & role);
+        }
+        left -= attr[1] + 2;
+        attr += attr[1] + 2;
+      }
+    }
+    ies += size;
+    len -= size;
+  }
+  return found && extension && backhaul;
+}
