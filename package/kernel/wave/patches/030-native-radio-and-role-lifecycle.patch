+#include <linux/crc32.h>
+#include <linux/ieee80211.h>
+#include <linux/limits.h>
+#include <linux/skbuff.h>
+#include <linux/unaligned.h>
+#include <net/cfg80211.h>
+#include <net/ieee80211_radiotap.h>
+
+/* The caller owns DMA retirement, record reassembly and both input extents.
+ * PHY96 is the matching packed G6_RX_PHY_METRICS ABI. This returns a separate
+ * skb so that delivering a monitor packet never transfers the DMA allocation.
+ * Unknown fields are omitted, including the unqualified TSF sample position.
+ */
+static struct sk_buff *
+wave_monitor_radiotap(const u8 *phy96, const u8 *frame, size_t frame_len,
+                      u16 frequency, enum nl80211_band band)
+{
+  static const u16 ofdm_rates[] = { 60, 90, 120, 180, 240, 360, 480, 540 };
+  static const u16 cck_rates[] = { 10, 20, 55, 110 };
+  u8 header[20] = { 0 };
+  struct sk_buff *skb;
+  u32 present = BIT(IEEE80211_RADIOTAP_FLAGS) |
+                BIT(IEEE80211_RADIOTAP_CHANNEL);
+  u32 common, user0, user1;
+  unsigned int mode, rate, mcs, pos = 8, i;
+  u16 channel_flags;
+  u8 flags = IEEE80211_RADIOTAP_F_FCS;
+  int signal = S8_MIN;
+  bool valid, have_rate = false, have_mcs = false;
+
+  if (!phy96 || !frame || frame_len < FCS_LEN ||
+      frame_len > UINT_MAX - sizeof(header))
+    return NULL;
+  if (band == NL80211_BAND_2GHZ)
+    channel_flags = IEEE80211_CHAN_2GHZ;
+  else if (band == NL80211_BAND_5GHZ)
+    channel_flags = IEEE80211_CHAN_5GHZ | IEEE80211_CHAN_OFDM;
+  else
+    return NULL;
+
+  common = get_unaligned_le32(phy96);
+  valid = !!(get_unaligned_le32(phy96 + 48) & BIT(1));
+  user0 = get_unaligned_le32(phy96 + 64);
+  user1 = get_unaligned_le32(phy96 + 68);
+  mode = (common >> 17) & 7;
+  rate = (user1 >> 4) & 0x1ffff;
+  mcs = (user0 >> 24) & 0x3f;
+
+  if (valid) {
+    /* Native Gen6 RSSI offset is zero. Match its four-entry consumer, while
+     * leaving the hardware's 0x80 unavailable value out of measurements. */
+    for (i = 0; i < 4; i++)
+      signal = max(signal, (int)(s8)phy96[72 + i]);
+
+    if (mode == 0) {
+      channel_flags |= IEEE80211_CHAN_OFDM;
+      for (i = 0; i < ARRAY_SIZE(ofdm_rates); i++)
+        if (rate == ofdm_rates[i])
+          have_rate = true;
+    } else if (mode == 1 && band == NL80211_BAND_2GHZ) {
+      channel_flags |= IEEE80211_CHAN_CCK;
+      for (i = 0; i < ARRAY_SIZE(cck_rates); i++)
+        if (rate == cck_rates[i])
+          have_rate = true;
+    } else if (mode >= 2 && mode <= 4) {
+      channel_flags |= IEEE80211_CHAN_OFDM;
+      have_mcs = mode == 2 && mcs <= 32;
+    }
+  }
+
+  /* Check the preserved received FCS, never infer integrity or decryption
+   * from the descriptor completion, Protected bit or PHY validity alone. */
+  if ((crc32_le(~0U, frame, frame_len - FCS_LEN) ^ ~0U) !=
+      get_unaligned_le32(frame + frame_len - FCS_LEN))
+    flags |= IEEE80211_RADIOTAP_F_BADFCS;
+  header[pos++] = flags;
+
+  if (have_rate) {
+    present |= BIT(IEEE80211_RADIOTAP_RATE);
+    header[pos++] = rate / 5; /* Native 0.1 Mbps to radiotap 0.5 Mbps. */
+  }
+  pos = ALIGN(pos, 2);
+  put_unaligned_le16(frequency, header + pos);
+  put_unaligned_le16(channel_flags, header + pos + 2);
+  pos += 4;
+
+  if (signal != S8_MIN) {
+    present |= BIT(IEEE80211_RADIOTAP_DBM_ANTSIGNAL);
+    header[pos++] = (u8)(s8)signal;
+  }
+  if (have_mcs) {
+    present |= BIT(IEEE80211_RADIOTAP_MCS);
+    header[pos++] = IEEE80211_RADIOTAP_MCS_HAVE_MCS |
+                    IEEE80211_RADIOTAP_MCS_HAVE_FEC;
+    header[pos++] = (user1 & BIT(0)) ? IEEE80211_RADIOTAP_MCS_FEC_LDPC : 0;
+    header[pos++] = mcs;
+  }
+
+  put_unaligned_le16(pos, header + 2);
+  put_unaligned_le32(present, header + 4);
+  skb = alloc_skb(pos + frame_len, GFP_ATOMIC);
+  if (!skb)
+    return NULL;
+  skb_put_data(skb, header, pos);
+  skb_put_data(skb, frame, frame_len);
+  return skb;
+}
