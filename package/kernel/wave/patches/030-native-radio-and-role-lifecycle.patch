  * Entry point for setting beacon template.
  * It has to be called from master VAP serializer context.
  */
+static bool wave_beacon_frame_valid(const void *data, unsigned int len, u8 subtype)
+{
+  const u8 *frame = data;
+  unsigned int pos = sizeof(frame_head_t) + sizeof(frame_beacon_head_t);
+
+  if (!frame || len < pos || frame[0] != subtype)
+    return false;
+  while (pos < len) {
+    if (len - pos < 2 || frame[pos + 1] > len - pos - 2)
+      return false;
+    pos += 2 + frame[pos + 1];
+  }
+  return true;
+}
+
+static bool wave_beacon_cap_changed(const mtlk_beacon_data_t *data,
+                                    const beacon_template_t *old, int id)
+{
+  const u8 *a = cfg80211_find_ie(id, data->tail, data->tail_len);
+  const u8 *b = cfg80211_find_ie(id, old->ptr + old->head_len, old->tail_len);
+  u8 width_mask = id == IE_HT_CAPABILITIES ? IEEE80211_HT_CAP_SUP_WIDTH_20_40 :
+    id == IE_VHT_CAPABILITIES ? IEEE80211_VHT_CAP_SUPP_CHAN_WIDTH_MASK : 0;
+
+  if (!a || !b)
+    return !!a != !!b;
+  if (a[1] != b[1])
+    return true;
+  if (!a[1])
+    return false;
+
+  /* Hostapd updates these advertised width bits after CSA. They do not
+   * alter SET_BSS state; keep all other capability, MCS and SMPS bytes
+   * immutable while the BSS runs. SET_CHAN owns channel/DFS permission. */
+  return ((a[2] ^ b[2]) & ~width_mask) || memcmp(a + 3, b + 3, a[1] - 1);
+}
