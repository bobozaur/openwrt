+/* Called only after acknowledged VAP removal or terminal hardware quiesce.
+ * Unsubmitted initial candidates have no DMA ownership and use the same reset. */
+void wave_beacon_man_stop(mtlk_core_t *core)
+{
+  beacon_manager_t *bmgr = &core->slow_ctx->beacon_man_data;
+  beacon_manager_priv_t *priv = wave_radio_beacon_man_private_get(wave_vap_radio_get(core->vap_handle));
+  unsigned int idx = mtlk_vap_get_id(core->vap_handle);
+
+  if (priv->fw_is_busy && priv->for_vap_idx == idx) {
+    atomic_inc(&priv->submission_epoch);
+    priv->fw_is_busy = FALSE;
+    priv->for_vap_idx = BMGR_NO_VAP;
+  }
+  wave_beacon_man_cleanup(bmgr, core->vap_handle);
+  mtlk_osal_lock_acquire(&core->slow_ctx->probe_resp_lock);
+  if (core->slow_ctx->probe_resp_templ)
+    mtlk_osal_mem_free(core->slow_ctx->probe_resp_templ);
+  core->slow_ctx->probe_resp_templ = NULL;
+  core->slow_ctx->probe_resp_templ_len = 0;
+  mtlk_osal_lock_release(&core->slow_ctx->probe_resp_lock);
+  memset(bmgr, 0, sizeof(*bmgr));
+  bmgr->drv_idx = 1;
+  wave_beacon_man_schedule(core, idx);
 }
 
