+static void wave_beacon_command(mtlk_handle_t handle)
+{
+  beacon_manager_priv_t *priv = HANDLE_T_PTR(beacon_manager_priv_t, handle);
+  struct wave_beacon_indication event;
+  mtlk_core_t *core;
+  unsigned long flags;
+
+  spin_lock_irqsave(&priv->indication_lock, flags);
+  event = priv->indication;
+  core = priv->receiver;
+  spin_unlock_irqrestore(&priv->indication_lock, flags);
+  wave_beacon_man_template_ind_handle(HANDLE_T(core), &event, sizeof(event));
+}
+
+static void wave_beacon_command_complete(serializer_result_t res,
+                                         mtlk_command_t *command, mtlk_handle_t ctx)
+{
+  MTLK_UNREFERENCED_PARAM(res);
+  MTLK_UNREFERENCED_PARAM(command);
+  MTLK_UNREFERENCED_PARAM(ctx);
+}
