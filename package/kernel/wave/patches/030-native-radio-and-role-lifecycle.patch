+/* Standard full-MAC monitor netdevice. It never owns a firmware DMA buffer.
+ * One card-wide reservation covers its VAP/template, channel and restart. */
+struct wave_monitor {
+  struct wireless_dev wdev;
+  wv_cfg80211_t *cfg;
+  mtlk_hw_t *hw;
+  mtlk_core_t *master;
+  struct cfg80211_chan_def chandef;
+  spinlock_t rx_lock;
+  struct sk_buff *fragment;
+  u16 fragment_id;
+  u16 fragment_length;
+  u16 frequency;
+  enum nl80211_band band;
+  bool claimed;
+  bool removing;
+  bool receiving;
+};
+
+static void wave_monitor_rx_clear(struct wave_monitor *mon)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&mon->rx_lock, flags);
+  mon->receiving = false;
+  mon->frequency = 0;
+  kfree_skb(mon->fragment);
+  mon->fragment = NULL;
+  spin_unlock_irqrestore(&mon->rx_lock, flags);
+}
+
+/* The hardware callback retains RCU lifetime and its checked, CPU-owned skb.
+ * Each native synthetic IPv4 fragment is parsed before any private prefix is
+ * read. One ordered datagram, bounded by the native 16-bit UDP length, may be
+ * pending; a new first fragment replaces an incomplete datagram. No IP packet
+ * or the driver's reused DMA skb is injected into the host network stack. */
+void wv_cfg80211_monitor_rx(struct wave_monitor *mon, const struct sk_buff *input)
+{
+  const u8 *p = input->data, *udp;
+  struct sk_buff *packet = NULL;
+  unsigned long flags;
+  unsigned int ip_len, frag, offset, length, udp_len, alignment, frame_len, i;
+  u32 sum = 0;
+  u16 id;
+  bool more;
+
+  spin_lock_irqsave(&mon->rx_lock, flags);
+  if (!mon->receiving || !mon->frequency || skb_is_nonlinear(input) ||
+      input->len < ETH_HLEN + 20)
+    goto drop;
+  if (memcmp(p, wave_monitor_header, ETH_HLEN) || p[14] != 0x45 ||
+      p[23] != IPPROTO_UDP || memcmp(p + 26, wave_monitor_header + 26, 8))
+    goto invalid;
+  ip_len = get_unaligned_be16(p + 16);
+  if (ip_len < 20 || ip_len > input->len - ETH_HLEN)
+    goto invalid;
+  for (i = 14; i < 34; i += 2)
+    sum += get_unaligned_be16(p + i);
+  while (sum >> 16)
+    sum = (sum & 0xffff) + (sum >> 16);
+  if (sum != 0xffff)
+    goto invalid;
+  frag = get_unaligned_be16(p + 20);
+  if (frag & (IP_CE | IP_DF))
+    goto invalid;
+  offset = (frag & IP_OFFSET) * 8;
+  more = !!(frag & IP_MF);
+  length = ip_len - 20;
+  id = get_unaligned_be16(p + 18);
+  if (!length || (more && (length & 7)))
+    goto invalid;
+  if (!offset) {
+    kfree_skb(mon->fragment);
+    mon->fragment = NULL;
+    if (length < 8 || memcmp(p + 34, wave_monitor_header + 34, 4) ||
+        get_unaligned_be16(p + 40) != 0)
+      goto invalid;
+    udp_len = get_unaligned_be16(p + 38);
+    if (udp_len < 120 + 4 || udp_len > 65535 - 20 || length > udp_len)
+      goto invalid;
+    if (!more) {
+      if (length != udp_len)
+        goto invalid;
+      udp = p + 34;
+      goto datagram;
+    }
+    if (length == udp_len)
+      goto invalid;
+    mon->fragment = alloc_skb(udp_len, GFP_ATOMIC);
+    if (!mon->fragment)
+      goto drop;
+    mon->fragment_id = id;
+    mon->fragment_length = udp_len;
+  } else if (!mon->fragment || mon->fragment_id != id ||
+             mon->fragment->len != offset) {
+    goto invalid;
+  }
+  if (length > mon->fragment_length - mon->fragment->len)
+    goto invalid;
+  skb_put_data(mon->fragment, p + 34, length);
+  if (more) {
+    if (mon->fragment->len == mon->fragment_length)
+      goto invalid;
+    spin_unlock_irqrestore(&mon->rx_lock, flags);
+    return;
+  }
+  if (mon->fragment->len != mon->fragment_length)
+    goto invalid;
+  udp = mon->fragment->data;
+  udp_len = mon->fragment_length;
+datagram:
+  /* UDP8 + proprietary16 + exact packed G6 PHY96 precede alignment/frame. */
+  if (udp[8] != 0xde || udp[9] != 0xaf)
+    goto invalid;
+  alignment = udp[10];
+  if (alignment > 15 || udp_len < 120 + alignment + 4)
+    goto invalid;
+  frame_len = udp_len - 120 - alignment;
+  packet = wave_monitor_radiotap(udp + 24, udp + 120 + alignment,
+                                  frame_len, mon->frequency, mon->band);
+  if (!packet)
+    goto invalid;
+  kfree_skb(mon->fragment);
+  mon->fragment = NULL;
+  packet->dev = mon->wdev.netdev;
+  packet->protocol = htons(ETH_P_802_2);
+  packet->pkt_type = PACKET_OTHERHOST;
+  packet->ip_summed = CHECKSUM_NONE;
+  skb_reset_mac_header(packet);
+  mon->wdev.netdev->stats.rx_packets++;
+  mon->wdev.netdev->stats.rx_bytes += packet->len;
+  spin_unlock_irqrestore(&mon->rx_lock, flags);
+  netif_rx(packet);
+  return;
+invalid:
+  kfree_skb(mon->fragment);
+  mon->fragment = NULL;
+drop:
+  mon->wdev.netdev->stats.rx_dropped++;
+  spin_unlock_irqrestore(&mon->rx_lock, flags);
+}
+
+void wv_cfg80211_monitor_suspend(struct wave_monitor *mon)
+{
+  wave_hw_monitor_set_tx(mon->hw, mon, false);
+  netif_tx_disable(mon->wdev.netdev);
+  netif_carrier_off(mon->wdev.netdev);
+  wave_monitor_rx_clear(mon);
+}
+
+struct wave_monitor_channel_command {
+  struct wave_monitor *mon;
+  struct cfg80211_chan_def chandef;
+  int result;
+};
+
+static void wave_monitor_channel_command(mtlk_handle_t handle)
+{
+  struct wave_monitor_channel_command *cmd = HANDLE_T_PTR(struct wave_monitor_channel_command, handle);
+  struct wave_monitor *mon = cmd->mon;
+  struct set_chan_param_data cpd = { 0 };
+
+  if (!wave_hw_monitor_is_owner(mon->hw, mon)) {
+    cmd->result = MTLK_ERR_NOT_READY;
+    return;
+  }
+  wave_radio_chandef_copy(&cpd.chandef, &cmd->chandef);
+  cpd.ndev = mon->wdev.netdev;
+  cpd.vap_id = mtlk_vap_get_id(mon->master->vap_handle);
+  cpd.monitor = true;
+  cpd.dont_notify_kernel = TRUE;
+  cpd.switch_type = ST_NORMAL;
+  cpd.block_tx_pre = TRUE;
+  /* Only receive operation is qualified for the native sniffer owner. */
+  cpd.block_tx_post = TRUE;
+  cmd->result = wave_core_vap_activate(mon->master, cpd.chandef.chan.band, TRUE);
+  if (cmd->result == MTLK_ERR_OK)
+    cmd->result = core_cfg_set_chan(mon->master, &cpd.chandef, &cpd);
+}
+
+static int wave_monitor_start_channel(struct wave_monitor *mon)
+{
+  struct wave_monitor_channel_command ctx = { .mon = mon, .chandef = mon->chandef,
+                                             .result = MTLK_ERR_NOT_READY };
+  mtlk_command_t command;
+  unsigned long flags;
+  int res;
+
+  if (!cfg80211_chandef_valid(&ctx.chandef) ||
+      !cfg80211_chandef_usable(mon->wdev.wiphy, &ctx.chandef, IEEE80211_CHAN_DISABLED))
+    return -EINVAL;
+  res = mtlk_command_init(&command, wave_monitor_channel_command, HANDLE_T(&ctx), MTLK_SLID);
+  if (res == MTLK_ERR_OK) {
+    /* execute_blocked joins an executing command even if its queue TTL expires. */
+    res = mtlk_core_execute_hw_command(mon->master, &command, 10000);
+    mtlk_command_cleanup(&command);
+    if (res == MTLK_ERR_OK)
+      res = ctx.result;
+  }
+  if (res == MTLK_ERR_OK && !wave_hw_monitor_set_tx(mon->hw, mon, false))
+    res = MTLK_ERR_NOT_READY;
+  if (res == MTLK_ERR_OK) {
+    spin_lock_irqsave(&mon->rx_lock, flags);
+    mon->band = mon->chandef.chan->band;
+    mon->frequency = mon->chandef.chan->center_freq;
+    mon->receiving = true;
+    spin_unlock_irqrestore(&mon->rx_lock, flags);
+    netif_carrier_on(mon->wdev.netdev);
+    netif_start_queue(mon->wdev.netdev);
+  }
+  return _mtlk_df_mtlk_to_linux_error_code(res);
+}
+
+static int wave_monitor_stop_hardware(struct wave_monitor *mon)
+{
+  int res = MTLK_ERR_OK;
+
+  wv_cfg80211_monitor_suspend(mon);
+  if (mon->removing) {
+    if (mon->claimed)
+      wave_hw_mmb_quiesce(mon->hw);
+    return 0;
+  }
+  if (mon->claimed && wave_hw_monitor_dirty(mon->hw))
+    res = wave_rcvry_monitor_restart(mon->hw);
+  if (res != MTLK_ERR_OK)
+    wave_hw_mmb_quiesce(mon->hw);
+  return _mtlk_df_mtlk_to_linux_error_code(res);
+}
+
+static int wave_monitor_open(struct net_device *ndev)
+{
+  struct wave_monitor *mon = netdev_priv(ndev);
+  int res;
+
+  res = wave_hw_monitor_claim(mon->hw, mon->master->vap_handle, mon);
+  if (res != MTLK_ERR_OK)
+    return _mtlk_df_mtlk_to_linux_error_code(res);
+  mon->claimed = true;
+  /* cfg80211 accepts monitor channel selection only with a running monitor.
+   * A cold radio has no channel yet: reserve the exclusive owner, but keep
+   * RX/TX stopped until the first successful set_monitor_channel request.
+   * A usable saved channel still resumes through the ordinary open path. */
+  if (!cfg80211_chandef_valid(&mon->chandef) ||
+      !cfg80211_chandef_usable(mon->wdev.wiphy, &mon->chandef, IEEE80211_CHAN_DISABLED)) {
+    wv_cfg80211_monitor_suspend(mon);
+    return 0;
+  }
+  res = wave_monitor_start_channel(mon);
+  if (res) {
+    wave_monitor_stop_hardware(mon);
+    wave_hw_monitor_release(mon->hw, mon);
+    mon->claimed = false;
+  }
+  return res;
+}
+
+static int wave_monitor_close(struct net_device *ndev)
+{
+  struct wave_monitor *mon = netdev_priv(ndev);
+  int res = wave_monitor_stop_hardware(mon);
+
+  if (mon->claimed) {
+    wave_hw_monitor_release(mon->hw, mon);
+    mon->claimed = false;
+  }
+  if (res)
+    pr_err("WAVE: monitor stop failed; card remains fenced (%d)\n", res);
+  return res;
+}
+
+static netdev_tx_t wave_monitor_xmit(struct sk_buff *skb, struct net_device *ndev)
+{
+  /* ndo_start_xmit consumes the packet even when TX is unsupported. Socket
+   * acceptance is not transmission; report the drop without retrying it. */
+  ndev->stats.tx_dropped++;
+  ndev->stats.tx_errors++;
+  dev_kfree_skb_any(skb);
+  return NETDEV_TX_OK;
+}
+
+static const struct net_device_ops wave_monitor_netdev_ops = {
+  .ndo_open = wave_monitor_open,
+  .ndo_stop = wave_monitor_close,
+  .ndo_start_xmit = wave_monitor_xmit,
+};
+
+static void wave_monitor_setup(struct net_device *ndev)
+{
+  ndev->type = ARPHRD_IEEE80211_RADIOTAP;
+  ndev->netdev_ops = &wave_monitor_netdev_ops;
+  ndev->needs_free_netdev = true;
+  ndev->flags = IFF_NOARP;
+  ndev->priv_flags |= IFF_NO_QUEUE;
+  ndev->addr_len = ETH_ALEN;
+  ndev->mtu = 65535;
+  ndev->min_mtu = 4;
+  ndev->max_mtu = 65535;
+  netif_carrier_off(ndev);
+}
+
+static struct wireless_dev *wave_monitor_add(wv_cfg80211_t *cfg,
+    const char *name, struct vif_params *params)
+{
+  struct net_device *ndev;
+  struct wave_monitor *mon;
+  struct mtlk_chan_def *home;
+  IEEE_ADDR native_mac;
+  mtlk_core_t *master = _wave_cfg80211_get_maste_core(cfg);
+  mtlk_hw_t *hw = mtlk_vap_get_hw(master->vap_handle);
+  int res;
+
+  if (!wave_hw_monitor_supported(hw) || wave_radio_id_get(cfg->radio) != 0)
+    return ERR_PTR(-EOPNOTSUPP);
+  if (cfg->monitor)
+    return ERR_PTR(-EBUSY);
+  if (params->use_4addr > 0 ||
+      (params->flags & (MONITOR_FLAG_ACTIVE | MONITOR_FLAG_COOK_FRAMES)))
+    return ERR_PTR(-EOPNOTSUPP);
+  MTLK_CORE_PDB_GET_MAC(master, PARAM_DB_CORE_MAC_ADDR, &native_mac);
+  if (is_zero_ether_addr(params->macaddr) && !is_valid_ether_addr(native_mac.au8Addr))
+    return ERR_PTR(-ENODEV);
+  ndev = alloc_netdev(sizeof(*mon), name, NET_NAME_USER, wave_monitor_setup);
+  if (!ndev)
+    return ERR_PTR(-ENOMEM);
+  mon = netdev_priv(ndev);
+  mon->cfg = cfg;
+  mon->hw = hw;
+  mon->master = master;
+  mon->wdev.wiphy = cfg->wiphy;
+  mon->wdev.netdev = ndev;
+  mon->wdev.iftype = NL80211_IFTYPE_MONITOR;
+  ndev->ieee80211_ptr = &mon->wdev;
+  SET_NETDEV_DEV(ndev, wiphy_dev(cfg->wiphy));
+  spin_lock_init(&mon->rx_lock);
+  if (is_zero_ether_addr(params->macaddr))
+    eth_hw_addr_set(ndev, native_mac.au8Addr);
+  else
+    eth_hw_addr_set(ndev, params->macaddr);
+  home = __wave_core_chandef_get(master);
+  mon->chandef.chan = ieee80211_get_channel(cfg->wiphy, home->chan.center_freq);
+  mon->chandef.width = mtlkcw2nlcw(home->width, home->is_noht);
+  mon->chandef.center_freq1 = home->center_freq1;
+  mon->chandef.center_freq2 = home->center_freq2;
+  res = cfg80211_register_netdevice(ndev);
+  if (res) {
+    free_netdev(ndev);
+    return ERR_PTR(res);
+  }
+  cfg->monitor = mon;
+  return &mon->wdev;
+}
+
+static int wave_monitor_del(wv_cfg80211_t *cfg, struct wireless_dev *wdev)
+{
+  if (!cfg->monitor || &cfg->monitor->wdev != wdev)
+    return -ENODEV;
+  cfg80211_unregister_netdevice(wdev->netdev);
+  cfg->monitor = NULL;
+  return 0;
+}
+
+/* RTNL owns netdev lifetime; close notifiers take wiphy themselves. This is
+ * called before native VAP/core teardown and remains harmless on rollback. */
+void wv_cfg80211_monitor_unregister(wv_cfg80211_t *cfg)
+{
+  struct wave_monitor *mon;
+
+  ASSERT_RTNL();
+  wiphy_lock(cfg->wiphy);
+  mon = cfg->monitor;
+  if (mon)
+    mon->removing = true;
+  wiphy_unlock(cfg->wiphy);
+  if (!mon)
+    return;
+  if (netif_running(mon->wdev.netdev))
+    dev_close(mon->wdev.netdev);
+  wiphy_lock(cfg->wiphy);
+  wave_monitor_del(cfg, &mon->wdev);
+  wiphy_unlock(cfg->wiphy);
+}
+
+static int wave_monitor_set_channel(struct wiphy *wiphy, struct net_device *ndev,
+                                     struct cfg80211_chan_def *chandef)
+{
+  wv_cfg80211_t *cfg = wiphy_priv(wiphy);
+  struct wave_monitor *mon = cfg->monitor;
+  int res;
+
+  if (!mon || mon->wdev.netdev != ndev)
+    return -ENODEV;
+  if (!cfg80211_chandef_valid(chandef) ||
+      !cfg80211_chandef_usable(wiphy, chandef, IEEE80211_CHAN_DISABLED))
+    return -EINVAL;
+  if (cfg80211_chandef_identical(chandef, &mon->chandef) &&
+      (!netif_running(mon->wdev.netdev) || READ_ONCE(mon->receiving)))
+    return 0;
+  if (!netif_running(mon->wdev.netdev)) {
+    mon->chandef = *chandef;
+    return 0;
+  }
+  /* A complete fence prevents old-channel queued packets from being labelled
+   * with the new channel. The exclusive card reservation remains held. */
+  res = wave_monitor_stop_hardware(mon);
+  if (res)
+    return res;
+  mon->chandef = *chandef;
+  res = wave_monitor_start_channel(mon);
+  if (res)
+    wave_monitor_stop_hardware(mon);
+  return res;
+}
+
+static int wave_cfg80211_native_admit(struct wiphy *wiphy, struct wireless_dev *wdev)
+{
+  wave_radio_t *radio;
+  mtlk_core_t *master;
+
+  if (wdev && wdev->iftype == NL80211_IFTYPE_MONITOR)
+    return -EOPNOTSUPP;
+  radio = wave_wiphy_radio(wiphy);
+  if (!radio || !wave_radio_control_ready_get(radio))
+    return -EBUSY;
+  master = wave_radio_master_core_get(radio);
+  if (!wave_hw_monitor_user_get(mtlk_vap_get_hw(master->vap_handle)))
+    return -EBUSY;
+  return 0;
+}
+
+static void wave_cfg80211_native_release(struct wiphy *wiphy)
+{
+  wave_hw_monitor_user_put(mtlk_vap_get_hw(wave_radio_master_core_get(wave_wiphy_radio(wiphy))->vap_handle));
+}
