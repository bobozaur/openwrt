   struct wiphy *wiphy,
-  struct net_device *ndev,
+  struct wireless_dev *wdev,
 #if !defined(MTCFG_LINUX_BACKPORT) && LINUX_VERSION_CODE < KERNEL_VERSION(3, 16, 0)
   uint8 *mac,
 #else
@@ -646,6 +646,7 @@
 #endif
   struct station_parameters *params)
 {
+  struct net_device *ndev = wdev->netdev;
   int res;
   int retry_times = 0;
 
@@ -671,7 +672,7 @@
 
