   int res;
   int retry_times = 0;
+
+  if (radio_idx >= 0)
+    return -EOPNOTSUPP;
 
   do {
     res = _wave_cfg80211_op_set_wiphy_params(wiphy, changed);
@@ -1108,13 +1116,14 @@
 
