Subject: [PATCH] validate the firmware station listen interval width

Reject values that would be truncated by the eight-bit firmware ABI.

--- a/wireless/driver/linux/wave_radio.c
+++ b/wireless/driver/linux/wave_radio.c
@@ -2454,6 +2454,10 @@
   }
 
   info->supported_rates_len = params->link_sta_params.supported_rates_len;
+  /* UMI_STA_ADD carries one byte, while nl80211 supplies the 16-bit IEEE
+   * listen interval. Reject values firmware cannot represent. */
+  if (params->listen_interval < 0 || params->listen_interval > U8_MAX)
+    return MTLK_ERR_PARAMS;
   info->listen_interval = params->listen_interval;
 
   /* This AP does not advertise pre-association station creation. */
