+/* Observation only: proc readers must not acquire wiphy or wait for firmware.
+ * The radio outlives its VAP proc entries, including terminal core teardown.
+ */
+void wave_radio_watchdog_start(wave_radio_t *radio)
+{
+  WRITE_ONCE(radio->watchdog_started_at, jiffies);
+  WRITE_ONCE(radio->watchdog_replied, false);
+  smp_store_release(&radio->watchdog_started, true);
+}
+
+void wave_radio_watchdog_reply(wave_radio_t *radio)
+{
+  WRITE_ONCE(radio->watchdog_last_reply, jiffies);
+  smp_store_release(&radio->watchdog_replied, true);
+}
+
+bool wave_radio_health_get(wave_radio_t *radio, uint32 *age_ms, bool *replied)
+{
+  unsigned long stamp, age;
+  bool started = smp_load_acquire(&radio->watchdog_started);
+
+  *replied = smp_load_acquire(&radio->watchdog_replied);
+  stamp = *replied ? READ_ONCE(radio->watchdog_last_reply) :
+                    READ_ONCE(radio->watchdog_started_at);
+  age = jiffies - stamp;
+  *age_ms = started ? jiffies_to_msecs(age) : 0;
+  /* Retained firmware watchdog period50s + reply timeout30s + scheduling
+   * margin20s. Startup grace is explicitly distinct from a firmware reply.
+   */
+  return started && age < 100 * HZ &&
+         smp_load_acquire(&radio->control_ready) &&
+         wave_hw_mmb_ready(radio->hw_api->hw);
 }
 
