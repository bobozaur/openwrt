+static int
+_mtlk_core_cfg_wmm_param_send(mtlk_core_t *core,
+                            const struct mtlk_txq_params table[UMI_AC_NUM_ACS])
+{
+  mtlk_txmm_msg_t man_msg;
+  mtlk_txmm_data_t *man_entry;
+  UMI_SET_WMM_PARAMETERS *req;
+  int i, res;
+  bool uncertain;
+
+  man_entry = mtlk_txmm_msg_init_with_empty_data(&man_msg,
+                  mtlk_vap_get_txmm(core->vap_handle), &res);
+  if (!man_entry)
+    return MTLK_ERR_NO_RESOURCES;
+
+  man_entry->id = UM_MAN_SET_WMM_PARAMETERS_REQ;
+  man_entry->payload_size = sizeof(*req);
+  req = (UMI_SET_WMM_PARAMETERS *)man_entry->payload;
+  memset(req, 0, sizeof(*req));
+  req->vapId = mtlk_vap_get_id(core->vap_handle);
+  for (i = 0; i < UMI_AC_NUM_ACS; i++) {
+    req->wmmParamsPerAc[i].u16CWmin = HOST_TO_MAC16(table[i].cwmin);
+    req->wmmParamsPerAc[i].u16CWmax = HOST_TO_MAC16(table[i].cwmax);
+    req->wmmParamsPerAc[i].u16TXOPlimit = HOST_TO_MAC16(table[i].txop);
+    req->wmmParamsPerAc[i].u8Aifsn = table[i].aifs;
+    req->wmmParamsPerAc[i].acm_flag = table[i].acm_flag;
+  }
+
+  res = mtlk_txmm_msg_send_blocked(&man_msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
+  uncertain = res != MTLK_ERR_OK;
+  if (!uncertain && req->u8Status != UMI_OK) {
+    ELOG_DD("CID-%04x: SET_WMM rejected, status=%u",
+            mtlk_vap_get_oid(core->vap_handle), req->u8Status);
+    res = MTLK_ERR_MAC;
+  }
+  mtlk_txmm_msg_cleanup(&man_msg);
+
+  /* A rejected request preserves the previous table. A missing confirmation
+   * leaves firmware ownership uncertain and uses the existing terminal stop. */
+  if (uncertain)
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+  return res;
+}
