+/* Master-serializer helpers for the paired A0 firmware implementation.
+ * The feature helper admits actual loaded bytes/PSD, never the ABI header
+ * or a version string. Old firmware and all other chips retain their
+ * existing AUTOMATIC/LIMITED path and reject standard FIXED.
+ */
+/* Admit the actual retained platform tables that this hardware owner parsed
+ * and sends, not a PSD filename or an assumed dictionary meaning. The new
+ * calculator uses the conservative UEVM anchor only when every native rate
+ * offset is nonnegative with zero EVM backoff and the external floor is0.
+ * The internal adaptive floor table is deliberately not a FIXED constraint.
+ */
+static BOOL
+_core_cfg_fixed_data_psd(mtlk_hw_t *hw)
+{
+  static const struct {
+    uint32 id, rows, columns;
+  } domain[] = {
+    {0x1b0000, 3, 1},
+    {0x140000, 1, 2},
+    {0x150000, 8, 2},
+    {0x160000, 33, 2},
+    {0x170000, 10, 8},
+    {0x300000, 12, 8},
+  };
+  const hw_psdb_t *psdb = mtlk_hw_get_psdb(hw);
+  uint32 i, j, k, words, seen = 0;
+
+  if (!psdb || !psdb->tables || !psdb->rate_pw_table)
+    return FALSE;
+  for (i = 0; i < psdb->nof_tables; i++) {
+    const psdb_any_table_t *table = psdb->tables[i];
+    if (!table)
+      return FALSE;
+    for (j = 0; j < ARRAY_SIZE(domain); j++)
+      if (table->id == domain[j].id)
+        break;
+    if (j == ARRAY_SIZE(domain))
+      continue;
+    if (seen & BIT(j))
+      return FALSE;
+    words = domain[j].rows * domain[j].columns;
+    if (table->nrows != domain[j].rows || table->ncols != domain[j].columns ||
+        table->nof_words != words + 2)
+      return FALSE;
+    if (j == 0) {
+      for (k = 0; k < words; k++)
+        if (MAC_TO_HOST32(table->data.words[k]) != 0)
+          return FALSE;
+    } else {
+      for (k = 0; k < words; k += 2) {
+        int32 offset = (int32)MAC_TO_HOST32(table->data.words[k]);
+        /* The host's signed8 conversion to1/8dBm must not wrap either. */
+        if (offset < 0 || offset > 31 ||
+            MAC_TO_HOST32(table->data.words[k + 1]) != 0)
+          return FALSE;
+      }
+    }
+    seen |= BIT(j);
+  }
+  return seen == (BIT(ARRAY_SIZE(domain)) - 1);
+}
+
+static BOOL
+_core_cfg_fixed_data_firmware(mtlk_core_t *core)
+{
+  return wave_hw_fw_feature_supported(mtlk_vap_get_hw(core->vap_handle),
+                                      WAVE_FW_FEATURE_FIXED_DATA);
+}
+
+static BOOL
+_core_cfg_fixed_data_supported(mtlk_core_t *core)
+{
+  return _core_cfg_fixed_data_firmware(core) &&
+         _core_cfg_fixed_data_psd(mtlk_vap_get_hw(core->vap_handle));
+}
+
+static int
+_core_cfg_fixed_data_command(mtlk_core_t *core, uint8 operation, uint8 flags,
+                             uint8 half_dbm, struct ax50_fixed_data_request *reply)
+{
+  mtlk_txmm_msg_t msg;
+  mtlk_txmm_data_t *entry;
+  struct ax50_fixed_data_request *req;
+  int res;
+
+  MTLK_STATIC_ASSERT(sizeof(*req) == 8);
+  /* QUERY and DISABLE remain available even if a diagnostic changed
+   * the PSD domain. Losing FIXED eligibility must not prevent its undo. */
+  if (!_core_cfg_fixed_data_firmware(core))
+    return MTLK_ERR_NOT_SUPPORTED;
+  entry = mtlk_txmm_msg_init_with_empty_data(&msg,
+              mtlk_vap_get_txmm(core->vap_handle), NULL);
+  if (!entry)
+    return MTLK_ERR_NO_RESOURCES;
+  entry->id = UM_MAN_FIXED_POWER_REQ;
+  entry->payload_size = sizeof(*req);
+  req = (void *)entry->payload;
+  memset(req, 0, sizeof(*req));
+  req->policy_flags = flags;
+  req->magic = AX50_FIXED_DATA_MAGIC;
+  req->half_dbm = half_dbm;
+  req->operation = operation;
+  req->status = 0xff;
+  req->abi = AX50_FIXED_DATA_ABI;
+  res = mtlk_txmm_msg_send_blocked(&msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
+  if (res == MTLK_ERR_OK) {
+    if (req->magic != AX50_FIXED_DATA_MAGIC || req->abi != AX50_FIXED_DATA_ABI ||
+        req->operation != operation || req->policy_flags > AX50_FIXED_DATA_INCLUDE_11B ||
+        req->active > 1 || req->admissible_half_dbm > AX50_FIXED_DATA_MAX_HALF_DBM) {
+      res = MTLK_ERR_UNKNOWN;
+    } else {
+      switch (req->status) {
+      case AX50_FIXED_DATA_OK:
+        if (reply)
+          *reply = *req;
+        break;
+      case AX50_FIXED_DATA_BAD_REQUEST:
+        res = MTLK_ERR_PARAMS;
+        break;
+      case AX50_FIXED_DATA_CONFLICT:
+        res = MTLK_ERR_BUSY;
+        break;
+      case AX50_FIXED_DATA_UNREPRESENTABLE:
+        res = MTLK_ERR_NOT_SUPPORTED;
+        break;
+      case AX50_FIXED_DATA_NOT_READY:
+        res = MTLK_ERR_NOT_READY;
+        break;
+      default:
+        res = MTLK_ERR_UNKNOWN;
+      }
+    }
+  }
+  mtlk_txmm_msg_cleanup(&msg);
+  return res;
+}
+
+static uint8
+_core_cfg_fixed_data_flags(const struct mtlk_chan_def *cd)
+{
+  return cd->chan.band == MTLK_HW_BAND_2_4_GHZ ? AX50_FIXED_DATA_INCLUDE_11B : 0;
+}
+
+static int
+_core_cfg_fixed_data_begin(mtlk_core_t *core, const struct mtlk_chan_def *cd,
+                           BOOL fixed, unsigned user_limit, BOOL new_request,
+                           unsigned switch_type, BOOL *submitted)
+{
+  struct ax50_fixed_data_request applied_state;
+  uint8 operation;
+  int res;
+
+  *submitted = FALSE;
+  if (!_core_cfg_fixed_data_firmware(core))
+    return fixed ? MTLK_ERR_NOT_SUPPORTED : MTLK_ERR_OK;
+  if (fixed && !_core_cfg_fixed_data_supported(core))
+    return MTLK_ERR_NOT_SUPPORTED;
+  res = _core_cfg_fixed_data_command(core, AX50_FIXED_DATA_QUERY, 0, 0, &applied_state);
+  /* A legacy/DUT policy is a distinct owner. Preserve that existing path
+   * for a normal non-FIXED transaction; do not silently replace it. */
+  if (res == MTLK_ERR_BUSY && !fixed)
+    return MTLK_ERR_OK;
+  if (res != MTLK_ERR_OK)
+    return res;
+  if (!fixed && !applied_state.active)
+    return MTLK_ERR_OK;
+  /* Includes a disable of an existing applied policy. Refuse before
+   * submission if this channel operation cannot run native212. */
+  if (switch_type > ST_NORMAL_AFTER_RSSI)
+    return MTLK_ERR_BUSY;
+  if (fixed && (user_limit % 4 ||
+       user_limit < AX50_FIXED_DATA_MIN_HALF_DBM * 4 ||
+       user_limit > AX50_FIXED_DATA_MAX_HALF_DBM * 4))
+    return MTLK_ERR_PARAMS;
+  operation = !fixed ? AX50_FIXED_DATA_DISABLE :
+              new_request ? AX50_FIXED_DATA_STAGE : AX50_FIXED_DATA_REPLAY;
+  /* Intent precedes submission. Even a lost stage reply may leave a native
+   * pending tuple, so every later failure invokes the existing quiesce and
+   * recovery path. The last-ACK radio PDB has not changed. */
+  *submitted = TRUE;
+  return _core_cfg_fixed_data_command(core, operation,
+            _core_cfg_fixed_data_flags(cd), fixed ? user_limit / 4 : 0, NULL);
+}
+
+static int
+_core_cfg_fixed_data_finish(mtlk_core_t *core, const struct mtlk_chan_def *cd,
+                            BOOL fixed, unsigned user_limit)
+{
+  struct ax50_fixed_data_request applied_state;
+  int res = _core_cfg_fixed_data_command(core, AX50_FIXED_DATA_QUERY, 0, 0, &applied_state);
+
+  if (res != MTLK_ERR_OK)
+    return res;
+  if (applied_state.active != !!fixed)
+    return MTLK_ERR_UNKNOWN;
+  if (fixed && (applied_state.half_dbm != user_limit / 4 ||
+      applied_state.policy_flags != _core_cfg_fixed_data_flags(cd) ||
+      applied_state.admissible_half_dbm < AX50_FIXED_DATA_MIN_HALF_DBM))
+    return MTLK_ERR_UNKNOWN;
+  return MTLK_ERR_OK;
+}
+
+static int
+_core_cfg_fixed_data_get(mtlk_core_t *core, unsigned user_limit, int *dbm)
+{
+  struct ax50_fixed_data_request applied_state;
+  int res;
+
+  if (!_core_cfg_fixed_data_supported(core))
+    return MTLK_ERR_NOT_SUPPORTED;
+  res = _core_cfg_fixed_data_command(core, AX50_FIXED_DATA_QUERY, 0, 0, &applied_state);
+  if (res != MTLK_ERR_OK)
+    return res;
+  if (!applied_state.active || applied_state.half_dbm != user_limit / 4 ||
+      applied_state.admissible_half_dbm < AX50_FIXED_DATA_MIN_HALF_DBM ||
+      applied_state.policy_flags != _core_cfg_fixed_data_flags(__wave_core_chandef_get(core)))
+    return MTLK_ERR_NOT_READY;
+  /* nl80211's get_tx_power callback returns integer dBm. The firmware
+   * request remains exact half-dBm; report the bounded configured value
+   * rounded downward, without labeling it RF telemetry. */
+  *dbm = MIN(applied_state.half_dbm, applied_state.admissible_half_dbm) / 2;
+  return MTLK_ERR_OK;
+}
