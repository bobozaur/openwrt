Subject: wave: acknowledge HE scheduler policy during master initialization

Use the existing Gen6 HE MU configuration message and radio PDB policy on
cold initialization, matching the recovery owner. Propagate command failure
through normal initialization. This does not add STA MU-EDCA timers or
advertise additional HE capabilities.

--- a/wireless/driver/linux/core.c
+++ b/wireless/driver/linux/core.c
@@ -5529,6 +5529,7 @@
 
   mu_operation_config = (UMI_HE_MU_OPERATION_CONFIG *)(man_entry->payload);
   mu_operation_config->enableHeMuOperation = he_mu_operation;
+  mu_operation_config->getSetOperation = API_SET_OPERATION;
 
   res = mtlk_txmm_msg_send_blocked(&man_msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
 
@@ -16670,6 +16671,13 @@
      * Match the retained pre-up owner and recovery before publishing a BSS.
      */
     res = _mtlk_core_send_bf_mode(core, WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_BF_MODE));
+    if (MTLK_ERR_OK != res) goto end;
+
+    /* Apply the radio-wide HE scheduler policy once, as recovery does. The
+     * PDB default alone does not establish an acknowledged firmware state. */
+    if (wave_radio_is_gen6(radio))
+      res = _mtlk_core_set_he_mu_operation(core,
+              WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_HE_MU_OPERATION));
   }
 
 end:
