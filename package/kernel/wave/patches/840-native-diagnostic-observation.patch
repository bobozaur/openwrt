 }
 
+/* The terminal owner has closed admission and joined IRQ/tasklet/DMA work,
+ * but has not reset firmware or released its mappings. Preserve the native
+ * fatal dump contract before that irreversible boundary. */
+void wave_rcvry_dump_before_reset (mtlk_hw_t *hw_ctx)
+{
+  wave_rcvry_card_cfg_t *pcard = _rcvry_card_hw_ctx_get(hw_ctx);
+
+  /* The caller owns this card's lifetime. Ordinary stop and nonfatal lost
+   * acknowledgements must not wait behind another card's dump. */
+  if (!pcard || atomic_read(&pcard->fatal_dump_state) == WAVE_FATAL_DUMP_NONE)
+    return;
+  if (atomic_read(&pcard->fatal_dump_state) == WAVE_FATAL_DUMP_PENDING &&
+      !READ_ONCE(pcard->rcvry_ctx.cfg.fw_dump))
+    return;
+  mutex_lock(&wave_rcvry_dump_mutex);
+  _rcvry_dump_locked(pcard);
+  mutex_unlock(&wave_rcvry_dump_mutex);
+}
+
+/* All actual firmware starts pass here while the CPUs are still in reset.
+ * The old evacuation has finished before a new fatal generation is admitted.
+ * Do not clear the transport poison: a late native reply can outlive reset. */
+void wave_rcvry_firmware_start (mtlk_hw_t *hw_ctx)
+{
+  wave_rcvry_card_cfg_t *pcard;
+
+  mutex_lock(&wave_rcvry_dump_mutex);
+  pcard = _rcvry_card_hw_ctx_get(hw_ctx);
+  if (pcard) {
+    atomic_set(&pcard->fatal_dump_state, WAVE_FATAL_DUMP_NONE);
+    pcard->fatal_dump_result = MTLK_ERR_NOT_READY;
+  }
+  mutex_unlock(&wave_rcvry_dump_mutex);
+}
+
 int wave_rcvry_nl_send_msg_complete_rcvry_req (const uint8 card_idx)
 {
   wave_rcvry_nl_ctx_t *pnl_ctx = &wave_rcvry.nl_ctx;
@@ -2429,6 +2480,9 @@
   if (!pcard)
     return;
 
+  /* Latch before terminating waiters can enter terminal quiesce. */
+  atomic_cmpxchg(&pcard->fatal_dump_state, WAVE_FATAL_DUMP_NONE,
+                 WAVE_FATAL_DUMP_PENDING);
   _rcvry_mac_fatal_pending_set(pcard, TRUE);
   _rcvry_process_mac_fatal(pcard, data);
 }
