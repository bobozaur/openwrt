+/* The General proc owner keeps the data pool alive until its readers drain.
+ * These are ordinary pool totals, not a hardware/register snapshot. */
+bool wave_hw_get_tx_stats(mtlk_hw_t *hw, struct wave_tx_stats *stats)
+{
+  if (!wave_hw_mmb_ready(hw))
+    return false;
+
+  mtlk_osal_lock_acquire(&hw->tx.bdr_data.lock);
+  stats->free_desc = hw->tx.nof_free_bds;
+  stats->used_peak = hw->tx.max_used_bds;
+  mtlk_osal_lock_release(&hw->tx.bdr_data.lock);
+  /* Native software completion total; no device register access. */
+  stats->completed_cfm = READ_ONCE(hw->tx.ring.regs.int_OUT_cntr);
+  return true;
+}
+
 /* Terminal for this probe. Only a fresh PCI probe may restart the card. */
 static void wave_hw_mmb_quiesce_locked(mtlk_hw_t *hw)
 {
@@ -7229,7 +7246,8 @@
   mtlk_osal_timer_cancel_sync(&hw->recover_timer);
 #endif
   wave_mmb_drv_drain_dma(mtlk_ccr_get_device(hw->ccr));
+  wave_rcvry_dump_before_reset(hw);
   _mtlk_mmb_cleanup_reset_mac(hw);
   mtlk_ccr_reset_mac(hw->ccr);
   _mtlk_hw_mhi_stats_dma_reset(hw);
 }
--- a/wireless/driver/shared/hw_mmb.h
+++ b/wireless/driver/shared/hw_mmb.h
