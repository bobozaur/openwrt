   rcvry_ctx->cfg.fail_timer_value = 60 * MTLK_OSAL_MSEC_IN_SEC;
-  rcvry_ctx->cfg.fw_dump = 0;
+  rcvry_ctx->cfg.fw_dump = 1;
 
   rcvry_ctx->signature = RCVRY_SIGN;
