     pnl_ctx->dump_poisoned[card_idx] = TRUE;
 out:
+  if (fatal)
+    pcard->fatal_dump_result = res;
   ILOG0_DD("CID-%02x: FW dump evacuation finished: res=%d", card_idx, res);
   return res;
 }
