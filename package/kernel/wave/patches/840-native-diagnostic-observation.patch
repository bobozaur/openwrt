From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] wave: retain extended native diagnostic observation

Retain the fatal dump before terminal reset and expose TX-pool totals.
The package diagnostic configuration also enables native debug and TSF access.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>

---
--- a/wireless/driver/linux/mtlk_df_user.c
+++ b/wireless/driver/linux/mtlk_df_user.c
@@ -6431,6 +6431,7 @@
   mtlk_df_user_t *df_user = mtlk_df_get_user(df);
   mtlk_core_ui_get_stadb_status_req_t get_stadb_status_req;
   unsigned long sta_cnt = 0;
+  struct wave_tx_stats tx;
 
   /* Get Core general information from DF buffer and don't call Core */
 
@@ -6493,6 +6494,13 @@
 
   _mtlk_df_ui_print_driver_stats(s, &df_user->slow_ctx->core_general_stats);
 
+  if (wave_hw_get_tx_stats(mtlk_vap_get_hw(mtlk_df_get_vap_handle(df)), &tx)) {
+    mtlk_aux_seq_printf(s, "\nShared TX descriptor statistics\n\n");
+    mtlk_aux_seq_printf(s, "%10u TX MSDUs free\n", tx.free_desc);
+    mtlk_aux_seq_printf(s, "%10u TX MSDUs usage peak\n", tx.used_peak);
+    mtlk_aux_seq_printf(s, "%10u TX confirmations consumed\n", tx.completed_cfm);
+  }
+
 #if MTLK_USE_DIRECTCONNECT_DP_API
   _mtlk_df_ui_print_litepath(s, df_user);
   _mtlk_df_ui_print_dcdp_stats(s, df_user);
