@@ -2083,10 +2091,16 @@
 {
   wave_rcvry_nl_ctx_t *pnl_ctx = &wave_rcvry.nl_ctx;
   uint8 card_idx = pcard->card_idx;
+  BOOL fatal = atomic_read(&pcard->fatal_dump_state) != WAVE_FATAL_DUMP_NONE;
   unsigned long flags;
   int res = MTLK_ERR_NOT_READY;
 
   lockdep_assert_held(&wave_rcvry_dump_mutex);
+  if (atomic_read(&pcard->fatal_dump_state) == WAVE_FATAL_DUMP_ATTEMPTED)
+    return pcard->fatal_dump_result;
