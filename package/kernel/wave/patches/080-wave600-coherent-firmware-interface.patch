+	TsManagerRecipientTidGlobalStatistics_t_wave600		tsManagerRecipientTidGlobalStats;
+	TsManagerRecipientStationGlobalStatistics_t_wave600	tsManagerRecipientStationGlobalStats;
+	LinkAdaptationStatistics_t_wave600					linkAdaptationStats;
+	MulticastStatistics_t_wave600						multicastStats;
+	TrainingManagerStatistics_t_wave600					trainingManagerStats;
+	GroupManagerStatistics_t_wave600					groupManagerStats;
+	LinkAdaptationMuStatistics_t_wave600				linkAdaptationMuStats;
