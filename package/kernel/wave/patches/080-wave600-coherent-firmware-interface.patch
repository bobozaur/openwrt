+/* Caller owns phy_rx_status.mutex and the MAC snapshot lock. */
+static void
+_wave600_stats_update_phy(mtlk_hw_t *hw)
+{
+    const StatisticsDb_t_wave600 *db = (const void *)hw->hw_mhi_stats.db_copy;
+    wholePhyRxStatusDb_t *dst = hw->phy_rx_status.db_data;
+    unsigned i, ant;
+
+    MTLK_STATIC_ASSERT(ARRAY_SIZE(db->phyStatistics.staPhyRxStatus) == GEN6_MAX_SID);
+    MTLK_STATIC_ASSERT(ARRAY_SIZE(db->phyStatistics.devicePhyRxStatus) == GEN6_MUN_OF_BANDS);
+    memset(dst, 0, sizeof(*dst));
+    for (i = 0; i < GEN6_MUN_OF_BANDS; i++) {
+        const devicePhyRxStatusDb_t_wave600 *src = &db->phyStatistics.devicePhyRxStatus[i];
+        devicePhyRxStatusDb_t *dev = &dst->dev_status[i];
+
+        /* The fixed cohort uses 0x80 as invalid; legacy readers use zero. */
+        for (ant = 0; ant < ARRAY_SIZE(dev->noise); ant++)
+            dev->noise[ant] = src->noise[ant] == GEN6_PHY_METRIC_INVALID ? 0 : src->noise[ant];
+        wave_memcpy(dev->rf_gain, sizeof(dev->rf_gain), src->rf_gain, sizeof(src->rf_gain));
+        dev->irad = src->irad;
+        dev->tsf = src->tsf;
+        dev->channel_load = src->channel_load;
+        dev->totalChannelUtilization = src->totalChannelUtilization;
+    }
+    for (i = 0; i < GEN6_MAX_SID; i++) {
+        const stationPhyRxStatusDb_t_wave600 *src = &db->phyStatistics.staPhyRxStatus[i];
+        stationPhyRxStatusDb_t *sta = &dst->sta_status[i];
+
+        wave_memcpy(sta->rssi, sizeof(sta->rssi), src->rssi, sizeof(src->rssi));
+        sta->phyRate = src->phyRate;
+        sta->irad = src->irad;
+        sta->lastTsf = src->lastTsf;
+        sta->perClientRxtimeUsage = src->perClientRxtimeUsage;
+        /* The legacy cache's maxRssi is derived from actual antenna samples. */
+        sta->maxRssi = src->rssi[0];
+        for (ant = 1; ant < ARRAY_SIZE(src->rssi); ant++)
+            sta->maxRssi = MAX(sta->maxRssi, src->rssi[ant]);
+    }
+    hw->phy_rx_status.sta_generation = hw->stats_generation;
+    hw->phy_rx_status.valid = TRUE;
+}
