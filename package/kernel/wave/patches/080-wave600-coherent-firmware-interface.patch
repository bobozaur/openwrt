+/* The scan serializer keeps this radio on the sampled channel. */
+int __MTLK_IFUNC
+mtlk_hw_mhi_get_channel_stats(mtlk_hw_t *hw, unsigned radio_idx, struct channel_data_event *ch_data)
+{
+    const StatisticsDb_t_wave600 *db;
+    const devicePhyRxStatusDb_t_wave600 *src;
+    wholePhyRxStatusDb_t *phy;
+    int res = MTLK_ERR_NOT_READY;
+
+    mtlk_osal_mutex_acquire(&hw->phy_rx_status.mutex);
+    if (!hw->phy_rx_status.valid)
+        goto finish;
+
+    mtlk_osal_lock_acquire(&hw->hw_mhi_stats.lock);
+    db = (const void *)hw->hw_mhi_stats.db_copy;
+    src = &db->phyStatistics.devicePhyRxStatus[radio_idx];
+    phy = hw->phy_rx_status.db_data;
+
+    ch_data->dynBW20 = MAC_TO_HOST32(db->dynamicBwStats.dynamicBW20MHz[radio_idx]);
+    ch_data->dynBW40 = MAC_TO_HOST32(db->dynamicBwStats.dynamicBW40MHz[radio_idx]);
+    ch_data->dynBW80 = MAC_TO_HOST32(db->dynamicBwStats.dynamicBW80MHz[radio_idx]);
+    ch_data->dynBW160 = MAC_TO_HOST32(db->dynamicBwStats.dynamicBW160MHz[radio_idx]);
+    ch_data->ext_sta_rx = MAC_TO_HOST32(src->extStaRx);
+    ch_data->tx_power = (int16)MAC_TO_HOST16(src->txPower);
+    ch_data->cwi_noise = src->CWIvalue;
+    ch_data->load = src->channel_load;
+    ch_data->noise_floor = _mtlk_hw_get_noise_by_phy_metrics(hw,
+        phy->dev_status[radio_idx].noise, phy->dev_status[radio_idx].rf_gain);
+    /* This A0 snapshot has no station RSSI/SNR or non-802.11 event sample. */
+    ch_data->filled_mask = CHDATA_DYNBW | CHDATA_CWI_NOISE |
+                          CHDATA_TX_POWER | CHDATA_LOAD;
+    if (ch_data->noise_floor != 0)
+        ch_data->filled_mask |= CHDATA_NOISE_FLOOR;
+    res = MTLK_ERR_OK;
+    mtlk_osal_lock_release(&hw->hw_mhi_stats.lock);
+finish:
+    mtlk_osal_mutex_release(&hw->phy_rx_status.mutex);
+    return res;
+}
