+static int wave_cfg80211_set_tx_power(struct wiphy *wiphy,
+                                      struct wireless_dev *wdev, int radio_idx,
+                                      enum nl80211_tx_power_setting type, int mbm)
+{
+  wv_cfg80211_t *cfg = wiphy_priv(wiphy);
+  if (radio_idx >= 0)
+    return -EOPNOTSUPP;
+  return wave_radio_tx_power_set(cfg->radio, type, mbm);
+}
+
+static int wave_cfg80211_get_tx_power(struct wiphy *wiphy,
+                                      struct wireless_dev *wdev, int radio_idx,
+                                      unsigned int link_id, int *dbm)
+{
+  wv_cfg80211_t *cfg = wiphy_priv(wiphy);
+  if (radio_idx >= 0 || link_id)
+    return -EOPNOTSUPP;
+  return wave_radio_tx_power_get(cfg->radio, dbm);
+}
+
 static struct cfg80211_ops wv_cfg80211_ops = {
+  .set_tx_power = wave_cfg80211_set_tx_power,
+  .get_tx_power = wave_cfg80211_get_tx_power,
   .add_virtual_intf = API_WRAPPER(_wave_cfg80211_op_add_virtual_iface),
