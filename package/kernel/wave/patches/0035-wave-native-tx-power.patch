+static void
+_core_cfg_limit_tx_power(psdb_pw_limits_t *table, unsigned user, unsigned mac)
+{
+  unsigned i, limit = user;
+  if (mac && (!limit || mac < limit))
+    limit = mac;
+  if (limit)
+    for (i = 0; i < ARRAY_SIZE(table->pw_limits); i++)
+      if (table->pw_limits[i] > limit)
+        table->pw_limits[i] = limit;
+}
+
+static void
+_core_cfg_intersect_tx_power(psdb_pw_limits_t *target, const psdb_pw_limits_t *previous)
+{
+  unsigned i;
+  for (i = 0; i < ARRAY_SIZE(target->pw_limits); i++)
+    if (previous->pw_limits[i] && (!target->pw_limits[i] ||
+        previous->pw_limits[i] < target->pw_limits[i]))
+      target->pw_limits[i] = previous->pw_limits[i];
+}
