+/* Both role wiphys submit to this radio's existing master serializer. They
+ * must not acquire each other's wiphy lock or maintain competing user limits.
+ */
+static int
+_wave_radio_tx_power(wave_radio_t *radio, enum wave_tx_power_operation operation,
+                     unsigned limit, int *dbm)
+{
+  struct wave_tx_power_request request = { operation, limit };
+  mtlk_clpb_t *clpb = NULL;
+  mtlk_df_t *df;
+  int res;
+
+  if (!smp_load_acquire(&radio->control_ready))
+    return -EBUSY;
+  df = mtlk_vap_manager_get_master_df(radio->vap_manager);
+  res = _mtlk_df_user_invoke_core(df, WAVE_RADIO_REQ_TX_POWER, &clpb,
+                                 &request, sizeof(request));
+  res = _mtlk_df_user_process_core_retval(res, clpb, WAVE_RADIO_REQ_TX_POWER, !dbm);
+  if (res == MTLK_ERR_OK && dbm) {
+    unsigned size;
+    int *value = mtlk_clpb_enum_get_next(clpb, &size);
+    if (!value || size != sizeof(*value))
+      res = MTLK_ERR_UNKNOWN;
+    else
+      *dbm = *value;
+    mtlk_clpb_delete(clpb);
+  }
+  return _mtlk_df_mtlk_to_linux_error_code(res);
+}
+
+int wave_radio_tx_power_set(wave_radio_t *radio,
+                            enum nl80211_tx_power_setting type, int mbm)
+{
+  unsigned limit;
+
+  switch (type) {
+  case NL80211_TX_POWER_AUTOMATIC:
+    limit = 0;
+    break;
+  case NL80211_TX_POWER_LIMITED:
+    /* Firmware uses positive signed16 values in 1/8 dBm; zero means unset.
+     * Round downward so the configured ceiling is never exceeded.
+     */
+    if (mbm < 13 || mbm > 32767 * 100 / 8)
+      return -EOPNOTSUPP;
+    limit = mbm * 8 / 100;
+    break;
+  case NL80211_TX_POWER_FIXED:
+    return -EOPNOTSUPP;
+  default:
+    return -EINVAL;
+  }
+  return _wave_radio_tx_power(radio, WAVE_TX_POWER_USER, limit, NULL);
+}
+
+int wave_radio_tx_power_get(wave_radio_t *radio, int *dbm)
+{
+  return _wave_radio_tx_power(radio, WAVE_TX_POWER_GET, 0, dbm);
+}
+
+int wave_radio_tx_power_mac(wave_radio_t *radio, int dbm)
+{
+  unsigned limit;
+
+  if (dbm == INT_MIN)
+    limit = 0;
+  else if (dbm <= 0 || dbm > 32767 / 8)
+    return -EOPNOTSUPP;
+  else
+    limit = dbm * 8;
+  return _wave_radio_tx_power(radio, WAVE_TX_POWER_MAC, limit, NULL);
 }
 
