+  return _core_cfg_apply_tx_power(core, center_freq, width, primary, country,
+    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_USER_TX_POWER),
+    WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_MAC_TX_POWER), prepare_channel);
+}
+
+/* The caller owns the master serializer. Before a channel is activated only
+ * the requested ceiling exists; the channel path must apply it before TX.
+ */
+static int
+_core_cfg_refresh_tx_power(mtlk_core_t *core, unsigned user_limit, unsigned mac_limit)
+{
+  struct mtlk_chan_def *cd = __wave_core_chandef_get(core);
+  mtlk_country_code_t country;
+
+  if (!is_channel_certain(cd) ||
+      !mtlk_vap_manager_get_active_vaps_number(mtlk_vap_get_manager(core->vap_handle)))
+    return MTLK_ERR_OK;
+  core_cfg_country_code_get(core, &country);
+  return _core_cfg_apply_tx_power(core, cd->center_freq1, cd->width,
+                                  cd->chan.center_freq, country,
+                                  user_limit, mac_limit, FALSE);
