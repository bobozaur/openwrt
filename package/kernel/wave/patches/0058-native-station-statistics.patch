+/* mac80211 owns association/management lifetime, while firmware owns the
+ * Ethernet data counters. The wiphy mutex pins the native VAP; the lookup
+ * reference pins the cached peer across concurrent disconnect/recovery. */
+static void _wv_ieee80211_op_sta_statistics(struct ieee80211_hw *hw,
+                                           struct ieee80211_vif *vif,
+                                           struct ieee80211_sta *sta,
+                                           struct station_info *sinfo)
+{
+  struct wv_vif_priv *priv = (void *)vif->drv_priv;
+  mtlk_vap_handle_t vap;
+  sta_entry *peer;
+
+  lockdep_assert_wiphy(hw->wiphy);
+  if (!priv->df_user)
+    return;
+  vap = mtlk_df_get_vap_handle(mtlk_df_user_get_df(priv->df_user));
+  peer = mtlk_stadb_find_sta(mtlk_core_get_stadb(mtlk_vap_get_core(vap)), sta->addr);
+  if (!peer)
+    return;
+  mtlk_sta_fill_station_info(peer, sinfo);
+  mtlk_sta_decref(peer);
+}
+
