Subject: [PATCH] wave: admit corrected native individual-SID TXOP reads

Bind the original GET transport to the actual corrected A0 request handlers.
Old firmware and ALL remain configured-only; propagate malformed replies and
native errors without mutating the cached configuration.

--- a/wireless/driver/linux/core_config.c
+++ b/wireless/driver/linux/core_config.c
@@ -6004,21 +6004,54 @@
   return res;
 }
 
-/* Return only the last acknowledged SID/mode configuration. */
+/* Query the last selected SID; ALL and older firmware remain configured-only. */
 int __MTLK_IFUNC
 mtlk_core_receive_txop_mode (mtlk_core_t *core, mtlk_core_txop_mode_t *txop_mode)
 {
-  wave_radio_t *radio = wave_vap_radio_get(core->vap_handle);
+  mtlk_vap_handle_t vap = core->vap_handle;
+  mtlk_hw_t *hw = mtlk_vap_get_hw(vap);
+  wave_radio_t *radio = wave_vap_radio_get(vap);
   uint32 sid = WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_TXOP_SID);
   uint32 mode = WAVE_RADIO_PDB_GET_INT(radio, PARAM_DB_RADIO_TXOP_MODE);
 
-  /* The matching A0 handler writes its upper-MAC SID table before the
-   * lower-MAC GET branch. A zeroed query therefore changes the upper mode.
-   * The serialized setter publishes this pair only after confirmation;
-   * recovery replays it. It is not current station-incarnation telemetry. */
   if (mode > TXOP_LAST_STATE ||
-      !mtlk_hw_is_sid_valid_or_all_sta_sid(mtlk_vap_get_hw(core->vap_handle), sid))
+      !mtlk_hw_is_sid_valid_or_all_sta_sid(hw, sid))
     return MTLK_ERR_NOT_SUPPORTED;
+
+  /* The original A0 GET mutates the upper mode table. Only the complete
+   * loaded correction admits a native read. ALL is not an aggregate GET:
+   * firmware selects slot0, so preserve its acknowledged configured pair.
+   * A numeric SID query is not a MAC/peer-incarnation statistics witness.
+   */
+  if (!mtlk_hw_is_sid_all_sta_sid(hw, sid) &&
+      wave_hw_fw_feature_supported(hw, WAVE_FW_FEATURE_TXOP_READ)) {
+    mtlk_txmm_msg_t msg;
+    mtlk_txmm_data_t *entry;
+    UMI_SET_TXOP_CONFIG_t *req;
+    int res;
+
+    entry = mtlk_txmm_msg_init_with_empty_data(&msg, mtlk_vap_get_txmm(vap), NULL);
+    if (!entry)
+      return MTLK_ERR_NO_RESOURCES;
+    entry->id = UM_MAN_SET_TXOP_CONFIG_REQ;
+    entry->payload_size = sizeof(*req);
+    req = (UMI_SET_TXOP_CONFIG_t *)entry->payload;
+    memset(req, 0, sizeof(*req));
+    req->staId = HOST_TO_MAC32(sid);
+    req->getSetOperation = API_GET_OPERATION;
+    res = mtlk_txmm_msg_send_blocked(&msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
+    if (res == MTLK_ERR_OK) {
+      if (MAC_TO_HOST32(req->staId) != sid ||
+          req->getSetOperation != API_GET_OPERATION ||
+          req->mode > TXOP_LAST_STATE)
+        res = MTLK_ERR_MAC;
+      else
+        mode = req->mode;
+    }
+    mtlk_txmm_msg_cleanup(&msg);
+    if (res != MTLK_ERR_OK)
+      return res;
+  }
 
   txop_mode->sid = sid;
   txop_mode->mode = mode;
--- a/wireless/driver/shared/hw_mmb.c
+++ b/wireless/driver/shared/hw_mmb.c
@@ -4294,6 +4294,7 @@
 
 static const u8 wave_monitor_fw_span[] = { 0x00, 0x42, 0x0c, 0x12, 0x84, 0x00, 0x8a, 0x20, 0xc9, 0x06, 0x2c, 0x74, 0x85, 0x01, 0x6f, 0xf5, 0x6c, 0x70, 0xe0, 0x78, 0xe0, 0x78, 0xe0, 0x78, 0xe0, 0x78, 0xe0, 0x78 };
 #include "fixed_data_fw.h"
+#include "txop_read_fw.h"
 
 
 static int
@@ -4359,6 +4360,12 @@
           !mtlk_hw_type_is_gen6_b0(hw) &&
           wave_fixed_data_fw_matches(fb.buffer, fb.size))
         hw->fw_features |= WAVE_FW_FEATURE_FIXED_DATA;
+      /* This admits only the complete non-mutating UMI GET and both
+       * lower saved-policy readers, never a version-string assertion. */
+      if (cpu == CHI_CPU_NUM_UM && mtlk_hw_type_is_gen6(hw) &&
+          !mtlk_hw_type_is_gen6_b0(hw) &&
+          wave_txop_read_fw_matches(fb.buffer, fb.size))
+        hw->fw_features |= WAVE_FW_FEATURE_TXOP_READ;
     }
 
     /* WAVE600: TODO: do it for the first radio now, but rework later! */
--- a/wireless/driver/shared/hw_mmb.h
+++ b/wireless/driver/shared/hw_mmb.h
@@ -417,6 +417,7 @@
 struct wave_monitor;
 #define WAVE_FW_FEATURE_RX_STREAM BIT(0)
 #define WAVE_FW_FEATURE_FIXED_DATA BIT(1)
+#define WAVE_FW_FEATURE_TXOP_READ BIT(2)
 bool wave_hw_fw_feature_supported(mtlk_hw_t *hw, u32 feature);
 bool wave_hw_monitor_supported(mtlk_hw_t *hw);
 bool wave_hw_monitor_held(mtlk_hw_t *hw);
