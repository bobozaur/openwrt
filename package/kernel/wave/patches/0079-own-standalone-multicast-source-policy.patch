+/* At most two physical tags, including skb metadata. VID0 supplies priority,
+ * not another membership domain. PCP/DEI never participate in identity.
+ */
+static void wave_mc_tag_add(u32 *domain, __be16 proto, u16 tci)
+{
+  unsigned int depth = *domain & 3;
+  u16 vid = tci & VLAN_VID_MASK;
+
+  if (!vid)
+    return;
+  *domain |= (u32)vid << (2 + depth * 12);
+  if (proto == htons(ETH_P_8021AD))
+    *domain |= BIT(26 + depth);
+  *domain = (*domain & ~3U) | (depth + 1);
+}
+
+static bool wave_mc_ipv4_alert(const u8 *options, unsigned int length)
+{
+  bool alert = false;
+
+  while (length) {
+    unsigned int len;
+
+    if (*options == IPOPT_END)
+      break;
+    if (*options == IPOPT_NOOP) {
+      options++;
+      length--;
+      continue;
+    }
+    if (length < 2 || options[1] < 2 || options[1] > length)
+      return false;
+    len = options[1];
+    if (*options == IPOPT_RA && len == 4 && !get_unaligned_be16(options + 2))
+      alert = true;
+    options += len;
+    length -= len;
+  }
+  return alert;
+}
+
+static bool wave_mc_ipv6_alert(const u8 *options, unsigned int length)
+{
+  bool alert = false;
+
+  while (length) {
+    unsigned int len;
+
+    if (*options == IPV6_TLV_PAD1) {
+      options++;
+      length--;
+      continue;
+    }
+    if (length < 2 || options[1] > length - 2)
+      return false;
+    len = options[1] + 2;
+    if (*options == IPV6_TLV_ROUTERALERT && len == 4 &&
+        !get_unaligned_be16(options + 2))
+      alert = true;
+    options += len;
+    length -= len;
+  }
+  return alert;
+}
