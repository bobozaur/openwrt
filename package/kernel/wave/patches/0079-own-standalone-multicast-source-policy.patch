+static bool wave_mc_group_valid(__be16 proto, const void *address, bool zero)
+{
+  if (proto == htons(ETH_P_IP)) {
+    __be32 ip = get_unaligned((const __be32 *)address);
+
+    return (zero && !ip) || ipv4_is_multicast(ip);
+  }
+  {
+    struct in6_addr ip;
+
+    memcpy(&ip, address, sizeof(ip));
+    return (zero && ipv6_addr_any(&ip)) || ipv6_addr_is_multicast(&ip);
+  }
+}
+
+static bool wave_mc_sources_valid(__be16 proto, const u8 *sources, unsigned int count)
+{
+  unsigned int size = proto == htons(ETH_P_IP) ? 4 : 16;
+
+  for (; count; count--, sources += size) {
+    if (proto == htons(ETH_P_IP)) {
+      __be32 ip = get_unaligned((const __be32 *)sources);
+
+      if (!ip || ip == htonl(INADDR_BROADCAST) || ipv4_is_multicast(ip))
+        return false;
+    } else {
+      struct in6_addr ip;
+
+      memcpy(&ip, sources, sizeof(ip));
+      if (ipv6_addr_any(&ip) || ipv6_addr_is_multicast(&ip))
+        return false;
+    }
+  }
+  return true;
+}
