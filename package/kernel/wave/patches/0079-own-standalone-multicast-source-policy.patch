+static bool wave_mc_ip_equal(__be16 proto, const union wave_mc_ip *a,
+                             const union wave_mc_ip *b)
+{
+  return proto == htons(ETH_P_IP) ? a->ip4 == b->ip4 :
+         ipv6_addr_equal(&a->ip6, &b->ip6);
+}
+
+static bool wave_mc_key_equal(const struct wave_mc_key *a,
+                              const struct wave_mc_key *b)
+{
