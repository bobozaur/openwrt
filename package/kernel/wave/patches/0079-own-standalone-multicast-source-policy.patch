+/* SET/GET and native packet admission share publication ordering on APs.
+ * Station VAPs do not initialize the AP multicast lock. Control serialization
+ * owns their PDB update, including cold readback before station activation. */
+void mtlk_mc_publish_reliable_mode(mtlk_core_t *nic, int mode)
+{
+  bool locked = mtlk_vap_is_ap(nic->vap_handle) && READ_ONCE(nic->mcast.initialized);
+
+  if (locked)
+    mtlk_osal_lock_acquire(&nic->mcast.lock);
+  MTLK_CORE_PDB_SET_INT(nic, PARAM_DB_CORE_RELIABLE_MCAST, mode);
+  if (locked)
+    mtlk_osal_lock_release(&nic->mcast.lock);
+}
