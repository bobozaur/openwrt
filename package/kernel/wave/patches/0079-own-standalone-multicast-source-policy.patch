+/* Data classification does not modify packet bytes or VLAN offload metadata.
+ * Control packets are fully checksummed before they can mutate policy or use
+ * the control-query flooding exception.
+ */
+static int wave_mc_packet(struct sk_buff *skb, struct wave_mc_packet *packet)
+{
+  struct ethhdr eth_buf;
+  const struct ethhdr *eth;
+  struct vlan_hdr tag_buf;
+  const struct vlan_hdr *tag;
+  __be16 proto;
+  unsigned int depth = 0, offset = ETH_HLEN;
+
+  memset(packet, 0, sizeof(*packet));
+  eth = skb_header_pointer(skb, 0, sizeof(eth_buf), &eth_buf);
+  if (!eth)
+    return -EINVAL;
+  ether_addr_copy(packet->reporter, eth->h_source);
+  proto = eth->h_proto;
+  if (skb_vlan_tag_present(skb)) {
+    if (skb->vlan_proto != htons(ETH_P_8021Q) && skb->vlan_proto != htons(ETH_P_8021AD))
+      return -EINVAL;
+    depth++;
+    wave_mc_tag_add(&packet->key.vlan, skb->vlan_proto, skb_vlan_tag_get(skb));
+  }
+  while (proto == htons(ETH_P_8021Q) || proto == htons(ETH_P_8021AD)) {
+    if (++depth > 2)
+      return -EINVAL;
+    tag = skb_header_pointer(skb, offset, sizeof(tag_buf), &tag_buf);
+    if (!tag)
+      return -EINVAL;
+    wave_mc_tag_add(&packet->key.vlan, proto, ntohs(tag->h_vlan_TCI));
+    proto = tag->h_vlan_encapsulated_proto;
+    offset += VLAN_HLEN;
+  }
+  packet->key.proto = proto;
+  if (proto == htons(0x893a)) { /* IEEE 1905.1 retains its control-group path. */
+    packet->exempt = true;
+    return 0;
+  }
+  if (proto == htons(ETH_P_IP)) {
+    struct iphdr ip_buf;
+    const struct iphdr *ip = skb_header_pointer(skb, offset, sizeof(ip_buf), &ip_buf);
+    unsigned int hlen, length;
+
+    if (!ip || ip->version != 4 || ip->ihl < 5)
+      return -EINVAL;
+    hlen = ip->ihl * 4;
+    length = ntohs(ip->tot_len);
+    if (length < hlen || length > skb->len - offset)
+      return -EINVAL;
+    if (!ipv4_is_multicast(ip->daddr))
+      return -EAFNOSUPPORT;
+    packet->key.group.ip4 = ip->daddr;
+    packet->source.ip4 = ip->saddr;
+    packet->exempt = ipv4_is_local_multicast(ip->daddr);
+    packet->offset = offset + hlen;
+    packet->length = length - hlen;
+    if (ip->protocol != IPPROTO_IGMP)
+      return 0;
+    if (ip->ttl != 1 || (ntohs(ip->frag_off) & (IP_MF | IP_OFFSET)) ||
+        packet->length < sizeof(struct igmphdr) ||
+        !pskb_may_pull(skb, offset + length))
+      return -EINVAL;
+    ip = (const struct iphdr *)(skb->data + offset);
+    packet->type = skb->data[packet->offset];
+    if (packet->type != IGMP_HOST_MEMBERSHIP_QUERY &&
+        packet->type != IGMP_HOST_MEMBERSHIP_REPORT &&
+        packet->type != IGMPV2_HOST_MEMBERSHIP_REPORT &&
+        packet->type != IGMP_HOST_LEAVE_MESSAGE &&
+        packet->type != IGMPV3_HOST_MEMBERSHIP_REPORT)
+      return 0;
+    if (ip_fast_csum((u8 *)ip, ip->ihl) ||
+        csum_fold(skb_checksum(skb, packet->offset, packet->length, 0)))
+      return -EINVAL;
+    if (packet->type != IGMP_HOST_MEMBERSHIP_REPORT &&
+        !(packet->type == IGMP_HOST_MEMBERSHIP_QUERY && packet->length == 8 &&
+          !skb->data[packet->offset + 1]) &&
+        !wave_mc_ipv4_alert((const u8 *)ip + sizeof(*ip), hlen - sizeof(*ip)))
+      return -EINVAL;
+    packet->control = true;
+    packet->exempt = true;
+    return 0;
+  }
+  if (proto == htons(ETH_P_IPV6)) {
+    struct ipv6hdr ip_buf;
+    const struct ipv6hdr *ip = skb_header_pointer(skb, offset, sizeof(ip_buf), &ip_buf);
+    unsigned int length, hop_length;
+    const u8 *hop;
+
+    if (!ip || ip->version != 6 || !ipv6_addr_is_multicast(&ip->daddr))
+      return -EAFNOSUPPORT;
+    length = ntohs(ip->payload_len);
+    if (length > skb->len - offset - sizeof(*ip))
+      return -EINVAL;
+    packet->key.group.ip6 = ip->daddr;
+    packet->source.ip6 = ip->saddr;
+    packet->exempt = (ip->daddr.s6_addr[1] & 15) == 2;
+    if (ip->nexthdr != IPPROTO_HOPOPTS)
+      return 0;
+    if (length < 8 || !pskb_may_pull(skb, offset + sizeof(*ip) + length))
+      return -EINVAL;
+    ip = (const struct ipv6hdr *)(skb->data + offset);
+    hop = (const u8 *)(ip + 1);
+    hop_length = ((unsigned int)hop[1] + 1) * 8;
+    if (hop_length > length)
+      return -EINVAL;
+    if (hop[0] != IPPROTO_ICMPV6)
+      return 0;
+    packet->offset = offset + sizeof(*ip) + hop_length;
+    packet->length = length - hop_length;
+    if (packet->length < sizeof(struct icmp6hdr))
+      return -EINVAL;
+    packet->type = skb->data[packet->offset];
+    if (packet->type != ICMPV6_MGM_QUERY && packet->type != ICMPV6_MGM_REPORT &&
+        packet->type != ICMPV6_MGM_REDUCTION && packet->type != ICMPV6_MLD2_REPORT)
+      return 0;
+    if (ip->hop_limit != 1 || skb->data[packet->offset + 1] ||
+        !wave_mc_ipv6_alert(hop + 2, hop_length - 2) ||
+        csum_ipv6_magic(&ip->saddr, &ip->daddr, packet->length, IPPROTO_ICMPV6,
+          skb_checksum(skb, packet->offset, packet->length, 0)))
+      return -EINVAL;
+    if (!(ipv6_addr_type(&ip->saddr) & IPV6_ADDR_LINKLOCAL) &&
+        !(packet->type != ICMPV6_MGM_QUERY && ipv6_addr_any(&ip->saddr)))
+      return -EINVAL;
+    packet->control = true;
+    packet->exempt = true;
+    return 0;
+  }
+  return -EAFNOSUPPORT;
+}
