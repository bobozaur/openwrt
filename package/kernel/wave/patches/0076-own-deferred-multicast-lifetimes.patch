+static void
+_wave_mc_free_host_info(mtlk_core_t *nic, mcast_group_info_t *info,
+                         mtlk_mc_addr_t *addr)
+{
+  mcast_sta_t *member;
+
+  mtlk_core_mcast_handle_grid(nic, addr, MTLK_GRID_DEL, info->grp_id);
+  while ((member = info->mcsta) != NULL) {
+    info->mcsta = member->next;
+    mtlk_sta_decref(member->sta);
+    mtlk_osal_mem_free(member);
+  }
+}
