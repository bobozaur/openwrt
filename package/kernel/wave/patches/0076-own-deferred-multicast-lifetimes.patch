+struct wave_mc_barrier_context {
+  mtlk_core_t *core;
+  BOOL all;
+};
+
+static void wave_mc_barrier_command(mtlk_handle_t handle)
+{
+  struct wave_mc_barrier_context *ctx = HANDLE_T_PTR(struct wave_mc_barrier_context, handle);
+  mtlk_vap_manager_t *manager;
+  mtlk_vap_handle_t vap;
+  int i;
+
+  if (!ctx->all) {
+    mtlk_mc_close_owned(ctx->core);
+    return;
+  }
+  manager = mtlk_vap_get_manager(ctx->core->vap_handle);
+  for (i = 0; i < mtlk_vap_manager_get_max_vaps_count(manager); i++)
+    if (mtlk_vap_manager_get_vap_handle(manager, i, &vap) == MTLK_ERR_OK)
+      mtlk_mc_close_owned(mtlk_vap_get_core(vap));
+}
+
+/* External teardown only. Normal master operations and recovery after its
+ * all-serializer barrier use mtlk_mc_close_owned() directly. */
+void mtlk_mc_close_external(mtlk_core_t *core, BOOL all)
+{
+  struct wave_mc_barrier_context ctx = { .core = core, .all = all };
+  mtlk_core_t *master = mtlk_vap_manager_get_master_core(mtlk_vap_get_manager(core->vap_handle));
+  mtlk_command_t command;
+  int res;
+
+  if (!master || (!all && (!mtlk_vap_is_ap(core->vap_handle) || !core->mcast.initialized)))
+    return;
+  res = mtlk_command_init(&command, wave_mc_barrier_command, HANDLE_T(&ctx), MTLK_SLID);
+  if (res == MTLK_ERR_OK) {
+    res = mtlk_core_execute_hw_command(master, &command, 2000);
+    mtlk_command_cleanup(&command);
+  }
+  if (res != MTLK_ERR_OK) {
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+    mtlk_serializer_stop(&master->slow_ctx->serializer);
+    wave_mc_barrier_command(HANDLE_T(&ctx));
+  }
+}
+
+/* The radio master owns firmware membership and station/SID retirement.
+ * RX producers hold mcast.lock while queueing; that lock also fences admission.
+ * Pending commands and applied memberships hold independent station/ID owners. */
+struct wave_mc_command {
+  struct list_head pending;
+  mtlk_command_t command;
+  mtlk_core_t *nic;
+  sta_entry *sta;
+  mtlk_mc_addr_t addr;
+  uint32 sid_order;
+  uint16 sid;
+  uint8 group;
+  mc_action_t action;
+  BOOL pinned;
+  BOOL retry;
+};
+
+static void
+_wave_mc_membership_unlink(sta_entry *sta, uint8 group)
+{
+  sta->info.mc_memberships &= ~BIT(group);
+  if (!sta->info.mc_memberships) {
+    list_del_init(&sta->mc_membership_node);
+    mtlk_sta_decref(sta);
+  }
+}
+
+static void
+_wave_mc_membership_put(mtlk_core_t *nic, sta_entry *sta, uint8 group)
+{
+  wave_hw_mc_put(mtlk_vap_get_hw(nic->vap_handle), group);
+  _wave_mc_membership_unlink(sta, group);
+}
+
+static void
+_wave_mc_command_run(mtlk_handle_t handle)
+{
+  struct wave_mc_command *work = HANDLE_T_PTR(struct wave_mc_command, handle);
+  mtlk_core_t *nic = work->nic;
+  sta_entry *sta = work->sta;
   mcast_group_info_t *group;
-  mcast_sta_t *mcsta;
-
-  switch (action) {
-  case MTLK_MC_STA_JOIN_GROUP:
+  BOOL valid, attempted;
+  int res;
+
+  /* Pool pressure is retryable without spinning or changing owner identity.
+   * Only subsequent attempts wait; higher-priority teardown can cancel the
+   * command between attempts, and each active attempt delays it by at most 20ms. */
+  if (work->retry)
+    mtlk_osal_msleep(20);
+  work->retry = FALSE;
+  mtlk_osal_lock_acquire(&nic->mcast.lock);
+  valid = !work->command.is_cancelled && nic->mcast.accepting &&
+          !sta->info.mc_retiring && sta->info.sid == work->sid &&
+          sta->info.sid_order == work->sid_order;
+  if (valid) {
+    if (work->addr.type == MTLK_IPv4)
+      group = _mtlk_mc_find_ip4_group(nic, &work->addr.grp_ip.ip4_addr,
+                                      &work->addr.src_ip.ip4_addr);
+    else
+      group = _mtlk_mc_find_ip6_group(nic, &work->addr.grp_ip.ip6_addr,
+                                      &work->addr.src_ip.ip6_addr);
+    valid = group && group->grp_id == work->group &&
+            __mtlk_mc_find_mcsta(group->mcsta, sta);
+    if (work->action == MTLK_MC_STA_JOIN_GROUP)
+      valid = valid && wave_hw_mc_get(mtlk_vap_get_hw(nic->vap_handle), work->group, FALSE);
+    else
+      /* A retry may follow a later JOIN. Withdraw only if this exact station
+       * is still absent from the host's desired membership. */
+      valid = !valid;
+  }
+  mtlk_osal_lock_release(&nic->mcast.lock);
+  if (!valid)
+    return;
+
+  if (work->action == MTLK_MC_STA_JOIN_GROUP) {
+    if (sta->info.mc_memberships & BIT(work->group))
+      return;
+    /* Retain even an uncertain JOIN until terminal reset or confirmed REMOVE. */
+    if (!sta->info.mc_memberships) {
+      mtlk_sta_incref(sta);
+      list_add_tail(&sta->mc_membership_node, &nic->mcast.memberships);
+    }
+    sta->info.mc_memberships |= BIT(work->group);
+    work->pinned = FALSE; /* Command pin becomes the applied-membership pin. */
+  } else if (!(sta->info.mc_memberships & BIT(work->group))) {
+    return;
+  }
+
+  res = mtlk_core_mcast_notify_fw(nic->vap_handle, work->action,
+                                  work->sid, work->group, &attempted);
+  if (res != MTLK_ERR_OK && !attempted) {
+    if (work->action == MTLK_MC_STA_JOIN_GROUP) {
+      /* The message was never allocated: transfer the pin back to its exact
+       * pending command, without claiming a firmware membership. */
+      work->pinned = TRUE;
+      _wave_mc_membership_unlink(sta, work->group);
+    }
+    work->retry = TRUE;
+  } else if (res != MTLK_ERR_OK) {
+    wave_hw_mc_quarantine(mtlk_vap_get_hw(nic->vap_handle), work->group);
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(nic->vap_handle));
+  } else if (work->action == MTLK_MC_STA_LEAVE_GROUP) {
+    _wave_mc_membership_put(nic, sta, work->group);
+  }
+}
+
+static void
+_wave_mc_command_done(serializer_result_t result, mtlk_command_t *command,
+                      mtlk_handle_t handle)
+{
+  struct wave_mc_command *work = HANDLE_T_PTR(struct wave_mc_command, handle);
+
+  mtlk_core_t *master;
+  int err;
+
+  /* EXECUTED also covers recovery-marked cancellation; only run() knows
+   * whether a firmware operation succeeded or transferred its group owner. */
+  mtlk_osal_lock_acquire(&work->nic->mcast.lock);
+  if (result == MTLK_CMD_EXECUTED && work->retry && !command->is_cancelled &&
+      work->nic->mcast.accepting && !work->sta->info.mc_retiring &&
+      wave_hw_mmb_ready(mtlk_vap_get_hw(work->nic->vap_handle))) {
+    master = mtlk_vap_manager_get_master_core(mtlk_vap_get_manager(work->nic->vap_handle));
+    /* Requeue only from done: keep the same pending link, pin and STA ref.
+     * The master cannot execute the next attempt until this done returns. */
+    err = mtlk_core_schedule_hw_command(master, command,
+                                        _wave_mc_command_done, HANDLE_T(work));
+    if (err == MTLK_ERR_OK) {
+      mtlk_osal_lock_release(&work->nic->mcast.lock);
+      return;
+    }
+  }
+  list_del(&work->pending);
+  mtlk_osal_lock_release(&work->nic->mcast.lock);
+  if (work->pinned)
+    wave_hw_mc_put(mtlk_vap_get_hw(work->nic->vap_handle), work->group);
+  mtlk_sta_decref(work->sta);
+  mtlk_command_cleanup(command);
+  mtlk_osal_mem_free(work);
+}
+
+/* Caller holds the host membership lock, including across enqueue. This makes
+ * publication of the pending owner atomic with station/VAP admission fencing. */
+static int
+_wave_mc_queue_locked(mtlk_core_t *nic, mc_action_t action, int group,
+                       sta_entry *sta, const mtlk_mc_addr_t *addr)
+{
+  mtlk_core_t *master;
+  struct wave_mc_command *work;
+  int res;
+
+  if (!nic->mcast.accepting || sta->info.mc_retiring ||
+      group < MC_MIN_GROUP || group >= MC_GROUPS)
+    return MTLK_ERR_NOT_READY;
+  work = mtlk_osal_mem_alloc(sizeof(*work), MTLK_MEM_TAG_MCAST);
+  if (!work)
+    return MTLK_ERR_NO_MEM;
+  memset(work, 0, sizeof(*work));
+  work->nic = nic;
+  work->sta = sta;
+  work->addr = *addr;
+  work->sid = sta->info.sid;
+  work->sid_order = sta->info.sid_order;
+  work->group = group;
+  work->action = action;
+  res = mtlk_command_init(&work->command, _wave_mc_command_run,
+                          HANDLE_T(work), MTLK_SLID);
+  if (res != MTLK_ERR_OK)
+    goto free_work;
+  if (!wave_hw_mc_get(mtlk_vap_get_hw(nic->vap_handle), group, TRUE)) {
+    res = MTLK_ERR_NOT_READY;
+    goto free_command;
+  }
+  work->pinned = TRUE;
+  mtlk_sta_incref(sta);
+  list_add_tail(&work->pending, &nic->mcast.pending);
+  master = mtlk_vap_manager_get_master_core(mtlk_vap_get_manager(nic->vap_handle));
+  res = mtlk_core_schedule_hw_command(master, &work->command,
+                                      _wave_mc_command_done, HANDLE_T(work));
+  if (res == MTLK_ERR_OK)
+    return res;
+  /* Enqueue failure has no completion callback. */
+  list_del(&work->pending);
+  mtlk_sta_decref(sta);
+  wave_hw_mc_put(mtlk_vap_get_hw(nic->vap_handle), group);
+free_command:
+  mtlk_command_cleanup(&work->command);
+free_work:
+  mtlk_osal_mem_free(work);
+  return res;
+}
+
