+int mtlk_mc_retire_sta_owned(mtlk_core_t *nic, sta_info *info)
+{
+  sta_entry *sta;
+  int group, res, first_error = MTLK_ERR_OK;
+
+  if (!mtlk_vap_is_ap(nic->vap_handle) || !nic->mcast.initialized)
+    return MTLK_ERR_OK;
+  mtlk_osal_lock_acquire(&nic->mcast.lock);
+  info->mc_retiring = true;
+  mtlk_osal_lock_release(&nic->mcast.lock);
+  _wave_mc_cancel_owned(nic, info);
+  if (!info->mc_memberships)
+    return MTLK_ERR_OK;
+
+  /* Only a live STA owner can acquire membership bits, never a setup copy. */
+  sta = container_of(info, sta_entry, info);
+  mtlk_sta_incref(sta); /* Preserve this walk across the final membership put. */
+  for (group = MC_MIN_GROUP; group < MC_GROUPS; group++) {
+    if (!(info->mc_memberships & BIT(group)))
+      continue;
+    res = mtlk_core_mcast_notify_fw(nic->vap_handle, MTLK_MC_STA_LEAVE_GROUP,
+                                    info->sid, group, NULL);
+    if (res != MTLK_ERR_OK) {
+      wave_hw_mc_quarantine(mtlk_vap_get_hw(nic->vap_handle), group);
+      /* No uncertain station membership may outlive reuse of its SID. */
+      wave_hw_mmb_quiesce(mtlk_vap_get_hw(nic->vap_handle));
+      if (first_error == MTLK_ERR_OK)
+        first_error = res;
+    }
+    _wave_mc_membership_put(nic, sta, group);
+  }
+  mtlk_sta_decref(sta);
+  return first_error;
+}
