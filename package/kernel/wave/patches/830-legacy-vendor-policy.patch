+/* The radio master serializes policy with STA_ADD, key operations and removal.
+ * STADB publication ends only after STOP_TRAFFIC, STA_REMOVE and native SID
+ * release have completed. An uncertain native lifetime quiesces the hardware;
+ * an empty host database alone must not authorize a new policy in that state.
+ */
+static int
+_core_cfg_four_addr_change_ready(mtlk_core_t *core, const IEEE_ADDR *addr)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  sta_entry *sta;
+
+  if (!wave_hw_mmb_ready(hw) || mtlk_core_rcvry_is_running(core) ||
+      wave_rcvry_mac_fatal_pending_get(hw) || core->slow_ctx->sta_connecting)
+    return MTLK_ERR_BUSY;
+  if (!addr)
+    return mtlk_stadb_get_sta_cnt(&core->slow_ctx->stadb) ?
+           MTLK_ERR_BUSY : MTLK_ERR_OK;
+
+  sta = mtlk_stadb_find_sta(&core->slow_ctx->stadb, addr->au8Addr);
+  if (!sta)
+    return MTLK_ERR_OK;
+  mtlk_sta_decref(sta);
+  return MTLK_ERR_BUSY;
+}
 
