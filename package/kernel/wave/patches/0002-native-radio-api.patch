+void wave_df_assoc_record(mtlk_df_user_t *df_user,
+                          const struct wave_assoc_metadata *metadata)
+{
+  unsigned long flags;
+  unsigned int i, slot = 0;
+  int free_slot = -1;
+
+  spin_lock_irqsave(&df_user->assoc_lock, flags);
+  for (i = 0; i < ARRAY_SIZE(df_user->assoc_metadata); i++) {
+    struct wave_assoc_metadata *entry = &df_user->assoc_metadata[i];
+    if (ether_addr_equal(entry->mac, metadata->mac)) {
+      slot = i;
+      goto replace;
+    }
+    if (!is_valid_ether_addr(entry->mac) || time_after_eq(jiffies, entry->expires))
+      free_slot = i;
+    if (time_before(entry->expires, df_user->assoc_metadata[slot].expires))
+      slot = i;
+  }
+  if (free_slot >= 0)
+    slot = free_slot;
+replace:
+  df_user->assoc_metadata[slot] = *metadata;
+  df_user->assoc_metadata[slot].expires = jiffies + 30 * HZ;
+  spin_unlock_irqrestore(&df_user->assoc_lock, flags);
+}
+
+bool wave_df_assoc_get(mtlk_df_user_t *df_user, const u8 *mac,
+                       struct wave_assoc_metadata *metadata)
+{
+  unsigned long flags;
+  unsigned int i;
+  bool found = false;
+
+  spin_lock_irqsave(&df_user->assoc_lock, flags);
+  for (i = 0; i < ARRAY_SIZE(df_user->assoc_metadata); i++) {
+    const struct wave_assoc_metadata *entry = &df_user->assoc_metadata[i];
+    if (ether_addr_equal(entry->mac, mac) && time_before(jiffies, entry->expires)) {
+      *metadata = *entry;
+      found = true;
+      break;
+    }
+  }
+  spin_unlock_irqrestore(&df_user->assoc_lock, flags);
+  return found;
+}
+
+void wave_df_assoc_forget(mtlk_df_user_t *df_user, const u8 *mac)
+{
+  unsigned long flags;
+  unsigned int i;
+
+  spin_lock_irqsave(&df_user->assoc_lock, flags);
+  for (i = 0; i < ARRAY_SIZE(df_user->assoc_metadata); i++) {
+    struct wave_assoc_metadata *entry = &df_user->assoc_metadata[i];
+    if (!mac || ether_addr_equal(entry->mac, mac))
+      memset(entry, 0, sizeof(*entry));
+  }
+  spin_unlock_irqrestore(&df_user->assoc_lock, flags);
+}
+
+static void wave_df_channel_notify_work(struct wiphy *wiphy,
+                                       struct wiphy_work *work)
+{
+  mtlk_df_user_t *df_user = container_of(work, mtlk_df_user_t, channel_notify_work);
+  struct cfg80211_chan_def chandef;
+  unsigned long flags;
+  bool pending;
+
+  lockdep_assert_wiphy(wiphy);
+  spin_lock_irqsave(&df_user->channel_notify_lock, flags);
+  pending = df_user->channel_notify_pending && !df_user->channel_notify_stopping;
+  chandef = df_user->channel_notify_chandef;
+  df_user->channel_notify_pending = false;
+  spin_unlock_irqrestore(&df_user->channel_notify_lock, flags);
+
+  if (pending && df_user->ndev_registered && netif_running(df_user->ndev) &&
+      df_user->ndev->ieee80211_ptr->links[0].ap.beacon_interval)
+    cfg80211_ch_switch_notify(df_user->ndev, &chandef, 0);
+}
+
+void wave_df_queue_channel_notify(mtlk_df_user_t *df_user,
+                                 const struct cfg80211_chan_def *chandef)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&df_user->channel_notify_lock, flags);
+  if (!df_user->channel_notify_stopping) {
+    df_user->channel_notify_chandef = *chandef;
+    df_user->channel_notify_pending = true;
+    /* Queue under the same lock as stop, so cancellation cannot race a
+     * producer that has published data but has not yet queued its work. */
+    wiphy_work_queue(df_user->ndev->ieee80211_ptr->wiphy,
+                     &df_user->channel_notify_work);
+  }
+  spin_unlock_irqrestore(&df_user->channel_notify_lock, flags);
+}
+
+void wave_df_notifications_start_locked(mtlk_df_user_t *df_user)
+{
+  unsigned long flags;
+
+  lockdep_assert_wiphy(df_user->ndev->ieee80211_ptr->wiphy);
+  spin_lock_irqsave(&df_user->channel_notify_lock, flags);
+  df_user->channel_notify_pending = false;
+  df_user->channel_notify_stopping = !df_user->ndev_registered;
+  spin_unlock_irqrestore(&df_user->channel_notify_lock, flags);
+}
+
+void wave_df_notifications_stop_locked(mtlk_df_user_t *df_user)
+{
+  struct wiphy *wiphy = df_user->ndev->ieee80211_ptr->wiphy;
+  unsigned long flags;
+
+  lockdep_assert_wiphy(wiphy);
+  spin_lock_irqsave(&df_user->channel_notify_lock, flags);
+  df_user->channel_notify_stopping = true;
+  df_user->channel_notify_pending = false;
+  spin_unlock_irqrestore(&df_user->channel_notify_lock, flags);
+  wiphy_work_cancel(wiphy, &df_user->channel_notify_work);
 }
 
