+void wave_radio_assoc_req_capture(struct net_device *ndev,
+                                  const u8 *buf, size_t len, s8 rssi)
+{
+  const struct ieee80211_mgmt *mgmt = (const void *)buf;
+  struct wave_assoc_metadata metadata = {0};
+  wv_ie80211_elems elems;
+  size_t offset;
+
+  if (!ndev || !ndev->ieee80211_ptr ||
+      ndev->ieee80211_ptr->iftype != NL80211_IFTYPE_AP || len < 24)
+    return;
+  if (ieee80211_is_assoc_req(mgmt->frame_control))
+    offset = offsetof(struct ieee80211_mgmt, u.assoc_req.variable);
+  else if (ieee80211_is_reassoc_req(mgmt->frame_control))
+    offset = offsetof(struct ieee80211_mgmt, u.reassoc_req.variable);
+  else
+    return;
+  if (len < offset || len > 4096 || !is_valid_ether_addr(mgmt->sa) ||
+      !ether_addr_equal(mgmt->da, ndev->dev_addr) ||
+      !ether_addr_equal(mgmt->bssid, ndev->dev_addr))
+    return;
+  if (mtlk_mgmt_parse_elems(buf + offset, len - offset, &elems) != MTLK_ERR_OK)
+    return;
+
+  ether_addr_copy(metadata.mac, mgmt->sa);
+  metadata.rssi = rssi;
+  if (elems.bss_coex_20_40)
+    metadata.coexistence = *elems.bss_coex_20_40;
+  if (elems.vendor_lantiq || elems.vendor_metalink)
+    metadata.vendor = 1;
+  else if (elems.vendor_w101)
+    metadata.vendor = 2;
+  /* The parser validated the complete IE; its preceding byte is its length.
+   * Check the bytes needed by each vendor extension before dereferencing. */
+  if (elems.vendor_intel && elems.vendor_intel[-1] >= 5 &&
+      elems.vendor_intel[3] == WLAN_EID_INTEL_VENDOR_TYPE_4ADDR_MODE &&
+      elems.vendor_intel[4] == WLAN_EID_INTEL_VENDOR_4ADDR_MODE_STA)
+    metadata.four_addr = true;
+  if (elems.vendor_brcm && elems.vendor_brcm[-1] >= 7 &&
+      elems.vendor_brcm[3] == WLAN_EID_BRCM_VENDOR_VERSION_2 &&
+      (elems.vendor_brcm[6] & WLAN_EID_BRCM_VENDOR_DWDS_CAPABLE))
+    metadata.four_addr = true;
+  if (elems.vendor_wfa && elems.vendor_wfa[-1] >= 4 &&
+      elems.vendor_wfa[3] == WLAN_OUI_TYPE_WFA_MULTI_AP)
+    metadata.four_addr = true;
+  if (elems.opmode_notif) {
+    metadata.opmode = *elems.opmode_notif;
+    metadata.opmode_valid = true;
+  }
+  if (elems.rsne_capab)
+    metadata.pbac = !!(get_unaligned_le16(elems.rsne_capab) & RSNE_CAPAB_PBAC);
+  wave_df_assoc_record(mtlk_df_user_from_ndev(ndev), &metadata);
+}
