 #endif
 
+/* Matched experimental raw-EAPOL classifier metadata in HOST_DSC DW1.
+ * The vendor path consumes only class/EP here; these bits require the paired
+ * firmware classifier and do not alter the supplied 802.11 header. */
+#define WAVE_BSS_RAW_EAPOL       BIT(31)
+#define WAVE_BSS_ENCRYPT_INTENT  BIT(30)
+
 static int
 _mtlk_mmb_bss_mgmt_tx(mtlk_hw_t *hw,
                       struct mtlk_hw_bss_req_mirror *bss_req, mtlk_vap_handle_t vap_handle)
@@ -11432,6 +11438,7 @@
   mtlk_dump(3, bss_req->virt_addr, bss_req->size, "BSS Mgmt TX frame:");
 
   switch (bss_req->extra_processing) {
+    case PROCESS_RAW_EAPOL:
     case PROCESS_MANAGEMENT:
         /* 1. dst address mc bit */
         dst_addr = WLAN_GET_ADDR1(bss_req->virt_addr);
@@ -11441,10 +11448,12 @@
         sid = bss_req->sid;
 
         /* 3. type, subtype, priority, frame type */
+        /* The native raw-frame consumer uses the management descriptor type;
+         * the supplied control-port DATA header and subtype remain unchanged. */
         type = IEEE80211_FTYPE_MGMT >> 2;
         frame_ctl = mtlk_wlan_pkt_get_frame_ctl(bss_req->virt_addr);
-        /* Check tods and from ds for managment packets must be 0 */
-        if (frame_ctl & TMP_FRAME_FROMDSTODS_MASK) {
+        if (bss_req->extra_processing == PROCESS_MANAGEMENT &&
+            (frame_ctl & TMP_FRAME_FROMDSTODS_MASK)) {
             ELOG_D("CID-%02x: ToDS and FromDS not null in managment packet", hw->card_idx);
             MTLK_ASSERT(NULL);
             return MTLK_ERR_PKT_DROPPED;
@@ -11493,6 +11502,7 @@
           wave_vap_increment_ndp_counter(vap_handle);
         }
         break;
+    case PROCESS_LEGACY_EAPOL:
     case PROCESS_EAPOL:
         /* 1. dst address mc bit */
         dst_addr = ((struct ethhdr *) bss_req->virt_addr)->h_dest;
@@ -11554,6 +11564,16 @@
 
   bss_hd.u32frameInfo1 = CPU_TO_LE32(MTLK_BFIELD_VALUE(TX_DATA_INFO_CLASS, ntid, uint32)
                           | MTLK_BFIELD_VALUE(TX_DATA_INFO_EP, wave_vap_ep_bit_get(vap_handle), uint32));
+  if (bss_req->extra_processing == PROCESS_RAW_EAPOL) {
+    const struct ieee80211_tx_info *info = IEEE80211_SKB_CB(bss_req->skb);
+    uint32 intent = WAVE_BSS_RAW_EAPOL;
+
+    /* mac80211 already applied no_encrypt and selected the hardware key.
+     * Compare the retained pointer only; firmware owns key lookup and PN. */
+    if (info->control.hw_key)
+      intent |= WAVE_BSS_ENCRYPT_INTENT;
+    bss_hd.u32frameInfo1 |= CPU_TO_LE32(intent);
+  }
 
   bss_hd.u32frameInfo3      = CPU_TO_LE32(MTLK_BFIELD_VALUE(TX_DATA_INFO_SOP_EOP, NO_FRAG, uint32) |
                               MTLK_BFIELD_VALUE(TX_DATA_INFO_OFFSET,
@@ -11821,7 +11841,15 @@
   }
 
 
-  if (extra_processing == PROCESS_EAPOL && sid == DB_UNKNOWN_SID)
+  if (extra_processing == PROCESS_RAW_EAPOL) {
+    uint16 frame_ctrl = mtlk_wlan_pkt_get_frame_ctl(buf);
+
+    subtype = (frame_ctrl & FRAME_SUBTYPE_MASK) >> FRAME_SUBTYPE_SHIFT;
+  }
+
+  if ((extra_processing == PROCESS_EAPOL ||
+       extra_processing == PROCESS_RAW_EAPOL ||
+       extra_processing == PROCESS_LEGACY_EAPOL) && sid == DB_UNKNOWN_SID)
     return MTLK_ERR_NOT_HANDLED;
 
   mtlk_osal_lock_acquire(&bss_mgmt->tx_bdr.lock);
@@ -11874,7 +11902,47 @@
   bss_req->vap_id = mtlk_vap_get_id(vap_handle);
   bss_req->radio_id = radio_id;
   bss_req->cookie = local_cookie;
-  wave_memcpy(bss_req->virt_addr, BSS_MGMT_FRAME_SIZE, buf, len);
+  if (extra_processing == PROCESS_LEGACY_EAPOL) {
+    struct sk_buff *view = skb_clone(skb, GFP_ATOMIC);
+    struct ethhdr eth;
+
+    if (!view) {
+      res = MTLK_ERR_NO_MEM;
+      goto release_entry;
+    }
+    /* The helper's iftype is the receiver of this canonical ToDS frame.
+     * An external Ethernet header leaves the original skb bytes untouched.
+     * WAVE rejects fragmentation and requests no software MIC/IV generation;
+     * uploaded WEP/TKIP frames still contain the original EAPOL payload. */
+    res = ieee80211_data_to_8023_exthdr(view, &eth, skb->dev->dev_addr,
+                                       NL80211_IFTYPE_AP, 0, false);
+    if (!res) {
+      wave_memcpy(bss_req->virt_addr, BSS_MGMT_FRAME_SIZE, &eth, ETH_HLEN);
+      res = skb_copy_bits(view, 0, (uint8 *)bss_req->virt_addr + ETH_HLEN, view->len);
+      len = ETH_HLEN + view->len;
+    }
+    kfree_skb(view);
+    if (res) {
+      res = MTLK_ERR_PARAMS;
+      goto release_entry;
+    }
+  } else if (extra_processing == PROCESS_RAW_EAPOL &&
+             ieee80211_is_data_qos(((const struct ieee80211_hdr *)buf)->frame_control)) {
+    const unsigned int hdrlen = sizeof(struct ieee80211_hdr_3addr);
+    struct ieee80211_hdr *raw = (struct ieee80211_hdr *)bss_req->virt_addr;
+
+    /* Native raw CCMP inserts its IV after a 24-byte header. Normalize only
+     * this wire copy; the original skb and its control-port status stay intact. */
+    wave_memcpy(raw, BSS_MGMT_FRAME_SIZE, buf, hdrlen);
+    wave_memcpy((uint8 *)raw + hdrlen, BSS_MGMT_FRAME_SIZE - hdrlen,
+                buf + hdrlen + IEEE80211_QOS_CTL_LEN,
+                len - hdrlen - IEEE80211_QOS_CTL_LEN);
+    raw->frame_control &= ~cpu_to_le16(IEEE80211_STYPE_QOS_DATA);
+    len -= IEEE80211_QOS_CTL_LEN;
+    subtype = IEEE80211_STYPE_DATA >> 4;
+  } else {
+    wave_memcpy(bss_req->virt_addr, BSS_MGMT_FRAME_SIZE, buf, len);
+  }
   bss_req->size = len;
   bss_req->extra_processing = extra_processing;
   bss_req->action_code      = action_code;
@@ -11913,6 +11981,20 @@
 
   *cookie = local_cookie;
   return MTLK_ERR_OK;
+
+release_entry:
+  /* No skb ownership or DMA mapping was transferred on conversion failure. */
+  mtlk_osal_lock_acquire(&bss_mgmt->tx_bdr.lock);
+  if (transmit_now) {
+    mtlk_dlist_remove(&bss_mgmt->tx_bdr.used_list, entry);
+    mtlk_dlist_push_back(&bss_mgmt->tx_bdr.free_list, entry);
+  } else {
+    mtlk_dlist_push_back(&bss_mgmt->tx_res_bdr.free_list, entry);
+  }
+  mtlk_osal_lock_release(&bss_mgmt->tx_bdr.lock);
+  if (!transmit_now)
+    mtlk_core_on_bss_res_freed(cur_core);
+  return res;
 
 frame_drop:
   ILOG0_V("Frame dropped");
