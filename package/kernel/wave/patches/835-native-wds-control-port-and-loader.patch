Subject: [PATCH] wave: preserve station control-port framing and native WDS headers

Use the canonical station control-port skb through the native BSS owner,
with the matched raw-frame classifier and CCMP key context. Apply the
fixed-cohort AP instruction overlay before firmware CPU release.

--- a/wireless/driver/linux/mac80211.c
+++ b/wireless/driver/linux/mac80211.c
@@ -497,9 +497,18 @@
     goto drop;
   }
   in_chan = ieee80211_frequency_to_channel(channel->center_freq);
-  extra_processing = (ieee80211_is_nullfunc(hdr->frame_control) ||
-                      ieee80211_is_qos_nullfunc(hdr->frame_control)) ?
-                     PROCESS_NULL_DATA_PACKET : PROCESS_MANAGEMENT;
+  if (vif->type == NL80211_IFTYPE_STATION &&
+      ieee80211_is_data(hdr->frame_control) &&
+      (info->control.flags & IEEE80211_TX_CTRL_PORT_CTRL_PROTO)) {
+    /* Keep legacy hardware ciphers on their existing Ethernet transport.
+     * Select while the stack's uploaded-key reference is still valid. */
+    extra_processing = info->control.hw_key &&
+                       info->control.hw_key->cipher != WLAN_CIPHER_SUITE_CCMP ?
+                       PROCESS_LEGACY_EAPOL : PROCESS_RAW_EAPOL;
+  } else
+    extra_processing = (ieee80211_is_nullfunc(hdr->frame_control) ||
+                        ieee80211_is_qos_nullfunc(hdr->frame_control)) ?
+                       PROCESS_NULL_DATA_PACKET : PROCESS_MANAGEMENT;
 
   /* The core dispatch for this request was synchronous. Submit directly so
    * a failed clipboard/result allocation cannot obscure skb ownership. */
@@ -2436,13 +2445,11 @@
   hw->wiphy->features |= NL80211_FEATURE_SK_TX_STATUS |
                           NL80211_FEATURE_SCAN_FLUSH;
 
-  /* This hybrid driver delivers Ethernet EAPOL through AF_PACKET. mac80211
-   * alloc_hw advertises its own control-port path by default, but that path
-   * bypasses our Ethernet ndo and lacks retained-firmware TX status support.
-   * Let unmodified supplicant select the implemented standard transport. */
+  /* Station control-port TX uses mac80211's canonical three-address header.
+   * Keep AF_PACKET RX and the existing AP transport policy; neither RX nor
+   * control-port TX-status capabilities are selected by this path. */
   {
     static const unsigned int unsupported[] = {
-      NL80211_EXT_FEATURE_CONTROL_PORT_OVER_NL80211,
       NL80211_EXT_FEATURE_CONTROL_PORT_NO_PREAUTH,
       NL80211_EXT_FEATURE_CONTROL_PORT_OVER_NL80211_TX_STATUS,
     };
