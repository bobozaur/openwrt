   mtlk_osal_unmap_phys_addr(mtlk_ccr_get_dev_ctx(hw->ccr), bss_req->dma_addr, bss_req->size, MTLK_DATA_TO_DEVICE);
   bss_req->dma_addr = 0;
 
-  if (PROCESS_MANAGEMENT == bss_req->extra_processing)
