+/* This WDS branch pairs the raw-control-port host contract with one AP
+ * image. Admission happens before upload; both cold start and recovery keep
+ * the CPUs reset until the entire firmware load succeeds.
+ */
+static int
+_mtlk_mmb_load_wds_ap(mtlk_cpu_mem_t *mem, mtlk_df_fw_file_buf_t *buf)
+{
+  uint8 digest[SHA256_DIGEST_SIZE];
+  mtlk_cpu_mem_t patch_mem[2] = { { 0 } };
+  mtlk_df_fw_file_buf_t patch_fb = { 0 };
+  unsigned int i;
+  int res;
+
+  if (buf->size != WAVE_WDS_AP_SIZE ||
+      mem[0].length != (int)WAVE_WDS_AP_SIZE || mem[0].swap) {
+    ELOG_V("WDS AP firmware size or IRAM mapping does not match");
+    return MTLK_ERR_FW;
+  }
+  sha256(buf->buffer, buf->size, digest);
+  if (memcmp(digest, wave_wds_ap_original_sha256, sizeof(digest))) {
+    ELOG_V("WDS AP firmware SHA256 does not match the original NETGEAR image");
+    return MTLK_ERR_FW;
+  }
+
+  res = _mtlk_mmb_load_fw2mem(mem, buf);
+  if (res != MTLK_ERR_OK)
+    return res;
+
+  /* The kernel firmware object stays const. Only the existing device IRAM
+   * destination is changed, using the same DWORD writer and error path.
+   * patch_fb borrows static bytes; it owns no request_firmware reference.
+   */
+  for (i = 0; i < ARRAY_SIZE(wave_wds_ap_spans); i++) {
+    const struct wave_wds_ap_span *span = &wave_wds_ap_spans[i];
+
+    patch_mem[0].start = (uint8 *)mem[0].start + span->offset;
+    patch_mem[0].length = span->size;
+    patch_fb.buffer = wave_wds_ap_code + span->data_offset;
+    patch_fb.size = span->size;
+    res = _mtlk_mmb_load_fw2mem(patch_mem, &patch_fb);
+    if (res != MTLK_ERR_OK)
+      return res;
+  }
+
+  ILOG0_V("Applied NETGEAR WDS AP correction 31bdd3e6");
+  return MTLK_ERR_OK;
+}
