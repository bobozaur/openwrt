+
+/* AP_VLAN owns a Linux port, never a firmware VAP. The first member keeps
+ * existing cfg80211 station/key operations attached to the parent BSS.
+ * ap_vlan_lock protects both sides of the binding and the station retirement
+ * flag. RX additionally uses RCU through the network-stack handoff.
+ */
+struct wave_ap_vlan {
+  mtlk_df_user_t *parent;
+  struct net_device *parent_ndev;
+  struct wireless_dev wdev;
+  struct list_head node;
+  struct wave_tx_queue tx_queue;
+  sta_entry *sta;
+};
+
+static int wave_ap_vlan_open(struct net_device *ndev)
+{
+  struct wave_ap_vlan *vlan = netdev_priv(ndev);
+  mtlk_vap_handle_t vap = mtlk_df_get_vap_handle(vlan->parent->df);
+
+  if (!netif_running(vlan->parent->ndev))
+    return -ENETDOWN;
+  wave_hw_tx_queue_start(mtlk_vap_get_hw(vap), &vlan->tx_queue);
+  return 0;
+}
+
+static int wave_ap_vlan_stop(struct net_device *ndev)
+{
+  struct wave_ap_vlan *vlan = netdev_priv(ndev);
+  mtlk_vap_handle_t vap = mtlk_df_get_vap_handle(vlan->parent->df);
+
+  wave_hw_tx_queue_stop(mtlk_vap_get_hw(vap), &vlan->tx_queue);
+  return 0;
+}
+
+static int wave_ap_vlan_iflink(const struct net_device *ndev)
+{
+  const struct wave_ap_vlan *vlan = netdev_priv(ndev);
+
+  return vlan->parent_ndev->ifindex;
+}
+
+static const struct net_device_ops wave_ap_vlan_ops = {
+  .ndo_open = wave_ap_vlan_open,
+  .ndo_stop = wave_ap_vlan_stop,
+  .ndo_start_xmit = _mtlk_df_user_linux_start_tx,
+  .ndo_get_iflink = wave_ap_vlan_iflink,
+};
+
+static void wave_ap_vlan_destructor(struct net_device *ndev)
+{
+  struct wave_ap_vlan *vlan = netdev_priv(ndev);
+
+  dev_put(vlan->parent_ndev);
+}
+
+/* Preserve the existing administrator hairpin decision. Without hairpin,
+ * driver intra-BSS forwarding still serves a non-isolated AP with m2u off.
+ */
+bool wave_df_intra_bss_forwarding(mtlk_df_user_t *df_user)
+{
+  bool forwarding = true;
+
+#if !MTLK_USE_DIRECTCONNECT_DP_API && !MTLK_USE_PUMA6_UDMA
+  rcu_read_lock();
+  forwarding = !br_port_flag_is_set(df_user->ndev, BR_HAIRPIN_MODE);
+  rcu_read_unlock();
+#endif
+  return forwarding;
+}
+
+/* A bridged parent has already passed VLAN and source policy. Remaining
+ * group frames use BSS flooding rather than the native VLAN-blind cache.
+ * Native RX shortcuts still use their own membership owner; their FORWARD
+ * flag is checked by the caller before selecting this OS/bridge policy.
+ */
+bool wave_df_bridge_mcast_owned(mtlk_df_user_t *df_user)
+{
+#if !MTLK_USE_DIRECTCONNECT_DP_API && !MTLK_USE_PUMA6_UDMA
+  return netif_is_bridge_port(df_user->ndev);
+#else
+  return false;
+#endif
+}
+
+struct wireless_dev *wave_df_ap_vlan_add(struct wiphy *wiphy, const char *name,
+                                         struct vif_params *params)
+{
+  struct wireless_dev *parent = NULL, *iter;
+  struct wave_ap_vlan *vlan;
+  struct net_device *ndev;
+  mtlk_df_user_t *df_user;
+  int err;
+
+  ASSERT_RTNL();
+  lockdep_assert_wiphy(wiphy);
+#if MTLK_USE_DIRECTCONNECT_DP_API || MTLK_USE_PUMA6_UDMA
+  return ERR_PTR(-EOPNOTSUPP);
+#endif
+  /* Four-address children have exactly one receiver. Ordinary dynamic-VLAN
+   * AP ports need a separate multi-station contract, not this peer binding.
+   */
+  if (params->use_4addr != 1 || !is_valid_ether_addr(params->macaddr))
+    return ERR_PTR(-EOPNOTSUPP);
+  list_for_each_entry(iter, &wiphy->wdev_list, list) {
+    if (iter->iftype == NL80211_IFTYPE_AP && iter->netdev &&
+        netif_running(iter->netdev) &&
+        ether_addr_equal(iter->netdev->dev_addr, params->macaddr)) {
+      mtlk_core_t *core;
+
+      df_user = mtlk_df_user_from_ndev(iter->netdev);
+      core = mtlk_vap_get_core(mtlk_df_get_vap_handle(df_user->df));
+      if (!READ_ONCE(core->slow_ctx->ap_started))
+        continue;
+      if (parent)
+        return ERR_PTR(-EINVAL);
+      parent = iter;
+    }
+  }
+  if (!parent)
+    return ERR_PTR(-ENODEV);
+  df_user = mtlk_df_user_from_ndev(parent->netdev);
+  ndev = alloc_netdev(sizeof(*vlan), name, NET_NAME_USER, ether_setup);
+  if (!ndev)
+    return ERR_PTR(-ENOMEM);
+  vlan = netdev_priv(ndev);
+  vlan->parent = df_user;
+  vlan->parent_ndev = parent->netdev;
+  vlan->wdev.wiphy = wiphy;
+  vlan->wdev.iftype = NL80211_IFTYPE_AP_VLAN;
+  vlan->wdev.use_4addr = true;
+  vlan->wdev.netdev = ndev;
+  INIT_LIST_HEAD(&vlan->node);
+  INIT_LIST_HEAD(&vlan->tx_queue.node);
+  vlan->tx_queue.ndev = ndev;
+  dev_net_set(ndev, dev_net(parent->netdev));
+  ndev->ieee80211_ptr = &vlan->wdev;
+  ndev->netdev_ops = &wave_ap_vlan_ops;
+  ndev->mtu = parent->netdev->mtu;
+  ndev->min_mtu = parent->netdev->min_mtu;
+  ndev->max_mtu = parent->netdev->max_mtu;
+  ndev->needed_headroom = parent->netdev->needed_headroom;
+  ndev->needed_tailroom = parent->netdev->needed_tailroom;
+  eth_hw_addr_set(ndev, parent->netdev->dev_addr);
+  SET_NETDEV_DEV(ndev, wiphy_dev(wiphy));
+  netif_carrier_off(ndev);
+  err = cfg80211_register_netdevice(ndev);
+  if (err) {
+    free_netdev(ndev);
+    return ERR_PTR(err);
+  }
+  dev_hold(parent->netdev);
+  ndev->needs_free_netdev = true;
+  ndev->priv_destructor = wave_ap_vlan_destructor;
+  list_add_tail(&vlan->node, &df_user->ap_vlans);
+  return &vlan->wdev;
+}
+
+/* Called at the station database's removal boundary, before its final refs.
+ * A station found concurrently by cfg80211 cannot be rebound after this point.
+ */
+void wave_df_ap_vlan_sta_drop(sta_entry *sta)
+{
+  mtlk_df_user_t *parent = mtlk_df_get_user(mtlk_vap_get_df(sta->vap_handle));
+  struct net_device *ndev;
+  struct wave_ap_vlan *vlan;
+  bool put = false;
+
+  spin_lock_bh(&parent->ap_vlan_lock);
+  sta->ap_vlan_retiring = true;
+  ndev = rcu_dereference_protected(sta->ap_vlan,
+                                  lockdep_is_held(&parent->ap_vlan_lock));
+  if (ndev) {
+    vlan = netdev_priv(ndev);
+    RCU_INIT_POINTER(sta->ap_vlan, NULL);
+    vlan->sta = NULL;
+    netif_carrier_off(ndev);
+    put = true;
+  }
+  spin_unlock_bh(&parent->ap_vlan_lock);
+  if (put)
+    mtlk_sta_decref(sta);
+}
+
+struct wave_ap_vlan_binding {
+  mtlk_df_user_t *parent;
+  struct wave_ap_vlan *vlan;
+  sta_entry *sta;
+  uint16 sid;
+  uint32 sid_order;
+  int result;
+};
+
+/* The existing radio master owns both SID lifetime and native memberships.
+ * Withdraw the latter through its reviewed command owner before changing the
+ * Linux port. In-flight descriptors retain their original parent ownership.
+ */
+static void wave_ap_vlan_bind_owned(mtlk_handle_t handle)
+{
+  struct wave_ap_vlan_binding *binding = HANDLE_T_PTR(struct wave_ap_vlan_binding, handle);
+  mtlk_df_user_t *parent = binding->parent;
+  struct wave_ap_vlan *vlan = binding->vlan, *old_vlan;
+  sta_entry *sta = binding->sta;
+  mtlk_core_t *core = mtlk_vap_get_core(sta->vap_handle);
+  struct net_device *old_ndev;
+  bool old_ref = false, reopen = false;
+  sta_entry *current;
+  int res;
+
+  current = mtlk_stadb_find_sid(&core->slow_ctx->stadb, binding->sid);
+  if (current != sta || sta->info.sid_order != binding->sid_order) {
+    if (current)
+      mtlk_sta_decref(current);
+    binding->result = -ENOENT;
+    return;
+  }
+  mtlk_sta_decref(current);
+  spin_lock_bh(&parent->ap_vlan_lock);
+  if (sta->ap_vlan_retiring || (vlan && vlan->sta && vlan->sta != sta)) {
+    binding->result = sta->ap_vlan_retiring ? -ENOENT : -EBUSY;
+    spin_unlock_bh(&parent->ap_vlan_lock);
+    return;
+  }
+  old_ndev = rcu_dereference_protected(sta->ap_vlan,
+                                      lockdep_is_held(&parent->ap_vlan_lock));
+  if ((vlan && old_ndev == vlan->wdev.netdev) ||
+      (!vlan && !old_ndev && !READ_ONCE(sta->info.mc_retiring))) {
+    spin_unlock_bh(&parent->ap_vlan_lock);
+    binding->result = 0;
+    return;
+  }
+  spin_unlock_bh(&parent->ap_vlan_lock);
+
+  if (vlan) {
+    if (mtlk_core_get_net_state(core) != NET_STATE_CONNECTED ||
+        mtlk_sta_get_packets_filter(sta) == MTLK_PCKT_FLTR_DISCARD_ALL ||
+        !wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle)) ||
+        !READ_ONCE(core->mcast.accepting)) {
+      binding->result = -ENETDOWN;
+      return;
+    }
+    res = mtlk_mc_retire_sta_owned(core, &sta->info);
+    if (res != MTLK_ERR_OK) {
+      /* Uncertain firmware membership stays closed/quarantined. Do not
+       * publish a child or reopen the native owner after this failure.
+       */
+      binding->result = _mtlk_df_mtlk_to_linux_error_code(res);
+      return;
+    }
+    mtlk_mc_drop_sta(core, mtlk_sta_get_addr(sta)->au8Addr);
+  } else {
+    /* A still-live parent may learn reports again. Teardown keeps admission
+     * closed, even though child removal must withdraw its Linux binding.
+     */
+    mtlk_osal_lock_acquire(&core->mcast.lock);
+    if (core->mcast.accepting &&
+        mtlk_core_get_net_state(core) == NET_STATE_CONNECTED &&
+        mtlk_sta_get_packets_filter(sta) != MTLK_PCKT_FLTR_DISCARD_ALL &&
+        wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle))) {
+      sta->info.mc_retiring = false;
+      reopen = true;
+    }
+    mtlk_osal_lock_release(&core->mcast.lock);
+    if (!old_ndev && !reopen) {
+      binding->result = -ENETDOWN;
+      return;
+    }
+  }
+
+  spin_lock_bh(&parent->ap_vlan_lock);
+  if (old_ndev) {
+    old_vlan = netdev_priv(old_ndev);
+    old_vlan->sta = NULL;
+    netif_carrier_off(old_ndev);
+    old_ref = true;
+  }
+  if (vlan) {
+    mtlk_sta_incref(sta);
+    vlan->sta = sta;
+    rcu_assign_pointer(sta->ap_vlan, vlan->wdev.netdev);
+    netif_carrier_on(vlan->wdev.netdev);
+  } else {
+    RCU_INIT_POINTER(sta->ap_vlan, NULL);
+  }
+  spin_unlock_bh(&parent->ap_vlan_lock);
+  if (old_ref)
+    mtlk_sta_decref(sta);
+  if (reopen)
+    mtlk_mc_add_sta(core, sta);
+  binding->result = 0;
+}
+
+static int wave_ap_vlan_submit_binding(mtlk_df_user_t *parent,
+                                       struct wave_ap_vlan *vlan, sta_entry *sta)
+{
+  mtlk_core_t *master = mtlk_vap_manager_get_master_core(mtlk_vap_get_manager(sta->vap_handle));
+  struct wave_ap_vlan_binding binding = {
+    .parent = parent, .vlan = vlan, .sta = sta,
+    .sid = sta->info.sid, .sid_order = sta->info.sid_order, .result = -EIO,
+  };
+  mtlk_command_t command;
+  int res;
+
+  /* SET_STATION holds the wiphy lock, not RTNL. Queued Linux-port traffic
+   * chooses its referenced peer at dequeue and native submission rechecks
+   * that binding. The blocked command joins completion even on timeout.
+   */
+  res = mtlk_command_init(&command, wave_ap_vlan_bind_owned, HANDLE_T(&binding), MTLK_SLID);
+  if (res == MTLK_ERR_OK) {
+    res = mtlk_core_execute_hw_command(master, &command, 2000);
+    mtlk_command_cleanup(&command);
+  }
+  synchronize_net();
+  return res == MTLK_ERR_OK ? binding.result : _mtlk_df_mtlk_to_linux_error_code(res);
+}
+
+int wave_df_ap_vlan_bind(struct net_device *parent_ndev, const u8 *mac,
+                        struct net_device *ndev)
+{
+  mtlk_df_user_t *parent = mtlk_df_user_from_ndev(parent_ndev);
+  mtlk_core_t *core = mtlk_vap_get_core(mtlk_df_get_vap_handle(parent->df));
+  struct wave_ap_vlan *vlan = NULL;
+  sta_entry *sta;
+  int res;
+
+  lockdep_assert_wiphy(parent_ndev->ieee80211_ptr->wiphy);
+  if (parent_ndev->ieee80211_ptr->iftype != NL80211_IFTYPE_AP)
+    return -EINVAL;
+  if (ndev != parent_ndev) {
+    if (ndev->netdev_ops != &wave_ap_vlan_ops)
+      return -EINVAL;
+    vlan = netdev_priv(ndev);
+    if (vlan->parent != parent)
+      return -EINVAL;
+  }
+  sta = mtlk_stadb_find_sta(&core->slow_ctx->stadb, mac);
+  if (!sta)
+    return -ENOENT;
+  if (vlan && !mtlk_sta_is_4addr(sta)) {
+    mtlk_sta_decref(sta);
+    return -EOPNOTSUPP;
+  }
+
+  res = wave_ap_vlan_submit_binding(parent, vlan, sta);
+  mtlk_sta_decref(sta);
+  return res;
+}
+
+sta_entry *wave_df_ap_vlan_tx_sta(struct net_device *ndev)
+{
+  struct wave_ap_vlan *vlan = netdev_priv(ndev);
+  sta_entry *sta;
+
+  spin_lock_bh(&vlan->parent->ap_vlan_lock);
+  sta = vlan->sta;
+  if (sta)
+    mtlk_sta_incref(sta);
+  spin_unlock_bh(&vlan->parent->ap_vlan_lock);
+  return sta;
+}
+
+static bool wave_df_ap_vlan_tx_allowed(sta_entry *sta, struct net_device *ndev)
+{
+  mtlk_df_user_t *parent = mtlk_df_get_user(mtlk_vap_get_df(sta->vap_handle));
+  struct net_device *bound;
+  bool allowed;
+
+  spin_lock_bh(&parent->ap_vlan_lock);
+  bound = rcu_dereference_protected(sta->ap_vlan,
+                                    lockdep_is_held(&parent->ap_vlan_lock));
+  allowed = !sta->ap_vlan_retiring &&
+            (bound ? bound == ndev : ndev == parent->ndev);
+  spin_unlock_bh(&parent->ap_vlan_lock);
+  return allowed;
+}
+
+bool wave_df_ap_vlan_prepare_tx(sta_entry *sta, mtlk_nbuf_t *nbuf)
+{
+  struct net_device *parent = mtlk_df_user_get_ndev(
+    mtlk_df_get_user(mtlk_vap_get_df(sta->vap_handle)));
+  struct net_device *origin = nbuf->dev ?: parent;
+
+  if (!wave_df_ap_vlan_tx_allowed(sta, origin))
+    return false;
+  /* DMA may outlive child removal. Only the existing parent VAP lifetime
+   * owns hardware-submitted skbs; unregister drains child qdiscs and RX.
+   */
+  nbuf->dev = parent;
+  return true;
+}
+
+int wave_df_ap_vlan_del(struct wireless_dev *wdev)
+{
+  struct wave_ap_vlan *vlan = netdev_priv(wdev->netdev);
+  mtlk_df_user_t *parent = vlan->parent;
+  sta_entry *sta;
+
+  ASSERT_RTNL();
+  lockdep_assert_wiphy(wdev->wiphy);
+  dev_deactivate(wdev->netdev);
+  spin_lock_bh(&parent->ap_vlan_lock);
+  sta = vlan->sta;
+  if (sta)
+    mtlk_sta_incref(sta);
+  spin_unlock_bh(&parent->ap_vlan_lock);
+  if (sta) {
+    wave_ap_vlan_submit_binding(parent, NULL, sta);
+    mtlk_sta_decref(sta);
+  }
+  /* Teardown must finish even if the master no longer accepts commands.
+   * Such a failed transition leaves native membership admission closed.
+   */
+  spin_lock_bh(&parent->ap_vlan_lock);
+  sta = vlan->sta;
+  if (sta) {
+    RCU_INIT_POINTER(sta->ap_vlan, NULL);
+    vlan->sta = NULL;
+  }
+  spin_unlock_bh(&parent->ap_vlan_lock);
+  if (sta)
+    mtlk_sta_decref(sta);
+  list_del(&vlan->node);
+  synchronize_net();
+  cfg80211_unregister_netdevice(wdev->netdev);
+  return 0;
+}
+
+static void wave_df_ap_vlan_del_all(mtlk_df_user_t *parent)
+{
+  struct wave_ap_vlan *vlan, *next;
+
+  list_for_each_entry_safe(vlan, next, &parent->ap_vlans, node)
+    wave_df_ap_vlan_del(&vlan->wdev);
+}
