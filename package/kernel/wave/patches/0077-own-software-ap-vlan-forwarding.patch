+/* Multi-AP's extension attribute explicitly identifies a backhaul station.
+ * Merely finding the WFA OUI/type also matches fronthaul-only associations.
+ */
+static bool wave_multi_ap_backhaul_sta(const u8 *ie)
+{
+  const u8 *pos, *end;
+  bool backhaul = false;
+
+  if (!ie || ie[-1] < 4 || ie[3] != WLAN_OUI_TYPE_WFA_MULTI_AP)
+    return false;
+  pos = ie + 4;
+  end = ie + ie[-1];
+  while (end - pos >= 2) {
+    u8 id = pos[0], len = pos[1];
+
+    pos += 2;
+    if (len > end - pos)
+      return false;
+    if (id == 6 && len == 1)
+      backhaul |= !!(pos[0] & BIT(7));
+    pos += len;
+  }
+  return pos == end && backhaul;
+}
