+/* Capture the native BSS while mac80211 holds the wiphy mutex. */
+static int wv_sta_bss_params(struct ieee80211_hw *hw,
+                            const struct ieee80211_bss_conf *info, u8 vap_index,
+                            struct mtlk_bss_parameters *bp)
+{
+  struct ieee80211_supported_band *sband = NULL;
+  unsigned long basic_rates = info->basic_rates;
+  int i;
+
+  if (info->chanreq.oper.chan) {
+    if (!cfg80211_chandef_valid(&info->chanreq.oper))
+      return MTLK_ERR_PARAMS;
+    sband = hw->wiphy->bands[info->chanreq.oper.chan->band];
+  }
+  /* Initial ERP setup precedes channel selection and enables probe TX.
+   * A concrete peer channel is required only to interpret its rate bitmap. */
+  if (basic_rates && !sband)
+    return MTLK_ERR_NOT_READY;
+  memset(bp, 0, sizeof(*bp));
+  bp->protection_mode = -1;
+  bp->vap_id = vap_index;
+  bp->use_cts_prot = info->use_cts_prot;
+  bp->use_short_preamble = info->use_short_preamble;
+  bp->use_short_slot_time = info->use_short_slot;
+  bp->ht_opmode = info->ht_operation_mode;
+  bp->beacon_interval = info->beacon_int ?: DEFAULT_BEACON_INTERVAL;
+  bp->dtim_period = info->dtim_period ?: 1;
+  bp->p2p_ctwindow = info->p2p_noa_attr.oppps_ctwindow;
+  /* mac80211 can retain the last HE color on a later non-HE association. */
+  bp->he_bss_color = info->he_support && info->he_bss_color.enabled ?
+                      info->he_bss_color.color : 0;
+  for_each_set_bit(i, &basic_rates, BITS_PER_LONG) {
+    if (i >= sband->n_bitrates || bp->basic_rates_len >= ARRAY_SIZE(bp->basic_rates))
+      return MTLK_ERR_PARAMS;
+    bp->basic_rates[bp->basic_rates_len++] = sband->bitrates[i].bitrate / 5;
+  }
+  return MTLK_ERR_OK;
+}
