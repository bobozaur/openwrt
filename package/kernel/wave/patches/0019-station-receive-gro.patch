+static int
+_mtlk_df_user_sta_gro_init(mtlk_df_user_t *df_user)
+{
+  if (mtlk_vap_is_ap(mtlk_df_get_vap_handle(df_user->df)))
+    return MTLK_ERR_OK;
+  /* STA borrows a registered mac80211 netdev. Its df_user is destroyed
+   * during remove_interface, before mac80211 unregisters the netdev.
+   * Keep AP's different netdev/destructor ownership unchanged.
+   */
+  if (gro_cells_init(&df_user->rx_gro, df_user->ndev))
+    return MTLK_ERR_NO_MEM;
+  WRITE_ONCE(df_user->rx_gro_accepting, true);
+  return MTLK_ERR_OK;
+}
+
+static void
+_mtlk_df_user_sta_gro_cleanup(mtlk_df_user_t *df_user)
+{
+  if (mtlk_vap_is_ap(mtlk_df_get_vap_handle(df_user->df)))
+    return;
+  spin_lock_bh(&df_user->rx_gro_lock);
+  df_user->rx_gro_accepting = false;
+  spin_unlock_bh(&df_user->rx_gro_lock);
+  synchronize_net();
+  gro_cells_destroy(&df_user->rx_gro);
+}
