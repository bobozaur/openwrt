   ILOG5_V("Send to Linux");
   nbuf->protocol        = eth_type_trans(nbuf, nbuf->dev);
-  res                   = netif_rx(nbuf);
+  if (mtlk_vap_is_ap(mtlk_df_get_vap_handle(df))) {
+    res = netif_rx(nbuf);
+  } else {
+    /* gro_cells uses a per-CPU queue: the receive handoff and stop gate
+     * share the network softirq lifetime. EAPOL keeps its separate path.
+     */
+    spin_lock_bh(&df_user->rx_gro_lock);
+    if (likely(df_user->rx_gro_accepting)) {
