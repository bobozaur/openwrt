     _mtlk_hst_update(host, sta);
+    mtlk_osal_lock_release(&hstdb->lock);
   }
   else {
+    mtlk_osal_lock_release(&hstdb->lock);
 
     ILOG2_V("Can't find peer (HOST), adding...");
     _mtlk_hstdb_add_host(hstdb, mac, sta);
