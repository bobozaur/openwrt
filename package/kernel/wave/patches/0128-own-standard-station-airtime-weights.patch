+void wave_hw_airtime_lock(mtlk_hw_t *hw) { mutex_lock(&hw->airtime_lock); }
+void wave_hw_airtime_unlock(mtlk_hw_t *hw) { mutex_unlock(&hw->airtime_lock); }
