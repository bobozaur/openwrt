+void wave_hw_airtime_mark(mtlk_hw_t *hw, unsigned radio, bool owned)
+{
+  lockdep_assert_held(&hw->airtime_lock);
+  if (WARN_ON(radio >= BITS_PER_LONG))
+    return;
+  if (owned)
+    hw->airtime_radios |= BIT(radio);
+  else
+    hw->airtime_radios &= ~BIT(radio);
 }
 
