+  if (wave_hw_fw_feature_supported(HANDLE_T_PTR(mtlk_hw_t, hw_handle),
+                                    WAVE_FW_FEATURE_TXOP_READ))
+    wiphy_ext_feature_set(wiphy, NL80211_EXT_FEATURE_AIRTIME_FAIRNESS);
   if (radio_id == 0 && wave_hw_monitor_supported(HANDLE_T_PTR(mtlk_hw_t, hw_handle))) {
     wiphy->interface_modes |= BIT(NL80211_IFTYPE_MONITOR);
     /* This receiver owns the firmware master and both radios exclusively.
