+int __MTLK_IFUNC
+mtlk_core_set_he_mu_operation(mtlk_core_t *core, BOOL enabled)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  int res;
+
+  wave_hw_airtime_lock(hw);
+  res = enabled && wave_hw_airtime_owned(hw) ? MTLK_ERR_BUSY :
+          _mtlk_core_set_he_mu_operation(core, enabled);
+  wave_hw_airtime_unlock(hw);
