From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] wave: coordinate simultaneous AP and station roles

Keep the shared physical channel, regulatory permission and confirmed CSA
notification under the existing paired AP and station owners.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>

---
--- a/wireless/driver/linux/core_config.c
+++ b/wireless/driver/linux/core_config.c
@@ -560,7 +560,8 @@
   primary_chan_num = ieee80211_frequency_to_channel(cd->chan.center_freq);
   req->primary_chan_idx = (primary_chan_num - req->low_chan_num) / CHANNUMS_PER_20MHZ;
 
-  if (!(cpd ? cpd->station : wave_radio_channel_is_station(radio)) &&
+  if (!wave_radio_channel_uses_sta_rules(radio,
+        cpd ? cpd->station : wave_radio_channel_is_station(radio)) &&
       _is_radar_det_needed(radio, cd)) {
     req->isRadarDetectionNeeded = 1;
   } else {
@@ -752,6 +753,14 @@
       res = wave_radio_role_check(radio, cpd->station);
       if (res != MTLK_ERR_OK)
         MTLK_CLPB_EXIT(res);
+      if (cpd->station ? wave_radio_ap_active(radio) : wave_radio_sta_active(radio)) {
+        struct mtlk_chan_def *home = is_scan_running(ss) ? &ss->orig_chandef : ccd;
+
+        /* A shared radio changes channel only through its coordinated CSA
+         * owner. Ordinary setup/reconnect must match the current home channel. */
+        if (!cpd->station_csa && !mtlk_core_is_chandef_identical(&cpd->chandef, home))
+          MTLK_CLPB_EXIT(MTLK_ERR_BUSY);
+      }
     }
 
     if (cpd->cac_time)
@@ -858,9 +867,14 @@
     if (is_scan_running(ss)) {
       /* save what we just set so the scan can return to it when it finishes */
       ss->orig_chandef = *ccd;
-      ss->orig_station = cpd->station;
+      ss->orig_station = wave_radio_channel_uses_sta_rules(radio, cpd->station);
     }
 
+    /* One firmware CSA applies to all VAPs. Publish the confirmed channel
+     * to the paired AP owner without submitting a second timed retune. */
+    if (cpd->station_csa && !cpd->block_tx_post)
+      wave_radio_ap_channel_changed(radio, ccd);
+
     /* In case of a successful NORMAL or CSA switch, notify the kernel, too, because hostapd need to know */
     if (!cpd->dont_notify_kernel && (cpd->switch_type == ST_NORMAL || cpd->switch_type == ST_CSA))
     {
--- a/wireless/driver/linux/wave_radio.c
+++ b/wireless/driver/linux/wave_radio.c
@@ -735,13 +735,25 @@
     return wave_radio_cac_active(radio) ? MTLK_ERR_OK : MTLK_ERR_NOT_READY;
   if (wave_radio_cac_active(radio) && !(cpd && cpd->cac_time))
     return MTLK_ERR_BUSY;
+  /* A station-origin command cannot lend its NO_IR permission to an AP.
+   * Check before SET_CHAN while firmware may still own active beacons. */
+  if (cpd && cpd->station && wave_radio_ap_active(radio)) {
+    if (!wave_radio_native_chandef(radio, mcd, &cd) ||
+        !cfg80211_reg_can_beacon(wiphy, &cd, NL80211_IFTYPE_AP))
+      return MTLK_ERR_NOT_READY;
+    /* Firmware's post-CSA TX fence applies to every VAP. The daemon removes
+     * STA before establishing AP operation on a DFS destination. */
+    if (cpd->station_csa && wv_cfg80211_chandef_dfs_required(wiphy, &cd))
+      return MTLK_ERR_NOT_READY;
+  }
   if (!wave_radio_dfs_tx_blocked(radio))
     return MTLK_ERR_OK;
   if (!wave_radio_native_chandef(radio, mcd, &cd))
     return MTLK_ERR_PARAMS;
   if (cpd && cpd->cac_time)
     return cfg80211_chandef_dfs_usable(wiphy, &cd) ? MTLK_ERR_OK : MTLK_ERR_NOT_READY;
-  if (cpd ? cpd->station : wave_radio_channel_is_station(radio))
+  if (wave_radio_channel_uses_sta_rules(radio,
+        cpd ? cpd->station : wave_radio_channel_is_station(radio)))
     return cfg80211_chandef_usable(wiphy, &cd, IEEE80211_CHAN_DISABLED) ?
       MTLK_ERR_OK : MTLK_ERR_NOT_READY;
   return cfg80211_reg_can_beacon(wiphy, &cd, NL80211_IFTYPE_AP) ?
@@ -753,6 +765,27 @@
   return radio->channel_station;
 }
 
+/* Master-serialized physical permission; command origin stays separate. */
+bool wave_radio_channel_uses_sta_rules(wave_radio_t *radio, bool station)
+{
+  return station && !wave_radio_ap_active(radio);
+}
+
+void wave_radio_ap_channel_changed(wave_radio_t *radio, const struct mtlk_chan_def *cd)
+{
+  unsigned int i, count = mtlk_vap_manager_get_max_vaps_count(radio->vap_manager);
+  mtlk_vap_handle_t vap;
+
+  for (i = 0; i < count; i++) {
+    if (mtlk_vap_manager_get_vap_handle(radio->vap_manager, i, &vap) != MTLK_ERR_OK ||
+        !mtlk_vap_is_ap(vap) || !mtlk_vap_get_core(vap)->slow_ctx->ap_started)
+      continue;
+    /* Existing AP-wiphy work owns the notification and cancels it on stop. */
+    wv_cfg80211_ch_switch_notify(mtlk_df_user_get_ndev(
+      mtlk_df_get_user(mtlk_vap_get_df(vap))), cd, true);
+  }
+}
+
 void wave_radio_channel_station_set(wave_radio_t *radio, bool station)
 {
   radio->channel_station = station;
@@ -781,7 +814,8 @@
     goto out;
   if (ctx->stopping || ctx->radar_generation != generation ||
       !wave_radio_native_chandef(radio, mcd, &cd) ||
-      ((cpd ? cpd->station : wave_radio_channel_is_station(radio)) ?
+      (wave_radio_channel_uses_sta_rules(radio,
+         cpd ? cpd->station : wave_radio_channel_is_station(radio)) ?
        !cfg80211_chandef_usable(wiphy, &cd, IEEE80211_CHAN_DISABLED) :
        !cfg80211_reg_can_beacon(wiphy, &cd, NL80211_IFTYPE_AP))) {
     ctx->tx_blocked = true;
@@ -4785,8 +4819,8 @@
 
 int wave_radio_role_check(wave_radio_t *radio, bool station)
 {
-  if (wave_radio_cac_active(radio) ||
-      (station ? wave_radio_ap_active(radio) : wave_radio_sta_active(radio)))
+  MTLK_UNREFERENCED_PARAM(station);
+  if (wave_radio_cac_active(radio))
     return MTLK_ERR_BUSY;
   return MTLK_ERR_OK;
 }
--- a/wireless/driver/linux/wave_radio.h
+++ b/wireless/driver/linux/wave_radio.h
@@ -325,6 +325,8 @@
                                  const struct set_chan_param_data *cpd);
 int wave_radio_ap_tx_check(wave_radio_t *radio, u32 generation, bool acknowledged);
 bool wave_radio_channel_is_station(wave_radio_t *radio);
+bool wave_radio_channel_uses_sta_rules(wave_radio_t *radio, bool station);
+void wave_radio_ap_channel_changed(wave_radio_t *radio, const struct mtlk_chan_def *cd);
 void wave_radio_channel_station_set(wave_radio_t *radio, bool station);
 u32 wave_radio_dfs_generation(wave_radio_t *radio);
 int wave_radio_dfs_channel_done(wave_radio_t *radio,
