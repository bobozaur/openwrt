+const u8 wave_monitor_header[44] = {
+  0x02,0x52,0x58,0x31,0x15,0x01, 0x02,0x52,0x58,0x31,0x15,0x02,
+  0x08,0x00, 0x45,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x40,0x11,0x00,0x00,
+  0xc6,0x12,0x5d,0x01,0xc6,0x12,0x5d,0x02,
+  0xbf,0x77,0xbf,0x78,0x00,0x00,0x00,0x00,0xca,0xfe
+};
+
+int wave_hw_monitor_template(mtlk_vap_handle_t vap)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(vap);
+  mtlk_txmm_msg_t msg;
+  mtlk_txmm_data_t *entry;
+  UMI_ADD_STREAM_REQ_t *req;
+  unsigned int i;
+  u32 sum = 0;
+  int res = MTLK_ERR_NOT_READY;
+
+  if (wave_hw_monitor_activation_begin(vap, TRUE) != MTLK_ERR_OK)
+    return res;
+  /* Intent precedes submission. Only complete card restart retires this mode,
+   * including a missing confirmation or an ADD_VAP failure. */
+  WRITE_ONCE(hw->monitor_dirty, true);
+  entry = mtlk_txmm_msg_init_with_empty_data(&msg, mtlk_vap_get_txmm(vap), &res);
+  if (!entry)
+    return res;
+  entry->id = UM_MAN_HW_LOGGER_ADD_STREAM_REQ;
+  entry->payload_size = sizeof(*req);
+  req = (UMI_ADD_STREAM_REQ_t *)entry->payload;
+  memset(req, 0, sizeof(*req));
+  req->be1 = 1;
+  for (i = 14; i < 34; i += 2)
+    sum += ((u32)wave_monitor_header[i] << 8) | wave_monitor_header[i + 1];
+  while (sum >> 16)
+    sum = (sum & 0xffff) + (sum >> 16);
+  req->swPreCalcChecksum = HOST_TO_MAC32(sum);
+  MTLK_STATIC_ASSERT(sizeof(req->udpHeader) == sizeof(wave_monitor_header));
+  memcpy(req->udpHeader, wave_monitor_header, sizeof(wave_monitor_header));
+  res = mtlk_txmm_msg_send_blocked(&msg, MTLK_MM_BLOCKED_SEND_TIMEOUT);
+  if (res == MTLK_ERR_OK && MAC_TO_HOST16(req->u16Status) != UMI_OK)
+    res = MTLK_ERR_MAC;
+  mtlk_txmm_msg_cleanup(&msg);
+  return res;
+}
+
+static bool wave_hw_monitor_rx(mtlk_hw_t *hw, const struct sk_buff *skb)
+{
+  struct wave_monitor *mon;
+
+  rcu_read_lock();
+  mon = rcu_dereference(hw->monitor);
+  if (mon)
+    wv_cfg80211_monitor_rx(mon, skb);
+  rcu_read_unlock();
+  return mon != NULL;
+}
