+      !mtlk_vap_is_master_ap(vap) || mtlk_vap_get_id(vap) != 0)
+    return MTLK_ERR_NOT_SUPPORTED;
+  spin_lock_irqsave(&hw->monitor_lock, flags);
+  if (hw->monitor || hw->monitor_users || !wave_hw_mmb_ready(hw) ||
+      wave_rcvry_type_current_get(hw) != RCVRY_TYPE_UNDEF)
+    goto out;
+  for (r = 0; r < hw->radio_descr->num_radios; r++) {
+    wave_radio_t *radio = wave_radio_descr_wave_radio_get(hw->radio_descr, r);
+    mtlk_vap_manager_t *manager = wave_radio_descr_vap_manager_get(hw->radio_descr, r);
+    mtlk_core_t *master = wave_radio_master_core_get(radio);
+
+    if (!master || wave_radio_get_sta_vifs_exist(radio) ||
+        mtlk_vap_manager_get_active_vaps_number(manager) ||
