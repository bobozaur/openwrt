+/* The same card owns both native radios. Normal user commands enter/leave
+ * this admission gate at execution, not at asynchronous submission. */
+bool wave_hw_monitor_user_get(mtlk_hw_t *hw)
+{
+  unsigned long flags;
+  bool allowed;
+
+  spin_lock_irqsave(&hw->monitor_lock, flags);
+  allowed = !hw->monitor && !hw->quiescing;
+  if (allowed)
+    hw->monitor_users++;
+  spin_unlock_irqrestore(&hw->monitor_lock, flags);
+  return allowed;
+}
+
+void wave_hw_monitor_user_put(mtlk_hw_t *hw)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&hw->monitor_lock, flags);
+  if (WARN_ON_ONCE(!hw->monitor_users)) {
+    spin_unlock_irqrestore(&hw->monitor_lock, flags);
+    return;
+  }
+  hw->monitor_users--;
+  spin_unlock_irqrestore(&hw->monitor_lock, flags);
+}
+
+bool wave_hw_fw_feature_supported(mtlk_hw_t *hw, u32 feature)
+{
+  return (READ_ONCE(hw->fw_features) & feature) == feature;
+}
+
+bool wave_hw_monitor_supported(mtlk_hw_t *hw)
+{
+  return mtlk_hw_type_is_gen6(hw) && !mtlk_hw_type_is_gen6_b0(hw) &&
+         wave_hw_mmb_card_is_asic(hw) &&
+         !MTLK_USE_DIRECTCONNECT_DP_API && !MTLK_USE_PUMA6_UDMA &&
+         wave_hw_fw_feature_supported(hw, WAVE_FW_FEATURE_RX_STREAM);
+}
+
+bool wave_hw_monitor_held(mtlk_hw_t *hw)
+{
+  return READ_ONCE(hw->monitor) != NULL;
+}
+
+bool wave_hw_monitor_is_owner(mtlk_hw_t *hw, const struct wave_monitor *mon)
+{
+  return READ_ONCE(hw->monitor) == mon && !READ_ONCE(hw->quiescing);
+}
+
+bool wave_hw_monitor_fenced(mtlk_hw_t *hw)
+{
+  return smp_load_acquire(&hw->monitor_fenced);
+}
+
+bool wave_hw_monitor_dirty(mtlk_hw_t *hw)
+{
+  return READ_ONCE(hw->monitor_dirty);
+}
+
+int wave_hw_monitor_claim(mtlk_hw_t *hw, mtlk_vap_handle_t vap,
+                          struct wave_monitor *mon)
