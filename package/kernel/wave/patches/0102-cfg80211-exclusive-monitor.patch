+      core = mtlk_vap_get_core(existing);
+      if (mtlk_core_get_net_state(core) &
+          (NET_STATE_ACTIVATING | NET_STATE_CONNECTED | NET_STATE_DEACTIVATING))
+        goto out;
+      if (core->is_stopping || core->is_iface_stopping)
+        goto out;
+    }
+  }
+  hw->monitor_vap = vap;
+  hw->monitor_saved_net_state = mtlk_core_get_net_state(mtlk_vap_get_core(vap));
+  hw->monitor_dirty = false;
+  rcu_assign_pointer(hw->monitor, mon);
+  res = MTLK_ERR_OK;
+out:
+  spin_unlock_irqrestore(&hw->monitor_lock, flags);
+  return res;
+}
+
+void wave_hw_monitor_release(mtlk_hw_t *hw, struct wave_monitor *mon)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&hw->monitor_lock, flags);
+  if (hw->monitor == mon) {
+    /* A failed restart retains the terminal fence, never an unfenced stream. */
+    WARN_ON_ONCE(hw->monitor_dirty && !hw->quiescing);
+    RCU_INIT_POINTER(hw->monitor, NULL);
+    hw->monitor_vap = NULL;
+  }
+  spin_unlock_irqrestore(&hw->monitor_lock, flags);
+  synchronize_net();
+}
+
+int wave_hw_monitor_activation_begin(mtlk_vap_handle_t vap, BOOL monitor)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(vap);
+
+  if (monitor)
+    return wave_hw_monitor_held(hw) && READ_ONCE(hw->monitor_vap) == vap &&
+           !READ_ONCE(hw->quiescing) ? MTLK_ERR_OK : MTLK_ERR_NOT_READY;
+  if (wave_hw_monitor_held(hw) && wave_rcvry_type_current_get(hw) != RCVRY_TYPE_UNDEF)
+    return MTLK_ERR_OK; /* Only the joined/blocked recovery owner can reach this. */
+  return wave_hw_monitor_user_get(hw) ? MTLK_ERR_OK : MTLK_ERR_BUSY;
+}
+
+void wave_hw_monitor_activation_end(mtlk_vap_handle_t vap, BOOL monitor)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(vap);
+
+  if (!monitor && !(wave_hw_monitor_held(hw) && wave_rcvry_type_current_get(hw) != RCVRY_TYPE_UNDEF))
+    wave_hw_monitor_user_put(hw);
+}
+
+u32 wave_hw_monitor_recovery_state(mtlk_hw_t *hw, mtlk_vap_handle_t vap, u32 state)
+{
+  return READ_ONCE(hw->monitor_vap) == vap ? hw->monitor_saved_net_state : state;
+}
