+/* Monitor mode changes card-global firmware classification. Its normal stop
+ * therefore uses the existing complete recovery stages, not REMOVE_STREAM or
+ * module unload. No fault budget/assertion/dump is manufactured. The caller is
+ * the cfg80211/RTNL netdevice owner, outside every core serializer. */
+int wave_rcvry_monitor_restart(mtlk_hw_t *hw)
+{
+  wave_rcvry_card_cfg_t *pcard = _rcvry_card_hw_ctx_get(hw);
+  wave_rcvry_task_ctx_t *ctx;
+  unsigned int r, v;
+  uint16 oid;
+  int res = MTLK_ERR_NOT_READY, start_res;
+
+  if (!pcard || !wave_hw_monitor_held(hw) || !wave_hw_monitor_dirty(hw))
+    return res;
+  ctx = &pcard->rcvry_ctx;
+  if (!_rcvry_is_initialized(ctx))
+    return res;
+  /* The same type lock excludes ordinary fault recovery throughout this
+   * synchronous lifetime; normal user commands remain admission-blocked. */
+  mtlk_osal_lock_acquire(&ctx->lock);
+  if (ctx->rcvry_type_current != RCVRY_TYPE_UNDEF) {
+    mtlk_osal_lock_release(&ctx->lock);
+    return MTLK_ERR_BUSY;
+  }
+  ctx->rcvry_type_current = RCVRY_TYPE_FULL;
+  mtlk_osal_lock_release(&ctx->lock);
+  _rcvry_task_vap_info_prepare(ctx);
+  res = _rcvry_task_scan_info_prepare(ctx);
+  if (res != MTLK_ERR_OK)
+    goto done;
+  for (r = 0; r < ctx->max_radios_number; r++) {
+    wave_rcvry_radio_ctx_t *radio = &ctx->radio_ctx[r];
+
+    if (radio->scan_info->scan_type_current != RCVRY_NO_SCAN) {
+      res = MTLK_ERR_BUSY;
+      goto done;
+    }
+    for (v = 0; radio->vap_info[v]; v++) {
+      if (radio->vap_info[v]->was_connected &
+          (NET_STATE_ACTIVATING | NET_STATE_CONNECTED | NET_STATE_DEACTIVATING)) {
+        res = MTLK_ERR_BUSY;
+        goto done;
+      }
+    }
+  }
+  /* Native serializer stop drains accepted commands and joins each worker.
+   * Unlike the fault queue this requires no new asynchronous allocation and
+   * cannot leave a partial set of blocked slave recovery commands. */
+  for (r = 0; r < ctx->max_radios_number; r++)
+    for (v = 0; ctx->radio_ctx[r].vap_info[v]; v++)
+      mtlk_serializer_stop(&mtlk_vap_get_core(ctx->radio_ctx[r].vap_info[v]->vap_handle)->slow_ctx->serializer);
+
+  oid = mtlk_vap_get_oid(ctx->radio_ctx[0].master_vap_handle);
+  res = wave_hw_monitor_fence(hw);
+  if (res == MTLK_ERR_OK)
+    res = _rcvry_step_vap_deactivation(ctx, oid);
+  if (res == MTLK_ERR_OK)
+    res = _rcvry_step_fw_isolation(pcard, oid);
+  if (res == MTLK_ERR_OK)
+    res = _rcvry_step_fw_restoration(pcard, oid);
+  if (res == MTLK_ERR_OK)
+    res = _rcvry_step_fw_reconfiguration(pcard, oid);
+  if (res != MTLK_ERR_OK)
+    wave_hw_mmb_quiesce(hw);
+
+  /* Recreate the same native workers even on failure so ordinary object
+   * destruction retains its owner. A failed card remains terminal-fenced. */
+  for (r = 0; r < ctx->max_radios_number; r++) {
+    for (v = 0; ctx->radio_ctx[r].vap_info[v]; v++) {
+      start_res = mtlk_serializer_start(&mtlk_vap_get_core(ctx->radio_ctx[r].vap_info[v]->vap_handle)->slow_ctx->serializer);
+      if (start_res != MTLK_ERR_OK && res == MTLK_ERR_OK)
+        res = start_res;
+    }
+  }
+  if (res == MTLK_ERR_OK)
+    wave_hw_monitor_restarted(hw);
+  else
+    wave_hw_mmb_quiesce(hw);
+done:
+  __rcvry_type_current_set(ctx, RCVRY_TYPE_UNDEF);
+  return res;
+}
