+      record = (struct mldv2_grec *)cursor;
+      record_length = sizeof(*record) + ntohs(record->grec_nsrcs) * sizeof(struct in6_addr) +
+                      record->grec_auxwords * sizeof(u32);
+      if (record_length > remaining)
