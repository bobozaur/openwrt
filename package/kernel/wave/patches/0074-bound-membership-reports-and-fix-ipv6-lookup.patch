 static int _mtlk_do_send_data_to_sta (mtlk_core_t* nic, mtlk_core_handle_tx_data_t *data, uint32 nbuf_flags)
@@ -1206,13 +1215,36 @@
 
 
 static int
-parse_igmp (mtlk_core_t *nic, struct igmphdr *igmp_header, sta_entry *sta)
+parse_igmp (mtlk_core_t *nic, struct igmphdr *igmp_header, uint32 length, sta_entry *sta)
 {
   unsigned grp_num, src_num;
   unsigned i;
   struct igmpv3_report *report;
   struct igmpv3_grec *record;
   struct in_addr grp_addr;
+
+  /* Validate all variable records first: a later truncation must not leave
+   * membership changes from the valid prefix of an incomplete report.
+   */
+  if (igmp_header->type == IGMPV3_HOST_MEMBERSHIP_REPORT) {
+    const uint8 *cursor = (const uint8 *)igmp_header + sizeof(*report);
+    unsigned remaining = length - sizeof(*report);
+
+    report = (struct igmpv3_report *)igmp_header;
+    for (i = 0; i < ntohs(report->ngrec); i++) {
+      unsigned record_length;
+
+      if (remaining < sizeof(*record))
+        return -1;
+      record = (struct igmpv3_grec *)cursor;
+      record_length = sizeof(*record) + ntohs(record->grec_nsrcs) * sizeof(struct in_addr) +
+                      record->grec_auxwords * sizeof(u32);
+      if (record_length > remaining)
+        return -1;
+      cursor += record_length;
+      remaining -= record_length;
+    }
+  }
 
   grp_addr.s_addr = ntohl(igmp_header->group);
 
@@ -1601,18 +1633,34 @@
