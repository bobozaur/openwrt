Subject: [PATCH] Validate complete IGMP/MLD reports before updating membership

Bound parsing by IP lengths, including all source and auxiliary records.
Resolve IPv6 multicast transmission using the group/source key in its declared order.
This does not implement VLAN-scoped membership or source filtering.

--- a/wireless/driver/linux/mcast.c
+++ b/wireless/driver/linux/mcast.c
@@ -22,6 +22,7 @@
 
 #include <linux/igmp.h>
 #include <linux/if_vlan.h>
+#include <net/ip.h>
 #include <net/addrconf.h>        /* for ipv6_addr_is_multicast() */
 
 #include "mcast.h"
@@ -51,7 +52,7 @@
 /*****************************************************************************/
 
