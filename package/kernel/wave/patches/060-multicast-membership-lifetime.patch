+struct wave_mc_targets {
+  DECLARE_BITMAP(bits, WAVE_MC_SIDS);
+  sta_entry *source;
+  const sta_entry *wanted;
+  bool found;
+  struct wave_mc_native_member *members;
+  bool allocate;
+  bool failed;
+};
+
+static void wave_mc_target(void *ctx, sta_entry *sta)
+{
+  struct wave_mc_targets *targets = ctx;
+  unsigned int sid = mtlk_sta_get_sid(sta);
+  struct wave_mc_native_member *member;
+
+  if (sta == targets->source || sta->info.mc_retiring || sta->ap_vlan_retiring ||
+      rcu_access_pointer(sta->ap_vlan) ||
+      mtlk_sta_get_packets_filter(sta) != MTLK_PCKT_FLTR_ALLOW_ALL)
+    return;
+  if (targets->wanted) {
+    if (sta == targets->wanted)
+      targets->found = true;
+    return;
+  }
+  if (sid >= WAVE_MC_SIDS || sta->peer_ap || mtlk_sta_is_4addr(sta) ||
+      test_and_set_bit(sid, targets->bits))
+    return;
+  if (!targets->allocate || targets->failed)
+    return;
+  member = kzalloc(sizeof(*member), GFP_ATOMIC);
+  if (!member) {
+    targets->failed = true;
+    return;
+  }
+  member->sta = sta;
+  member->sid = sta->info.sid;
+  member->sid_order = sta->info.sid_order;
+  mtlk_sta_incref(sta);
+  member->next = targets->members;
+  targets->members = member;
+}
+
+static void wave_mc_members_free(struct wave_mc_native_member *members)
+{
+  while (members) {
+    struct wave_mc_native_member *next = members->next;
+
+    mtlk_sta_decref(members->sta);
+    kfree(members);
+    members = next;
+  }
+}
+
+static bool wave_mc_class_current(const struct wave_mc_native_class *class)
+{
+  const struct wave_mc_native_member *member;
+
+  for (member = class->members; member; member = member->next)
+    if (member->sta->info.sid != member->sid ||
+        member->sta->info.sid_order != member->sid_order ||
+        member->sta->info.mc_retiring || member->sta->ap_vlan_retiring ||
+        rcu_access_pointer(member->sta->ap_vlan) ||
+        mtlk_sta_get_packets_filter(member->sta) != MTLK_PCKT_FLTR_ALLOW_ALL)
+      return false;
+  return true;
+}
+
+static bool wave_mc_class_ready(struct wave_mc_native_class *class)
+{
+  struct wave_mc_native_member *member;
+
+  if (class->retiring || class->pending || class->id == MCAST_GROUP_UNDEF ||
+      !wave_mc_class_current(class))
+    return false;
+  for (member = class->members; member; member = member->next)
+    if (!(member->sta->info.mc_memberships & BIT(class->id)))
+      return false;
+  return true;
+}
+
+bool wave_mc_native_command_valid(struct wave_mc_native_class *class,
+                                   sta_entry *sta, int action)
+{
+  struct wave_mc_native_member *member;
+
+  for (member = class->members; member; member = member->next)
+    if (member->sta == sta && member->sid == sta->info.sid &&
+        member->sid_order == sta->info.sid_order)
+      return action == MTLK_MC_STA_JOIN_GROUP ?
+        !class->retiring && !class->owner->reset_pending &&
+        wave_mc_native_needed(class->owner->core) &&
+        wave_mc_class_current(class) &&
+        wave_hw_mc_get(mtlk_vap_get_hw(class->owner->core->vap_handle), class->id, FALSE) :
+        class->retiring;
+  return false;
+}
+
+void wave_mc_native_command_queued(struct wave_mc_native_class *class,
+                                    sta_entry *sta, int action)
+{
+  struct wave_mc_native_member *member;
+
+  class->pending++;
+  for (member = class->members; member; member = member->next)
+    if (member->sta == sta)
+      member->status = action == MTLK_MC_STA_JOIN_GROUP ?
+                       MCAST_STA_STATUS_JOIN : MCAST_STA_STATUS_DELETE;
+}
+
+void wave_mc_native_command_done(struct wave_mc_native_class *class,
+                                  sta_entry *sta, int action)
+{
+  struct wave_mc_native_member *member;
+
+  MTLK_ASSERT(class->pending);
+  class->pending--;
+  for (member = class->members; member; member = member->next)
+    if (member->sta == sta)
+      member->status = MCAST_STA_STATUS_NONE;
+  wave_mc_native_wake(class->owner);
+}
+
+static void wave_mc_class_free(struct wave_mc_native_class *class)
+{
+  struct wave_mc_native *native = class->owner;
+
+  MTLK_ASSERT(!class->pending);
+  list_del(&class->node);
+  native->count--;
+  if (class->id != MCAST_GROUP_UNDEF)
+    wave_hw_mc_release_native(mtlk_vap_get_hw(native->core->vap_handle), class->id);
+  wave_mc_members_free(class->members);
+  kfree(class);
+}
