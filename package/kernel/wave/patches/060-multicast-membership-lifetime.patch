+static bool wave_mc_group_valid(__be16 proto, const void *address, bool zero)
+{
+  if (proto == htons(ETH_P_IP)) {
+    __be32 ip = get_unaligned((const __be32 *)address);
+
+    return (zero && !ip) || ipv4_is_multicast(ip);
+  }
+  {
+    struct in6_addr ip;
+
+    memcpy(&ip, address, sizeof(ip));
+    return (zero && ipv6_addr_any(&ip)) || ipv6_addr_is_multicast(&ip);
+  }
+}
+
+static bool wave_mc_sources_valid(__be16 proto, const u8 *sources, unsigned int count)
+{
+  unsigned int size = proto == htons(ETH_P_IP) ? 4 : 16;
+
+  for (; count; count--, sources += size) {
+    if (proto == htons(ETH_P_IP)) {
+      __be32 ip = get_unaligned((const __be32 *)sources);
+
+      if (!ip || ip == htonl(INADDR_BROADCAST) || ipv4_is_multicast(ip))
+        return false;
+    } else {
+      struct in6_addr ip;
+
+      memcpy(&ip, sources, sizeof(ip));
+      if (ipv6_addr_any(&ip) || ipv6_addr_is_multicast(&ip))
+        return false;
+    }
+  }
+  return true;
+}
+
+/* Validate every advertised record before publishing the first one. Ethernet
+ * padding is outside the bounded IP payload and cannot complete a short record.
+ */
+static int wave_mc_validate_control(const struct wave_mc_packet *packet, const u8 *body)
+{
+  unsigned int size = packet->key.proto == htons(ETH_P_IP) ? 4 : 16;
+  unsigned int base = size == 4 ? 8 : 20;
+  unsigned int count, offset, i, nsrc, length = packet->length;
+  bool query = packet->type == (size == 4 ? IGMP_HOST_MEMBERSHIP_QUERY : ICMPV6_MGM_QUERY);
+
+  if (query) {
+    unsigned int minimum = size == 4 ? 8 : 24;
+    unsigned int version3 = size == 4 ? 12 : 28;
+    unsigned int group_offset = size == 4 ? 4 : 8;
+
+    if (length < minimum || !wave_mc_group_valid(packet->key.proto, body + group_offset, true))
+      return -EINVAL;
+    if (length == minimum)
+      return 0;
+    if (length < version3)
+      return -EINVAL;
+    nsrc = get_unaligned_be16(body + version3 - 2);
+    if (nsrc > (length - version3) / size || length != version3 + nsrc * size ||
+        (nsrc && !wave_mc_group_valid(packet->key.proto, body + group_offset, false)) ||
+        !wave_mc_sources_valid(packet->key.proto, body + version3, nsrc))
+      return -EINVAL;
+    return 0;
+  }
+  if (packet->type != (size == 4 ? IGMPV3_HOST_MEMBERSHIP_REPORT : ICMPV6_MLD2_REPORT)) {
+    unsigned int minimum = size == 4 ? 8 : 24;
+
+    if (length != minimum ||
+        !wave_mc_group_valid(packet->key.proto, body + (size == 4 ? 4 : 8), false))
+      return -EINVAL;
+    return 0;
+  }
+  if (length < 8)
+    return -EINVAL;
+  count = get_unaligned_be16(body + 6);
+  offset = 8;
+  for (i = 0; i < count; i++) {
+    unsigned int record;
+
+    if (length - offset < base)
+      return -EINVAL;
+    nsrc = get_unaligned_be16(body + offset + 2);
+    if (nsrc > (length - offset - base) / size)
+      return -EINVAL;
+    record = base + nsrc * size;
+    if (body[offset + 1] > (length - offset - record) / 4)
+      return -EINVAL;
+    record += body[offset + 1] * 4;
+    if (!wave_mc_group_valid(packet->key.proto, body + offset + 4, false) ||
+        !wave_mc_sources_valid(packet->key.proto, body + offset + base, nsrc))
+      return -EINVAL;
+    offset += record;
+  }
+  return offset == length ? 0 : -EINVAL;
+}
+
+static unsigned int wave_mc_decode8(u8 code)
+{
+  return code < 128 ? code : ((code & 15) | 16) << (((code >> 4) & 7) + 3);
+}
+
+static unsigned int wave_mc_decode16(u16 code)
+{
+  return code < 32768 ? code : ((code & 4095) | 4096) << (((code >> 12) & 7) + 3);
+}
+
+int wave_mc_native_observe(mtlk_core_t *core, struct sk_buff *skb, sta_entry *reporter)
+{
+  struct wave_mc_native *native = core->mcast.native;
+  struct wave_mc_packet packet;
+  struct wave_mc_key key;
+  const u8 *body, *sources = NULL;
+  unsigned int size, base, count, offset, nsrc = 0, i;
+  unsigned long maxresp, qqi = 0;
+  u8 qrv = 0;
+  bool query, suppress = false;
+  int error, result = 0;
+
+  if (!native || !wave_mc_native_needed(core))
+    return 0;
+  error = wave_mc_packet(skb, &packet);
+  if (error)
+    return error;
+  if (!packet.control) {
+    mtlk_osal_lock_acquire(&core->mcast.lock);
+    if (core->mcast.accepting && wave_mc_native_sync_locked(native) &&
+        (packet.key.proto == htons(ETH_P_IP) || packet.key.proto == htons(ETH_P_IPV6))) {
+      if (wave_mc_policy_activate(native->policy, packet.key.vlan, packet.key.proto, jiffies) > 0)
+        wave_mc_native_wake(native);
+    }
+    mtlk_osal_lock_release(&core->mcast.lock);
+    return 0;
+  }
+  if (reporter && !is_valid_ether_addr(packet.reporter))
+    return -EINVAL;
+  body = skb->data + packet.offset;
+  error = wave_mc_validate_control(&packet, body);
+  if (error)
+    return error;
+  size = packet.key.proto == htons(ETH_P_IP) ? 4 : 16;
+  query = packet.type == (size == 4 ? IGMP_HOST_MEMBERSHIP_QUERY : ICMPV6_MGM_QUERY);
+  if (!query && !reporter)
+    return 0; /* OS reports do not identify an over-air station owner. */
+
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  if (!core->mcast.accepting || !wave_mc_native_sync_locked(native) ||
+      (reporter && reporter->info.mc_retiring)) {
+    result = -ESHUTDOWN;
+    goto out;
+  }
+  wave_mc_policy_activate(native->policy, packet.key.vlan, packet.key.proto, jiffies);
+  if (query) {
+    unsigned int v3 = size == 4 ? 12 : 28;
+    unsigned int interval;
+
+    key = packet.key;
+    memset(&key.group, 0, sizeof(key.group));
+    memcpy(&key.group, body + (size == 4 ? 4 : 8), size);
+    if (size == 4) {
+      interval = packet.length == 8 ? body[1] : wave_mc_decode8(body[1]);
+      maxresp = packet.length == 8 && !interval ? 10 * HZ :
+                max_t(unsigned long, 1, msecs_to_jiffies(interval * 100));
+    } else {
+      interval = get_unaligned_be16(body + 4);
+      if (packet.length >= v3)
+        interval = wave_mc_decode16(interval);
+      maxresp = msecs_to_jiffies(interval);
+    }
+    if (packet.length >= v3) {
+      qrv = body[v3 - 4] & 7;
+      suppress = !!(body[v3 - 4] & 8);
+      qqi = (unsigned long)wave_mc_decode8(body[v3 - 3]) * HZ;
+      nsrc = get_unaligned_be16(body + v3 - 2);
+      sources = body + v3;
+    }
+    result = wave_mc_policy_query(native->policy, &key, &packet.source,
+                                  sources, nsrc, qrv, qqi, maxresp, suppress, jiffies);
+    goto out;
+  }
+
+  if (packet.type != (size == 4 ? IGMPV3_HOST_MEMBERSHIP_REPORT : ICMPV6_MLD2_REPORT)) {
+    u8 type = (packet.type == IGMP_HOST_LEAVE_MESSAGE || packet.type == ICMPV6_MGM_REDUCTION) ?
+              WAVE_MC_ASM_LEAVE : WAVE_MC_ASM_JOIN;
+
+    key = packet.key;
+    memset(&key.group, 0, sizeof(key.group));
+    memcpy(&key.group, body + (size == 4 ? 4 : 8), size);
+    result = wave_mc_policy_report(native->policy, &key, reporter, packet.reporter,
+                                   type, NULL, 0, jiffies);
+    if (result)
+      wave_mc_policy_drop_reporter(native->policy, &key, reporter, packet.reporter);
+    goto out;
+  }
+
+  count = get_unaligned_be16(body + 6);
+  base = size == 4 ? 8 : 20;
+  offset = 8;
+  for (i = 0; i < count; i++) {
+    u8 type = body[offset];
+
+    nsrc = get_unaligned_be16(body + offset + 2);
+    key = packet.key;
+    memset(&key.group, 0, sizeof(key.group));
+    memcpy(&key.group, body + offset + 4, size);
+    if (type >= WAVE_MC_IS_INCLUDE && type <= WAVE_MC_BLOCK) {
+      error = wave_mc_policy_report(native->policy, &key, reporter, packet.reporter,
+                                    type, body + offset + base, nsrc, jiffies);
+      if (error) {
+        wave_mc_policy_drop_reporter(native->policy, &key, reporter, packet.reporter);
+        result = error;
+      }
+    }
+    offset += base + nsrc * size + body[offset + 1] * 4;
+  }
+out:
+  wave_mc_native_wake(native);
+  mtlk_osal_lock_release(&core->mcast.lock);
+  return result;
+}
+
+static bool wave_mc_packet_exempt(mtlk_core_t *core, struct sk_buff *skb,
+                                  const struct wave_mc_packet *packet)
+{
+  mtlk_dlist_entry_t *entry, *head;
+  bool exempt = packet->exempt;
+
+  if (packet->control && wave_mc_validate_control(packet, skb->data + packet->offset))
+    return false;
+  if (exempt)
+    return true;
+  /* Explicit configured flood ranges retain their existing group policy.
+   * Exhaustion or incomplete firmware admission never reaches this branch.
+   */
+  mtlk_osal_lock_acquire(&core->mcast.lock_ranges);
+  if (packet->key.proto == htons(ETH_P_IP)) {
+    struct in_addr group = { .s_addr = ntohl(packet->key.group.ip4) };
+
+    mtlk_dlist_foreach(&core->mcast.ip4_ranges_list, entry, head) {
+      mcast_ip4_range *range = MTLK_LIST_GET_CONTAINING_RECORD(entry, mcast_ip4_range, list_entry);
+
+      if (!mtlk_osal_ipv4_masked_addr_cmp(&range->ip4_addr, &range->ip4_mask, &group)) {
+        exempt = true;
+        break;
+      }
+    }
+  } else if (packet->key.proto == htons(ETH_P_IPV6)) {
+    mtlk_dlist_foreach(&core->mcast.ip6_ranges_list, entry, head) {
+      mcast_ip6_range *range = MTLK_LIST_GET_CONTAINING_RECORD(entry, mcast_ip6_range, list_entry);
+
+      if (!mtlk_osal_ipv6_masked_addr_cmp(&range->ip6_addr, &range->ip6_mask,
+                                        &packet->key.group.ip6)) {
+        exempt = true;
+        break;
+      }
+    }
+  }
+  mtlk_osal_lock_release(&core->mcast.lock_ranges);
+  return exempt;
+}
+
+static bool wave_mc_ether_broadcast(struct sk_buff *skb)
+{
+  struct ethhdr buffer;
+  const struct ethhdr *eth = skb_header_pointer(skb, 0, sizeof(buffer), &buffer);
+
+  return eth && is_broadcast_ether_addr(eth->h_dest);
+}
+
+static void wave_mc_retire_oldest(struct wave_mc_native *native,
+                                  const struct wave_mc_native_class *except)
+{
+  struct wave_mc_native_class *class, *oldest = NULL;
+
+  list_for_each_entry(class, &native->classes, node) {
+    if (class == except || class->retiring || class->id == MCAST_GROUP_UNDEF)
+      continue;
+    if (!oldest || time_before(class->last_used, oldest->last_used))
+      oldest = class;
+  }
+  if (oldest)
+    oldest->retiring = true;
+  wave_mc_native_wake(native);
+}
+
+int wave_mc_native_grid(mtlk_core_t *core, struct sk_buff *skb, bool pin, sta_entry *source)
+{
+  struct wave_mc_native *native = core->mcast.native;
+  struct wave_mc_native_class *class;
+  struct wave_mc_packet packet;
+  struct wave_mc_targets targets = { .source = source };
+  u64 generation;
+  int error, result = MCAST_GROUP_UNDEF;
+  unsigned int mode;
+  bool changed = false;
+
+  if (!native || !wave_mc_native_needed(core))
+    return result;
+  error = wave_mc_packet(skb, &packet);
+  if (error)
+    return error == -EAFNOSUPPORT && wave_mc_ether_broadcast(skb) ? MCAST_GROUP_BROADCAST : result;
+  if (packet.control && wave_mc_validate_control(&packet, skb->data + packet.offset))
+    return result;
+  if (wave_mc_packet_exempt(core, skb, &packet))
+    return MCAST_GROUP_BROADCAST;
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  if (!core->mcast.accepting || !wave_mc_native_sync_locked(native))
+    goto out;
+  mode = MTLK_CORE_PDB_GET_INT(core, PARAM_DB_CORE_RELIABLE_MCAST);
+  if (mode != ENABLE_RELIABLE_MULTICAST && mode != DISABLE_RELIABLE_MULTICAST)
+    goto out;
+  if (wave_mc_policy_activate(native->policy, packet.key.vlan, packet.key.proto, jiffies) > 0)
+    changed = true;
+  wave_mc_policy_expire(native->policy, jiffies);
+  generation = wave_mc_policy_generation(native->policy);
+  if (mode == ENABLE_RELIABLE_MULTICAST) {
+    list_for_each_entry(class, &native->classes, node) {
+      if (source || class->excluded_source || class->retiring || class->generation != generation ||
+          !wave_mc_key_equal(&class->key, &packet.key) ||
+          !wave_mc_ip_equal(packet.key.proto, &class->last_source, &packet.source))
+        continue;
+      if (!wave_mc_class_current(class)) {
+        class->retiring = true;
+        changed = true;
+        continue;
+      }
+      class->last_used = jiffies;
+      if (wave_mc_class_ready(class) &&
+          wave_hw_mc_get(mtlk_vap_get_hw(core->vap_handle), class->id, pin))
+        result = class->id;
+      goto out;
+    }
+  }
+  wave_mc_policy_foreach_receiver(native->policy, &packet.key, &packet.source,
+                                  jiffies, wave_mc_target, &targets);
+  if (bitmap_empty(targets.bits, WAVE_MC_SIDS))
+    goto out;
+  if (mode == DISABLE_RELIABLE_MULTICAST) {
+    /* The administrator chose one aggregate air frame. Apply the group/source
+     * union, without claiming per-station enforcement or converting its DA.
+     */
+    result = MCAST_GROUP_BROADCAST;
+    goto out;
+  }
+  list_for_each_entry(class, &native->classes, node) {
+    if (class->retiring || !wave_mc_key_equal(&class->key, &packet.key) ||
+        !bitmap_equal(class->receivers, targets.bits, WAVE_MC_SIDS))
+      continue;
+    if (!wave_mc_class_current(class)) {
+      class->retiring = true;
+      changed = true;
+      continue;
+    }
+    class->last_source = packet.source;
+    class->excluded_source = !!source;
+    class->generation = generation;
+    class->last_used = jiffies;
+    if (wave_mc_class_ready(class) &&
+        wave_hw_mc_get(mtlk_vap_get_hw(core->vap_handle), class->id, pin))
+      result = class->id;
+    goto out;
+  }
+  if (native->count >= MC_GROUPS - MC_MIN_GROUP) {
+    wave_mc_retire_oldest(native, NULL);
+    goto out;
+  }
+  class = kzalloc(sizeof(*class), GFP_ATOMIC);
+  if (!class)
+    goto out;
+  bitmap_zero(targets.bits, WAVE_MC_SIDS);
+  targets.allocate = true;
+  wave_mc_policy_foreach_receiver(native->policy, &packet.key, &packet.source,
+                                  jiffies, wave_mc_target, &targets);
+  if (targets.failed) {
+    wave_mc_members_free(targets.members);
+    kfree(class);
+    goto out;
+  }
+  class->owner = native;
+  class->key = packet.key;
+  class->last_source = packet.source;
+  class->excluded_source = !!source;
+  class->generation = generation;
+  bitmap_copy(class->receivers, targets.bits, WAVE_MC_SIDS);
+  class->members = targets.members;
+  class->id = MCAST_GROUP_UNDEF;
+  class->last_used = jiffies;
+  list_add_tail(&class->node, &native->classes);
+  native->count++;
+  changed = true;
+out:
+  if (changed)
+    wave_mc_native_wake(native);
+  mtlk_osal_lock_release(&core->mcast.lock);
+  return result;
+}
+
+bool wave_mc_native_receiver(mtlk_core_t *core, struct sk_buff *skb, const sta_entry *sta)
+{
+  struct wave_mc_packet packet;
+  struct wave_mc_targets targets = { .wanted = sta };
+  int error;
+
+  if (!wave_mc_native_needed(core))
+    return false;
+  error = wave_mc_packet(skb, &packet);
+  if (error)
+    return error == -EAFNOSUPPORT && wave_mc_ether_broadcast(skb);
+  if (packet.control && wave_mc_validate_control(&packet, skb->data + packet.offset))
+    return false;
+  if (wave_mc_packet_exempt(core, skb, &packet))
+    return true;
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  if (core->mcast.accepting && wave_mc_native_sync_locked(core->mcast.native)) {
+    if (wave_mc_policy_activate(core->mcast.native->policy, packet.key.vlan, packet.key.proto, jiffies) > 0)
+      wave_mc_native_wake(core->mcast.native);
+    wave_mc_policy_foreach_receiver(core->mcast.native->policy, &packet.key, &packet.source,
+                                    jiffies, wave_mc_target, &targets);
+  }
+  mtlk_osal_lock_release(&core->mcast.lock);
+  return targets.found;
+}
+
+
+/* Mode changes are event-driven. The module notifier is registered before PCI
+ * probe and unregistered after every device is gone, avoiding RTNL acquisition
+ * from a radio serializer whose cfg80211 caller may already own RTNL.
+ */
+static LIST_HEAD(wave_mc_native_devices);
+static DEFINE_SPINLOCK(wave_mc_native_devices_lock);
+
+static void wave_mc_native_reset_locked(struct wave_mc_native *native)
+{
+  struct wave_mc_native_class *class;
+
+  list_for_each_entry(class, &native->classes, node)
+    class->retiring = true;
+  wave_mc_policy_clear(native->policy);
+  native->standalone = false;
+  native->reset_pending = false;
+  native->epoch++;
+}
+
+static bool wave_mc_native_sync_locked(struct wave_mc_native *native)
+{
+  bool needed;
+
+  if (native->reset_pending)
+    wave_mc_native_reset_locked(native);
+  /* A master tick settles the upper-change notification under RTNL. RX/TX
+   * cannot adopt an intermediate bridge state or a rejected attach attempt. */
+  if (native->bridge_pending)
+    return false;
+  needed = wave_mc_native_needed(native->core);
+  if (!needed) {
+    if (native->standalone)
+      wave_mc_native_reset_locked(native);
+    return false;
+  }
+  if (!native->standalone) {
+    int v4, v6;
+
+    v4 = wave_mc_policy_activate(native->policy, 0, htons(ETH_P_IP), jiffies);
+    v6 = wave_mc_policy_activate(native->policy, 0, htons(ETH_P_IPV6), jiffies);
+    if (v4 < 0 || v6 < 0)
+      return false;
+    native->standalone = true;
+    wave_mc_native_wake(native);
+  }
+  return true;
+}
+
+static int wave_mc_native_netdev_event(struct notifier_block *block,
+                                       unsigned long event, void *ptr)
+{
+  struct netdev_notifier_changeupper_info *info = ptr;
+  struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+  struct wave_mc_native *native;
+
+  MTLK_UNREFERENCED_PARAM(block);
+  if (event != NETDEV_CHANGEUPPER || !netif_is_bridge_master(info->upper_dev))
+    return NOTIFY_DONE;
+  spin_lock_bh(&wave_mc_native_devices_lock);
+  list_for_each_entry(native, &wave_mc_native_devices, devices) {
+    if (READ_ONCE(native->netdev) != dev)
+      continue;
+    mtlk_osal_lock_acquire(&native->core->mcast.lock);
+    native->reset_pending = true;
+    native->bridge_pending = true;
+    wave_mc_native_wake(native);
+    mtlk_osal_lock_release(&native->core->mcast.lock);
+  }
+  spin_unlock_bh(&wave_mc_native_devices_lock);
+  return NOTIFY_DONE;
+}
+
+static struct notifier_block wave_mc_native_notifier = {
+  .notifier_call = wave_mc_native_netdev_event,
+};
+
+int wave_mc_native_module_init(void)
+{
+  return register_netdevice_notifier(&wave_mc_native_notifier);
+}
+
+void wave_mc_native_module_exit(void)
+{
+  unregister_netdevice_notifier(&wave_mc_native_notifier);
+}
+
+struct wave_mc_query_tx {
+  struct list_head node;
+  struct sk_buff *skb;
+  mtlk_hw_msg_t *msg;
+  u64 epoch;
+};
+
+struct wave_mc_query_queue {
+  struct list_head packets;
+  struct wave_mc_native *native;
+};
+
+static u8 wave_mc_encode8(unsigned long value)
+{
+  unsigned int code;
+
+  for (code = 0; code < U8_MAX; code++)
+    if (wave_mc_decode8(code) >= value)
+      return code;
+  return U8_MAX;
+}
+
+static u16 wave_mc_encode16(unsigned long value)
+{
+  unsigned int exponent, mantissa;
+
+  if (value < 32768)
+    return value;
+  for (exponent = 0; exponent < 8; exponent++) {
+    mantissa = DIV_ROUND_UP(value, 1UL << (exponent + 3));
+    if (mantissa <= 8191)
+      return 0x8000 | (exponent << 12) | (mantissa & 4095);
+  }
+  return U16_MAX;
+}
+
+/* The bounded queue owns both packet and a reserved TX descriptor. Nothing is
+ * transmitted while policy's lock is held. Only this explicit query path can
+ * bypass native recipient filtering; received/OS packets cannot set the flag.
+ */
+static int wave_mc_query_emit(void *ctx, const struct wave_mc_key *key,
+                              const void *sources, unsigned int nsrc, u8 qrv,
+                              unsigned long qqi, unsigned long maxresp, bool suppress)
+{
+  struct wave_mc_query_queue *queue = ctx;
+  struct wave_mc_native *native = queue->native;
+  mtlk_core_t *core = native->core;
+  struct net_device *dev = native->netdev;
+  struct wave_mc_query_tx *packet;
+  struct sk_buff *skb;
+  struct ethhdr *eth;
+  unsigned int size = key->proto == htons(ETH_P_IP) ? 4 : 16;
+  unsigned int depth = key->vlan & 3, l2 = ETH_HLEN + depth * VLAN_HLEN;
+  unsigned int query_len = (size == 4 ? 12 : 28) + nsrc * size;
+  unsigned int ip_len = (size == 4 ? 24 : 48) + query_len;
+  unsigned int index;
+  union wave_mc_ip dest = key->group;
+  struct in6_addr local6;
+  __be16 *eth_proto;
+  u8 *query, *cursor;
+  int error;
+
+  if (!core->mcast.accepting || !native->standalone || native->reset_pending ||
+      !wave_mc_native_needed(core) || nsrc > WAVE_MC_QUERY_SOURCES || depth > 2)
+    return -ESHUTDOWN;
+  if (size == 4) {
+    if (!dest.ip4)
+      dest.ip4 = htonl(INADDR_ALLHOSTS_GROUP);
+  } else {
+    if (ipv6_addr_any(&dest.ip6))
+      dest.ip6 = in6addr_linklocal_allnodes;
+    /* Query source is always link-local, even for a global/site-scope group.
+     * ipv6_get_lladdr is not exported; link-local destination selection uses
+     * the exported address owner and its normal usability checks.
+     */
+    error = ipv6_dev_get_saddr(dev_net(dev), dev, &in6addr_linklocal_allnodes, 0, &local6);
+    if (error || !(ipv6_addr_type(&local6) & IPV6_ADDR_LINKLOCAL))
+      return -EADDRNOTAVAIL;
+  }
+  packet = kzalloc(sizeof(*packet), GFP_ATOMIC);
+  if (!packet)
+    return -ENOMEM;
+  skb = mtlk_df_nbuf_alloc(l2 + ip_len + NET_IP_ALIGN);
+  if (!skb) {
+    kfree(packet);
+    return -ENOMEM;
+  }
+  skb_reserve(skb, NET_IP_ALIGN);
+  skb_put_zero(skb, l2 + ip_len);
+  skb->dev = dev;
+  eth = (struct ethhdr *)skb->data;
+  ether_addr_copy(eth->h_source, dev->dev_addr);
+  if (size == 4)
+    ip_eth_mc_map(dest.ip4, eth->h_dest);
+  else
+    ipv6_eth_mc_map(&dest.ip6, eth->h_dest);
+  eth_proto = &eth->h_proto;
+  cursor = skb->data + ETH_HLEN;
+  for (index = 0; index < depth; index++) {
+    struct vlan_hdr *tag = (struct vlan_hdr *)cursor;
+
+    *eth_proto = htons(key->vlan & BIT(26 + index) ? ETH_P_8021AD : ETH_P_8021Q);
+    tag->h_vlan_TCI = htons((key->vlan >> (2 + index * 12)) & VLAN_VID_MASK);
+    eth_proto = &tag->h_vlan_encapsulated_proto;
+    cursor += VLAN_HLEN;
+  }
+  *eth_proto = key->proto;
+  skb->protocol = eth->h_proto;
+  skb_reset_mac_header(skb);
+  skb_set_network_header(skb, l2);
+  if (size == 4) {
+    struct iphdr *ip = (struct iphdr *)cursor;
+    u8 *options = cursor + sizeof(*ip);
+
+    ip->version = 4;
+    ip->ihl = 6;
+    ip->tos = 0xc0;
+    ip->tot_len = htons(ip_len);
+    ip->ttl = 1;
+    ip->protocol = IPPROTO_IGMP;
+    /* As with the bridge's default querier, zero is deliberately subordinate
+     * to a configured external router and needs no invented interface address.
+     */
+    ip->saddr = 0;
+    ip->daddr = dest.ip4;
+    options[0] = IPOPT_RA;
+    options[1] = 4;
+    ip_send_check(ip);
+    query = cursor + 24;
+    query[0] = IGMP_HOST_MEMBERSHIP_QUERY;
+    query[1] = wave_mc_encode8(DIV_ROUND_UP(jiffies_to_msecs(maxresp), 100));
+    memcpy(query + 4, &key->group.ip4, 4);
+    query[8] = (qrv & 7) | (suppress ? 8 : 0);
+    query[9] = wave_mc_encode8(DIV_ROUND_UP(qqi, HZ));
+    put_unaligned_be16(nsrc, query + 10);
+    if (nsrc)
+      memcpy(query + 12, sources, nsrc * 4);
+    put_unaligned(csum_fold(csum_partial(query, query_len, 0)), (__sum16 *)(query + 2));
+  } else {
+    struct ipv6hdr *ip = (struct ipv6hdr *)cursor;
+    u8 *hop = cursor + sizeof(*ip);
+
+    ip->version = 6;
+    ip->payload_len = htons(ip_len - sizeof(*ip));
+    ip->nexthdr = IPPROTO_HOPOPTS;
+    ip->hop_limit = 1;
+    ip->saddr = local6;
+    ip->daddr = dest.ip6;
+    hop[0] = IPPROTO_ICMPV6;
+    hop[2] = IPV6_TLV_ROUTERALERT;
+    hop[3] = 2;
+    hop[6] = IPV6_TLV_PADN;
+    query = hop + 8;
+    query[0] = ICMPV6_MGM_QUERY;
+    put_unaligned_be16(wave_mc_encode16(jiffies_to_msecs(maxresp)), query + 4);
+    memcpy(query + 8, &key->group.ip6, 16);
+    query[24] = (qrv & 7) | (suppress ? 8 : 0);
+    query[25] = wave_mc_encode8(DIV_ROUND_UP(qqi, HZ));
+    put_unaligned_be16(nsrc, query + 26);
+    if (nsrc)
+      memcpy(query + 28, sources, nsrc * 16);
+    put_unaligned(csum_ipv6_magic(&ip->saddr, &ip->daddr, query_len, IPPROTO_ICMPV6,
+                                  csum_partial(query, query_len, 0)), (__sum16 *)(query + 2));
+  }
+  packet->msg = mtlk_hw_get_msg_to_send(mtlk_vap_get_hwapi(core->vap_handle),
+                                      core->vap_handle, &error);
+  if (!packet->msg) {
+    mtlk_df_nbuf_free(skb);
+    kfree(packet);
+    return -ENOBUFS;
+  }
+  packet->skb = skb;
+  packet->epoch = native->epoch;
+  list_add_tail(&packet->node, &queue->packets);
+  return 0;
+}
+
+static void wave_mc_queries_send(struct wave_mc_query_queue *queue)
+{
+  struct wave_mc_native *native = queue->native;
+  mtlk_core_t *core = native->core;
+  struct wave_mc_query_tx *packet, *next;
+
+  list_for_each_entry_safe(packet, next, &queue->packets, node) {
+    mtlk_core_handle_tx_data_t data = {
+      .nbuf = packet->skb,
+      .msg = packet->msg,
+      .native_control = true,
+    };
+    bool live;
+
+    mtlk_osal_lock_acquire(&core->mcast.lock);
+    live = core->mcast.accepting && native->standalone && !native->reset_pending &&
+           packet->epoch == native->epoch && wave_mc_native_needed(core) &&
+           wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle));
+    mtlk_osal_lock_release(&core->mcast.lock);
+    if (live)
+      mtlk_mc_transmit(core, &data, MTLK_NBUFF_MULTICAST,
+                       MTLK_CORE_HOT_PATH_PDB_GET_INT(core, CORE_DB_CORE_BRIDGE_MODE), NULL);
+    else
+      mtlk_df_nbuf_free(data.nbuf);
+    /* A complete all-four-address snapshot can consume only cloned packets. */
+    if (data.msg)
+      mtlk_hw_release_msg_to_send(mtlk_vap_get_hwapi(core->vap_handle), data.msg);
+    list_del(&packet->node);
+    kfree(packet);
+  }
+}
+
+static void wave_mc_classes_update_locked(struct wave_mc_native *native)
+{
+  struct wave_mc_native_class *class, *next;
+  mtlk_core_t *core = native->core;
+
+  list_for_each_entry_safe(class, next, &native->classes, node) {
+    struct wave_mc_native_member *member;
+    bool applied = false;
+
+    if (!native->standalone || !wave_mc_class_current(class) ||
+        time_after_eq(jiffies, class->last_used + WAVE_MC_IDLE))
+      class->retiring = true;
+    if (class->retiring) {
+      for (member = class->members; member; member = member->next) {
+        if (class->id == MCAST_GROUP_UNDEF ||
+            !(member->sta->info.mc_memberships & BIT(class->id)))
+          continue;
+        applied = true;
+        if (member->status == MCAST_STA_STATUS_NONE && !member->sta->info.mc_retiring)
+          mtlk_mc_queue_native_locked(core, MTLK_MC_STA_LEAVE_GROUP,
+                                      class->id, member->sta, class);
+      }
+      if (!class->pending && !applied)
+        wave_mc_class_free(class);
+      continue;
+    }
+    if (class->id == MCAST_GROUP_UNDEF) {
+      class->id = wave_hw_mc_alloc_native(mtlk_vap_get_hw(core->vap_handle));
+      if (class->id == MCAST_GROUP_UNDEF) {
+        wave_mc_retire_oldest(native, class);
+        continue;
+      }
+    }
+    for (member = class->members; member; member = member->next) {
+      if (member->status != MCAST_STA_STATUS_NONE ||
+          (member->sta->info.mc_memberships & BIT(class->id)))
+        continue;
+      mtlk_mc_queue_native_locked(core, MTLK_MC_STA_JOIN_GROUP,
+                                  class->id, member->sta, class);
+    }
+  }
+}
+
+static void wave_mc_native_arm_locked(struct wave_mc_native *native)
+{
+  struct wave_mc_native_class *class;
+  unsigned long deadline = 0, candidate;
+  bool have = false;
+
+  if (!native->core->mcast.accepting ||
+      !wave_hw_mmb_ready(mtlk_vap_get_hw(native->core->vap_handle)))
+    return;
+  if (native->reset_pending || native->bridge_pending ||
+      (!native->standalone && wave_mc_native_needed(native->core))) {
+    deadline = jiffies + WAVE_MC_RETRY;
+    have = true;
+  }
+  if (native->standalone && wave_mc_policy_next_deadline(native->policy, &candidate)) {
+    if (!have || time_before(candidate, deadline))
+      deadline = candidate;
+    have = true;
+  }
+  list_for_each_entry(class, &native->classes, node) {
+    if (class->pending)
+      continue; /* Command completion supplies the next wakeup. */
+    candidate = wave_mc_class_ready(class) ? class->last_used + WAVE_MC_IDLE :
+                                            jiffies + WAVE_MC_RETRY;
+    if (!have || time_before(candidate, deadline))
+      deadline = candidate;
+    have = true;
+  }
+  if (have)
+    mod_timer(&native->timer, time_after(deadline, jiffies) ? deadline : jiffies + 1);
+}
+
+static void wave_mc_native_tick(mtlk_handle_t handle)
+{
+  struct wave_mc_native *native = HANDLE_T_PTR(struct wave_mc_native, handle);
+  struct wave_mc_query_queue queue = { .native = native };
+  mtlk_core_t *core = native->core;
+
+  INIT_LIST_HEAD(&queue.packets);
+  /* cfg80211 may hold RTNL while waiting for this serializer: never wait for
+   * it here. A later tick observes the settled bridge state, including a link
+   * rejected by another notifier. Detach notifies before clearing its flag.
+   */
+  if (READ_ONCE(native->bridge_pending) && rtnl_trylock()) {
+    mtlk_osal_lock_acquire(&core->mcast.lock);
+    native->bridge_pending = false;
+    wave_mc_native_sync_locked(native);
+    mtlk_osal_lock_release(&core->mcast.lock);
+    rtnl_unlock();
+  }
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  if (!native->tick.is_cancelled && core->mcast.accepting &&
+      wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle))) {
+    if (wave_mc_native_sync_locked(native)) {
+      wave_mc_policy_expire(native->policy, jiffies);
+      wave_mc_policy_drain_queries(native->policy, jiffies, WAVE_MC_QUERY_BUDGET,
+                                    wave_mc_query_emit, &queue);
+    }
+    wave_mc_classes_update_locked(native);
+  }
+  mtlk_osal_lock_release(&core->mcast.lock);
+  wave_mc_queries_send(&queue);
+}
+
+static void wave_mc_native_tick_done(serializer_result_t result,
+                                     mtlk_command_t *command, mtlk_handle_t handle)
+{
+  struct wave_mc_native *native = HANDLE_T_PTR(struct wave_mc_native, handle);
+
+  MTLK_UNREFERENCED_PARAM(result);
+  mtlk_command_cleanup(command);
+  mtlk_osal_lock_acquire(&native->core->mcast.lock);
+  native->tick_pending = false;
+  wave_mc_native_arm_locked(native);
+  mtlk_osal_lock_release(&native->core->mcast.lock);
+}
+
+static void wave_mc_native_timer(struct timer_list *timer)
+{
+  struct wave_mc_native *native = timer_container_of(native, timer, timer);
+  mtlk_core_t *core = native->core;
+  mtlk_core_t *master;
+  int error;
+
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  if (!core->mcast.accepting || native->tick_pending)
+    goto out;
+  error = mtlk_command_init(&native->tick, wave_mc_native_tick, HANDLE_T(native), MTLK_SLID);
+  if (error != MTLK_ERR_OK) {
+    mod_timer(&native->timer, jiffies + WAVE_MC_RETRY);
+    goto out;
+  }
+  native->tick_pending = true;
+  master = mtlk_vap_manager_get_master_core(mtlk_vap_get_manager(core->vap_handle));
+  error = mtlk_core_schedule_hw_command(master, &native->tick,
+                                        wave_mc_native_tick_done, HANDLE_T(native));
+  if (error != MTLK_ERR_OK) {
+    mtlk_command_cleanup(&native->tick);
+    native->tick_pending = false;
+    mod_timer(&native->timer, jiffies + WAVE_MC_RETRY);
+  }
+out:
+  mtlk_osal_lock_release(&core->mcast.lock);
+}
+
+int wave_mc_native_init(mtlk_core_t *core)
+{
+#if !MTLK_USE_DIRECTCONNECT_DP_API && !MTLK_USE_PUMA6_UDMA
+  struct wave_mc_native *native;
+
+  if (!mtlk_vap_is_ap(core->vap_handle))
+    return MTLK_ERR_OK;
+  native = kzalloc(sizeof(*native), GFP_KERNEL);
+  if (!native)
+    return MTLK_ERR_NO_MEM;
+  native->policy = wave_mc_policy_create(GFP_KERNEL);
+  if (!native->policy) {
+    kfree(native);
+    return MTLK_ERR_NO_MEM;
+  }
+  native->core = core;
+  INIT_LIST_HEAD(&native->classes);
+  timer_setup(&native->timer, wave_mc_native_timer, 0);
+  core->mcast.native = native;
+  spin_lock_bh(&wave_mc_native_devices_lock);
+  list_add_tail(&native->devices, &wave_mc_native_devices);
+  spin_unlock_bh(&wave_mc_native_devices_lock);
+#endif
+  return MTLK_ERR_OK;
+}
+
+void wave_mc_native_open_owned(mtlk_core_t *core)
+{
+  struct wave_mc_native *native = core->mcast.native;
+
+  if (!native)
+    return;
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  WRITE_ONCE(native->netdev, mtlk_df_user_get_ndev(
+    mtlk_df_get_user(mtlk_vap_get_df(core->vap_handle))));
+  native->reset_pending = true;
+  wave_mc_native_sync_locked(native);
+  wave_mc_native_wake(native);
+  mtlk_osal_lock_release(&core->mcast.lock);
+}
+
+void wave_mc_native_drop_sta(mtlk_core_t *core, sta_entry *sta)
+{
+  struct wave_mc_native *native = core->mcast.native;
+  struct wave_mc_native_class *class;
+
+  if (!native)
+    return;
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  wave_mc_policy_drop_sta(native->policy, sta);
+  list_for_each_entry(class, &native->classes, node) {
+    struct wave_mc_native_member *member;
+
+    for (member = class->members; member; member = member->next) {
+      if (member->sta == sta) {
+        class->retiring = true;
+        break;
+      }
+    }
+  }
+  wave_mc_native_wake(native);
+  mtlk_osal_lock_release(&core->mcast.lock);
+}
+
+void wave_mc_native_stop_owned(mtlk_core_t *core)
+{
+  struct wave_mc_native *native = core->mcast.native;
+  mtlk_core_t *master;
+  bool pending;
+
+  if (!native)
+    return;
+  /* accepting was closed before this join; timer and notifier cannot rearm. */
+  timer_delete_sync(&native->timer);
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  pending = native->tick_pending;
+  WRITE_ONCE(native->netdev, NULL);
+  mtlk_osal_lock_release(&core->mcast.lock);
+  if (pending) {
+    BOOL canceled;
+
+    master = mtlk_vap_manager_get_master_core(mtlk_vap_get_manager(core->vap_handle));
+    canceled = mtlk_serializer_cancel(&master->slow_ctx->serializer, &native->tick);
+    MTLK_ASSERT(canceled);
+  }
+}
+
+void wave_mc_native_clear_owned(mtlk_core_t *core)
+{
+  struct wave_mc_native *native = core->mcast.native;
+  struct wave_mc_native_class *class, *next;
+
+  if (!native)
+    return;
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  MTLK_ASSERT(!native->tick_pending);
+  list_for_each_entry_safe(class, next, &native->classes, node) {
+    struct wave_mc_native_member *member;
+
+    for (member = class->members; member; member = member->next)
+      MTLK_ASSERT(class->id == MCAST_GROUP_UNDEF ||
+                   !(member->sta->info.mc_memberships & BIT(class->id)));
+    wave_mc_class_free(class);
+  }
+  wave_mc_policy_clear(native->policy);
+  native->standalone = false;
+  native->reset_pending = false;
+  native->bridge_pending = false;
+  native->epoch++;
+  mtlk_osal_lock_release(&core->mcast.lock);
+}
+
+void wave_mc_native_destroy(mtlk_core_t *core)
+{
+  struct wave_mc_native *native = core->mcast.native;
+
+  if (!native)
+    return;
+  spin_lock_bh(&wave_mc_native_devices_lock);
+  list_del(&native->devices);
+  spin_unlock_bh(&wave_mc_native_devices_lock);
+  MTLK_ASSERT(!native->tick_pending && list_empty(&native->classes));
+  timer_delete_sync(&native->timer);
+  mtlk_osal_lock_acquire(&core->mcast.lock);
+  wave_mc_policy_destroy(native->policy);
+  core->mcast.native = NULL;
+  mtlk_osal_lock_release(&core->mcast.lock);
+  kfree(native);
+}
