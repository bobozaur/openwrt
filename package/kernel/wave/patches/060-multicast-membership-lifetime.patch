@@ -0,0 +1,1043 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Native reporter state follows the IGMPv3/MLDv2 transition tables used by
+ * net/bridge/br_multicast.c. Firmware group IDs and packet ownership remain
+ * outside this engine. EXCLUDE stores running X and blocked Y independently.
+ */
+#include "mtlkinc.h"
+#include "stadb.h"
+#include "wave_mc_policy.h"
+
+#include <linux/etherdevice.h>
+#include <linux/if_ether.h>
+#include <linux/jhash.h>
+#include <linux/jiffies.h>
+#include <linux/list.h>
+#include <linux/rbtree.h>
+#include <linux/slab.h>
+
+#define WAVE_MC_BUCKETS 32
+#define WAVE_MC_MAX_DOMAINS WAVE_MC_MAX_GROUPS
+#define WAVE_MC_DEFAULT_RV 2
+#define WAVE_MC_DEFAULT_QI (125 * HZ)
+#define WAVE_MC_DEFAULT_QRI (10 * HZ)
+#define WAVE_MC_LMI HZ
+
+enum wave_mc_mode { WAVE_MC_INCLUDE, WAVE_MC_EXCLUDE };
+
+struct wave_mc_source {
+  struct rb_node node;
+  union wave_mc_ip addr;
+  unsigned long expires;
+  unsigned long query_at;
+  u8 queries;
+  bool running;
+  bool query_started;
+};
+
+struct wave_mc_reporter {
+  struct list_head list;
+  struct _sta_entry *sta;
+  u8 mac[ETH_ALEN];
+  enum wave_mc_mode mode;
+  struct rb_root sources;
+  unsigned int nsrc;
+  unsigned long group_expires;
+  unsigned long group_query_at;
+  u8 group_queries;
+  bool group_query_started;
+};
+
+struct wave_mc_domain {
+  struct list_head list;
+  u32 vlan;
+  __be16 proto;
+  unsigned int groups;
+  unsigned long qi, qri;
+  unsigned long other_expires;
+  unsigned long activity_expires;
+  unsigned long general_at;
+  union wave_mc_ip querier_source;
+  u8 rv, startup_queries;
+  bool other_active;
+  bool activated;
+};
+
+struct wave_mc_group {
+  struct hlist_node hash;
+  struct list_head list;
+  struct list_head reporters;
+  struct wave_mc_key key;
+  struct wave_mc_domain *domain;
+};
+
+struct wave_mc_policy {
+  struct hlist_head hash[WAVE_MC_BUCKETS];
+  struct list_head groups;
+  struct list_head domains;
+  unsigned int ngroups, nreporters, nsrc, ndomains;
+  u64 generation;
+  unsigned long gc_at;
+  bool gc_pending;
+  bool specific_first;
+  u8 query_sources[WAVE_MC_QUERY_SOURCES * sizeof(struct in6_addr)];
+};
+
+static unsigned int mc_addr_size(__be16 proto)
+{
+  if (proto == htons(ETH_P_IP))
+    return sizeof(__be32);
+  if (proto == htons(ETH_P_IPV6))
+    return sizeof(struct in6_addr);
+  return 0;
+}
+
+static unsigned long mc_interval(unsigned long value)
+{
+  return min_t(unsigned long, max_t(unsigned long, value, 1), MAX_JIFFY_OFFSET);
+}
+
+static unsigned long mc_product(unsigned long value, unsigned int count)
+{
+  if (value > MAX_JIFFY_OFFSET / count)
+    return MAX_JIFFY_OFFSET;
+  return mc_interval(value * count);
+}
+
+static unsigned long mc_gmi(const struct wave_mc_domain *d)
+{
+  unsigned long interval = mc_product(d->qi, d->rv);
+
+  return interval > MAX_JIFFY_OFFSET - d->qri ? MAX_JIFFY_OFFSET : interval + d->qri;
+}
+
+static unsigned long mc_other_interval(const struct wave_mc_domain *d)
+{
+  unsigned long interval = mc_product(d->qi, d->rv);
+
+  return interval > MAX_JIFFY_OFFSET - d->qri / 2 ?
+         MAX_JIFFY_OFFSET : interval + d->qri / 2;
+}
+
+/* Packet lookups can expire state without walking every source on every frame.
+ * Deletion may leave an early deadline; that causes at most one extra sweep.
+ */
+static void mc_gc_note(struct wave_mc_policy *p, unsigned long when)
+{
+  if (!p->gc_pending || time_before(when, p->gc_at)) {
+    p->gc_at = when;
+    p->gc_pending = true;
+  }
+}
+
+/* Untagged interface domains live until clear. Tagged domains remain active
+ * while real observed traffic refreshes their membership interval.
+ */
+static void mc_domain_activity(struct wave_mc_policy *p,
+                                struct wave_mc_domain *d, unsigned long now)
+{
+  if (d->activated && d->vlan) {
+    d->activity_expires = now + mc_gmi(d);
+    mc_gc_note(p, d->activity_expires);
+  }
+}
+
+static bool mc_general(const struct wave_mc_key *key)
+{
+  static const union wave_mc_ip zero;
+
+  return !memcmp(&key->group, &zero, mc_addr_size(key->proto));
+}
+
+static unsigned int mc_hash(const struct wave_mc_key *key)
+{
+  return jhash(&key->group, mc_addr_size(key->proto),
+               key->vlan ^ (__force u16)key->proto) & (WAVE_MC_BUCKETS - 1);
+}
+
+static bool mc_key_equal(const struct wave_mc_key *a, const struct wave_mc_key *b)
+{
+  return a->vlan == b->vlan && a->proto == b->proto &&
+         !memcmp(&a->group, &b->group, mc_addr_size(a->proto));
+}
+
+static struct wave_mc_group *mc_group_find(struct wave_mc_policy *p,
+                                           const struct wave_mc_key *key)
+{
+  struct wave_mc_group *g;
+
+  hlist_for_each_entry(g, &p->hash[mc_hash(key)], hash)
+    if (mc_key_equal(&g->key, key))
+      return g;
+  return NULL;
+}
+
+static struct wave_mc_domain *mc_domain_find(struct wave_mc_policy *p,
+                                             const struct wave_mc_key *key)
+{
+  struct wave_mc_domain *d;
+
+  list_for_each_entry(d, &p->domains, list)
+    if (d->vlan == key->vlan && d->proto == key->proto)
+      return d;
+  return NULL;
+}
+
+static struct wave_mc_domain *mc_domain_new(const struct wave_mc_key *key,
+                                            unsigned long now)
+{
+  struct wave_mc_domain *d = kzalloc(sizeof(*d), GFP_ATOMIC);
+
+  if (!d)
+    return NULL;
+  d->vlan = key->vlan;
+  d->proto = key->proto;
+  d->rv = WAVE_MC_DEFAULT_RV;
+  d->qi = WAVE_MC_DEFAULT_QI;
+  d->qri = WAVE_MC_DEFAULT_QRI;
+  d->startup_queries = d->rv;
+  d->general_at = now;
+  return d;
+}
+
+static struct wave_mc_reporter *mc_reporter_find(struct wave_mc_group *g,
+                                                struct _sta_entry *sta,
+                                                const u8 reporter[ETH_ALEN])
+{
+  struct wave_mc_reporter *r;
+
+  if (!g)
+    return NULL;
+  list_for_each_entry(r, &g->reporters, list)
+    if (r->sta == sta && ether_addr_equal(r->mac, reporter))
+      return r;
+  return NULL;
+}
+
+static struct wave_mc_source *mc_source_find(const struct wave_mc_reporter *r,
+                                            const union wave_mc_ip *addr,
+                                            unsigned int size)
+{
+  struct rb_node *node = r->sources.rb_node;
+
+  while (node) {
+    struct wave_mc_source *s = rb_entry(node, struct wave_mc_source, node);
+    int cmp = memcmp(addr, &s->addr, size);
+
+    if (!cmp)
+      return s;
+    node = cmp < 0 ? node->rb_left : node->rb_right;
+  }
+  return NULL;
+}
+
+static int mc_source_add(struct wave_mc_reporter *r,
+                          const union wave_mc_ip *addr, unsigned int size,
+                          unsigned int limit, const struct wave_mc_source *copy,
+                          struct wave_mc_source **result)
+{
+  struct rb_node **link = &r->sources.rb_node, *parent = NULL;
+  struct wave_mc_source *s;
+
+  while (*link) {
+    int cmp;
+
+    parent = *link;
+    s = rb_entry(parent, struct wave_mc_source, node);
+    cmp = memcmp(addr, &s->addr, size);
+    if (!cmp) {
+      *result = s;
+      return 0;
+    }
+    link = cmp < 0 ? &parent->rb_left : &parent->rb_right;
+  }
+  if (r->nsrc == limit)
+    return -ENOSPC;
+  s = kzalloc(sizeof(*s), GFP_ATOMIC);
+  if (!s)
+    return -ENOMEM;
+  if (copy)
+    *s = *copy;
+  else
+    memcpy(&s->addr, addr, size);
+  rb_link_node(&s->node, parent, link);
+  rb_insert_color(&s->node, &r->sources);
+  r->nsrc++;
+  *result = s;
+  return 0;
+}
+
+static void mc_source_del(struct wave_mc_reporter *r, struct wave_mc_source *s)
+{
+  rb_erase(&s->node, &r->sources);
+  r->nsrc--;
+  kfree(s);
+}
+
+static void mc_reporter_free(struct wave_mc_reporter *r, bool referenced)
+{
+  struct rb_node *node;
+
+  while ((node = rb_first(&r->sources)))
+    mc_source_del(r, rb_entry(node, struct wave_mc_source, node));
+  if (referenced)
+    mtlk_sta_decref(r->sta);
+  kfree(r);
+}
+
+static void mc_reporter_del(struct wave_mc_policy *p, struct wave_mc_reporter *r)
+{
+  list_del(&r->list);
+  p->nreporters--;
+  p->nsrc -= r->nsrc;
+  mc_reporter_free(r, true);
+}
+
+static void mc_domain_unused(struct wave_mc_policy *p, struct wave_mc_domain *d)
+{
+  if (d->activated || d->groups || d->other_active)
+    return;
+  list_del(&d->list);
+  p->ndomains--;
+  kfree(d);
+}
+
+static void mc_group_del(struct wave_mc_policy *p, struct wave_mc_group *g)
+{
+  struct wave_mc_domain *d = g->domain;
+
+  hlist_del(&g->hash);
+  list_del(&g->list);
+  d->groups--;
+  p->ngroups--;
+  kfree(g);
+  mc_domain_unused(p, d);
+}
+
+static void mc_refresh(struct wave_mc_source *s, unsigned long expires)
+{
+  s->running = true;
+  s->expires = expires;
+  s->queries = 0;
+  s->query_started = false;
+}
+
+static void mc_source_query(struct wave_mc_source *s,
+                             const struct wave_mc_domain *d, unsigned long now)
+{
+  if (!s->running || s->queries)
+    return;
+  s->queries = d->rv;
+  s->query_at = now;
+  s->query_started = false;
+}
+
+static void mc_group_query(struct wave_mc_reporter *r,
+                            const struct wave_mc_domain *d, unsigned long now)
+{
+  if (r->mode != WAVE_MC_EXCLUDE || r->group_queries)
+    return;
+  r->group_queries = d->rv;
+  r->group_query_at = now;
+  r->group_query_started = false;
+}
+
+/* A new reporter is built in isolation. Even ENOSPC in the last source leaves
+ * the live record and its query work unchanged. No station reference transfers
+ * until the complete replacement is published under the caller's lock.
+ *
+ * With + = union, * = intersection, and - = difference, the bridge RFC tables
+ * are applied to INCLUDE(A) or EXCLUDE(X,Y), where X runs timers and Y blocks:
+ * IS_IN/ALLOW(B): A+B, or (X+B,Y-B); refresh B to GMI.
+ * IS_EX(B): (A*B,B-A), or (B-Y,Y*B); refresh only new EXCLUDE sources to GMI.
+ * TO_IN(B): A+B, or (X+B,Y-B); query old running sources outside B, plus G in EX.
+ * TO_EX(B): as IS_EX, but new EX sources inherit the old group timer; query X.
+ * BLOCK(B): query A*B, or retain (X+(B-Y),Y) and query B-Y.
+ * EX records refresh the group timer. Query-driven timer reductions happen
+ * when the corresponding query is accepted, not while building this record.
+ */
+static int mc_build_reporter(const struct wave_mc_reporter *old,
+                              const struct wave_mc_domain *d, u8 type,
+                              const void *sources, unsigned int nsrc,
+                              unsigned int limit, unsigned long now,
+                              struct wave_mc_reporter **result)
+{
+  struct wave_mc_reporter *r;
+  enum wave_mc_mode mode = old ? old->mode : WAVE_MC_INCLUDE;
+  unsigned int size = mc_addr_size(d->proto), i;
+  bool replace = type == WAVE_MC_IS_EXCLUDE || type == WAVE_MC_TO_EXCLUDE;
+  struct wave_mc_source *s;
+  struct rb_node *node;
+  int err;
+
+  r = kzalloc(sizeof(*r), GFP_ATOMIC);
+  if (!r)
+    return -ENOMEM;
+  r->sources = RB_ROOT;
+  r->mode = mode;
+  if (old) {
+    r->group_expires = old->group_expires;
+    r->group_queries = old->group_queries;
+    r->group_query_at = old->group_query_at;
+    r->group_query_started = old->group_query_started;
+  }
+  if (type == WAVE_MC_ASM_JOIN) {
+    r->mode = WAVE_MC_EXCLUDE;
+    r->group_expires = now + mc_gmi(d);
+    r->group_queries = 0;
+    goto done;
+  }
+  if (!replace && old) {
+    for (node = rb_first(&old->sources); node; node = rb_next(node)) {
+      const struct wave_mc_source *prev = rb_entry(node, struct wave_mc_source, node);
+
+      err = mc_source_add(r, &prev->addr, size, limit, prev, &s);
+      if (err)
+        goto fail;
+      if (type == WAVE_MC_TO_INCLUDE || type == WAVE_MC_ASM_LEAVE)
+        mc_source_query(s, d, now);
+    }
+  }
+  for (i = 0; i < nsrc; i++) {
+    union wave_mc_ip addr = {};
+    const struct wave_mc_source *prev;
+
+    memcpy(&addr, (const u8 *)sources + i * size, size);
+    prev = old ? mc_source_find(old, &addr, size) : NULL;
+    if (type == WAVE_MC_BLOCK && mode == WAVE_MC_INCLUDE) {
+      s = mc_source_find(r, &addr, size);
+      if (s)
+        mc_source_query(s, d, now);
+      continue;
+    }
+    s = mc_source_find(r, &addr, size);
+    if (!s) {
+      err = mc_source_add(r, &addr, size, limit, replace ? prev : NULL, &s);
+      if (err)
+        goto fail;
+      if (!prev && mode == WAVE_MC_EXCLUDE &&
+          (replace || type == WAVE_MC_BLOCK))
+        mc_refresh(s, type == WAVE_MC_IS_EXCLUDE ?
+                      now + mc_gmi(d) : old->group_expires);
+    }
+    switch (type) {
+    case WAVE_MC_IS_INCLUDE:
+    case WAVE_MC_ALLOW:
+    case WAVE_MC_TO_INCLUDE:
+      mc_refresh(s, now + mc_gmi(d));
+      break;
+    case WAVE_MC_TO_EXCLUDE:
+    case WAVE_MC_BLOCK:
+      mc_source_query(s, d, now);
+      break;
+    default:
+      break;
+    }
+  }
+  if (replace) {
+    r->mode = WAVE_MC_EXCLUDE;
+    r->group_expires = now + mc_gmi(d);
+    r->group_queries = 0;
+    r->group_query_started = false;
+  } else if (type == WAVE_MC_TO_INCLUDE || type == WAVE_MC_ASM_LEAVE) {
+    mc_group_query(r, d, now);
+  }
+done:
+  *result = r;
+  return 0;
+fail:
+  mc_reporter_free(r, false);
+  return err;
+}
+
+struct wave_mc_policy *wave_mc_policy_create(gfp_t flags)
+{
+  struct wave_mc_policy *p = kzalloc(sizeof(*p), flags);
+  unsigned int i;
+
+  if (!p)
+    return NULL;
+  INIT_LIST_HEAD(&p->groups);
+  INIT_LIST_HEAD(&p->domains);
+  for (i = 0; i < WAVE_MC_BUCKETS; i++)
+    INIT_HLIST_HEAD(&p->hash[i]);
+  return p;
+}
+
+int wave_mc_policy_activate(struct wave_mc_policy *p, u32 vlan,
+                            __be16 proto, unsigned long now)
+{
+  struct wave_mc_key key = { .vlan = vlan, .proto = proto };
+  struct wave_mc_domain *d;
+
+  if (!mc_addr_size(proto))
+    return -EINVAL;
+  wave_mc_policy_expire(p, now);
+  d = mc_domain_find(p, &key);
+  if (!d) {
+    if (p->ndomains == WAVE_MC_MAX_DOMAINS)
+      return -ENOSPC;
+    d = mc_domain_new(&key, now);
+    if (!d)
+      return -ENOMEM;
+    list_add_tail(&d->list, &p->domains);
+    p->ndomains++;
+  }
+  if (d->activated) {
+    mc_domain_activity(p, d, now);
+    return 0;
+  }
+  d->activated = true;
+  mc_domain_activity(p, d, now);
+  return 1;
+}
+
+void wave_mc_policy_clear(struct wave_mc_policy *p)
+{
+  struct wave_mc_group *g, *gtmp;
+  struct wave_mc_domain *d, *dtmp;
+
+  list_for_each_entry_safe(g, gtmp, &p->groups, list) {
+    struct wave_mc_reporter *r, *tmp;
+
+    list_for_each_entry_safe(r, tmp, &g->reporters, list)
+      mc_reporter_del(p, r);
+    mc_group_del(p, g);
+  }
+  list_for_each_entry_safe(d, dtmp, &p->domains, list) {
+    list_del(&d->list);
+    kfree(d);
+  }
+  p->ndomains = 0;
+  p->gc_pending = false;
+  p->specific_first = false;
+  p->generation++;
+}
+
+void wave_mc_policy_destroy(struct wave_mc_policy *p)
+{
+  if (!p)
+    return;
+  wave_mc_policy_clear(p);
+  kfree(p);
+}
+
+void wave_mc_policy_expire(struct wave_mc_policy *p, unsigned long now)
+{
+  struct wave_mc_group *g, *gtmp;
+  struct wave_mc_domain *d, *dtmp;
+  bool changed = false;
+
+  if (!p->gc_pending || time_before(now, p->gc_at))
+    return;
+  p->gc_pending = false;
+  list_for_each_entry_safe(g, gtmp, &p->groups, list) {
+    struct wave_mc_reporter *r, *tmp;
+
+    list_for_each_entry_safe(r, tmp, &g->reporters, list) {
+      struct rb_node *node, *next;
+
+      if (r->mode == WAVE_MC_EXCLUDE && time_after_eq(now, r->group_expires)) {
+        r->mode = WAVE_MC_INCLUDE;
+        r->group_queries = 0;
+        changed = true;
+      }
+      if (r->mode == WAVE_MC_EXCLUDE)
+        mc_gc_note(p, r->group_expires);
+      for (node = rb_first(&r->sources); node; node = next) {
+        struct wave_mc_source *s = rb_entry(node, struct wave_mc_source, node);
+
+        next = rb_next(node);
+        if (s->running && time_after_eq(now, s->expires)) {
+          s->running = false;
+          s->queries = 0;
+          changed = true;
+        }
+        if (!s->running && r->mode == WAVE_MC_INCLUDE) {
+          mc_source_del(r, s);
+          p->nsrc--;
+        } else if (s->running) {
+          mc_gc_note(p, s->expires);
+        }
+      }
+      if (r->mode == WAVE_MC_INCLUDE && !r->nsrc) {
+        mc_reporter_del(p, r);
+        changed = true;
+      }
+    }
+    if (list_empty(&g->reporters))
+      mc_group_del(p, g);
+  }
+  list_for_each_entry_safe(d, dtmp, &p->domains, list) {
+    if (d->activated && d->vlan) {
+      if (time_after_eq(now, d->activity_expires))
+        d->activated = false;
+      else
+        mc_gc_note(p, d->activity_expires);
+    }
+    if (d->other_active && time_after_eq(now, d->other_expires)) {
+      d->other_active = false;
+      memset(&d->querier_source, 0, sizeof(d->querier_source));
+      d->startup_queries = d->rv;
+      d->general_at = now;
+    }
+    if (d->other_active)
+      mc_gc_note(p, d->other_expires);
+    mc_domain_unused(p, d);
+  }
+  if (changed)
+    p->generation++;
+}
+
+int wave_mc_policy_report(struct wave_mc_policy *p,
+                          const struct wave_mc_key *key,
+                          struct _sta_entry *sta, const u8 reporter[ETH_ALEN],
+                          u8 type, const void *sources, unsigned int nsrc,
+                          unsigned long now)
+{
+  struct wave_mc_reporter *old, *r;
+  struct wave_mc_group *g;
+  struct wave_mc_domain *d;
+  bool new_group = false, new_domain = false;
+  unsigned int limit;
+  int err;
+
+  if (!mc_addr_size(key->proto) || !sta || !reporter ||
+      type < WAVE_MC_IS_INCLUDE || type > WAVE_MC_ASM_LEAVE ||
+      (nsrc && !sources) || (type >= WAVE_MC_ASM_JOIN && nsrc))
+    return -EINVAL;
+  if (nsrc > WAVE_MC_MAX_SOURCES)
+    return -ENOSPC;
+  wave_mc_policy_expire(p, now);
+  g = mc_group_find(p, key);
+  old = mc_reporter_find(g, sta, reporter);
+  if (!old && (type == WAVE_MC_ASM_LEAVE || type == WAVE_MC_BLOCK ||
+               (!nsrc && (type == WAVE_MC_IS_INCLUDE ||
+                           type == WAVE_MC_TO_INCLUDE ||
+                           type == WAVE_MC_ALLOW || type == WAVE_MC_BLOCK))))
+    return 0;
+  if (!old && p->nreporters == WAVE_MC_MAX_REPORTERS)
+    return -ENOSPC;
+  d = mc_domain_find(p, key);
+  if (!d) {
+    if (p->ndomains == WAVE_MC_MAX_DOMAINS)
+      return -ENOSPC;
+    d = mc_domain_new(key, now);
+    if (!d)
+      return -ENOMEM;
+    new_domain = true;
+  }
+  if (!g) {
+    err = -ENOSPC;
+    if (p->ngroups == WAVE_MC_MAX_GROUPS)
+      goto fail_domain;
+    err = -ENOMEM;
+    g = kzalloc(sizeof(*g), GFP_ATOMIC);
+    if (!g)
+      goto fail_domain;
+    g->key.vlan = key->vlan;
+    g->key.proto = key->proto;
+    memcpy(&g->key.group, &key->group, mc_addr_size(key->proto));
+    g->domain = d;
+    INIT_LIST_HEAD(&g->reporters);
+    new_group = true;
+  }
+  limit = WAVE_MC_MAX_SOURCES - p->nsrc + (old ? old->nsrc : 0);
+  err = mc_build_reporter(old, d, type, sources, nsrc, limit, now, &r);
+  if (err)
+    goto fail_group;
+  if (r->mode == WAVE_MC_INCLUDE && !r->nsrc) {
+    mc_reporter_free(r, false);
+    err = 0;
+    goto fail_group;
+  }
+  r->sta = sta;
+  ether_addr_copy(r->mac, reporter);
+  mtlk_sta_incref(sta);
+  if (new_domain) {
+    list_add_tail(&d->list, &p->domains);
+    p->ndomains++;
+  }
+  if (new_group) {
+    list_add_tail(&g->list, &p->groups);
+    hlist_add_head(&g->hash, &p->hash[mc_hash(key)]);
+    d->groups++;
+    p->ngroups++;
+  }
+  p->nsrc += r->nsrc;
+  if (old) {
+    list_replace(&old->list, &r->list);
+    p->nsrc -= old->nsrc;
+    mc_reporter_free(old, true);
+  } else {
+    list_add_tail(&r->list, &g->reporters);
+    p->nreporters++;
+  }
+  p->generation++;
+  if (r->mode == WAVE_MC_EXCLUDE)
+    mc_gc_note(p, r->group_expires);
+  {
+    struct rb_node *node;
+
+    for (node = rb_first(&r->sources); node; node = rb_next(node)) {
+      struct wave_mc_source *s = rb_entry(node, struct wave_mc_source, node);
+
+      if (s->running)
+        mc_gc_note(p, s->expires);
+    }
+  }
+  return 0;
+fail_group:
+  if (new_group)
+    kfree(g);
+fail_domain:
+  if (new_domain)
+    kfree(d);
+  return err;
+}
+
+void wave_mc_policy_drop_reporter(struct wave_mc_policy *p,
+                                  const struct wave_mc_key *key,
+                                  struct _sta_entry *sta,
+                                  const u8 reporter[ETH_ALEN])
+{
+  struct wave_mc_group *g = mc_group_find(p, key);
+  struct wave_mc_reporter *r = mc_reporter_find(g, sta, reporter);
+
+  if (!r)
+    return;
+  mc_reporter_del(p, r);
+  if (list_empty(&g->reporters))
+    mc_group_del(p, g);
+  p->generation++;
+}
+
+void wave_mc_policy_drop_sta(struct wave_mc_policy *p, struct _sta_entry *sta)
+{
+  struct wave_mc_group *g, *gtmp;
+  bool changed = false;
+
+  list_for_each_entry_safe(g, gtmp, &p->groups, list) {
+    struct wave_mc_reporter *r, *tmp;
+
+    list_for_each_entry_safe(r, tmp, &g->reporters, list)
+      if (r->sta == sta) {
+        mc_reporter_del(p, r);
+        changed = true;
+      }
+    if (list_empty(&g->reporters))
+      mc_group_del(p, g);
+  }
+  if (changed)
+    p->generation++;
+}
+
+int wave_mc_policy_query(struct wave_mc_policy *p,
+                         const struct wave_mc_key *key,
+                         const union wave_mc_ip *querier_source,
+                         const void *sources, unsigned int nsrc, u8 qrv,
+                         unsigned long qqi, unsigned long maxresp,
+                         bool suppress, unsigned long now)
+{
+  struct wave_mc_domain *d;
+  struct wave_mc_group *g;
+  struct wave_mc_reporter *r;
+  unsigned long until;
+  unsigned int i, size = mc_addr_size(key->proto);
+  bool general;
+
+  if (!size || !querier_source || qrv > 7 || (nsrc && !sources))
+    return -EINVAL;
+  general = mc_general(key);
+  if ((general && nsrc) || nsrc > WAVE_MC_MAX_SOURCES)
+    return -EINVAL;
+  wave_mc_policy_expire(p, now);
+  d = mc_domain_find(p, key);
+  if (!d) {
+    if (p->ndomains == WAVE_MC_MAX_DOMAINS)
+      return -ENOSPC;
+    d = mc_domain_new(key, now);
+    if (!d)
+      return -ENOMEM;
+    list_add_tail(&d->list, &p->domains);
+    p->ndomains++;
+  }
+  if (d->other_active &&
+      !(key->proto == htons(ETH_P_IP) && !d->querier_source.ip4) &&
+      memcmp(querier_source, &d->querier_source, size) > 0)
+    return 0;
+  memcpy(&d->querier_source, querier_source, size);
+  if (qrv)
+    d->rv = qrv;
+  if (qqi)
+    d->qi = mc_interval(qqi);
+  if (general)
+    d->qri = mc_interval(maxresp);
+  mc_domain_activity(p, d, now);
+  d->other_active = true;
+  d->other_expires = now + mc_other_interval(d);
+  mc_gc_note(p, d->other_expires);
+  if (general || suppress)
+    return 0;
+  g = mc_group_find(p, key);
+  if (!g)
+    return 0;
+  until = now + mc_product(mc_interval(maxresp), d->rv);
+  list_for_each_entry(r, &g->reporters, list) {
+    if (!nsrc) {
+      if (r->mode == WAVE_MC_EXCLUDE && time_after(r->group_expires, until)) {
+        r->group_expires = until;
+        mc_gc_note(p, until);
+      }
+      continue;
+    }
+    for (i = 0; i < nsrc; i++) {
+      union wave_mc_ip addr = {};
+      struct wave_mc_source *s;
+
+      memcpy(&addr, (const u8 *)sources + i * size, size);
+      s = mc_source_find(r, &addr, size);
+      if (s && s->running && time_after(s->expires, until)) {
+        s->expires = until;
+        mc_gc_note(p, until);
+      }
+    }
+  }
+  return 0;
+}
+
+u64 wave_mc_policy_generation(const struct wave_mc_policy *p)
+{
+  return p->generation;
+}
+
+static void mc_deadline(unsigned long value, bool *found, unsigned long *deadline)
+{
+  if (!*found || time_before(value, *deadline)) {
+    *deadline = value;
+    *found = true;
+  }
+}
+
+bool wave_mc_policy_next_deadline(const struct wave_mc_policy *p,
+                                  unsigned long *deadline)
+{
+  const struct wave_mc_group *g;
+  const struct wave_mc_domain *d;
+  bool found = false;
+
+  list_for_each_entry(d, &p->domains, list) {
+    if (d->activated && d->vlan)
+      mc_deadline(d->activity_expires, &found, deadline);
+    if (d->other_active)
+      mc_deadline(d->other_expires, &found, deadline);
+    else if (d->activated || d->groups)
+      mc_deadline(d->general_at, &found, deadline);
+  }
+  list_for_each_entry(g, &p->groups, list) {
+    const struct wave_mc_reporter *r;
+
+    list_for_each_entry(r, &g->reporters, list) {
+      struct rb_node *node;
+
+      if (r->mode == WAVE_MC_EXCLUDE)
+        mc_deadline(r->group_expires, &found, deadline);
+      if (r->group_queries && !g->domain->other_active)
+        mc_deadline(r->group_query_at, &found, deadline);
+      for (node = rb_first(&r->sources); node; node = rb_next(node)) {
+        const struct wave_mc_source *s = rb_entry(node, struct wave_mc_source, node);
+
+        if (s->running)
+          mc_deadline(s->expires, &found, deadline);
+        if (s->queries && !g->domain->other_active)
+          mc_deadline(s->query_at, &found, deadline);
+      }
+    }
+  }
+  return found;
+}
+
+void wave_mc_policy_foreach_receiver(struct wave_mc_policy *p,
+                                     const struct wave_mc_key *key,
+                                     const union wave_mc_ip *source,
+                                     unsigned long now,
+                                     wave_mc_receiver_fn receive, void *ctx)
+{
+  struct wave_mc_group *g;
+  struct wave_mc_reporter *r;
+  unsigned int size = mc_addr_size(key->proto);
+
+  if (!size)
+    return;
+  wave_mc_policy_expire(p, now);
+  g = mc_group_find(p, key);
+  if (!g)
+    return;
+  list_for_each_entry(r, &g->reporters, list) {
+    struct wave_mc_source *s = mc_source_find(r, source, size);
+
+    if ((s && s->running) || (!s && r->mode == WAVE_MC_EXCLUDE))
+      receive(ctx, r->sta);
+  }
+}
+
+static unsigned int mc_drain_general(struct wave_mc_policy *p,
+                                      unsigned long now, unsigned int budget,
+                                      wave_mc_query_fn emit, void *ctx)
+{
+  struct wave_mc_domain *d, *dtmp;
+  unsigned long retry = max_t(unsigned long, msecs_to_jiffies(20), 1);
+  unsigned int used = 0;
+
+  list_for_each_entry_safe(d, dtmp, &p->domains, list) {
+    struct wave_mc_key key = { .vlan = d->vlan, .proto = d->proto };
+    unsigned long interval;
+
+    if (used == budget)
+      return used;
+    if (d->other_active || (!d->activated && !d->groups) ||
+        time_before(now, d->general_at))
+      continue;
+    /* A failing domain must not monopolize a caller's small packet budget. */
+    list_move_tail(&d->list, &p->domains);
+    used++;
+    if (emit(ctx, &key, NULL, 0, d->rv, d->qi, d->qri, false)) {
+      d->general_at = now + retry;
+      continue;
+    }
+    if (d->startup_queries)
+      d->startup_queries--;
+    interval = d->startup_queries ? max_t(unsigned long, d->qi / 4, 1) : d->qi;
+    d->general_at = now + interval;
+  }
+  return used;
+}
+
+static unsigned int mc_drain_specific(struct wave_mc_policy *p,
+                                       unsigned long now, unsigned int budget,
+                                       wave_mc_query_fn emit, void *ctx)
+{
+  struct wave_mc_domain *d;
+  struct wave_mc_group *g, *gtmp;
+  unsigned long retry = max_t(unsigned long, msecs_to_jiffies(20), 1);
+  unsigned int used = 0;
+
+  list_for_each_entry_safe(g, gtmp, &p->groups, list) {
+    struct wave_mc_reporter *r, *rtmp;
+
+    d = g->domain;
+    if (d->other_active)
+      continue;
+    list_for_each_entry_safe(r, rtmp, &g->reporters, list) {
+      unsigned int size = mc_addr_size(g->key.proto);
+      unsigned long lmqt = now + mc_product(WAVE_MC_LMI, d->rv);
+      struct wave_mc_source *batch[WAVE_MC_QUERY_SOURCES];
+      struct rb_node *node;
+      unsigned int count, i;
+      int err;
+
+      if (used == budget)
+        return used;
+      if (r->group_queries && time_after_eq(now, r->group_query_at)) {
+        list_move_tail(&g->list, &p->groups);
+        list_move_tail(&r->list, &g->reporters);
+        used++;
+        err = emit(ctx, &g->key, NULL, 0, d->rv, d->qi,
+                   WAVE_MC_LMI, r->group_query_started);
+        if (!err) {
+          if (!r->group_query_started) {
+            r->group_queries = d->rv;
+            if (time_after(r->group_expires, lmqt)) {
+              r->group_expires = lmqt;
+              mc_gc_note(p, lmqt);
+            }
+          }
+          r->group_query_started = true;
+          r->group_queries--;
+        }
+        r->group_query_at = now + (err ? retry : WAVE_MC_LMI);
+      }
+      while (used < budget) {
+        unsigned long oldest = 0;
+        bool found = false;
+
+        /* Prefer the oldest due work. Retried low-address sources must not
+         * starve later batches when only a few query packets fit per tick. */
+        for (node = rb_first(&r->sources); node; node = rb_next(node)) {
+          struct wave_mc_source *s = rb_entry(node, struct wave_mc_source, node);
+
+          if (s->running && s->queries && time_after_eq(now, s->query_at))
+            mc_deadline(s->query_at, &found, &oldest);
+        }
+        if (!found)
+          break;
+        count = 0;
+        for (node = rb_first(&r->sources); node && count < WAVE_MC_QUERY_SOURCES;
+             node = rb_next(node)) {
+          struct wave_mc_source *s = rb_entry(node, struct wave_mc_source, node);
+
+          if (!s->running || !s->queries || s->query_at != oldest)
+            continue;
+          batch[count] = s;
+          memcpy(p->query_sources + count * size, &s->addr, size);
+          count++;
+        }
+        if (!count)
+          break;
+        list_move_tail(&g->list, &p->groups);
+        list_move_tail(&r->list, &g->reporters);
+        used++;
+        err = emit(ctx, &g->key, p->query_sources, count,
+                   d->rv, d->qi, WAVE_MC_LMI, false);
+        for (i = 0; i < count; i++) {
+          struct wave_mc_source *s = batch[i];
+
+          if (!err) {
+            if (!s->query_started) {
+              s->queries = d->rv;
+              if (time_after(s->expires, lmqt)) {
+                s->expires = lmqt;
+                mc_gc_note(p, lmqt);
+              }
+            }
+            s->query_started = true;
+            s->queries--;
+          }
+          s->query_at = now + (err ? retry : WAVE_MC_LMI);
+        }
+      }
+    }
+  }
+  return used;
+}
+
+unsigned int wave_mc_policy_drain_queries(struct wave_mc_policy *p,
+                                         unsigned long now,
+                                         unsigned int budget,
+                                         wave_mc_query_fn emit, void *ctx)
+{
+  unsigned int first_budget, used;
+  bool specific_first;
+
+  wave_mc_policy_expire(p, now);
+  if (!budget)
+    return 0;
+  specific_first = p->specific_first;
+  p->specific_first = !specific_first;
+  first_budget = budget / 2 + (budget & 1);
+
+  /* Each class receives a turn before the other consumes the whole budget.
+   * Alternation also covers budget one. Unused quota returns to ready work;
+   * failed callbacks consume quota just like successful ownership transfers.
+   */
+  used = specific_first ?
+         mc_drain_specific(p, now, first_budget, emit, ctx) :
+         mc_drain_general(p, now, first_budget, emit, ctx);
+  used += specific_first ?
+          mc_drain_general(p, now, budget - used, emit, ctx) :
+          mc_drain_specific(p, now, budget - used, emit, ctx);
+  if (used < budget)
+    used += specific_first ?
+            mc_drain_specific(p, now, budget - used, emit, ctx) :
+            mc_drain_general(p, now, budget - used, emit, ctx);
+  return used;
+}
