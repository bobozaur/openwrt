+static bool wave_mc_native_needed(mtlk_core_t *core)
+{
+  mtlk_df_user_t *user = mtlk_df_get_user(mtlk_vap_get_df(core->vap_handle));
+
+  if (mtlk_core_mcast_module_is_available(core))
+    return false;
+  return READ_ONCE(core->slow_ctx->ap_started) &&
+         !wave_df_bridge_mcast_owned(user);
+}
