+static void wave_mc_native_wake(struct wave_mc_native *native)
+{
+  unsigned long when = jiffies + 1;
+
+  if (native->core->mcast.accepting && !native->tick_pending &&
+      (!timer_pending(&native->timer) || time_after(native->timer.expires, when)))
+    mod_timer(&native->timer, when);
+}
