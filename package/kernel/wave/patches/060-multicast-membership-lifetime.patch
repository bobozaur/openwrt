+static void wave_mc_barrier_command(mtlk_handle_t handle)
+{
+  struct wave_mc_barrier_context *ctx = HANDLE_T_PTR(struct wave_mc_barrier_context, handle);
+  mtlk_vap_manager_t *manager;
+  mtlk_vap_handle_t vap;
+  int i;
