+  memset(nic->mcast.mcast_ip4_hash, 0, sizeof(v4));
+  memset(nic->mcast.mcast_ip6_hash, 0, sizeof(v6));
+  mtlk_osal_lock_release(&nic->mcast.lock);
+
+  for (i = 0; i < MCAST_HASH_SIZE; i++) {
+    for (g4 = v4[i]; g4; g4 = next4) {
+      next4 = g4->next;
+      __mtlk_mc_set_mc_addr_type(&addr, MTLK_IPv4);
+      addr.grp_ip.ip4_addr = g4->ip4_grp_addr;
+      for (s4 = g4->ip4_src_list; s4; s4 = sn4) {
+        sn4 = s4->next;
+        addr.src_ip.ip4_addr = s4->ip4_src_addr;
+        _wave_mc_free_host_info(nic, &s4->info, &addr);
+        mtlk_osal_mem_free(s4);
+      }
+      addr.src_ip.ip4_addr = all_IPv4;
+      _wave_mc_free_host_info(nic, &g4->info, &addr);
+      mtlk_osal_mem_free(g4);
+    }
+    for (g6 = v6[i]; g6; g6 = next6) {
+      next6 = g6->next;
+      __mtlk_mc_set_mc_addr_type(&addr, MTLK_IPv6);
+      addr.grp_ip.ip6_addr = g6->ip6_grp_addr;
+      for (s6 = g6->ip6_src_list; s6; s6 = sn6) {
+        sn6 = s6->next;
+        addr.src_ip.ip6_addr = s6->ip6_src_addr;
+        _wave_mc_free_host_info(nic, &s6->info, &addr);
+        mtlk_osal_mem_free(s6);
+      }
+      addr.src_ip.ip6_addr = all_IPv6;
+      _wave_mc_free_host_info(nic, &g6->info, &addr);
+      mtlk_osal_mem_free(g6);
+    }
