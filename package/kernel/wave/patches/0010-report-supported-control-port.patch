--- a/wireless/driver/linux/mac80211.c
+++ b/wireless/driver/linux/mac80211.c
@@ -2146,6 +2146,22 @@
   /* set WIPHY features */
   hw->wiphy->features = (NL80211_FEATURE_SK_TX_STATUS |
                          NL80211_FEATURE_SCAN_FLUSH);
+
+  /* This hybrid driver delivers Ethernet EAPOL through AF_PACKET. mac80211
+   * alloc_hw advertises its own control-port path by default, but that path
+   * bypasses our Ethernet ndo and lacks retained-firmware TX status support.
+   * Let unmodified supplicant select the implemented standard transport. */
+  {
+    static const unsigned int unsupported[] = {
+      NL80211_EXT_FEATURE_CONTROL_PORT_OVER_NL80211,
+      NL80211_EXT_FEATURE_CONTROL_PORT_NO_PREAUTH,
+      NL80211_EXT_FEATURE_CONTROL_PORT_OVER_NL80211_TX_STATUS,
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(unsupported); i++)
+      hw->wiphy->ext_features[unsupported[i] / 8] &= ~BIT(unsupported[i] % 8);
+  }
 
   hw->wiphy->max_scan_ssids = MAX_SCAN_SSIDS;
   hw->wiphy->max_sched_scan_ssids = MAX_SCAN_SSIDS;
