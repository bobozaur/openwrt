-static int _wave_cfg80211_op_del_key (
-struct wiphy *wiphy,
-struct net_device *ndev,
-  uint8 key_index,
-  bool pairwise,
-  const uint8 *mac_addr)
-{
-  ILOG1_SSD("%s: Invoked from %s (%i)", ndev->name, current->comm, current->pid);
-  ILOG2_DD("pairwise = %d key_index = %d ", pairwise, key_index);
-  mac_addr = mac_addr ? mac_addr : _bcast_addr ;
-  ILOG2_Y(" mac_addr = %Y", mac_addr);
-
-  /* FW doesn't support delete key */
-  return _mtlk_df_mtlk_to_linux_error_code(MTLK_ERR_OK);
-}
-
-static int API_WRAPPER( _wave_cfg80211_op_del_key) (
-struct wiphy *wiphy,
-struct wireless_dev *wdev,
-  int link_id,
-  uint8 key_index,
-  bool pairwise,
-  const uint8 *mac_addr)
-{
-  struct net_device *ndev = wdev->netdev;
-  int res;
-  int retry_times = 0;
+static int API_WRAPPER(_wave_cfg80211_op_del_key)(struct wiphy *wiphy,
+    struct wireless_dev *wdev, int link_id, uint8 key_index, bool pairwise,
+    const uint8 *mac_addr)
+{
+  mtlk_df_user_t *df_user = mtlk_df_user_from_ndev(wdev->netdev);
+  enum wave_key_revoke_result removed;
+  int res;
 
   if (link_id > 0)
     return -EOPNOTSUPP;
-
-  do {
-    res = _wave_cfg80211_op_del_key(wiphy, ndev, key_index, pairwise, mac_addr);
-
-    retry_times++;
-  } while ((res != LINUX_ERR_OK) && (retry_times < MAX_RETRY_TIMES));
-
-  return res;
+  res = wave_core_revoke_key(mtlk_df_user_get_df(df_user), key_index,
+                             pairwise, mac_addr, &removed);
+  if (res != MTLK_ERR_OK) {
+    wave_df_keys_revoked_locked(df_user);
+    return _mtlk_df_mtlk_to_linux_error_code(res);
+  }
+  if (removed == WAVE_KEY_PEER_REMOVED) {
+    wave_df_assoc_forget(df_user, mac_addr);
+    cfg80211_del_sta(wdev, mac_addr, GFP_KERNEL);
+  } else if (removed == WAVE_KEY_VAP_REMOVED) {
+    wave_df_assoc_forget(df_user, NULL);
+    wave_df_keys_revoked_locked(df_user);
+  }
+  return 0;
 }
 
