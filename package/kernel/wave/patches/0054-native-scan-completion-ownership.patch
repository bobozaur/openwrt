Subject: [PATCH] wave: restore the station channel before completing hardware scans

--- a/wireless/driver/shared/mtlk_coreui.h
+++ b/wireless/driver/shared/mtlk_coreui.h
@@ -1755,6 +1755,8 @@
   void *wiphy;
   mtlk_scan_type_e type;
   u8 requester_vap_index;
+  /* mac80211 operating channel, captured under its wiphy mutex for STA scans. */
+  struct mtlk_chan_def sta_return_chandef;
   struct mtlk_channel channels[NUM_TOTAL_CHANS];
   u32 n_channels;
   u32 flags;
--- a/wireless/driver/linux/mac80211.c
+++ b/wireless/driver/linux/mac80211.c
@@ -2060,6 +2060,12 @@
     return _mtlk_df_mtlk_to_linux_error_code(MTLK_ERR_VALUE);
   }
 
+  /* Hardware scanning does not update mac80211's cached operating channel.
+   * It may omit .config after completion, so carry the return channel to the
+   * master serializer instead of relying on another channel notification. */
+  if (!cfg80211_chandef_valid(&hw->conf.chandef))
+    return -EINVAL;
+
   /* scan request is too big to put on the stack */
   if (!(sr = mtlk_osal_mem_alloc(sizeof(*sr), MTLK_MEM_TAG_CFG80211))) {
     ELOG_V("_wv_ieee80211_op_hw_scan: can't allocate memory");
@@ -2069,6 +2075,7 @@
   memset(sr, 0, sizeof(*sr));
   sr->saved_request = req;
   sr->type = MTLK_SCAN_STA;
+  wave_radio_chandef_copy(&sr->sta_return_chandef, &hw->conf.chandef);
   sr->requester_vap_index = wv_iface_inf->vap_index;
   sr->wiphy = hw->wiphy;
   sr->n_channels = req->n_channels;
@@ -2109,26 +2116,13 @@
   sr->ie_len = req->ie_len;
   wave_memcpy(sr->ie, sizeof(sr->ie), req->ie, sr->ie_len);
 
-  /* Keep trying in case scan is in progress for the current radio */
-  {
-    int retry_counter = 0;
-
-    do {
-      /* any checks for preexisting scans done later to minimize locking */
-      res = _mtlk_df_user_invoke_core(master_df,
+  /* Admission runs on the master. Never sleep waiting for a channel change
+   * while holding mac80211's wiphy mutex; report transient conflicts so the
+   * caller can retry after the operation owning that change has completed. */
+  res = _mtlk_df_user_invoke_core(master_df,
           WAVE_RADIO_REQ_DO_SCAN, &clpb, sr, sizeof(*sr));
-      res = _mtlk_df_user_process_core_retval(res, clpb,
+  res = _mtlk_df_user_process_core_retval(res, clpb,
           WAVE_RADIO_REQ_DO_SCAN, TRUE);
-
-      if (MTLK_ERR_RETRY != res) break;
-      mtlk_osal_msleep(50);
-      retry_counter++;
-    } while ((MTLK_ERR_RETRY == res) && (retry_counter < MAX_SCAN_WAIT_RETRIES));
-
-    if (retry_counter > 0)
-      ILOG0_SD("%s: Scan waited, number of retries %d", ieee80211_vif_to_wdev(vif)->netdev->name, retry_counter);
-
-  }
 
   /* no waiting for the end of the scan, just return and let the kernel report the scan as started */
   mtlk_osal_mem_free(sr);
--- a/wireless/driver/shared/scan_support.c
+++ b/wireless/driver/shared/scan_support.c
@@ -206,16 +206,19 @@
 uint32 scan_timer_clb_func(mtlk_osal_timer_t *timer, mtlk_handle_t nic)
 {
   mtlk_core_t *core = (mtlk_core_t *) nic;
+  int res;
 
   MTLK_ASSERT(core == mtlk_vap_manager_get_master_core(mtlk_vap_get_manager(core->vap_handle)));
 
   if (wave_rcvry_mac_fatal_pending_get(mtlk_vap_get_hw(core->vap_handle)))
     return MTLK_ERR_OK;
 
-  /* this interface is way too heavy for the simple context switch we need to do */
-  _mtlk_df_user_invoke_core_async(mtlk_vap_get_df(core->vap_handle), WAVE_RADIO_REQ_SCAN_TIMEOUT, NULL, 0, NULL, 0);
-
-  return MTLK_ERR_OK;
+  /* Keep continuation admission explicit. The normal USER-priority task
+   * reports allocation/enqueue failure; the same cancellable timer retries
+   * it without losing the accepted scan or allocating another request. */
+  res = mtlk_core_schedule_user_task(core, HANDLE_T(core),
+                                     scan_timeout_async_func, NULL, 0);
+  return res == MTLK_ERR_OK ? 0 : 50;
 }
 
 /* the scheduled scan timer calls this one */
@@ -551,6 +554,8 @@
 {
   if (is_scan_running(ss))
   {
+    uint32 retry;
+
     ILOG0_V("Aborting the scan");
     ss->flags |= SDF_ABORT;
 
@@ -561,7 +566,9 @@
     mtlk_osal_timer_cancel_sync(&ss->scan_timer);
 
     /* call it one more time to make sure it has seen the ABORT flag set */
-    scan_timer_clb_func(NULL, HANDLE_T(ss->master_core));
+    retry = scan_timer_clb_func(NULL, HANDLE_T(ss->master_core));
+    if (retry)
+      mtlk_osal_timer_set(&ss->scan_timer, retry);
   }
 }
 
@@ -677,9 +684,22 @@
 
   /* we have to restore the channel, if we had one, and set normal mode (not scan mode) */
   if (is_channel_certain(&ss->orig_chandef)) {
-    if (wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle)))
-      res = core_cfg_set_chan(core, &ss->orig_chandef, NULL);
-    else
+    if (wave_hw_mmb_ready(mtlk_vap_get_hw(core->vap_handle))) {
+      struct set_chan_param_data cpd = {0};
+
+      /* Finish the firmware scan on mac80211's operating channel before
+       * publishing completion. The AP and STA wiphys share this hardware,
+       * but an old AP channel is not the STA return-channel owner. */
+      cpd.chandef = ss->orig_chandef;
+      cpd.switch_type = ST_NORMAL;
+      cpd.station = ss->req.type == MTLK_SCAN_STA;
+      cpd.block_tx_pre = TRUE;
+      cpd.dont_notify_kernel = TRUE;
+      cpd.vap_id = mtlk_vap_get_id(core->vap_handle);
+      cpd.ndev = mtlk_df_user_get_ndev(mtlk_df_get_user(df));
+      res = core_cfg_set_chan(core, &ss->orig_chandef,
+                              cpd.station ? &cpd : NULL);
+    } else
       res = MTLK_ERR_NOT_READY;
     if (res != MTLK_ERR_OK)
       wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
@@ -1186,6 +1206,7 @@
 int scan_do_scan(mtlk_handle_t hcore, const void* data, uint32 data_size)
  {
   int res = MTLK_ERR_OK;
+  int *reply;
   unsigned r_size;
   mtlk_core_t *core = HANDLE_T_PTR(mtlk_core_t, hcore);
   mtlk_clpb_t *clpb = *(mtlk_clpb_t **)data;
@@ -1198,12 +1219,24 @@
   MTLK_ASSERT(NULL != request);
   MTLK_ASSERT(sizeof(*request) == r_size);
 
+  /* Once admitted, completion owns the request. Allocate the synchronous
+   * admission reply before any scan can start or complete. */
+  reply = mtlk_osal_mem_alloc(sizeof(*reply), MTLK_MEM_TAG_CLPB);
+  if (!reply)
+    return MTLK_ERR_NO_MEM;
+  res = mtlk_clpb_push_nocopy(clpb, reply, sizeof(*reply));
+  if (res != MTLK_ERR_OK) {
+    mtlk_osal_mem_free(reply);
+    return res;
+  }
+
   res = wave_radio_role_check(wave_vap_radio_get(core->vap_handle),
               request->type == MTLK_SCAN_STA || request->type == MTLK_SCAN_SCHED_STA);
   if (res == MTLK_ERR_OK)
     res = _scan_do_scan(core, request);
 
-  return mtlk_clpb_push(clpb, &res, sizeof(res));
+  *reply = res;
+  return MTLK_ERR_OK;
 }
 
 #define MAX_BASIC_RATES_LEN 4
@@ -1324,7 +1357,10 @@
   }
 
   /* Save the info to what channel (and how wide) we have to return to after the scan */
-  ss->orig_chandef = *current_chandef;
+  if (request->type == MTLK_SCAN_STA)
+    ss->orig_chandef = request->sta_return_chandef;
+  else
+    ss->orig_chandef = *current_chandef;
   ss->req = *request; /* save the request */
 
   ILOG0_SD("%s: Beginning scan, requester_vap_index=%i", name, ss->req.requester_vap_index);
@@ -1581,8 +1617,11 @@
   ILOG1_SDDD("%s: Scan preparation complete: channels=%u, modifier_flags=0x%02x, flags=0x%02x",
              name, request->n_channels, ss->ScanModifierFlags, ss->flags);
 
-  /* Now just invoke the regular scan timeout handling func, which will get the real work done */
-  return scan_timeout_func(core, ss);
+  /* The scan is now accepted. This path can complete synchronously, so
+   * operational failures belong to the completion event, never also to the
+   * scan callback's return value. Preparation errors below have no event. */
+  scan_timeout_func(core, ss);
+  return MTLK_ERR_OK;
 
 nomem_exit:
   res = MTLK_ERR_NO_MEM;
--- a/wireless/driver/linux/mtlk_df_user.c
+++ b/wireless/driver/linux/mtlk_df_user.c
@@ -395,6 +395,7 @@
       break;
 
     case MTLK_ERR_NOT_READY:
+    case MTLK_ERR_RETRY:
       linux_res = -EAGAIN;
       break;
 
