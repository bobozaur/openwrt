Subject: [PATCH] wave: cancel control waits before joining monitor recovery workers

An exclusive monitor stop can wait for a serializer whose running command is
itself waiting for firmware confirmation. Pause both control transports and
wake blocked senders before joining the serializers. Retain their storage
through the existing DMA/reset fence; only native queue restore and start may
reopen a paused transport. Terminal quiesce remains irreversible.

Reject asynchronous sends and queue pumping while paused as well, so a late
confirmation cannot publish new firmware work during the drain.

--- a/wireless/driver/shared/txmm.c
+++ b/wireless/driver/shared/txmm.c
@@ -26,6 +26,8 @@
 #define TXMM_FLAGS_STOPPED             0x20000000
 #define TXMM_FLAGS_INITIALIZED         0x10000000
 #define TXMM_FLAGS_QUIESCED            0x08000000
+#define TXMM_FLAGS_PAUSED              0x04000000
+#define TXMM_FLAGS_UNAVAILABLE         (TXMM_FLAGS_QUIESCED | TXMM_FLAGS_PAUSED)
 
 struct _mtlk_txmm_block_t
 {
@@ -339,8 +341,8 @@
   PMSG_OBJ pmsg = *_pmsg;
 
   /* Called with the base lock held. An in-flight CFM may return its slot,
-   * but must not start queued firmware work after terminal shutdown. */
-  if (obj->flags & TXMM_FLAGS_QUIESCED) {
+   * but cannot start queued work during recovery or terminal shutdown. */
+  if (obj->flags & TXMM_FLAGS_UNAVAILABLE) {
     if (pmsg)
       obj->api.msg_free_to_pool(obj->api.usr_data, pmsg);
     *_pmsg = NULL;
@@ -552,7 +554,7 @@
   mtlk_txmm_base_t          *obj = HANDLE_T_PTR(mtlk_txmm_base_t, clb_usr_data);
   mtlk_osal_msec_t now_time = mtlk_osal_timestamp_to_ms(mtlk_osal_timestamp());
 
-  if (READ_ONCE(obj->flags) & TXMM_FLAGS_QUIESCED)
+  if (READ_ONCE(obj->flags) & TXMM_FLAGS_UNAVAILABLE)
     return 0;
 
   _mtlk_txmm_on_timer_que(obj, now_time, MTLK_TXMMB_SENT, MTLK_TXMM_CLBR_TIMEOUT_SENT, 0);
@@ -714,7 +716,12 @@
 
 int __MTLK_IFUNC mtlk_txmm_start(mtlk_txmm_base_t *obj)
 {
-  if (READ_ONCE(obj->flags) & TXMM_FLAGS_QUIESCED)
+  BOOL unavailable;
+
+  mtlk_osal_lock_acquire(&obj->lock);
+  unavailable = !!(obj->flags & TXMM_FLAGS_UNAVAILABLE);
+  mtlk_osal_lock_release(&obj->lock);
+  if (unavailable)
     return MTLK_ERR_NOT_READY;
 
   MTLK_START_TRY(txmm, MTLK_OBJ_PTR(obj))
@@ -723,10 +730,18 @@
                     mtlk_osal_timer_set, (&obj->timer,
                                           obj->cfg.tmr_granularity));
 
-  obj->flags |= TXMM_FLAGS_ACTIVE;  /* allow blocked send from this point */
-  obj->flags &= ~TXMM_FLAGS_STOPPED;
-
   MTLK_START_FINALLY(txmm, MTLK_OBJ_PTR(obj))
+    if (__res == MTLK_ERR_OK) {
+      /* The timer step is complete. Recheck cancellation before admission;
+       * native failed-start rollback cancels the timer outside this lock. */
+      mtlk_osal_lock_acquire(&obj->lock);
+      if (obj->flags & TXMM_FLAGS_UNAVAILABLE)
+        __res = MTLK_ERR_NOT_READY;
+      else
+        WRITE_ONCE(obj->flags, obj->flags | TXMM_FLAGS_ACTIVE);
+      WRITE_ONCE(obj->flags, obj->flags & ~TXMM_FLAGS_STOPPED);
+      mtlk_osal_lock_release(&obj->lock);
+    }
   MTLK_START_RETURN(txmm, MTLK_OBJ_PTR(obj), mtlk_txmm_stop, (obj))
 }
 
@@ -768,13 +783,20 @@
       MTLK_ASSERT(obj->ques[i].total == obj->cfg.max_msgs);
     }
   }
+
+  /* The existing card-recovery owner has joined users and fenced/reset
+   * firmware before rebuilding these queues. Only start reopens admission;
+   * terminal QUIESCED is deliberately retained and still rejects start. */
+  mtlk_osal_lock_acquire(&obj->lock);
+  WRITE_ONCE(obj->flags, obj->flags & ~TXMM_FLAGS_PAUSED);
+  mtlk_osal_lock_release(&obj->lock);
 }
 
 static void _mtlk_txmm_attach_data(mtlk_txmm_t *obj, mtlk_txmm_msg_t *msg)
 {
   mtlk_txmm_block_t* block = NULL;
 
-  if ((obj->base->flags & (TXMM_FLAGS_ACTIVE | TXMM_FLAGS_QUIESCED)) != TXMM_FLAGS_ACTIVE) {
+  if ((obj->base->flags & (TXMM_FLAGS_ACTIVE | TXMM_FLAGS_UNAVAILABLE)) != TXMM_FLAGS_ACTIVE) {
     goto FINISH;
   }
 
@@ -838,7 +860,7 @@
     block->send_time = mtlk_osal_timestamp_to_ms(mtlk_osal_timestamp());
 
   mtlk_osal_lock_acquire(&obj->base->lock);
-  if (obj->base->flags & TXMM_FLAGS_QUIESCED) {
+  if (obj->base->flags & TXMM_FLAGS_UNAVAILABLE) {
     mtlk_osal_lock_release(&obj->base->lock);
     return MTLK_ERR_NOT_READY;
   }
@@ -901,7 +923,7 @@
   mtlk_osal_mutex_acquire(&obj->base->bsend.mutex);
 
   mtlk_osal_lock_acquire(&obj->base->lock);
-  if ((obj->base->flags & (TXMM_FLAGS_ACTIVE | TXMM_FLAGS_QUIESCED)) != TXMM_FLAGS_ACTIVE)
+  if ((obj->base->flags & (TXMM_FLAGS_ACTIVE | TXMM_FLAGS_UNAVAILABLE)) != TXMM_FLAGS_ACTIVE)
   { /* Cleanup issued. We must release all queued by mtlk_osal_mutex_acquire() threads */
     mtlk_osal_lock_release(&obj->base->lock);
     res = MTLK_ERR_NOT_READY;
@@ -1018,14 +1040,19 @@
 
 void __MTLK_IFUNC mtlk_txmm_stop(mtlk_txmm_base_t *obj)
 {
+  mtlk_osal_lock_acquire(&obj->lock);
   if (obj->flags & TXMM_FLAGS_STOPPED) {
+    mtlk_osal_lock_release(&obj->lock);
     return;
   }
+  mtlk_osal_lock_release(&obj->lock);
 
   MTLK_STOP_BEGIN(txmm, MTLK_OBJ_PTR(obj))
     MTLK_STOP_STEP(txmm, TXMM_TIMER, MTLK_OBJ_PTR(obj),
                    mtlk_osal_timer_cancel_sync, (&obj->timer));
-    obj->flags |= TXMM_FLAGS_STOPPED;
+    mtlk_osal_lock_acquire(&obj->lock);
+    WRITE_ONCE(obj->flags, obj->flags | TXMM_FLAGS_STOPPED);
+    mtlk_osal_lock_release(&obj->lock);
   MTLK_STOP_END(txmm, MTLK_OBJ_PTR(obj))
 }
 
@@ -1038,6 +1065,22 @@
 
   mtlk_osal_lock_acquire(&obj->lock);
   WRITE_ONCE(obj->flags, obj->flags | TXMM_FLAGS_QUIESCED);
+  mtlk_osal_event_set(&obj->bsend.evt);
+  mtlk_osal_lock_release(&obj->lock);
+  mtlk_txmm_stop(obj);
+}
+
+void __MTLK_IFUNC mtlk_txmm_pause(mtlk_txmm_base_t *obj)
+{
+  if (!(READ_ONCE(obj->flags) & TXMM_FLAGS_INITIALIZED))
+    return;
+
+  /* A serializer may be waiting for firmware. Close both blocked and
+   * asynchronous admission before joining it, and wake its real waiter.
+   * Use the same lock as blocked-send admission/event reset so this wake
+   * cannot be lost. Keep all slots/storage until the normal reset/restore. */
+  mtlk_osal_lock_acquire(&obj->lock);
+  WRITE_ONCE(obj->flags, (obj->flags | TXMM_FLAGS_PAUSED) & ~TXMM_FLAGS_ACTIVE);
   mtlk_osal_event_set(&obj->bsend.evt);
   mtlk_osal_lock_release(&obj->lock);
   mtlk_txmm_stop(obj);
@@ -1090,12 +1133,16 @@
 
 void __MTLK_IFUNC mtlk_txmm_halt(mtlk_txmm_base_t* obj)
 {
-  obj->flags &= ~TXMM_FLAGS_ACTIVE;
+  if (!(READ_ONCE(obj->flags) & TXMM_FLAGS_INITIALIZED))
+    return;
+  mtlk_osal_lock_acquire(&obj->lock);
+  WRITE_ONCE(obj->flags, obj->flags & ~TXMM_FLAGS_ACTIVE);
+  mtlk_osal_lock_release(&obj->lock);
 }
 
 BOOL __MTLK_IFUNC mtlk_txmm_is_running(mtlk_txmm_base_t* obj)
 {
-  return (READ_ONCE(obj->flags) & (TXMM_FLAGS_ACTIVE | TXMM_FLAGS_QUIESCED)) == TXMM_FLAGS_ACTIVE;
+  return (READ_ONCE(obj->flags) & (TXMM_FLAGS_ACTIVE | TXMM_FLAGS_UNAVAILABLE)) == TXMM_FLAGS_ACTIVE;
 }
 
 MTLK_INIT_STEPS_LIST_BEGIN(txmm_msg)
--- a/wireless/driver/shared/txmm.h
+++ b/wireless/driver/shared/txmm.h
@@ -553,6 +553,10 @@
 void __MTLK_IFUNC
 mtlk_txmm_terminate_waiting_msg(mtlk_txmm_base_t *base);
 
+/* Restartable cancellation: join users and fence/reset firmware before
+ * mtlk_txmm_restore() and mtlk_txmm_start(). Never clears terminal quiesce. */
+void __MTLK_IFUNC mtlk_txmm_pause(mtlk_txmm_base_t *base);
+
 /*! \fn       void mtlk_txmm_base_get_stats(mtlk_txmm_base_t  *base,
                                             mtlk_txmm_stats_t *stats)
     \brief    retrieves TXMM base object statistics
@@ -572,4 +576,3 @@
 #include "mtlkidefs.h"
 
 #endif /* !_MTLK_TXMM_H_ */
-
--- a/wireless/driver/shared/fw_recovery.c
+++ b/wireless/driver/shared/fw_recovery.c
@@ -2061,6 +2061,12 @@
       }
     }
   }
+  /* Accepted control commands may be blocked waiting for firmware. Native
+   * recovery cancellation must release them before joining their workers.
+   * Queues/storage stay owned until the existing DMA fence and restore. */
+  mtlk_txmm_pause(mtlk_hw_mmb_get_txmm_base(hw));
+  mtlk_txmm_pause(mtlk_hw_mmb_get_txdm_base(hw));
+
   /* Native serializer stop drains accepted commands and joins each worker.
    * Unlike the fault queue this requires no new asynchronous allocation and
    * cannot leave a partial set of blocked slave recovery commands. */
