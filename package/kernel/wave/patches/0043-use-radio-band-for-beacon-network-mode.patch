+     */
+    if (band == MTLK_HW_BAND_2_4_GHZ) {
+        BOOL cck = !!(oper_rateset & BASIC_RATE_SET_2DOT4_OPERATIONAL_RATE);
+
+        if (is_he)
+            mode = MTLK_NETWORK_11BGNAX_MIXED;
