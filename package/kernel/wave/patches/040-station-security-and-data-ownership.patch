+/* Process context, outside the master serializer. A stack command avoids
+ * allocating a clipboard or async context during cancellation and teardown. */
+int wave_core_cancel_scan(mtlk_core_t *master, bool terminal)
+{
+  struct wave_cancel_scan_context ctx = { .master = master, .terminal = terminal };
+  mtlk_serializer_t *serializer = &master->slow_ctx->serializer;
+  mtlk_command_t command;
+  int res;
+
+  res = mtlk_command_init(&command, wave_cancel_scan_command, HANDLE_T(&ctx), MTLK_SLID);
+  if (res == MTLK_ERR_OK) {
+    res = mtlk_serializer_execute_blocked(serializer, _MTLK_CORE_PRIORITY_INTERNAL,
+                                         &command, 2000);
+    mtlk_command_cleanup(&command);
+  }
+  if (res != MTLK_ERR_OK) {
+    /* Teardown cannot free mac80211's scan request while a producer owns it.
+     * Stop firmware waits, drain/join the serializer, then take exclusive
+     * ownership of its timer and pending scan before unregistering hardware. */
+    ELOG_D("Scan cancellation failed, making the card terminal: %d", res);
+    ctx.terminal = true;
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(master->vap_handle));
+    mtlk_serializer_stop(serializer);
+    mtlk_osal_timer_cancel_sync(&__wave_core_scan_support_get(master)->scan_timer);
+    wave_cancel_scan_command(HANDLE_T(&ctx));
+    res = MTLK_ERR_OK;
+  }
+  return res;
+}
