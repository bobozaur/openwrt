+struct wave_cancel_scan_context {
+  mtlk_core_t *master;
+  bool terminal;
+};
+
+static void wave_cancel_scan_command(mtlk_handle_t handle)
+{
+  struct wave_cancel_scan_context *ctx = HANDLE_T_PTR(struct wave_cancel_scan_context, handle);
+
+  abort_scan_sync(ctx->master);
+  if (ctx->terminal)
+    pause_or_prevent_scan(ctx->master);
