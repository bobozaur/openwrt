+static void wave_delete_vap_command(mtlk_handle_t handle)
+{
+  mtlk_vap_handle_t vap = HANDLE_T_PTR(struct _mtlk_vap_handle_t, handle);
+
+  mtlk_vap_set_stopped(vap);
+  synchronize_net();
+  mtlk_mc_close_owned(mtlk_vap_get_core(vap));
+  mtlk_vap_stop(vap);
+  mtlk_vap_delete(vap);
+}
+
+/* The control owner has withdrawn the netdevice/vif and drained its callbacks.
+ * The radio master still enumerates this VAP for statistics until deletion, so
+ * final stop/free must share its serializer. No clipboard allocation is needed
+ * after unregister, when the control operation can no longer be rolled back. */
+void wave_core_delete_vap(mtlk_vap_handle_t vap)
+{
+  mtlk_core_t *master = mtlk_vap_manager_get_master_core(mtlk_vap_get_manager(vap));
+  mtlk_serializer_t *serializer = &master->slow_ctx->serializer;
+  mtlk_command_t command;
+  int res;
+
+  MTLK_ASSERT(!mtlk_vap_is_master(vap));
+  res = mtlk_command_init(&command, wave_delete_vap_command, HANDLE_T(vap), MTLK_SLID);
+  if (res == MTLK_ERR_OK) {
+    res = mtlk_serializer_execute_blocked(serializer, _MTLK_CORE_PRIORITY_INTERNAL,
+                                         &command, 2000);
+    mtlk_command_cleanup(&command);
+  }
+  if (res != MTLK_ERR_OK) {
+    /* A failed submission has not run the destructor. Fence firmware producers
+     * and join the master before taking exclusive ownership of the VAP. */
+    ELOG_D("VAP deletion failed, making the card terminal: %d", res);
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(vap));
+    mtlk_serializer_stop(serializer);
+    wave_delete_vap_command(HANDLE_T(vap));
+  }
+}
