+static int wave_core_pmf_clear(mtlk_core_t *core)
+{
+  struct wave_pmf *pmf = &core->slow_ctx->pmf;
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  int ret;
+
+  wave_pmf_block(pmf);
+  ret = wave_pmf_del_key(pmf, 4);
+  if (!ret)
+    ret = wave_pmf_del_key(pmf, 5);
+  if (ret) {
+    wave_hw_mmb_quiesce(hw);
+    wave_hw_mmb_detach_pmf(hw, pmf);
+  }
+  wave_pmf_reset(pmf);
+  return ret ? MTLK_ERR_UNKNOWN : MTLK_ERR_OK;
+}
