+/* The caller holds a peer reference. TX counters and RX bytes use the
+ * existing firmware cache; accepted RX packets are counted by the host.
+ * Station queries do not issue a new firmware request. */
+void __MTLK_IFUNC
+mtlk_sta_fill_station_info(const sta_entry *sta, struct station_info *sinfo)
+{
+  uint32 tx_rate = _mtlk_sta_get_tx_data_rate(sta);
+  uint32 rx_rate = _mtlk_sta_get_rx_data_rate(sta);
+
+  sinfo->signal = rx_rate == MTLK_BITRATE_INVALID ?
+                   mtlk_sta_get_mgmt_max_rssi(sta) : READ_ONCE(sta->info.stats.max_rssi);
+  sinfo->tx_bytes = mtlk_sta_get_mhi_stat_cntr(sta, STAT_STA_CNTR_TX_BYTES);
+  sinfo->rx_bytes = mtlk_sta_get_mhi_stat_cntr(sta, STAT_STA_CNTR_RX_BYTES);
+  sinfo->tx_packets = mtlk_sta_get_mhi_stat_cntr(sta, STAT_STA_CNTR_TX_FRAMES);
+  sinfo->rx_packets = mtlk_sta_get_rx_packets(sta);
+  sinfo->connected_time = mtlk_sta_get_age(sta);
+  sinfo->inactive_time = mtlk_sta_get_inactive_time(sta);
+  if (smp_load_acquire(&mtlk_core_get_master(
+        mtlk_vap_get_core(sta->vap_handle))->airtime_applied)) {
+    sinfo->airtime_weight = READ_ONCE(sta->info.airtime_weight) ?: 256;
+    sinfo->filled |= BIT_ULL(NL80211_STA_INFO_AIRTIME_WEIGHT);
+  }
+
+  /* These firmware counters wrap at 32 bits; do not label them as 64-bit
+   * totals or replace unrelated fields already supplied by the stack. */
+  sinfo->filled &= ~(BIT_ULL(NL80211_STA_INFO_TX_BYTES64) |
+                     BIT_ULL(NL80211_STA_INFO_RX_BYTES64));
+  sinfo->filled |= BIT_ULL(NL80211_STA_INFO_SIGNAL) |
+                    BIT_ULL(NL80211_STA_INFO_TX_BYTES) |
+                    BIT_ULL(NL80211_STA_INFO_RX_BYTES) |
+                    BIT_ULL(NL80211_STA_INFO_TX_PACKETS) |
+                    BIT_ULL(NL80211_STA_INFO_RX_PACKETS) |
+                    BIT_ULL(NL80211_STA_INFO_CONNECTED_TIME) |
+                    BIT_ULL(NL80211_STA_INFO_INACTIVE_TIME);
+
+  /* cfg80211 and the firmware conversion both use 100 kbit/s. A missing
+   * rate must remain unfilled, not masquerade as a measured zero bitrate. */
+  if (tx_rate != MTLK_BITRATE_INVALID && tx_rate <= U16_MAX) {
+    memset(&sinfo->txrate, 0, sizeof(sinfo->txrate));
+    sinfo->txrate.legacy = tx_rate;
+    sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_BITRATE);
+  }
+  if (rx_rate != MTLK_BITRATE_INVALID && rx_rate <= U16_MAX) {
+    memset(&sinfo->rxrate, 0, sizeof(sinfo->rxrate));
+    sinfo->rxrate.legacy = rx_rate;
+    sinfo->filled |= BIT_ULL(NL80211_STA_INFO_RX_BITRATE);
+  }
+}
