+/* Atomic card admission covers the complete execution, including firmware
+ * waits. Already queued user work is rejected after monitor reservation. */
+static int wave_core_owned_call(mtlk_vap_handle_t vap, BOOL user,
+    mtlk_core_task_func_t func, mtlk_handle_t receiver, const void *data, uint32 size)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(vap);
+  int res;
+
+  if (!user)
+    return func(receiver, data, size);
+  if (!wave_hw_monitor_user_get(hw))
+    return MTLK_ERR_BUSY;
+  res = func(receiver, data, size);
+  wave_hw_monitor_user_put(hw);
+  return res;
+}
