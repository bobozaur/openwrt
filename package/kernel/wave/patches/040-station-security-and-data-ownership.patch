+struct wave_key_revoke_request {
+  u8 index;
+  bool pairwise;
+  IEEE_ADDR address;
+};
+
+static int
+_wave_core_revoke_key(mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  mtlk_core_t *core = HANDLE_T_PTR(mtlk_core_t, hcore);
+  mtlk_core_t *master = mtlk_core_get_master(core);
+  mtlk_clpb_t *clpb = *(mtlk_clpb_t **)data;
+  const struct wave_key_revoke_request *request;
+  enum wave_key_revoke_result removed = WAVE_KEY_UNCHANGED;
+  unsigned size;
+  int res = MTLK_ERR_OK;
+  sta_entry *sta;
+
+  MTLK_ASSERT(data_size == sizeof(mtlk_clpb_t *));
+  request = mtlk_clpb_enum_get_next(clpb, &size);
+  if (!request || size != sizeof(*request) || request->index >= 4)
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_PARAMS);
+  if (!wave_core_keys_ready(core))
+    return mtlk_clpb_push_res(clpb, MTLK_ERR_NOT_READY);
+
+  if (request->pairwise) {
+    sta = mtlk_stadb_find_sta(&core->slow_ctx->stadb, request->address.au8Addr);
+    if (sta) {
+      bool installed = sta->hw_key_mask & BIT(request->index);
+      mtlk_sta_decref(sta);
+      if (installed) {
+        res = _mtlk_core_ap_disconnect_sta_blocked(core, &request->address,
+                                                   FM_STATUSCODE_USER_REQUEST);
+        if (res == MTLK_ERR_OK)
+          removed = WAVE_KEY_PEER_REMOVED;
+      }
+    }
+  } else if (core->slow_ctx->hw_group_key_mask & BIT(request->index)) {
+    /* Firmware has no CLEAR_KEY command. Removing the VAP is the only
+     * acknowledged revocation of its group-key slots. Retain the Linux VIF. */
+    abort_scan_sync(master);
+    if (!wave_core_keys_ready(core))
+      res = MTLK_ERR_NOT_READY;
+    else
+      res = __mtlk_core_deactivate(master, core);
+    if (res == MTLK_ERR_OK)
+      removed = WAVE_KEY_VAP_REMOVED;
+  }
+  if (res != MTLK_ERR_OK)
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(core->vap_handle));
+  return mtlk_clpb_push_res_data(clpb, res, &removed, sizeof(removed));
+}
+
+int wave_core_revoke_key(mtlk_df_t *df, u8 index, bool pairwise,
+                         const u8 *mac, enum wave_key_revoke_result *removed)
+{
+  struct wave_key_revoke_request request = { .index = index, .pairwise = pairwise };
+  mtlk_clpb_t *clpb = NULL;
+  int res;
+
+  *removed = WAVE_KEY_UNCHANGED;
+  if (index >= 4 || (pairwise && (!mac || !is_valid_ether_addr(mac))))
+    return MTLK_ERR_PARAMS;
+  if (!wave_core_keys_ready(mtlk_vap_get_core(mtlk_df_get_vap_handle(df))))
+    return MTLK_ERR_NOT_READY;
+  if (mac)
+    ether_addr_copy(request.address.au8Addr, mac);
+  res = _mtlk_df_user_invoke_core(df, WAVE_CORE_REQ_REVOKE_KEY,
+                                 &clpb, &request, sizeof(request));
+  res = _mtlk_df_user_process_core_retval(res, clpb, WAVE_CORE_REQ_REVOKE_KEY, FALSE);
+  if (res == MTLK_ERR_OK) {
+    unsigned size;
+    enum wave_key_revoke_result *value = mtlk_clpb_enum_get_next(clpb, &size);
+    if (!value || size != sizeof(*value)) {
+      res = MTLK_ERR_UNKNOWN;
+      wave_hw_mmb_quiesce(mtlk_vap_get_hw(mtlk_df_get_vap_handle(df)));
+    } else {
+      *removed = *value;
+    }
+    mtlk_clpb_delete(clpb);
+  }
+  /* A failed reply allocation can hide an already completed revocation. */
+  if (res != MTLK_ERR_OK)
+    wave_hw_mmb_quiesce(mtlk_vap_get_hw(mtlk_df_get_vap_handle(df)));
   return res;
 }
 
