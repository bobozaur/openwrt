+static bool wave_eapol_frame_valid(const void *data, size_t len)
+{
+  const uint8 *frame = data;
+
+  /* Ethernet followed by the four-byte 802.1X header. Padding is valid. */
+  return frame && len >= ETH_HLEN + 4 &&
+         get_unaligned_be16(frame + 12) == ETH_P_PAE &&
+         get_unaligned_be16(frame + ETH_HLEN + 2) <= len - ETH_HLEN - 4;
+}
+
+int mtlk_core_tx_eapol(mtlk_vap_handle_t vap_handle, const void *data, size_t len)
+{
+  mtlk_core_t *core = mtlk_vap_get_core(vap_handle);
+  const struct ethhdr *eth = data;
+  sta_entry *sta;
+  uint64 cookie;
+  int res;
+
+  if (!wave_eapol_frame_valid(data, len) || is_multicast_ether_addr(eth->h_dest))
+    return MTLK_ERR_PARAMS;
+  sta = mtlk_stadb_find_sta(&core->slow_ctx->stadb, eth->h_dest);
+  if (!sta)
+    return MTLK_ERR_NOT_HANDLED;
+  if (MTLK_PCKT_FLTR_DISCARD_ALL == mtlk_sta_get_packets_filter(sta)) {
+    mtlk_sta_on_packet_dropped(sta, MTLK_TX_DISCARDED_DROP_ALL_FILTER);
+    res = MTLK_ERR_NOT_HANDLED;
+  } else {
+    /* ndo_start_xmit cannot sleep. The management ring copies the frame
+     * before returning and owns no mac80211 skb for Ethernet EAPOL. */
+    res = mtlk_mmb_bss_mgmt_tx(vap_handle, data, len, 0, FALSE, FALSE, FALSE,
+                              &cookie, PROCESS_EAPOL, NULL,
+                              FALSE, NTS_TID_USE_DEFAULT);
+    if (res == MTLK_ERR_OK)
+      mtlk_sta_on_tx_packet_802_1x(sta);
+    else
+      mtlk_sta_on_tx_packet_discarded_802_1x(sta);
+  }
+  mtlk_sta_decref(sta);
+  return res;
+}
