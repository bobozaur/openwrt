+static mtlk_core_t *wave_cfg_core(struct net_device *ndev)
+{
+  return mtlk_vap_get_core(mtlk_df_get_vap_handle(
+                           mtlk_df_user_get_df(mtlk_df_user_from_ndev(ndev))));
+}
+
+static int wave_cfg_pmf_result(struct net_device *ndev, int result)
+{
+  if (result == -ETIMEDOUT) {
+    mtlk_core_t *core = wave_cfg_core(ndev);
+    mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+
+    wave_hw_mmb_quiesce(hw);
+    wave_hw_mmb_detach_pmf(hw, &core->slow_ctx->pmf);
+    wave_df_keys_revoked_locked(mtlk_df_user_from_ndev(ndev));
+  }
+  return result;
+}
