#!/bin/sh /etc/rc.common
# Copyright (C) 2008 OpenWrt.org

START=96

extra_command "turnon" "Put the LEDs into their default state"
extra_command "turnoff" "Turn all LEDs off"
extra_command "blink" "Blink all LEDs"

. /lib/functions/leds.sh
. /lib/functions/led-service.sh

led_command() {
	local ret
	if led_policy led "$@"; then
		return 0
	else
		ret=$?
	fi
	case "$ret" in
		65) led_apply "$@" ;;
		*) return 1 ;;
	esac
}

start() { led_command start "$@"; }
turnon() { led_command turnon "$@"; }
turnoff() { led_command turnoff "$@"; }
blink() { led_command blink "$@"; }
