#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -e

usage() {
	cat <<'HELP'
Usage: wave600-firmware-import [NETGEAR.zip|NETGEAR.img [AX50.zip|AX50.bin]]
       wave600-firmware-import --migrate

Import NETGEAR RAX40 V1 1.0.6.106 radio firmware with the Archer AX50 V1
1.1.2 Build 20251022 PSD. Reuse an existing verified AX50 PSD; otherwise
supply the AX50 input as the second argument. Local inputs never download.
Without arguments, download the pinned inputs needed for this import.
A complete installed cohort is reused without downloading or writing it again.
The dedicated firmware volume survives sysupgrade and factory reset. Reboot
following import to initialize the radios with the matching driver.

--migrate mounts or migrates a complete verified current cohort without
fetching or converting older firmware. Package installation and early boot
run this local operation automatically. An older AX50 cohort requires an
explicit reimport. Matching old regular files are retained outside the firmware
search path until reimport. User settings are never copied to the volume.
HELP
}

case "${1:-}" in
	-h|--help) usage; exit 0 ;;
esac
[ "$#" -le 2 ] || { usage >&2; exit 1; }
[ "${1:-}" != --migrate ] || [ "$#" -eq 1 ] || { usage >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || { echo 'Run as root to install firmware.' >&2; exit 1; }

. /lib/functions/system.sh
. /lib/upgrade/nand.sh
[ "$(board_name)" = tplink,archer-ax50-v1 ] || {
	echo 'This importer requires an Archer AX50 V1.' >&2
	exit 1
}

manifest=/usr/share/wave600-firmware-importer/SHA256SUMS
previous_manifest=/usr/share/wave600-firmware-importer/SHA256SUMS.ax50
store=/mnt/wave600_firmware
volume_name=wave600_firmware
netgear_url='https://www.downloads.netgear.com/files/GDC/RAX40/RAX40-V1.0.6.106_1.0.1.zip'
netgear_archive_hash=e91470e1d264536edaf06732de8c552753908e247c03f98f769faf9a5eb016cf
netgear_image_hash=f05acc7e03be14014c70746c896fcf6d0a4a00a95a9f12797700c2b1c75be417
ax50_url='https://static.tp-link.com/upload/firmware/2025/202511/20251121/Archer%20AX50_V1_251022.zip'
ax50_archive_hash=755156fc9897092189f551107fd05adff92439cd8039837b559d0002e8cf918f
ax50_image_hash=cf887d15c65108ed6bfcd9bd26d5dcde93dc2a6544cf6795260ff57d60f07119
psd_hash=$(awk '$2 == "PSD.bin" {print $1}' "$manifest")
work=
stage=
previous=0
legacy_dir=/lib/firmware/wave600-legacy
legacy_checked=0
withdrawn=0

# S09 runs before S10boot creates /var/lock. flock releases ownership on exit
# or power loss, including interrupted first imports.
exec 9>/tmp/wave600-firmware.lock
flock -x 9
ubidev=$(nand_find_ubi system_sw)
[ -n "$ubidev" ] || { echo 'Cannot find the system_sw UBI device.' >&2; exit 1; }
volume=$(nand_find_volume "$ubidev" "$volume_name")

check_cohort() {
	local hash file list="${2:-$manifest}"
	[ -d "$1" ] && [ ! -L "$1" ] || return 1
	while read -r hash file; do
		[ -f "$1/$file" ] && [ ! -L "$1/$file" ] || return 1
	done < "$list"
	(cd "$1" && sha256sum -c "$list") >/dev/null 2>&1
}

check_psd() {
	local actual
	[ -f "$1" ] && [ ! -L "$1" ] || return 1
	actual=$(sha256sum < "$1") || return 1
	[ "${actual%% *}" = "$psd_hash" ]
}

mounted_store() {
	awk -v dir="$store" -v name="$ubidev:$volume_name" -v dev="/dev/$volume" '
		$2 == dir {count++; if (($1 == name || $1 == dev) && $3 == "ubifs") matched++}
		END {exit count == 1 && matched == 1 ? 0 : 1}' /proc/mounts
}

mount_store() {
	local mode="$1"
	if [ "$mode" = rw ]; then
		[ "$(cat "/sys/class/ubi/$volume/type")" = dynamic ] &&
		[ "$(cat "/sys/class/ubi/$volume/reserved_ebs")" = 32 ] &&
		[ "$(cat "/sys/class/ubi/$volume/usable_eb_size")" = 126976 ] || return 1
	fi
	mkdir -p "$store" || return 1
	if mounted_store; then
		awk -v dir="$store" -v mode="$mode" '$2 == dir && $4 ~ "(^|,)" mode "(,|$)" {found=1}
			END {exit found ? 0 : 1}' /proc/mounts && return 0
		mount -o "remount,$mode" "$store"
	else
		# Refuse an unrelated mount at the package-owned mountpoint.
		awk -v dir="$store" '$2 == dir {found=1} END {exit found ? 1 : 0}' /proc/mounts || return 1
		mount -t ubifs -o "$mode,nosuid,nodev,noexec" "$ubidev:$volume_name" "$store"
	fi
}

withdraw_store() {
	# Withdraw loader links without erasing rejected bytes. Existing readers
	# still own any firmware they already loaded.
	umount "$store" || umount -l "$store" || {
		echo 'Cannot withdraw WAVE600 firmware; release users of the store and unmount it before loading radios.' >&2
		return 1
	}
}

cleanup() {
	local result="$?" failed=0
	trap - EXIT HUP INT TERM
	set +e
	[ -z "$work" ] || rm -rf "$work" || failed=1
	[ -z "$stage" ] || rm -rf "$stage" || failed=1
	if mounted_store && awk -v dir="$store" '$2 == dir && $4 ~ /(^|,)rw(,|$)/ {found=1}
		END {exit found ? 0 : 1}' /proc/mounts; then
		sync || failed=1
		mount -o remount,ro "$store" || failed=1
	fi
	[ "$result" != 0 ] || result="$failed"
	exit "$result"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

legacy_directory() {
	[ "$legacy_checked" = 0 ] || return 0
	if [ ! -e "$legacy_dir" ] && [ ! -L "$legacy_dir" ]; then
		[ "${1:-}" = create ] || return 1
		mkdir -m 0700 "$legacy_dir" || return 1
	fi
	[ -d "$legacy_dir" ] && [ ! -L "$legacy_dir" ] || {
		echo 'The WAVE600 legacy path must be a real directory.' >&2
		return 1
	}
	legacy_checked=1
}

legacy_files() {
	local action="$1" dir="$2" list="$3" hash file actual
	while read -r hash file; do
		[ -f "$dir/$file" ] && [ ! -L "$dir/$file" ] || continue
		actual=$(sha256sum < "$dir/$file") || return 1
		[ "${actual%% *}" = "$hash" ] || continue
		if [ "$action" = withdraw ]; then
			legacy_directory create || return 1
			if [ -e "$legacy_dir/$file" ] || [ -L "$legacy_dir/$file" ]; then
				[ -f "$legacy_dir/$file" ] && [ ! -L "$legacy_dir/$file" ] || return 1
				actual=$(sha256sum < "$legacy_dir/$file") || return 1
				[ "${actual%% *}" = "$hash" ] || {
					echo 'Refusing to overwrite an unrecognized retained WAVE600 file.' >&2
					return 1
				}
			fi
			mv "$dir/$file" "$legacy_dir/$file" || return 1
			withdrawn=1
		else
			rm -f "$dir/$file" || return 1
		fi
	done < "$list"
}

remove_legacy_files() {
	# Publication was checked first. Retire only matching package files;
	# unrelated regular files and retained directory contents remain untouched.
	legacy_files remove /lib/firmware "$manifest"
	legacy_files remove /lib/firmware "$previous_manifest"
	if legacy_directory; then
		legacy_files remove "$legacy_dir" "$previous_manifest"
		rmdir "$legacy_dir" 2>/dev/null || :
	fi
}

# A verified archive identifies its one image. Raw images have their own pin.
# Output paths belong to this invocation; local inputs are never removed.
unpack_image() {
	local input="$1" archive_hash="$2" image_hash="$3" member="$4" output="$5" hash
	hash=$(sha256sum < "$input") || return 1
	case "${hash%% *}" in
		"$archive_hash") unzip -p "$input" "$member" > "$output" || return 1; echo "$output" ;;
		"$image_hash") echo "$input" ;;
		*) echo 'Input is not the supported pinned vendor release.' >&2; return 1 ;;
	esac
}

# The retained directory is outside the kernel firmware search path. Check it
# once before reading, moving or retiring its individually pinned files.
if [ -e "$legacy_dir" ] || [ -L "$legacy_dir" ]; then
	legacy_directory
fi
root_current=0
if [ "${1:-}" = --migrate ] && check_cohort /lib/firmware; then
	root_current=1
fi

if [ -n "$volume" ]; then
	# An interrupted creation may leave an empty volume which UBIFS can only
	# initialize on the later writable mount. Never recreate or erase it.
	if mount_store ro; then
		if check_cohort "$store/firmware"; then
			remove_legacy_files
			echo 'WAVE600 firmware is already installed in the reset-preserved volume.'
			exit 0
		fi
		if check_cohort "$store/firmware" "$previous_manifest"; then
			previous=1
			if [ "${1:-}" = --migrate ] && [ "$root_current" = 0 ]; then
				withdraw_store
				legacy_files withdraw /lib/firmware "$previous_manifest"
				echo 'Previous AX50 firmware retained but withdrawn; run wave600-firmware-import to reimport the matching NETGEAR cohort.' >&2
				exit 0
			fi
		elif [ -e "$store/firmware" ] || [ -L "$store/firmware" ]; then
			withdraw_store
			if [ "${1:-}" = --migrate ] && [ "$root_current" = 0 ]; then
				legacy_files withdraw /lib/firmware "$previous_manifest"
			fi
			echo 'The published WAVE600 firmware cohort failed verification; store unmounted.' >&2
			exit 1
		fi
	fi
fi

legacy=0
if [ "${1:-}" = --migrate ]; then
	# Boot/package installation never downloads or converts a previous cohort.
	if [ "$root_current" = 0 ]; then
		# Move individually verified previous files so interrupted moves can
		# resume; never leave an old regular file as a kernel fallback.
		legacy_files withdraw /lib/firmware "$previous_manifest"
		if [ "$withdrawn" = 1 ] || [ -d "$legacy_dir" ]; then
			echo 'Previous AX50 firmware retained outside the search path; explicit reimport is required.' >&2
		fi
		exit 0
	fi
	legacy=1
fi
work=$(mktemp -d /tmp/wave600-import.XXXXXX)
ram=$work/firmware
mkdir "$ram"

if [ "$legacy" = 1 ]; then
	while read -r _hash file; do
		cp "/lib/firmware/$file" "$ram/$file"
	done < "$manifest"
else
	# Reuse the board's PSD before acquiring any large NETGEAR input. A stale
	# unpublished stage may also retain a verified PSD after power loss.
	for psd in "$store/firmware/PSD.bin" "$store/.staging/PSD.bin" /lib/firmware/PSD.bin "$legacy_dir/PSD.bin"; do
		if check_psd "$psd"; then
			cp "$psd" "$ram/PSD.bin"
			break
		fi
	done
	if [ ! -f "$ram/PSD.bin" ]; then
		if [ "$#" -eq 0 ]; then
			ax50_input=$work/ax50.zip
			uclient-fetch -O "$ax50_input" "$ax50_url"
		elif [ "$#" -eq 2 ]; then
			ax50_input=$2
		else
			echo 'No verified AX50 PSD is available; supply the pinned AX50 ZIP or raw image as the second argument.' >&2
			exit 1
		fi
		image=$(unpack_image "$ax50_input" "$ax50_archive_hash" "$ax50_image_hash" '*.bin' "$work/ax50.bin")
		rm -f "$work/ax50.zip"
		unsquashfs -cat -processors 1 -mem 8M -o 286889 "$image" lib/firmware/PSD.bin > "$ram/PSD.bin"
		check_psd "$ram/PSD.bin"
		# Release our AX50 archive/image before acquiring NETGEAR. Inputs
		# supplied by the caller remain untouched.
		rm -f "$work/ax50.bin"
	fi

	# Keep the known old data intact, but withdraw its loader links during
	# bulk acquisition. The board PSD is now safely in our RAM cohort.
	if [ "$previous" = 1 ]; then
		withdraw_store
	fi

	if [ "$#" -eq 0 ]; then
		input=$work/netgear.zip
		uclient-fetch -O "$input" "$netgear_url"
	else
		input=$1
	fi
	image=$(unpack_image "$input" "$netgear_archive_hash" "$netgear_image_hash" '*.img' "$work/netgear.img")
	rm -f "$work/netgear.zip"
	while read -r _hash file; do
		[ "$file" != PSD.bin ] || continue
		unsquashfs -cat -processors 1 -mem 8M -o 209 "$image" "opt/lantiq/wave/images/$file" > "$ram/$file"
	done < "$manifest"
	rm -f "$work/netgear.img"
fi
# No existing published file is retired until every new file is verified in RAM.
check_cohort "$ram"
chmod 0644 "$ram"/*.bin

if [ -z "$volume" ]; then
	# Allocate only this named volume from free space; existing volumes and
	# their IDs, including the fallback and calibration, are never changed.
	[ "$(cat "/sys/class/ubi/$ubidev/avail_eraseblocks")" -ge 32 ] || {
		echo 'The firmware store requires 32 free UBI eraseblocks.' >&2
		exit 1
	}
	ubimkvol "/dev/$ubidev" -N "$volume_name" -t dynamic -s 4063232
	volume=$(nand_find_volume "$ubidev" "$volume_name")
	[ -n "$volume" ]
fi
mount_store rw

if [ -e "$store/firmware" ] || [ -L "$store/firmware" ]; then
	[ "$previous" = 1 ] && check_cohort "$store/firmware" "$previous_manifest" || {
		echo 'Refusing to replace an unrecognized published WAVE600 cohort.' >&2
		exit 1
	}
	# Do not retire unrelated entries from a directory merely because it
	# contains the nine old package files.
	count=0
	for entry in "$store/firmware"/* "$store/firmware"/.[!.]* "$store/firmware"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		count=$((count + 1))
	done
	[ "$count" -eq "$(wc -l < "$previous_manifest")" ] || {
		echo 'Previous firmware directory contains unrelated entries; refusing replacement.' >&2
		exit 1
	}
fi

# The one-cohort store need not hold old and new copies at once. Once the old
# directory is withdrawn, interruption requires explicit reimport; only the
# complete RAM cohort below can be published through the existing staging path.
stage=$store/.staging
rm -rf "$stage"
if [ "$previous" = 1 ]; then
	mv "$store/firmware" "$stage"
	while read -r _hash file; do
		rm "$stage/$file"
	done < "$previous_manifest"
	rmdir "$stage"
fi
mkdir "$stage"
while read -r _hash file; do
	cp "$ram/$file" "$stage/$file"
done < "$manifest"
check_cohort "$stage"
# Persist file contents before the atomic directory publication. Readers use
# only firmware/, so an interrupted staging copy never exposes a partial set.
sync
mv "$stage" "$store/firmware"
stage=
sync
remove_legacy_files

echo 'WAVE600 firmware imported into the reset-preserved volume. Reboot to initialize the radios with the matching driver.'
