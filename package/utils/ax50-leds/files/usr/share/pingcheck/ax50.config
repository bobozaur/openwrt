config default
	option interval '10'
	option timeout '30'
	option protocol 'icmp'
	option require_default '1'

config interface 'wan_ipv4'
	option name 'wan_ipv4'
	option interface 'wan'
	option family 'ipv4'
	option host '1.1.1.1'

config interface 'wan_ipv4_alternate'
	option name 'wan_ipv4_alternate'
	option interface 'wan'
	option family 'ipv4'
	option host '9.9.9.9'

config interface 'wan_ipv6'
	option name 'wan_ipv6'
	option interface 'wan6 wan_6 wan'
	option family 'ipv6'
	option host '2606:4700:4700::1111'

config interface 'wan_ipv6_alternate'
	option name 'wan_ipv6_alternate'
	option interface 'wan6 wan_6 wan'
	option family 'ipv6'
	option host '2620:fe::fe'
