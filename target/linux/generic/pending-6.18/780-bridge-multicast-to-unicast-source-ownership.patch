@@ -599,6 +602,7 @@
 	sg_key.addr = src->pg->key.addr;
 	sg_key.addr.src = src->addr.src;
 	sg_key.port = src->pg->key.port;
+	ether_addr_copy(sg_key.host, src->pg->key.host);
 
 	sg = br_sg_port_find(src->br, &sg_key);
 	if (!sg || (sg->flags & MDB_PG_FLAGS_PERMANENT))
@@ -850,6 +854,26 @@
 	}
 
 	WARN_ON(1);
+}
+
+/* Switching between a port-wide aggregate and host-specific reports cannot
+ * reuse the old dynamic membership. Permanent entries retain user ownership.
+ * Restart the walk after each deletion: removing *,G can recursively remove
+ * source entries from the same port's mglist.
+ */
+void br_multicast_to_unicast_changed(struct net_bridge_port *port)
+{
+	struct net_bridge_port_group *pg;
+
+	spin_lock_bh(&port->br->multicast_lock);
+restart:
+	hlist_for_each_entry(pg, &port->mglist, mglist) {
+		if (pg->flags & MDB_PG_FLAGS_PERMANENT)
+			continue;
+		br_multicast_find_del_pg(port->br, pg);
+		goto restart;
+	}
+	spin_unlock_bh(&port->br->multicast_lock);
 }
 
 static void br_multicast_port_group_expired(struct timer_list *t)
@@ -1422,6 +1446,13 @@
 
 	p->key.addr = *group;
 	p->key.port = port;
+	/* Host-specific S,G entries belong to their reporting host. Port-wide
+	 * aggregates and user MDB entries retain the canonical zero host key.
+	 * Derived source lookups copy their parent *,G key, never a new reporter.
+	 */
+	if ((port->flags & BR_MULTICAST_TO_UNICAST) && src &&
+	    is_valid_ether_addr(src))
+		ether_addr_copy(p->key.host, src);
 	p->flags = flags;
 	p->filter_mode = filter_mode;
 	p->rt_protocol = rt_protocol;
