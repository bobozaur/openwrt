Subject: [PATCH] bridge: retain host ownership for multicast source entries

Include the reporting host in source-group identity on multicast-to-unicast
ports and filter before conversion. Keep user MDB entries port-wide, merge
their forwarding with learned hosts, and discard dynamic ownership when
the conversion mode changes. VLAN identity and protocol timers stay in
the bridge.

--- a/net/bridge/br_forward.c
+++ b/net/bridge/br_forward.c
@@ -293,6 +293,29 @@
 	__br_forward(p, skb, local_orig);
 }
 
+/* A user MDB entry covers the whole port. It shares the output with learned
+ * host entries, but only an eligible wildcard can suppress their unicast
+ * copies. Router ports are handled by the caller's normal port merge.
+ */
+static bool br_multicast_pg_eligible(const struct net_bridge_port_group *pg,
+				     bool allow_mode_include)
+{
+	return (allow_mode_include || pg->filter_mode != MCAST_INCLUDE) &&
+	       !(pg->flags & MDB_PG_FLAGS_BLOCKED);
+}
+
+static bool br_multicast_has_wildcard(struct net_bridge_port_group *pg,
+				      bool allow_mode_include)
+{
+	const struct net_bridge_port *port = pg->key.port;
+
+	for (; pg && pg->key.port == port; pg = rcu_dereference(pg->next))
+		if (is_zero_ether_addr(pg->key.host) &&
+		    br_multicast_pg_eligible(pg, allow_mode_include))
+			return true;
+	return false;
+}
+
 /* called with rcu_read_lock */
 void br_multicast_flood(struct net_bridge_mdb_entry *mdst,
 			struct sk_buff *skb,
@@ -303,6 +326,8 @@
 	struct net_bridge_port *prev = NULL;
 	struct net_bridge_port_group *p;
 	bool allow_mode_include = true;
+	struct net_bridge_port *ucast_port = NULL;
+	bool wildcard = false;
 	struct hlist_node *rp;
 
 	rp = br_multicast_get_first_rport_node(brmctx, skb);
@@ -326,15 +351,27 @@
 		if ((unsigned long)lport > (unsigned long)rport) {
 			port = lport;
 
+			/* A router or wildcard entry already scheduled a group copy. */
+			if (prev == port)
+				goto delivered;
 			if (port->flags & BR_MULTICAST_TO_UNICAST) {
-				maybe_deliver_addr(lport, skb, p->eth_addr,
-						   local_orig);
+				if (ucast_port != port) {
+					ucast_port = port;
+					wildcard = br_multicast_has_wildcard(p,
+								   allow_mode_include);
+				}
+				if (!br_multicast_pg_eligible(p, allow_mode_include))
+					goto delivered;
+				if (!wildcard) {
+					maybe_deliver_addr(lport, skb, p->eth_addr,
+							   local_orig);
+					goto delivered;
+				}
+				if (!is_zero_ether_addr(p->key.host))
+					goto delivered;
+			} else if (!br_multicast_pg_eligible(p, allow_mode_include)) {
 				goto delivered;
 			}
-			if ((!allow_mode_include &&
-			     p->filter_mode == MCAST_INCLUDE) ||
-			    (p->flags & MDB_PG_FLAGS_BLOCKED))
-				goto delivered;
 		} else {
 			port = rport;
 		}
