From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] MIPS: EVA: use the instruction accessor for kernel exception PCs

The EPC can name either user or kernel instructions. EVA user loads cannot
read a kernel instruction alias. Use the existing mode-aware accessor, as
the surrounding exception code already does.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---

--- a/arch/mips/kernel/branch.c
+++ b/arch/mips/kernel/branch.c
@@ -20,6 +20,7 @@
 #include <asm/ptrace.h>
 #include <linux/uaccess.h>
 
+#include "access-helper.h"
 #include "probes-common.h"
 
 /*
@@ -848,7 +849,6 @@
 
 int __compute_return_epc(struct pt_regs *regs)
 {
-	unsigned int __user *addr;
 	long epc;
 	union mips_instruction insn;
 
@@ -856,11 +856,8 @@
 	if (epc & 3)
 		goto unaligned;
 
-	/*
-	 * Read the instruction
-	 */
-	addr = (unsigned int __user *) epc;
-	if (__get_user(insn.word, addr)) {
+	/* EVA kernel instructions require kernel access, not user loads. */
+	if (__get_inst32(&insn.word, (u32 *)epc, user_mode(regs))) {
 		force_sig(SIGSEGV);
 		return -EFAULT;
 	}
