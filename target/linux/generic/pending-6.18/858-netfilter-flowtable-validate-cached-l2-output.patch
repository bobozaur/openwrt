 	struct flow_rule	*rule;
+	u8			h_source[ETH_ALEN];
+	u8			h_dest[ETH_ALEN];
 };
 
 struct nf_flowtable_type {
@@ -107,6 +109,13 @@
 
 #define NF_FLOW_TABLE_ENCAP_MAX		2
 
+/* Root bridge state captured by the native forwarding-path resolver. */
+struct flow_offload_bridge {
+	u16 vlan_id;
+	__be16 vlan_proto;
+	u8 vlan_mode;
+};
+
 struct flow_offload_tuple {
 	union {
 		struct in_addr		src_v4;
@@ -148,6 +157,8 @@
 			u32		hw_ifidx;
 			u8		h_source[ETH_ALEN];
 			u8		h_dest[ETH_ALEN];
+			struct neighbour *neigh;
+			struct flow_offload_bridge bridge;
 		} out;
 		struct {
 			u32		iifidx;
@@ -214,6 +225,7 @@
 			u32			hw_ifindex;
 			u8			h_source[ETH_ALEN];
 			u8			h_dest[ETH_ALEN];
+			struct flow_offload_bridge bridge;
 		} out;
 		enum flow_offload_xmit_type	xmit_type;
 	} tuple[FLOW_OFFLOAD_DIR_MAX];
@@ -224,6 +236,12 @@
 
 struct nft_flowtable;
 struct nft_pktinfo;
+bool nf_flow_direct_valid(const struct flow_offload_tuple *tuple,
+			  const struct net_device *outdev);
+bool nf_flow_route_valid(struct nf_flowtable *table, const struct flow_offload *flow,
+			 enum flow_offload_tuple_dir rule_dir,
+			 const struct nf_flow_rule *rule);
+
 int nft_flow_route(const struct nft_pktinfo *pkt, const struct nf_conn *ct,
 		   struct nf_flow_route *route, enum ip_conntrack_dir dir,
 		   struct nft_flowtable *ft);
