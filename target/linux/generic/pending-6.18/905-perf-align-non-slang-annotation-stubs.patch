Subject: [PATCH] perf annotate: align non-Slang stubs with the current API

The real annotation functions and their callers no longer take al_addr.
Their !HAVE_SLANG_SUPPORT stubs still declare that obsolete last argument,
which prevents perf from building with NO_SLANG=1. Remove it from both
stubs so the optional TUI configuration does not change the function API.

---
--- a/tools/perf/util/hist.h
+++ b/tools/perf/util/hist.h
@@ -748,16 +748,14 @@
 static inline int __hist_entry__tui_annotate(struct hist_entry *he __maybe_unused,
 					     struct map_symbol *ms __maybe_unused,
 					     struct evsel *evsel __maybe_unused,
-					     struct hist_browser_timer *hbt __maybe_unused,
-					     u64 al_addr __maybe_unused)
+					     struct hist_browser_timer *hbt __maybe_unused)
 {
 	return 0;
 }
 
 static inline int hist_entry__tui_annotate(struct hist_entry *he __maybe_unused,
 					   struct evsel *evsel __maybe_unused,
-					   struct hist_browser_timer *hbt __maybe_unused,
-					   u64 al_addr __maybe_unused)
+					   struct hist_browser_timer *hbt __maybe_unused)
 {
 	return 0;
 }
