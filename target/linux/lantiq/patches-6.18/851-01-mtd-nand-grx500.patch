From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] mtd: rawnand: add GRX500 controller build support

Register the GRX500 EBU controller with the raw NAND core. The driver uses
the native software BCH engine and retains the factory OOB layout.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---

--- a/drivers/mtd/nand/raw/Makefile
+++ b/drivers/mtd/nand/raw/Makefile
@@ -71,3 +71,5 @@
 nand-objs += nand_sandisk.o
 nand-objs += nand_samsung.o
 nand-objs += nand_toshiba.o
+
+obj-$(CONFIG_MTD_NAND_GRX500) += grx500-nand.o
--- a/drivers/mtd/nand/raw/Kconfig
+++ b/drivers/mtd/nand/raw/Kconfig
@@ -538,3 +538,10 @@
 	  parameter "inftl_bbt_write=1".
 
 endif # MTD_RAW_NAND
+
+config MTD_NAND_GRX500
+	bool "Lantiq GRX500 EBU NAND controller"
+	depends on MTD_RAW_NAND && MACH_GRX500 && OF
+	select MTD_NAND_ECC_SW_BCH
+	help
+	  GRX500 EBU NAND with the factory BCH4/512 OOB layout.
