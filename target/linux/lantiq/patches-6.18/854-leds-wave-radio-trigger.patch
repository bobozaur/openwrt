Subject: [PATCH] dt-bindings: leds: describe WAVE physical radio triggers

--- a/Documentation/devicetree/bindings/leds/common.yaml
+++ b/Documentation/devicetree/bindings/leds/common.yaml
@@ -136,6 +136,8 @@
       - pattern: "^mmc[0-9]+$"
         # LED is triggered by WLAN activity
       - pattern: "^phy[0-9]+tx$"
+        # WAVE physical radio activity, named by device and hardware radio ID
+      - pattern: "^wave-.+-[0-9]+-radio$"
 
   led-pattern:
     description: |
