From: Bogdan Mircea <mirceapetrebogdan@gmail.com>
Subject: [PATCH] reset: add GRX500 RCU build support

Register the GRX500 reset provider against the shared RCU syscon.

Upstream-Status: Pending
Signed-off-by: Bogdan Mircea <mirceapetrebogdan@gmail.com>
---

--- a/drivers/reset/Makefile
+++ b/drivers/reset/Makefile
@@ -49,3 +49,5 @@
 obj-$(CONFIG_RESET_UNIPHIER_GLUE) += reset-uniphier-glue.o
 obj-$(CONFIG_RESET_ZYNQ) += reset-zynq.o
 obj-$(CONFIG_RESET_ZYNQMP) += reset-zynqmp.o
+
+obj-$(CONFIG_RESET_GRX500) += reset-grx500.o
--- a/drivers/reset/Kconfig
+++ b/drivers/reset/Kconfig
@@ -399,3 +399,8 @@
 source "drivers/reset/tegra/Kconfig"
 
 endif
+
+config RESET_GRX500
+	bool "Lantiq GRX500 reset controller"
+	depends on MACH_GRX500 && RESET_CONTROLLER && OF
+	select MFD_SYSCON
