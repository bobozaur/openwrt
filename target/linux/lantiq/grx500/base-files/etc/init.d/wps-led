#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=97
STOP=10
USE_PROCD=1

start_service() {
	[ "$(board_name)" = 'tplink,archer-ax50-v1' ] || return 0
	/usr/libexec/led-runtime on
	wps_led_result=$?
	[ "$wps_led_result" = 0 ] || return "$wps_led_result"
	procd_open_instance
	procd_set_param command /usr/libexec/led-runtime watch
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/libexec/led-runtime off
	wps_led_result=$?
}

service_started() {
	return "${wps_led_result:-0}"
}

service_stopped() {
	return "${wps_led_result:-0}"
}

reload_service() {
	/usr/libexec/led-runtime notify
}

service_triggers() {
	procd_add_reload_trigger system
}
