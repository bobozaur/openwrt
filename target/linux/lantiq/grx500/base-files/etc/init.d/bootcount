#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99

boot() {
	local bank expected

	. /lib/functions/ax50.sh

	ax50_is_initial_install && return 0
	bank=$(ax50_running_bank) || return 1
	case "$bank" in A) expected=0 ;; B) expected=2 ;; esac
	# A confirmed bank keeps ordinary recovery and extroot behavior.
	[ "$(fw_printenv -n update_chk)" = "$expected" ] &&
		[ "$(fw_printenv -n loadaddr)" = 0x82000000 ] && return 0

	if ax50_check_running_root "$bank" && ax50_select_bank "$bank" stable; then
		return 0
	fi
	logger -t ax50 'Cannot confirm the running bank'
	return 1
}
